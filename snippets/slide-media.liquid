{%- doc -%}
  One media pane of a slideshow slide (blocks/_slide.liquid): image, uploaded video, MP4 link,
  or YouTube / Vimeo. Videos are muted, looped and only play while their slide is showing
  (assets/slideshow-media.js). The image doubles as the video cover.

  @param {object} settings - The slide block settings
  @param {number} n - Media slot (1 or 2)
  @param {string} loading - 'eager' | 'lazy'
  @param {string} fetchpriority - 'high' | 'low'
  @param {string} sizes - Image sizes attribute
{%- enddoc -%}
{%- liquid
  assign k_type = 'media_type_' | append: n
  assign k_image = 'image_' | append: n
  assign k_video = 'video_' | append: n
  assign k_mp4 = 'video_url_' | append: n
  assign k_ext = 'video_external_' | append: n
  assign k_mobile = 'image_mobile_' | append: n

  assign kind = settings[k_type] | default: 'image'
  assign image = settings[k_image]
  assign video = settings[k_video]
  assign mp4 = settings[k_mp4]
  assign ext = settings[k_ext]
  assign image_mobile = settings[k_mobile]

  # Fall back to the image when the chosen video source is empty
  if kind == 'video' and video == blank
    assign kind = 'image'
  elsif kind == 'mp4' and mp4 == blank
    assign kind = 'image'
  elsif kind == 'external' and ext == blank
    assign kind = 'image'
  endif

  assign poster = image
  if poster == blank and kind == 'video'
    assign poster = video.preview_image
  endif
  assign widths = '832, 1200, 1600, 1920, 2560, 3840'
-%}
<div class="slide__media slide__media--{{ kind }}" data-slide-media="{{ kind }}">
  {%- if poster != blank -%}
    {%- if image_mobile != blank and kind == 'image' -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1100 }} 1100w, {{ image_mobile | image_url: width: 1500 }} 1500w" sizes="100vw">
        {{ poster | image_url: width: 3840 | image_tag: sizes: sizes, widths: widths, class: 'slide__image', loading: loading, fetchpriority: fetchpriority }}
      </picture>
    {%- else -%}
      {%- capture img_class -%}{% if kind == 'image' %}slide__image{% else %}slide__image slide__video-poster{% endif %}{%- endcapture -%}
      {{ poster | image_url: width: 3840 | image_tag: sizes: sizes, widths: widths, class: img_class, loading: loading, fetchpriority: fetchpriority }}
    {%- endif -%}
  {%- elsif kind == 'image' -%}
    {%- assign placeholder_variant = n | modulo: 2 | plus: 1 -%}
    {{ 'hero-apparel-' | append: placeholder_variant | placeholder_svg_tag: 'slide__image' }}
  {%- endif -%}

  {%- case kind -%}
    {%- when 'video' -%}
      {{ video | video_tag: poster: nil, autoplay: false, loop: true, controls: false, muted: true, playsinline: true, preload: 'metadata', class: 'slide__video' }}
    {%- when 'mp4' -%}
      <video class="slide__video" muted loop playsinline preload="none"{% if poster != blank %} poster="{{ poster | image_url: width: 1920 }}"{% endif %}>
        <source data-src="{{ mp4 | escape }}" type="video/mp4">
      </video>
    {%- when 'external' -%}
      {%- liquid
        assign ext_id = ext.id
        if ext.type == 'youtube'
          assign ext_src = 'https://www.youtube-nocookie.com/embed/' | append: ext_id | append: '?autoplay=1&mute=1&loop=1&playlist=' | append: ext_id | append: '&controls=0&playsinline=1&rel=0&modestbranding=1&enablejsapi=1&cc_load_policy=0&iv_load_policy=3&disablekb=1&fs=0'
        else
          assign ext_src = 'https://player.vimeo.com/video/' | append: ext_id | append: '?background=1&autoplay=1&loop=1&muted=1&dnt=1'
        endif
      -%}
      <div class="slide__embed">
        <iframe
          class="slide__iframe"
          data-slide-iframe="{{ ext.type }}"
          data-src="{{ ext_src }}"
          aria-hidden="true"
          tabindex="-1"
          allow="autoplay; encrypted-media; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
  {%- endcase -%}

</div>
