{%- comment -%}
  Accordion FAQ Snippet
  FAQ-specific accordion variant with plus/minus icons
  {%- endcomment -%}

{%- liquid
  assign heading_text = block.settings.heading_text | default: ''
  assign content_image = block.settings.content_image | default: blank
  assign body_text = block.settings.body_text | default: ''
  assign body_variant = block.settings.body_variant | default: 'base'
  assign body_color = block.settings.body_color | default: ''
  assign image_max_width = block.settings.image_max_width | default: ''
-%}

{%- if heading_text != blank -%}
  <div class="faq-section__accordion-item tw-border-0 tw-border-b tw-border-[#dddddd] tw-border-solid tw-box-border tw-content-stretch tw-flex tw-flex-col tw-gap-[16px] tw-items-start tw-px-0 tw-py-[16px] tw-relative tw-shrink-0 tw-w-full">
    <button 
      type="button"
      data-accordion-target="faq-panel-{{ block.id }}" 
      aria-expanded="false" 
      class="faq-section__accordion-button tw-box-border tw-content-stretch tw-flex tw-items-center tw-justify-between tw-px-0 tw-py-[12px] tw-relative tw-w-full tw-word-break tw-gap-2">
      <div class="faq-section__accordion-question tw-content-stretch tw-flex tw-flex-col tw-items-left tw-relative tw-w-full ">
        <div class="faq-section__accordion-question-text tw-flex tw-flex-col tw-font-medium tw-justify-center tw-leading-[0] tw-not-italic tw-relative tw-text-[20px] tw-text-[#000000] tw-tracking-[-0.8px]">
          <p class="tw-leading-[1.1] tw-text-left tw-max-w-[1300px]">{{ heading_text }}</p>
        </div>
      </div>
      {%- comment -%} Plus/Minus Icon - Based on Figma design {%- endcomment -%}
      {%- comment -%} When closed: white background with black lines (plus) {%- endcomment -%}
      {%- comment -%} When open: teal background with white lines (minus) {%- endcomment -%}
      <div class="faq-section__accordion-icon tw-bg-white tw-relative tw-rounded-[50px] tw-shrink-0 tw-w-[30px] tw-h-[30px] tw-flex tw-items-center tw-justify-center">
        <svg class="faq-section__accordion-icon-svg" width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
          {%- comment -%} Horizontal line (always visible) {%- endcomment -%}
          <line class="faq-section__icon-line-horizontal" x1="7" y1="15" x2="23" y2="15" stroke="#000000" stroke-width="2" stroke-linecap="round"/>
          {%- comment -%} Vertical line (hidden when open, shows plus when closed) {%- endcomment -%}
          <line class="faq-section__icon-line-vertical" x1="15" y1="7" x2="15" y2="23" stroke="#000000" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
    </button>
    
    {%- comment -%} Accordion Panel - Based on Figma design {%- endcomment -%}
    <div 
      id="faq-panel-{{ block.id }}" 
      hidden
      class="faq-section__accordion-panel tw-content-stretch tw-flex tw-flex-col tw-gap-[10px] tw-items-start tw-relative tw-shrink-0 tw-w-full tw-max-w-[800px]">
      {%- comment -%} Body Text {%- endcomment -%}
      {%- if body_text != blank -%}
        <div class="faq-section__accordion-answer tw-content-stretch tw-flex tw-flex-col tw-items-start tw-relative tw-shrink-0 tw-w-full">
          {%- render 'body',
            text: body_text,
            variant: body_variant,
            color: body_color,
            parent_class: 'faq-section__accordion'
          -%}
        </div>
      {%- endif -%}
      
      {%- comment -%} Content Image (if provided) {%- endcomment -%}
      {%- if content_image != blank -%}
        <div class="faq-section__accordion-image tw-relative tw-shrink-0 tw-w-full">
          {%- if image_max_width != blank -%}
            <div style="max-width: {{ image_max_width }};">
          {%- endif -%}
          {%- render 'image',
            desktop_image: content_image,
            mobile_image: block.settings.content_image_mobile | default: content_image,
            image_id: block.id | append: '-image',
            layout_type: 'full',
            desktop_aspect_ratio: block.settings.image_aspect_ratio | default: '0.79',
            mobile_aspect_ratio: block.settings.image_aspect_ratio_mobile | default: '2.37',
            parent_class: 'faq-section__accordion'
          -%}
          {%- if image_max_width != blank -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

