{% comment %}
  Renders a single category card (image, badge, title, description, link).
  Used by sections/shop-by-category.liquid
  Required: block, section
{% endcomment %}

{% if block.settings.layout_style == 'image' or block.settings.layout_style == 'default' %}
  <div class="category-image-wrapper">
    {% if block.settings.image != blank %}
      {% assign image = block.settings.image %}
      {% assign image_alt = image.alt | default: block.settings.title | escape %}
      <img
        src="{{ image | image_url: width: 600 }}"
        srcset="{{ image | image_url: width: 300 }} 300w, {{ image | image_url: width: 600 }} 600w"
        alt="{{ image_alt }}"
        loading="lazy"
        width="600"
        height="{{ image.height | times: 600 | divided_by: image.width }}"
      >
    {% else %}
      <div class="image-placeholder">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" aria-hidden="true">
          <rect x="10" y="10" width="80" height="80" rx="8" fill="#ddd" stroke="#bbb" stroke-width="2"/>
          <circle cx="50" cy="35" r="15" fill="#bbb"/>
          <path d="M20 75 L80 75" stroke="#bbb" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 85 L70 85" stroke="#bbb" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
    {% endif %}
  </div>
{% endif %}

<div class="category-content">
  {% if block.settings.badge_text != blank %}
    <span class="category-badge badge-{{ block.settings.badge_type | default: 'neutral' }}">
      {{ block.settings.badge_text }}
    </span>
  {% endif %}

  {% if block.settings.title != blank %}
    <h3 class="category-title">{{ block.settings.title }}</h3>
  {% endif %}

  {% if block.settings.description != blank %}
    <p class="category-description">{{ block.settings.description }}</p>
  {% endif %}

  {% if block.settings.link_text != blank and block.settings.link != blank %}
    <span class="category-link">{{ block.settings.link_text }}</span>
  {% endif %}
</div>
