{% comment %}
  Brand logo row(s).
  @param section {section}
  @param {boolean} [marquee]
  @param {number} [marquee_segments] — how many repeated logo rows (min 2); section sets --brand-logos-marquee-segments for CSS
  @param {boolean} [scroll_mobile] — static only: horizontal scroll on small screens
{% endcomment %}
{%- liquid
  assign is_marquee = marquee | default: false
  assign scroll_m = scroll_mobile | default: false
  assign seg_count = marquee_segments | default: 6
  if seg_count < 2
    assign seg_count = 2
  endif
  if seg_count > 12
    assign seg_count = 12
  endif
-%}
{%- if is_marquee -%}
  {%- for seg in (1..seg_count) -%}
    <ul
      class="brand-logos__row brand-logos__row--marquee{% if seg > 1 %} brand-logos__row--duplicate{% endif %}"
      role="list"
      {% if seg > 1 %}
        aria-hidden="true"
      {% endif %}
    >
      {%- for block in section.blocks -%}
        {%- if block.type == 'logo' -%}
          <li
            class="brand-logos__item"
            {% if seg == 1 %}
              {{ block.shopify_attributes }}
            {% endif %}
          >
            {%- assign logo_alt = block.settings.alt | default: block.settings.image.alt | default: shop.name -%}
            {%- if seg > 1 %}
              {%- assign logo_alt_visible = '' -%}
            {%- else %}
              {%- assign logo_alt_visible = logo_alt -%}
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a
                class="brand-logos__link"
                href="{{ block.settings.link }}"
                {% if seg > 1 %}
                  tabindex="-1"
                {% endif %}
                {% if block.settings.open_new_tab %}
                  target="_blank" rel="noopener noreferrer"
                {% endif %}
              >
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      class: 'brand-logos__img',
                      widths: '200, 360, 480, 600',
                      sizes: '200px',
                      alt: logo_alt_visible
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg brand-logos__img brand-logos__img--placeholder' }}
                {%- endif -%}
              </a>
            {%- else -%}
              <div class="brand-logos__link brand-logos__link--static">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      class: 'brand-logos__img',
                      widths: '200, 360, 480, 600',
                      sizes: '200px',
                      alt: logo_alt_visible
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg brand-logos__img brand-logos__img--placeholder' }}
                {%- endif -%}
              </div>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endfor -%}
{%- else -%}
  <ul
    class="brand-logos__row{% if scroll_m %} brand-logos__row--scroll-mobile{% endif %}"
    role="list"
  >
    {%- for block in section.blocks -%}
      {%- if block.type == 'logo' -%}
        <li class="brand-logos__item" {{ block.shopify_attributes }}>
          {%- assign logo_alt = block.settings.alt | default: block.settings.image.alt | default: shop.name -%}
          {%- if block.settings.link != blank -%}
            <a
              class="brand-logos__link"
              href="{{ block.settings.link }}"
              {% if block.settings.open_new_tab %}
                target="_blank" rel="noopener noreferrer"
              {% endif %}
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    class: 'brand-logos__img',
                    widths: '200, 360, 480, 600',
                    sizes: '(min-width: 990px) 200px, (min-width: 750px) 24vw, 32vw',
                    alt: logo_alt
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg brand-logos__img brand-logos__img--placeholder' }}
              {%- endif -%}
            </a>
          {%- else -%}
            <div class="brand-logos__link brand-logos__link--static">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    class: 'brand-logos__img',
                    widths: '200, 360, 480, 600',
                    sizes: '(min-width: 990px) 200px, (min-width: 750px) 24vw, 32vw',
                    alt: logo_alt
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg brand-logos__img brand-logos__img--placeholder' }}
              {%- endif -%}
            </div>
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
