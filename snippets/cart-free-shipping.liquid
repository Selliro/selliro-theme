{%- doc -%}
  Free shipping progress bar for the cart drawer. The threshold is set in Theme settings › Cart, in the store's
  default currency; cart-drawer-plus.js converts it when the shopper browses in another currency.
{%- enddoc -%}
{%- liquid
  assign threshold = settings.cart_free_shipping_threshold | default: 0 | times: 100
  assign total = cart.total_price
  assign remaining = threshold | minus: total
  if remaining < 0
    assign remaining = 0
  endif
  if threshold > 0
    assign percent = total | times: 100 | divided_by: threshold
  else
    assign percent = 100
  endif
  if percent > 100
    assign percent = 100
  endif
  assign unlocked = false
  if remaining == 0
    assign unlocked = true
  endif
-%}
{%- capture amount_money -%}{{ remaining | money }}{%- endcapture -%}
{%- capture amount_html -%}<strong data-shipping-amount>{{ amount_money }}</strong>{%- endcapture -%}

<cart-shipping-progress
  class="cart-ship{% if unlocked %} cart-ship--unlocked{% endif %}"
  data-threshold="{{ threshold }}"
  data-total="{{ total }}"
  data-shop-currency="{{ shop.currency }}"
  style="--ship-progress: {{ percent }}%;"
>
  <p
    class="cart-ship__message"
    role="status"
  >
    <span class="cart-ship__text cart-ship__text--away">
      {{- 'cart_drawer_plus.free_shipping_away_html' | t: amount: amount_html -}}
    </span>
    <span class="cart-ship__text cart-ship__text--unlocked">
      {{- 'cart_drawer_plus.free_shipping_unlocked_html' | t -}}
    </span>
  </p>
  <div
    class="cart-ship__bar"
    aria-hidden="true"
  >
    <span class="cart-ship__fill">
      <span class="cart-ship__truck">
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3 6.5h10v9H3zM13 9.5h4l3 3v3h-7z"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/>
        </svg>
      </span>
    </span>
  </div>
</cart-shipping-progress>
