{%- comment -%}
  Banner Layout: Color Background
  
  Solid color background layout for image banner section.
  
  Accepts:
  - background_color: Background color hex value
  - max_height: Maximum height in pixels
  - section: Section object with blocks
{%- endcomment -%}

<div class="banner-layout-color__background tw-absolute tw-inset-0" style="background-color: {{ background_color }};"></div>

{%- comment -%} Content Container {%- endcomment -%}
<div class="banner-layout-color__content-wrapper tw-relative tw-h-full tw-flex tw-items-end">
  <div class="section-container section-container--wide image-banner-final__container tw-w-full">
    <div class="image-banner-final__content-wrapper tw-flex tw-flex-col md:tw-flex-row md:tw-justify-between md:tw-items-start tw-gap-10 md:tw-gap-0 tw-w-full tw-border-b tw-border-white/10 tw-pb-14">
      
      {%- comment -%} Left Content Column {%- endcomment -%}
      <div class="image-banner-final__column image-banner-final__column--left tw-flex tw-flex-col tw-gap-2 tw-gap-4 md:tw-max-w-[55%]">
        {%- for block in section.blocks -%}
          {%- if block.settings.position == 'left' -%}
            {%- render 'banner-content-block',
              position: 'left',
              block_type: block.type,
              block_settings: block.settings,
              block_shopify_attributes: block.shopify_attributes,
              block: block,
              max_width: '600px'
            -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      
      {%- comment -%} Right Content Column {%- endcomment -%}
      {%- assign has_right_content = false -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.position == 'right' -%}
          {%- assign has_right_content = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      
      {%- if has_right_content -%}
        <div class="image-banner-final__column image-banner-final__column--right tw-flex tw-flex-col tw-gap-10 md:tw-max-w-[40%]">
          {%- for block in section.blocks -%}
            {%- if block.settings.position == 'right' -%}
              {%- render 'banner-content-block',
                position: 'right',
                block_type: block.type,
                block_settings: block.settings,
                block_shopify_attributes: block.shopify_attributes,
                block: block,
                max_width: '490px'
              -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      
    </div>
  </div>
</div>

