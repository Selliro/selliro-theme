{%- doc -%}
  Design tokens: theme settings as CSS custom properties, inlined in <head> (layout/theme.liquid,
  layout/password.liquid).
  · Fonts: heading, body and accent font pickers, each with bold, italic and bold italic loaded through
    font_modify (Theme Store requirement), font-display: swap.
  · :root — type scale, page width / margin, section spacing, radii, motion.
  · .color-{{ scheme.id }} — one class per color scheme (Theme settings → Colors). Every color is also
    given as an "r g b" triplet (--color-*-rgb) so components can mix transparency:
    rgb(var(--color-text-rgb) / 0.6).
{%- enddoc -%}
{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_body_font
  assign accent_font = settings.type_accent_font
  assign body_bold = body_font | font_modify: 'weight', 'bold'
  assign body_italic = body_font | font_modify: 'style', 'italic'
  assign body_bold_italic = body_bold | font_modify: 'style', 'italic'
  assign heading_bold = heading_font | font_modify: 'weight', 'bold'
  assign heading_italic = heading_font | font_modify: 'style', 'italic'
  assign heading_bold_italic = heading_bold | font_modify: 'style', 'italic'
  assign accent_bold = accent_font | font_modify: 'weight', 'bold'
  assign accent_italic = accent_font | font_modify: 'style', 'italic'
  assign accent_bold_italic = accent_bold | font_modify: 'style', 'italic'
  assign body_scale = settings.body_scale | default: 100 | divided_by: 100.0
  assign heading_scale = settings.heading_scale | default: 100 | divided_by: 100.0
-%}
{% style %}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_bold | font_face: font_display: 'swap' }}
  {{ body_italic | font_face: font_display: 'swap' }}
  {{ body_bold_italic | font_face: font_display: 'swap' }}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_bold | font_face: font_display: 'swap' }}
  {{ heading_italic | font_face: font_display: 'swap' }}
  {{ heading_bold_italic | font_face: font_display: 'swap' }}
  {{ accent_font | font_face: font_display: 'swap' }}
  {{ accent_bold | font_face: font_display: 'swap' }}
  {{ accent_italic | font_face: font_display: 'swap' }}
  {{ accent_bold_italic | font_face: font_display: 'swap' }}

  :root {
    /* Fonts */
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-style: {{ body_font.style }};
    --font-body-weight: {{ body_font.weight }};
    --font-body-weight-bold: {{ body_bold.weight | default: 700 }};
    --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading-style: {{ heading_font.style }};
    --font-heading-weight: {{ heading_font.weight }};
    --font-accent: {{ accent_font.family }}, {{ accent_font.fallback_families }};
    --font-accent-style: {{ accent_font.style }};
    --font-accent-weight: {{ accent_font.weight }};
    --heading-case: {{ settings.heading_case | default: 'none' }};

    /* Type scale (fluid; the settings scale body text and headings separately) */
    --body-scale: {{ body_scale }};
    --heading-scale: {{ heading_scale }};
    --text-xs: calc(0.75rem * var(--body-scale));
    --text-sm: calc(0.875rem * var(--body-scale));
    --text-md: calc(1rem * var(--body-scale));
    --text-lg: calc(1.125rem * var(--body-scale));
    --text-xl: calc(1.25rem * var(--body-scale));
    --h6: calc(clamp(0.875rem, 0.84rem + 0.15vw, 1rem) * var(--heading-scale));
    --h5: calc(clamp(1rem, 0.95rem + 0.25vw, 1.25rem) * var(--heading-scale));
    --h4: calc(clamp(1.25rem, 1.15rem + 0.45vw, 1.625rem) * var(--heading-scale));
    --h3: calc(clamp(1.5rem, 1.3rem + 0.9vw, 2.125rem) * var(--heading-scale));
    --h2: calc(clamp(1.875rem, 1.55rem + 1.5vw, 3rem) * var(--heading-scale));
    --h1: calc(clamp(2.25rem, 1.75rem + 2.3vw, 3.75rem) * var(--heading-scale));
    --display: calc(clamp(2.75rem, 2rem + 3.6vw, 5.25rem) * var(--heading-scale));

    /* Layout */
    --page-width: {{ settings.page_width | default: '1440px' }};
    --page-margin-desktop: {{ settings.page_margin | default: 40 }}px;
    --page-margin: 16px;
    --section-spacing-desktop: {{ settings.section_spacing | default: 96 }}px;
    --section-spacing-mobile: {{ settings.section_spacing_mobile | default: 56 }}px;
    --section-spacing: var(--section-spacing-mobile);

    /* Shapes */
    --radius-button: {{ settings.button_radius | default: 14 }}px;
    --button-height: {{ settings.button_height | default: 52 }}px;
    --radius-input: {{ settings.input_radius | default: 12 }}px;
    --radius-card: {{ settings.card_radius | default: 20 }}px;
    --radius-media: {{ settings.media_radius | default: 16 }}px;

    /* Section titles: one shared scale for home page section headings (ported sections) */
    --section-title-size: calc(clamp(1.65rem, 3.2vw, 2.35rem) * var(--heading-scale));
    --section-title-weight: var(--font-heading-weight);
    --section-title-leading: 1.12;
    --section-title-tracking: -0.02em;

    /* Misc */
    --focus-outline-width: 2px;
    --icon-stroke-width: 1.5px;
    --layer-section-background: -2;
    --opacity-10: 0.1;
    --opacity-10-25: 0.1;
    --drawer-border: 1px solid var(--color-border);
    --drawer-shadow: 0 0 40px rgb(0 0 0 / 0.18);

    /* Logo */
    --logo-width: {{ settings.logo_width | default: 120 }}px;
    --logo-width-mobile: {{ settings.logo_width_mobile | default: 96 }}px;
  }

  @media screen and (min-width: 750px) {
    :root {
      --page-margin: var(--page-margin-desktop);
      --section-spacing: var(--section-spacing-desktop);
    }
  }

  {% for scheme in settings.color_schemes -%}
    {%- assign s = scheme.settings -%}
    {%- if forloop.first %}:root,
    {% endif -%}
    .color-{{ scheme.id }} {
      --color-background: {{ s.background }};
      --color-background-rgb: {{ s.background.red }} {{ s.background.green }} {{ s.background.blue }};
      {%- if s.background_gradient != blank %}
        --gradient-background: {{ s.background_gradient }};
      {%- else %}
        --gradient-background: {{ s.background }};
      {%- endif %}
      --color-text: {{ s.text }};
      --color-text-rgb: {{ s.text.red }} {{ s.text.green }} {{ s.text.blue }};
      --color-heading: {{ s.heading }};
      --color-heading-rgb: {{ s.heading.red }} {{ s.heading.green }} {{ s.heading.blue }};
      --color-accent: {{ s.accent }};
      --color-accent-rgb: {{ s.accent.red }} {{ s.accent.green }} {{ s.accent.blue }};
      --color-accent-text: {{ s.accent_text }};
      --color-border: {{ s.border }};
      --color-border-rgb: {{ s.border.red }} {{ s.border.green }} {{ s.border.blue }};
      --color-button: {{ s.button }};
      --color-button-rgb: {{ s.button.red }} {{ s.button.green }} {{ s.button.blue }};
      --color-button-text: {{ s.button_text }};
      --color-secondary-button: {{ s.secondary_button }};
      --color-secondary-button-text: {{ s.secondary_button_text }};
      --color-input: {{ s.input }};
      --color-input-text: {{ s.input_text }};
      --color-input-text-rgb: {{ s.input_text.red }} {{ s.input_text.green }} {{ s.input_text.blue }};
      --color-button-text-rgb: {{ s.button_text.red }} {{ s.button_text.green }} {{ s.button_text.blue }};
      --color-text-muted: rgb({{ s.text.red }} {{ s.text.green }} {{ s.text.blue }} / 0.7);
      --color-shadow-rgb: 0 0 0;
    }
  {% endfor %}
{% endstyle %}
