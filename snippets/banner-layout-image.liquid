{%- comment -%}
  Banner Layout: Image Background
  
  Image background layout with overlay support.
  
  Accepts:
  - image_desktop: Desktop image object
  - image_mobile: Mobile image object
  - show_overlay: Boolean to show solid overlay
  - overlay_opacity: Overlay opacity percentage
  - show_gradient_overlay: Boolean to show gradient overlay
  - max_height: Maximum height in pixels
  - image_aspect_ratio_desktop: Optional decimal for desktop aspect ratio (default 1.8)
  - image_aspect_ratio_mobile: Optional decimal for mobile aspect ratio (default 0.48)
  - section: Section object with blocks
{%- endcomment -%}

{%- liquid
  assign ar_desktop = image_aspect_ratio | default: 1.8
  assign ar_mobile = image_aspect_ratio_mobile | default: 0.48
-%}

{%- comment -%} Desktop Image {%- endcomment -%}
{%- if image_desktop != blank -%}
  <div class="banner-layout-image__image banner-layout-image__image--desktop tw-hidden md:tw-block tw-inset-0">
    {%- render 'shopify-responsive-image',
      image: image_desktop,
      image_id: 'bg-desktop',
      image_aspect_ratio: ar_desktop,
      wrapper_class: 'tw-w-full tw-h-full',
      image_class: 'tw-w-full tw-h-full tw-object-cover',
      crop: true,
      no_lazyload: true,
      max_height: max_height
    -%}
  </div>
{%- endif -%}

{%- comment -%} Mobile Image {%- endcomment -%}
{%- if image_mobile != blank -%}
  <div class="banner-layout-image__image banner-layout-image__image--mobile md:tw-hidden tw-inset-0">
    {%- render 'shopify-responsive-image',
      image: image_mobile,
      image_id: 'bg-mobile',
      image_aspect_ratio: ar_mobile,
      wrapper_class: 'tw-w-full tw-h-full',
      image_class: 'tw-w-full tw-h-full tw-object-cover',
      no_lazyload: true,
      crop: true,
      max_height: max_height
    -%}
  </div>
{%- elsif image_desktop != blank -%}
  {%- comment -%} Fallback to desktop image on mobile {%- endcomment -%}
  <div class="banner-layout-image__image banner-layout-image__image--mobile-fallback md:tw-hidden tw-inset-0">
    {%- render 'shopify-responsive-image',
      image: image_desktop,
      image_id: 'bg-mobile-fallback',
      image_aspect_ratio: ar_mobile,
      wrapper_class: 'tw-w-full tw-h-full',
      image_class: 'tw-w-full tw-h-full tw-object-cover',
      no_lazyload: true,
      crop: true,
      max_height: max_height
    -%}
  </div>
{%- endif -%}

{%- comment -%} Placeholder if no images {%- endcomment -%}
{%- if image_desktop == blank and image_mobile == blank -%}
  <div class="banner-layout-image__placeholder tw-inset-0">
    {{ 'lifestyle-1' | placeholder_svg_tag: 'tw-w-full tw-h-full tw-object-cover' }}
  </div>
{%- endif -%}

{%- comment -%} Overlay Layers {%- endcomment -%}
{%- if show_overlay -%}
  <div class="banner-layout-image__overlay banner-layout-image__overlay--solid tw-absolute tw-inset-0" style="background-color: rgba(0, 0, 0, {{ overlay_opacity | divided_by: 100.0 }});"></div>
{%- endif -%}

{%- if show_gradient_overlay -%}
  <div class="banner-layout-image__overlay banner-layout-image__overlay--gradient tw-absolute tw-inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.2) 55%, rgba(0,0,0,0) 100%);"></div>
{%- endif -%}

{%- comment -%} Content Container {%- endcomment -%}
<div class="banner-layout-image__content-wrapper tw-absolute tw-inset-0 tw-h-full tw-flex tw-items-end">
  <div class="section-container section-container--wide image-banner-final__container tw-w-full tw-pb-5 md:tw-pb-8">
    <div class="image-banner-final__content-wrapper tw-flex tw-flex-col md:tw-flex-row md:tw-justify-between md:tw-items-start tw-gap-2 
      md:tw-gap-0 tw-w-full tw-border-b tw-border-white/10 tw-pb-9 md:tw-pb-14
      
      ">
      
      {%- comment -%} Left Content Column {%- endcomment -%}
      <div class="image-banner-final__column image-banner-final__column--left tw-flex tw-flex-col tw-gap-2 md:tw-gap-4 md:tw-max-w-[55%]">
        {%- for block in section.blocks -%}
          {%- if block.settings.position == 'left' -%}
            {%- render 'banner-content-block',
              position: 'left',
              block_type: block.type,
              block_settings: block.settings,
              block_shopify_attributes: block.shopify_attributes,
              block: block,
              max_width: '600px'
            -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      
      {%- comment -%} Right Content Column {%- endcomment -%}
      {%- assign has_right_content = false -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.position == 'right' -%}
          {%- assign has_right_content = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      
      {%- if has_right_content -%}
        <div class="image-banner-final__column image-banner-final__column--right tw-flex tw-flex-col tw-gap-5 md:tw-gap-10 md:tw-max-w-[40%]">
          {%- for block in section.blocks -%}
            {%- if block.settings.position == 'right' -%}
              {%- render 'banner-content-block',
                position: 'right',
                block_type: block.type,
                block_settings: block.settings,
                block_shopify_attributes: block.shopify_attributes,
                block: block,
                max_width: '490px'
              -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      
    </div>
  </div>
</div>

