{%- doc -%}
  One cart line, shared by the cart drawer and the cart page (assets/cart-items.js).

  Image · title, options, properties, purchase option, discounts, unit price · price (bold) on the right with
  the quantity field and remove button under it. Line-level errors appear under the line.
  Styles: assets/cart.css ("Line").

  @param {object} item - Line item
  @param {string} id - Unique prefix (cart section id)
  @param {boolean} [compact] - Drawer layout (smaller image and quantity)

  @example
  {% render 'cart-line', item: item, id: 'cart-drawer', compact: true %}
{%- enddoc -%}
{%- liquid
  assign rule = item.variant.quantity_rule
  assign quantity_id = id | append: '-quantity-' | append: item.index
  assign line_label = item.product.title | escape
-%}
<li class="cart-line{% if compact %} cart-line--compact{% endif %}" data-line-key="{{ item.key }}" data-variant-id="{{ item.variant_id }}" data-quantity="{{ item.quantity }}">
  <a href="{{ item.url }}" class="cart-line__image media" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 300 | image_tag: widths: '120, 180, 240, 300', sizes: '96px', loading: 'lazy', alt: '' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>

  <div class="cart-line__details">
    {%- if item.vendor != blank and compact == false -%}
      <p class="cart-line__vendor">{{ item.vendor | escape }}</p>
    {%- endif -%}
    <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title | escape }}</a>

    {%- unless item.product.has_only_default_variant and item.properties == empty and item.selling_plan_allocation == nil -%}
      <dl class="cart-line__options">
        {%- unless item.product.has_only_default_variant -%}
          {%- for option in item.options_with_values -%}
            <div>
              <dt>{{ option.name | escape }}:</dt>
              <dd>{{ option.value | escape }}</dd>
            </div>
          {%- endfor -%}
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <div>
              <dt>{{ property.first | escape }}:</dt>
              <dd>
                {%- if property.last contains '/uploads/' -%}
                  <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
                {%- else -%}
                  {{ property.last | escape }}
                {%- endif -%}
              </dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <div class="cart-line__plan"><dd>{{ item.selling_plan_allocation.selling_plan.name | escape }}</dd></div>
        {%- endif -%}
      </dl>
    {%- endunless -%}

    {%- if item.original_price != item.final_price or item.unit_price_measurement -%}
      <p class="cart-line__each">
        {%- if item.original_price != item.final_price -%}
          <s>{{ item.original_price | money }}</s>
        {%- endif -%}
        {{ item.final_price | money }}
        {%- if item.unit_price_measurement -%}
          <span class="cart-line__unit">
            ({{ item.unit_price | money }}/
            {%- if item.unit_price_measurement.reference_value != 1 -%}{{ item.unit_price_measurement.reference_value }}{%- endif -%}
            {{ item.unit_price_measurement.reference_unit }})
          </span>
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- if item.line_level_discount_allocations.size > 0 -%}
      <ul class="cart-line__discounts" role="list">
        {%- for allocation in item.line_level_discount_allocations -%}
          <li>
            {%- render 'icon', name: 'gift' -%}
            {{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="cart-line__end">
    <p class="cart-line__price">
      {%- if item.original_line_price != item.final_line_price -%}
        <s class="cart-line__price-compare">
          <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
          {{- item.original_line_price | money -}}
        </s>
        <span class="visually-hidden">{{ 'products.sale_price' | t }}</span>
      {%- endif -%}
      {{- item.final_line_price | money -}}
    </p>
    <div class="cart-line__controls">
      {%- render 'quantity-input',
        id: quantity_id,
        name: 'updates[]',
        value: item.quantity,
        min: 0,
        max: rule.max,
        step: rule.increment,
        label: line_label,
        line_key: item.key,
        size: 'small'
      -%}
      <button type="button" class="cart-line__remove icon-button" data-remove="{{ item.key }}">
        {%- render 'icon', name: 'trash' -%}
        <span class="visually-hidden">{{ 'cart.remove_item' | t: title: line_label }}</span>
      </button>
    </div>
  </div>

  <p class="cart-line__error form-message--error" role="alert" data-line-error hidden></p>
</li>
