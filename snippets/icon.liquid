{%- doc -%}
  Inline SVG icons used across the theme. Icons are decorative (aria-hidden, focusable="false"): the
  button or link around them carries the accessible name.

  @param {string} name - menu, close, search, account, cart, chevron-down, chevron-left, chevron-right,
    arrow-right, arrow-up, pause, play, play-circle, globe, check, plus, minus, trash, star, truck, store,
    lock, filter, zoom, leaf, rabbit, shield, recycle, flask, sparkle, heart, clipboard, gift,
    share, link, clock, droplet, sun, map-pin, return, chat, info; social: instagram, facebook, tiktok, pinterest, youtube, x
  @param {string} [class] - extra class on the <svg>

  @example
  {% render 'icon', name: 'search' %}
{%- enddoc -%}
{%- capture classes -%}icon icon--{{ name }}{% if class != blank %} {{ class }}{% endif %}{%- endcapture -%}
