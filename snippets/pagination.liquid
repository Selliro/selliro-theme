{%- doc -%}
  Numbered pagination with previous / next, from a paginate object. Links load in place inside
  <facet-filters> (assets/facets.js); elsewhere they are normal links. Styles: assets/base.css ("Pagination").

  @param {object} paginate - The paginate object
  @param {string} [anchor] - Fragment added to every link (for example '#MainContent')

  @example
  {% render 'pagination', paginate: paginate %}
{%- enddoc -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'pagination.label' | t }}">
    <ul class="pagination__list" role="list">
      {%- if paginate.previous -%}
        <li>
          <a href="{{ paginate.previous.url }}{{ anchor }}" class="pagination__item pagination__item--arrow" rel="prev">
            {%- render 'icon', name: 'chevron-left' -%}
            <span class="visually-hidden">{{ 'pagination.previous' | t }}</span>
          </a>
        </li>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a href="{{ part.url }}{{ anchor }}" class="pagination__item">
              <span class="visually-hidden">{{ 'pagination.page' | t: number: part.title }}</span>
              <span aria-hidden="true">{{ part.title }}</span>
            </a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__item pagination__item--current" aria-current="page">
              <span class="visually-hidden">{{ 'pagination.page' | t: number: part.title }}</span>
              <span aria-hidden="true">{{ part.title }}</span>
            </span>
          {%- else -%}
            <span class="pagination__item pagination__item--gap" aria-hidden="true">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if paginate.next -%}
        <li>
          <a href="{{ paginate.next.url }}{{ anchor }}" class="pagination__item pagination__item--arrow" rel="next">
            {%- render 'icon', name: 'chevron-right' -%}
            <span class="visually-hidden">{{ 'pagination.next' | t }}</span>
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
