{%- doc -%}
  One post on the blog list page (sections/main-blog.liquid).

  @param {object} post - The article
  @param {object} blog - The blog it belongs to (for category links)
  @param {object} settings - The section settings
  @param {boolean} [featured] - Large horizontal card for the featured post
  @param {number} [index] - Position, used for the cascade animation
{%- enddoc -%}
{%- liquid
  assign words = post.content | strip_html | strip_newlines | split: ' ' | size
  assign minutes = words | divided_by: 200.0 | ceil
  if minutes < 1
    assign minutes = 1
  endif
  assign primary_tag = post.tags.first
  assign excerpt_words = 24
  if featured
    assign excerpt_words = 40
  endif
  assign excerpt = post.excerpt_or_content | strip_html | strip | truncatewords: excerpt_words
-%}
<article
  class="blog-card{% if featured %} blog-card--featured{% endif %}"
  style="--i: {{ index | default: 0 }};"
>
  <a
    class="blog-card__media"
    href="{{ post.url }}"
    tabindex="-1"
    aria-hidden="true"
  >
    {%- if post.image -%}
      {%- liquid
        if featured
          assign sizes = '(min-width: 990px) 58vw, 94vw'
        else
          assign sizes = '(min-width: 1200px) 30vw, (min-width: 750px) 45vw, 94vw'
        endif
      -%}
      {{ post.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200, 1600', sizes: sizes, alt: post.image.alt }}
    {%- else -%}
      {{ 'blog-apparel-1' | placeholder_svg_tag: 'blog-card__placeholder' }}
    {%- endif -%}
    {%- if featured -%}
      <span class="blog-card__badge">{{ 'blog_plus.featured' | t }}</span>
    {%- endif -%}
  </a>

  <div class="blog-card__body">
    {%- if settings.show_card_tags and primary_tag != blank -%}
      <a
        class="blog-card__tag"
        href="{{ blog.url }}/tagged/{{ primary_tag | handleize }}"
      >
        {{- primary_tag | escape -}}
      </a>
    {%- endif -%}

    <h2 class="blog-card__title">
      <a href="{{ post.url }}">{{ post.title | escape }}</a>
    </h2>

    {%- if settings.show_excerpt and excerpt != blank -%}
      <p class="blog-card__excerpt">{{ excerpt }}</p>
    {%- endif -%}

    <div class="blog-card__meta">
      {%- if settings.show_author and post.author != blank -%}
        <span class="blog-card__author">{{ post.author | escape }}</span>
      {%- endif -%}
      {%- if settings.show_date -%}
        <span>{{ post.published_at | time_tag: format: 'date' }}</span>
      {%- endif -%}
      {%- if settings.show_reading_time -%}
        <span>{{ 'article_plus.min_read' | t: count: minutes }}</span>
      {%- endif -%}
    </div>

    <a
      class="blog-card__cta"
      href="{{ post.url }}"
      aria-label="{{ 'blog_plus.read_article' | t }}: {{ post.title | escape }}"
    >
      {{- 'blog_plus.read_article' | t -}}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
