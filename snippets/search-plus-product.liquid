{%- doc -%}
  Compact product card for the search pop-up (results, trending and recently viewed).

  @param {object} product - The product to show
  @param {number} [index] - Position, used for the cascade animation
{%- enddoc -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign image = product.featured_media.preview_image | default: product.featured_image
-%}
<a
  class="sp-product"
  href="{{ product.url }}"
  style="--i: {{ index | default: 0 }};"
>
  <span class="sp-product__media">
    {%- if image -%}
      {{ image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '160, 240, 320, 400', sizes: '(min-width: 750px) 160px, 40vw', alt: product.title | escape }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'sp-product__placeholder' }}
    {%- endif -%}
    {%- if product.available == false -%}
      <span class="sp-product__badge">{{ 'content.product_badge_sold_out' | t }}</span>
    {%- elsif variant.compare_at_price > variant.price -%}
      <span class="sp-product__badge sp-product__badge--sale">{{ 'content.product_badge_sale' | t }}</span>
    {%- endif -%}
  </span>
  <span class="sp-product__info">
    {%- if product.vendor != blank -%}
      <span class="sp-product__vendor">{{ product.vendor | escape }}</span>
    {%- endif -%}
    <span
      class="sp-product__title"
      data-search-highlight
    >
      {{- product.title | escape -}}
    </span>
    <span class="sp-product__price">
      {%- if product.price_varies -%}
        {{ 'content.price_from' | t: price: product.price_min | money }}
      {%- else -%}
        {{ variant.price | money }}
      {%- endif -%}
      {%- if variant.compare_at_price > variant.price -%}
        <s>{{ variant.compare_at_price | money }}</s>
      {%- endif -%}
    </span>
  </span>
</a>
