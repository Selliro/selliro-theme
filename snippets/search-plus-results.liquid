{%- doc -%}
  Search pop-up results (rendered by sections/predictive-search.liquid for /search/suggest).
  Products fill the main column; suggestions, collections, pages and blog posts sit in a side column.
  Every result list uses `.predictive-search-results__list` and `ref="resultsItems[]"` so the arrow keys,
  Tab and Enter keep working (assets/predictive-search.js).

  @param {object} results - The predictive_search object
{%- enddoc -%}
{%- liquid
  assign res = results.resources
  assign terms = results.terms
  assign side_count = res.queries.size | plus: res.collections.size | plus: res.pages.size | plus: res.articles.size
  assign total = res.products.size | plus: side_count
  assign safe_terms = terms | escape
  assign encoded_terms = terms | url_encode
  assign search_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last'
-%}

{%- if total > 0 -%}
  <div class="sp-results{% if side_count == 0 %} sp-results--products-only{% endif %}{% if res.products.size == 0 %} sp-results--no-products{% endif %}">
    {%- if res.products.size > 0 -%}
      <div class="sp-results__main">
        <div class="sp-head">
          <h4
            class="sp-head__title"
            id="predictive-search-products-heading"
          >
            {{ 'content.search_results_resource_products' | t }}
            <span class="sp-head__count">{{ res.products.size }}</span>
          </h4>
          <a
            class="sp-head__link"
            href="{{ search_url }}&type=product"
          >
            {{- 'search_plus.see_all' | t -}}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul
          class="predictive-search-results__list sp-grid list-unstyled"
          role="listbox"
          aria-labelledby="predictive-search-products-heading"
        >
          {%- for product in res.products -%}
            <li
              class="sp-grid__item"
              ref="resultsItems[]"
              role="option"
            >
              {% render 'search-plus-product', product: product, index: forloop.index0 %}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if side_count > 0 -%}
      <div class="sp-results__side">
        {%- if res.queries.size > 0 -%}
          <div class="sp-group">
            <h4
              class="sp-group__title"
              id="predictive-search-queries"
            >
              {{ 'search_plus.suggestions' | t }}
            </h4>
            <ul
              class="predictive-search-results__list sp-rows list-unstyled"
              role="listbox"
              aria-labelledby="predictive-search-queries"
            >
              {%- for query in res.queries -%}
                <li
                  class="sp-rows__item"
                  ref="resultsItems[]"
                  role="option"
                >
                  <a
                    class="sp-row sp-row--query"
                    href="{{ query.url }}"
                  >
                    <span
                      class="sp-row__icon"
                      aria-hidden="true"
                    >
                      {{- 'icon-search.svg' | inline_asset_content -}}
                    </span>
                    <span
                      class="sp-row__text"
                      aria-label="{{ query.text | escape }}"
                    >
                      {{- query.styled_text -}}
                    </span>
                    <span
                      class="sp-row__go"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- liquid
          assign groups = 'collection,page,article' | split: ','
        -%}
        {%- for group in groups -%}
          {%- liquid
            case group
              when 'collection'
                assign items = res.collections
                assign heading = 'content.search_results_resource_collections' | t
              when 'page'
                assign items = res.pages
                assign heading = 'content.search_results_resource_pages' | t
              when 'article'
                assign items = res.articles
                assign heading = 'content.search_results_resource_articles' | t
            endcase
          -%}
          {%- if items.size > 0 -%}
            <div class="sp-group">
              <h4
                class="sp-group__title"
                id="predictive-search-{{ group }}"
              >
                {{ heading }}
              </h4>
              <ul
                class="predictive-search-results__list sp-rows list-unstyled"
                role="listbox"
                aria-labelledby="predictive-search-{{ group }}"
              >
                {%- for item in items limit: 4 -%}
                  {%- liquid
                    assign thumb = nil
                    assign meta = nil
                    case group
                      when 'collection'
                        assign thumb = item.featured_image | default: item.products.first.featured_image
                        assign meta = 'search_plus.products_count' | t: count: item.products_count
                      when 'article'
                        assign thumb = item.image
                        assign meta = item.published_at | date: format: 'abbreviated_date'
                        if item.blog.title != blank
                          assign meta = item.blog.title | append: ' · ' | append: meta
                        endif
                      when 'page'
                        assign meta = 'search_plus.page' | t
                    endcase
                  -%}
                  <li
                    class="sp-rows__item"
                    ref="resultsItems[]"
                    role="option"
                  >
                    <a
                      class="sp-row"
                      href="{{ item.url }}"
                    >
                      <span
                        class="sp-row__thumb sp-row__thumb--{{ group }}"
                        aria-hidden="true"
                      >
                        {%- if thumb != blank -%}
                          {{ thumb | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                        {%- elsif group == 'page' -%}
                          <svg
                            viewBox="0 0 20 20"
                            width="18"
                            height="18"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linejoin="round"
                          >
                            <path d="M5 2.5h7l3 3v12H5z"/><path d="M12 2.5v3h3M7.5 9.5h5M7.5 12.5h5"/>
                          </svg>
                        {%- else -%}
                          <svg
                            viewBox="0 0 20 20"
                            width="18"
                            height="18"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linejoin="round"
                          >
                            <path d="M3 4.5h14v11H3zM3 8h14"/>
                          </svg>
                        {%- endif -%}
                      </span>
                      <span class="sp-row__body">
                        <span
                          class="sp-row__title"
                          data-search-highlight
                        >
                          {{- item.title | escape -}}
                        </span>
                        {%- if meta != blank -%}
                          <span class="sp-row__meta">{{ meta }}</span>
                        {%- endif -%}
                      </span>
                      <span
                        class="sp-row__go"
                        aria-hidden="true"
                      >
                        →
                      </span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- else -%}
  <div class="sp-none predictive-search-results__no-results">
    <span
      class="sp-none__icon"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 48 48"
        width="40"
        height="40"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      >
        <circle cx="21" cy="21" r="12"/><path d="m30 30 9 9M16.5 21h9"/>
      </svg>
    </span>
    <p class="sp-none__title">{{ 'search_plus.no_results_title_html' | t: terms: safe_terms }}</p>
    <p class="sp-none__text">{{ 'search_plus.no_results_text' | t }}</p>
    {% render 'search-plus-chips', class: 'sp-none__chips' %}
  </div>
{%- endif -%}
