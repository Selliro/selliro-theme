{% liquid
  assign block_settings = block.settings
  assign menu_content_type = block_settings.menu_style | default: 'text'
  assign image_border_radius = block_settings.image_border_radius
  assign color_scheme_classes = ''
  assign color_scheme_setting_id = 'color_scheme_' | append: section.settings.menu_row
  assign current_color_scheme = block_settings.color_scheme
  assign parent_color_scheme = section.settings[color_scheme_setting_id]

  if parent_color_scheme.id != current_color_scheme.id
    assign color_scheme_classes = ' color-' | append: current_color_scheme
  endif

  # Check if header and menu colors match. This is used to apply different padding styles in css
  if parent_color_scheme.settings.background.rgb == current_color_scheme.settings.background.rgb
    assign color_scheme_classes = color_scheme_classes | append: ' color-scheme-matches-parent'
  endif

  # Submenu layout (Selliro): 'mega' = full-width panel for every item (Horizon default),
  # 'dropdown' = a small list under the item (third-level links fly out to the side),
  # 'auto' = mega menu only where there's more to show (third-level links, images, promo cards), dropdown otherwise
  assign submenu_layout = block_settings.submenu_layout | default: 'mega'

  if block_settings.menu_style == 'featured_collections'
    assign ratio = block_settings.featured_collections_aspect_ratio
  elsif block_settings.menu_style == 'featured_products'
    assign ratio = block_settings.featured_products_aspect_ratio
  endif
%}

{% capture children %}
  {% for link in block_settings.menu.links %}
    {%- liquid
      assign use_dropdown = false
      if link.links != blank
        if submenu_layout == 'dropdown'
          assign use_dropdown = true
        elsif submenu_layout == 'auto'
          assign use_dropdown = true
          for child in link.links
            if child.links != blank
              assign use_dropdown = false
              break
            endif
          endfor
          case menu_content_type
            when 'collection_images', 'featured_products', 'featured_collections'
              assign use_dropdown = false
            when 'promo_cards'
              # A promo card meant for this item (or for every item) needs the mega menu
              assign link_title_handle = link.title | handleize
              for i in (1..2)
                assign key_prefix = 'promo_' | append: i | append: '_'
                assign key_image = key_prefix | append: 'image'
                assign key_heading = key_prefix | append: 'heading'
                assign key_target = key_prefix | append: 'menu_item'
                if block_settings[key_image] == blank and block_settings[key_heading] == blank
                  continue
                endif
                assign promo_target = block_settings[key_target] | strip | handleize
                if promo_target == blank or promo_target == link.handle or promo_target == link_title_handle
                  assign use_dropdown = false
                endif
              endfor
          endcase
        endif
      endif
    -%}
    <li
      role="presentation"
      class="menu-list__list-item{% if use_dropdown %} menu-list__list-item--dropdown{% endif %}"
      on:focus="/activate"
      on:blur="/deactivate"
      on:pointerenter="/activate"
      on:pointerleave="/deactivate"
    >
      <a
        href="{{ link.url }}"
        data-skip-node-update="true"
        class="menu-list__link{% if link.active %} menu-list__link--active{% endif %}"
        {%- if link.links != blank -%}
          aria-controls="submenu-{{ forloop.index }}"
          aria-haspopup="true"
          aria-expanded="false"
        {%- endif -%}
        ref="menuitem"
      >
        <span class="menu-list__link-title" data-text="{{ link.title | escape }}">{{- link.title -}}</span>
        {%- if link.links != blank and block_settings.show_dropdown_icon != false -%}
          <span class="menu-list__link-caret" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="12" height="12" fill="none" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        {%- endif -%}
      </a>
      {%- if use_dropdown -%}
        <div
          class="menu-list__submenu menu-list__submenu--dropdown{{ color_scheme_classes }}"
          ref="submenu[]"
          data-submenu-dropdown
        >
          <div
            id="submenu-{{ forloop.index }}"
            class="menu-dropdown"
            style="{% render 'submenu-font-styles', settings: block_settings %}"
          >
            <ul
              class="menu-dropdown__list list-unstyled"
              role="list"
            >
              {%- for child in link.links -%}
                <li class="menu-dropdown__item{% if child.links != blank %} menu-dropdown__item--has-children{% endif %}">
                  <a
                    href="{{ child.url }}"
                    class="menu-dropdown__link{% if child.active %} menu-dropdown__link--active{% endif %}"
                    {% if child.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    <span>{{ child.title }}</span>
                    {%- if child.links != blank -%}
                      <svg class="menu-dropdown__caret" viewBox="0 0 12 12" width="12" height="12" fill="none" aria-hidden="true" focusable="false"><path d="M4.5 2.5 8 6l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- endif -%}
                  </a>
                  {%- if child.links != blank -%}
                    <ul
                      class="menu-dropdown__flyout list-unstyled"
                      role="list"
                    >
                      {%- for grandchild in child.links -%}
                        <li class="menu-dropdown__item">
                          <a
                            href="{{ grandchild.url }}"
                            class="menu-dropdown__link{% if grandchild.active %} menu-dropdown__link--active{% endif %}"
                            {% if grandchild.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{- grandchild.title -}}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- elsif link.links != blank -%}
        <div class="menu-list__submenu{{ color_scheme_classes }}" ref="submenu[]">
          <div
            id="submenu-{{ forloop.index }}"
            class="menu-list__submenu-inner"
            style="{% render 'submenu-font-styles', settings: block_settings %}"
          >
            {% assign list_id = 'MegaMenuList-' | append: forloop.index %}
            {% render 'mega-menu',
              section: section,
              parent_link: link,
              id: list_id,
              menu_content_type: menu_content_type,
              content_aspect_ratio: ratio,
              image_border_radius: image_border_radius,
              menu_settings: block_settings
            %}
          </div>
        </div>
      {%- endif -%}
    </li>
  {% endfor %}
  <li
    class="menu-list__list-item"
    role="presentation"
    slot="more"
    on:focus="/activate"
    on:blur="/deactivate"
    on:pointerenter="/activate"
    on:pointerleave="/deactivate"
  >
    <button role="menuitem" class="button menu-list__link button-unstyled">
      <span class="menu-list__link-title">{{ 'actions.more' | t }}</span>
    </button>
  </li>
{% endcapture %}

<nav
  header-menu
  class="header-menu-nav header-menu-nav--hover-{{ block_settings.menu_hover_style | default: 'dim' }}{% if block_settings.submenu_divider != false %} header-menu-nav--submenu-divider{% endif %}{% if block_settings.submenu_animate_content != false %} header-menu-nav--animate-content{% endif %}"
  style="--submenu-radius: {{ block_settings.submenu_radius | default: 0 }}px;"
>
  <div
    class="menu-list"
    style="{% render 'menu-font-styles', settings: block_settings %}"
  >
    {% assign class = 'overflow-menu' | append: color_scheme_classes %}
    {% render 'overflow-list', class: class, ref: 'overflowMenu', children: children, minimum-items: 2, defer: true %}
  </div>
</nav>
