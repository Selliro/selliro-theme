    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 11.5c2-2.6 4.2-4 6-4 1.2 0 2.2.6 3.5 1.6 1.3-1 2.3-1.6 3.5-1.6 1.8 0 4 1.4 6 4-2.4 3.4-5.6 5.5-9.5 5.5S4.9 14.9 2.5 11.5Z"/><path d="M2.5 11.5c3 .9 6.2 1.3 9.5 1.3s6.5-.4 9.5-1.3"/></svg>
