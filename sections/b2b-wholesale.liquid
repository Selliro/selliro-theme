{%- comment -%}
  Wholesale / B2B — sells the wholesale programme and lets businesses price and request an order on the spot.
  · Left: eyebrow, heading, text, benefit cards (icon, title, text), key numbers, buttons (apply, line sheet, call).
  · Right: a card with two tabs.
      Bulk pricing — pick a product + variant, set the quantity in case packs; shows the tier reached, unit price,
      order total, saving, the margin at retail price and how many more units unlock the next tier.
      Request a quote — Shopify contact form (emails the store), pre-filled from the calculator.
  · Logged-in Shopify B2B customers: real catalog pricing (quantity price breaks + quantity rules), their company
    and location, and add to cart. Everyone else: a labelled preview of the tiers below; add to cart only if
    "Let retail customers order" is on (each tier's discount code is applied to the cart).
  Blocks: benefit, stat, tier.   Files: assets/b2b-wholesale.js (+ shared assets/section-reveal.*)
{%- endcomment -%}
{{ 'section-reveal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-reveal.js' | asset_url }}" defer></script>
<script src="{{ 'b2b-wholesale.js' | asset_url }}" defer></script>

{%- liquid
  assign is_b2b = false
  if customer and customer.b2b?
    assign is_b2b = true
  endif

  assign products = section.settings.products
  if products == blank or products.size == 0
    if section.settings.collection != blank
      assign products = section.settings.collection.products
    else
      assign products = collections.all.products
    endif
  endif
  assign product_limit = section.settings.product_limit

  assign benefits = section.blocks | where: 'type', 'benefit'
  assign stats = section.blocks | where: 'type', 'stat'
  assign tiers = section.blocks | where: 'type', 'tier'

  assign case_size = section.settings.case_size | default: 1
  assign min_order = section.settings.min_order | default: 1
  assign can_order = false
  if is_b2b or section.settings.retail_ordering
    assign can_order = true
  endif

  assign form_id = 'B2BQuote-' | append: section.id
  assign form_dom_id = 'B2BQuoteForm-' | append: section.id
  assign welcome_name = customer.first_name | default: customer.name
  assign anchor = section.settings.anchor_id | handleize
-%}

{%- capture icon_svgs -%}
  tag|<path d="M3 12.2V4.5A1.5 1.5 0 0 1 4.5 3h7.7l8.8 8.8a1.5 1.5 0 0 1 0 2.1l-7.1 7.1a1.5 1.5 0 0 1-2.1 0L3 12.2Z"/><circle cx="7.8" cy="7.8" r="1.6"/>
  truck|<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
  calendar|<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4M8 13.5h2M14 13.5h2M8 16.5h2"/>
  headset|<path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M19 19c0 1.5-2 2.5-5 2.5"/>
  box|<path d="M12 2.8 20.5 7v10L12 21.2 3.5 17V7L12 2.8Z"/><path d="M3.5 7 12 11.2 20.5 7M12 11.2v10"/>
  sparkle|<path d="M12 3c.6 4.2 2.8 6.4 7 7-4.2.6-6.4 2.8-7 7-.6-4.2-2.8-6.4-7-7 4.2-.6 6.4-2.8 7-7Z"/><path d="M19 15.5c.2 1.4.9 2.1 2.3 2.3-1.4.2-2.1.9-2.3 2.3-.2-1.4-.9-2.1-2.3-2.3 1.4-.2 2.1-.9 2.3-2.3Z"/>
  leaf|<path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19c3-4 6-7 10-9"/>
  shield|<path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.2 7.5 9.5 4.4-1.3 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.8 12.2 2.2 2.2 4.4-4.6"/>
{%- endcapture -%}
{%- assign icon_lines = icon_svgs | strip | newline_to_br | split: '<br />' -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  {% if anchor != blank %}id="{{ anchor }}"{% endif %}
  class="b2b {{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  data-reveal
  style="--b2b-pad-top: {{ section.settings.padding_top }}px; --b2b-pad-bottom: {{ section.settings.padding_bottom }}px; --b2b-accent: {{ section.settings.accent_color | default: '#f8d12f' }}; --b2b-card: {{ section.settings.card_color | default: '#ffffff' }}; --b2b-radius: {{ section.settings.radius }}px;"
>
  <div class="b2b__grid">
    {%- comment -%} ======================================================== pitch {%- endcomment -%}
    <div class="b2b__pitch">
      {%- if section.settings.eyebrow != blank -%}
        <p class="b2b__eyebrow" data-reveal-fade="first">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/></svg>
          {{- section.settings.eyebrow | escape -}}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="b2b__heading" data-reveal-title>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="b2b__text rte" data-reveal-fade>{{ section.settings.text }}</div>
      {%- endif -%}

      {%- comment -%} Account state {%- endcomment -%}
      <div class="b2b__account" data-reveal-fade>
        {%- if is_b2b -%}
          <span class="b2b__account-dot b2b__account-dot--ok" aria-hidden="true"></span>
          <span>
            <strong>{{ 'b2b_wholesale.welcome' | t: name: welcome_name }}</strong>
            {%- if customer.current_company -%}
              <br>{{ 'b2b_wholesale.buying_for' | t: company: customer.current_company.name, location: customer.current_location.name }}
            {%- endif -%}
          </span>
          <a class="b2b__account-link" href="{{ routes.account_url }}">{{ 'b2b_wholesale.view_orders' | t }}</a>
        {%- elsif customer -%}
          <span class="b2b__account-dot" aria-hidden="true"></span>
          <span>{{ 'b2b_wholesale.signed_in_retail' | t }}</span>
        {%- else -%}
          <span class="b2b__account-dot" aria-hidden="true"></span>
          <span>{{ 'b2b_wholesale.partner_login' | t }}</span>
          <a class="b2b__account-link" href="{{ routes.account_login_url }}">{{ 'b2b_wholesale.log_in' | t }}</a>
        {%- endif -%}
      </div>

      {%- if benefits.size > 0 -%}
        <ul class="b2b__benefits" role="list">
          {%- for block in benefits -%}
            <li class="b2b__benefit" data-reveal-card {{ block.shopify_attributes }}>
              <span class="b2b__benefit-icon" aria-hidden="true">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  {%- for line in icon_lines -%}
                    {%- assign parts = line | strip | split: '|' -%}
                    {%- if parts.first == block.settings.icon -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{{ parts.last }}</svg>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </span>
              <span class="b2b__benefit-copy">
                {%- if block.settings.title != blank -%}<strong class="b2b__benefit-title">{{ block.settings.title | escape }}</strong>{%- endif -%}
                {%- if block.settings.text != blank -%}<span class="b2b__benefit-text">{{ block.settings.text | escape }}</span>{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if stats.size > 0 -%}
        <dl class="b2b__stats" data-reveal-fade>
          {%- for block in stats -%}
            <div class="b2b__stat" {{ block.shopify_attributes }}>
              <dt class="b2b__stat-label">{{ block.settings.label | escape }}</dt>
              <dd class="b2b__stat-value">{{ block.settings.value | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- if section.settings.apply_label != blank or section.settings.sheet_label != blank or section.settings.call_label != blank -%}
        <div class="b2b__actions" data-reveal-fade>
          {%- if section.settings.apply_label != blank -%}
            <a class="button b2b__btn" href="#{{ form_id }}" data-b2b-open-quote>
              {{- section.settings.apply_label | escape -}}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.sheet_label != blank and section.settings.sheet_link != blank -%}
            <a class="button-secondary b2b__btn b2b__btn--ghost" href="{{ section.settings.sheet_link }}" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {{- section.settings.sheet_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.call_label != blank and section.settings.call_link != blank -%}
            <a class="b2b__text-link" href="{{ section.settings.call_link }}">{{ section.settings.call_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ======================================================== card {%- endcomment -%}
    <b2b-wholesale
      class="b2b__card"
      data-reveal-rise
      data-money-format="{{ shop.money_format | escape }}"
      data-mode="{% if is_b2b %}contract{% else %}preview{% endif %}"
      data-can-order="{{ can_order }}"
      data-case="{{ case_size }}"
      data-min="{{ min_order }}"
      data-text-next="{{ 'b2b_wholesale.next_tier' | t }}"
      data-text-top="{{ 'b2b_wholesale.top_tier' | t }}"
      data-text-min="{{ 'b2b_wholesale.below_min' | t }}"
      data-text-quote="{{ 'b2b_wholesale.quote_for' | t }}"
      data-text-added="{{ 'b2b_wholesale.added' | t }}"
      data-text-error="{{ 'b2b_wholesale.error' | t }}"
    >
      <div class="b2b__tabs" role="tablist">
        <button type="button" class="b2b__tab is-active" role="tab" id="{{ section.id }}-tab-calc" aria-controls="{{ section.id }}-panel-calc" aria-selected="true" data-b2b-tab="calc">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2.5"/><path d="M8 7.5h8M8 12h2M14 12h2M8 16h2M14 16h2"/></svg>
          {{ 'b2b_wholesale.tab_calculator' | t }}
        </button>
        <button type="button" class="b2b__tab" role="tab" id="{{ section.id }}-tab-quote" aria-controls="{{ form_id }}" aria-selected="false" tabindex="-1" data-b2b-tab="quote">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H8l-4 4V5Z"/><path d="M8 9.5h8M8 12.5h5"/></svg>
          {{ 'b2b_wholesale.tab_quote' | t }}
        </button>
      </div>

      {%- comment -%} ---------------- calculator {%- endcomment -%}
      <div class="b2b__panel" role="tabpanel" id="{{ section.id }}-panel-calc" aria-labelledby="{{ section.id }}-tab-calc" data-b2b-panel="calc">
        <p class="b2b__mode{% if is_b2b %} b2b__mode--contract{% endif %}">
          <span class="b2b__mode-dot" aria-hidden="true"></span>
          {%- if is_b2b -%}{{ 'b2b_wholesale.contract_pricing' | t }}{%- else -%}{{ 'b2b_wholesale.preview_pricing' | t }}{%- endif -%}
        </p>

        {%- if products.size == 0 -%}
          <p class="b2b__empty">{{ 'b2b_wholesale.editor_hint' | t }}</p>
        {%- else -%}
          <fieldset class="b2b__products">
            <legend class="b2b__label">{{ 'b2b_wholesale.product' | t }}</legend>
            <div class="b2b__product-list">
              {%- for product in products limit: product_limit -%}
                <label class="b2b__product{% if forloop.first %} is-active{% endif %}">
                  <input type="radio" name="{{ section.id }}-product" value="{{ forloop.index0 }}" class="visually-hidden" data-b2b-product {% if forloop.first %}checked{% endif %}>
                  <span class="b2b__product-media">
                    {%- if product.featured_image != blank -%}
                      {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 80, height: 80 }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'b2b__placeholder' }}
                    {%- endif -%}
                  </span>
                  <span class="b2b__product-name">{{ product.title | escape }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>

          <div class="b2b__row">
            <label class="b2b__field b2b__field--variant" data-b2b-variant-field hidden>
              <span class="b2b__label">{{ 'b2b_wholesale.variant' | t }}</span>
              <select class="b2b__select" data-b2b-variant></select>
            </label>

            <div class="b2b__field b2b__field--qty">
              <label class="b2b__label" for="{{ section.id }}-qty">{{ 'b2b_wholesale.quantity' | t }}</label>
              <div class="b2b__stepper">
                <button type="button" class="b2b__step" data-b2b-step="-1" aria-label="{{ 'b2b_wholesale.decrease' | t }}">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </button>
                <input class="b2b__qty" id="{{ section.id }}-qty" type="number" inputmode="numeric" min="1" value="{{ min_order }}" data-b2b-qty>
                <button type="button" class="b2b__step" data-b2b-step="1" aria-label="{{ 'b2b_wholesale.increase' | t }}">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </button>
              </div>
              <p class="b2b__hint" data-b2b-case>{% if case_size > 1 %}{{ 'b2b_wholesale.case_pack' | t: size: case_size }}{% endif %}</p>
            </div>
          </div>

          {%- comment -%} Tier ladder (filled by the script in contract mode, from the blocks in preview mode) {%- endcomment -%}
          <ol class="b2b__tiers" role="list" data-b2b-tiers>
            {%- for block in tiers -%}
              <li class="b2b__tier" data-qty="{{ block.settings.min_qty }}" {{ block.shopify_attributes }}>
                <button type="button" class="b2b__tier-btn" data-b2b-tier="{{ block.settings.min_qty }}">
                  <span class="b2b__tier-name">{{ block.settings.label | escape }}</span>
                  {%- assign tier_pct = block.settings.discount | append: '%' -%}
                  <span class="b2b__tier-off">{{ 'b2b_wholesale.tier_off' | t: discount: tier_pct }}</span>
                  <span class="b2b__tier-qty">{{ 'b2b_wholesale.tier_units' | t: qty: block.settings.min_qty }}</span>
                </button>
              </li>
            {%- endfor -%}
          </ol>
          <div class="b2b__progress" aria-hidden="true"><span class="b2b__progress-fill" data-b2b-progress></span></div>
          <p class="b2b__nudge" data-b2b-nudge aria-live="polite"></p>

          <div class="b2b__summary">
            <div class="b2b__price">
              <span class="b2b__label">{{ 'b2b_wholesale.unit_price' | t }}</span>
              <span class="b2b__price-row">
                <strong class="b2b__unit" data-b2b-unit></strong>
                <s class="b2b__retail" data-b2b-retail></s>
                <span class="b2b__badge" data-b2b-badge hidden></span>
              </span>
            </div>
            <dl class="b2b__totals">
              <div><dt>{{ 'b2b_wholesale.total' | t }}</dt><dd data-b2b-total></dd></div>
              <div class="b2b__save"><dt>{{ 'b2b_wholesale.savings' | t }}</dt><dd data-b2b-save></dd></div>
              <div class="b2b__margin" data-b2b-margin-row><dt>{{ 'b2b_wholesale.margin' | t }}</dt><dd data-b2b-margin></dd></div>
            </dl>
            <p class="b2b__margin-note" data-b2b-margin-note data-template="{{ 'b2b_wholesale.margin_note' | t: amount: '[amount]', price: '[price]' }}"></p>
          </div>

          <div class="b2b__ctas">
            {%- if can_order -%}
              <button type="button" class="button b2b__cta" data-b2b-add>
                <span data-b2b-add-label>{{ 'b2b_wholesale.add_to_cart' | t }}</span>
              </button>
              <button type="button" class="button-secondary b2b__cta b2b__cta--ghost" data-b2b-quote>{{ 'b2b_wholesale.quote_this' | t }}</button>
            {%- else -%}
              <button type="button" class="button b2b__cta" data-b2b-quote>
                {{- 'b2b_wholesale.quote_this' | t -}}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            {%- endif -%}
          </div>
          <p class="b2b__error" data-b2b-error role="alert" hidden></p>

          {%- comment -%} Product data for the calculator {%- endcomment -%}
          <script type="application/json" data-b2b-data>
            {
              "tiers": [
                {%- for block in tiers -%}
                  { "qty": {{ block.settings.min_qty | json }}, "off": {{ block.settings.discount | json }}, "label": {{ block.settings.label | json }}, "code": {{ block.settings.discount_code | strip | json }} }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ],
              "products": [
                {%- for product in products limit: product_limit -%}
                  {
                    "title": {{ product.title | json }},
                    "url": {{ product.url | json }},
                    "variants": [
                      {%- for variant in product.variants -%}
                        {
                          "id": {{ variant.id }},
                          "title": {{ variant.title | json }},
                          "available": {{ variant.available }},
                          "price": {{ variant.price }},
                          "compare": {{ variant.compare_at_price | default: 0 }},
                          "min": {{ variant.quantity_rule.min | default: 1 }},
                          "max": {{ variant.quantity_rule.max | default: 0 }},
                          "step": {{ variant.quantity_rule.increment | default: 1 }},
                          "breaks": [
                            {%- if is_b2b and variant.quantity_price_breaks_configured? -%}
                              {%- for qb in variant.quantity_price_breaks -%}
                                { "qty": {{ qb.minimum_quantity }}, "price": {{ qb.price }} }{% unless forloop.last %},{% endunless %}
                              {%- endfor -%}
                            {%- endif -%}
                          ]
                        }{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    ]
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            }
          </script>
        {%- endif -%}
      </div>

      {%- comment -%} ---------------- quote form {%- endcomment -%}
      <div class="b2b__panel" role="tabpanel" id="{{ form_id }}" aria-labelledby="{{ section.id }}-tab-quote" data-b2b-panel="quote" hidden>
        {%- form 'contact', id: form_dom_id, class: 'b2b__form' -%}
          {%- if form.posted_successfully? -%}
            {%- comment -%}
              Thank-you message. The form stays in the page (hidden) so it can come back without a reload: after the
              delay chosen in the settings (paused while hovered / focused) or straight away via the button.
            {%- endcomment -%}
            <div class="b2b__success" role="status" tabindex="-1" data-b2b-posted data-b2b-success data-delay="{{ section.settings.success_delay }}">
              <span class="b2b__success-icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <p>{% if section.settings.success_text != blank %}{{ section.settings.success_text | escape }}{% else %}{{ 'b2b_wholesale.success' | t }}{% endif %}</p>
              <button type="button" class="button-secondary b2b__again" data-b2b-again>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.6-5.9M4 4v4.5h4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {{- 'b2b_wholesale.send_another' | t -}}
              </button>
              {%- if section.settings.success_delay != '0' -%}
                <span class="b2b__success-timer" aria-hidden="true"><span data-b2b-timer></span></span>
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="b2b__form-body" data-b2b-form-body{% if form.posted_successfully? %} hidden{% endif %}>
            {%- if form.errors -%}
              <div class="b2b__form-error" role="alert" data-b2b-posted>{{ form.errors | default_errors }}</div>
            {%- endif -%}

            <p class="b2b__quote-summary" data-b2b-quote-summary hidden></p>
            <input type="hidden" name="contact[Enquiry]" value="Wholesale / B2B">
            <input type="hidden" name="contact[Product]" data-b2b-f-product>
            <input type="hidden" name="contact[Variant]" data-b2b-f-variant>
            <input type="hidden" name="contact[Quantity]" data-b2b-f-qty>
            <input type="hidden" name="contact[Estimated total]" data-b2b-f-total>

            <div class="b2b__form-grid">
              <label class="b2b__field">
                <span class="b2b__label">{{ 'b2b_wholesale.name' | t }}</span>
                <input class="b2b__input" type="text" name="contact[name]" autocomplete="name" value="{% if customer %}{{ customer.name | escape }}{% endif %}" required>
              </label>
              <label class="b2b__field">
                <span class="b2b__label">{{ 'b2b_wholesale.business' | t }}</span>
                <input class="b2b__input" type="text" name="contact[Business name]" autocomplete="organization" value="{% if is_b2b %}{{ customer.current_company.name | escape }}{% endif %}" required>
              </label>
              <label class="b2b__field">
                <span class="b2b__label">{{ 'b2b_wholesale.email' | t }}</span>
                <input class="b2b__input" type="email" name="contact[email]" autocomplete="email" value="{% if customer %}{{ customer.email | escape }}{% endif %}" required>
              </label>
              <label class="b2b__field">
                <span class="b2b__label">{{ 'b2b_wholesale.phone' | t }}</span>
                <input class="b2b__input" type="tel" name="contact[phone]" autocomplete="tel">
              </label>
              <label class="b2b__field">
                <span class="b2b__label">{{ 'b2b_wholesale.business_type' | t }}</span>
                <select class="b2b__select" name="contact[Business type]">
                  <option>{{ 'b2b_wholesale.type_salon' | t }}</option>
                  <option>{{ 'b2b_wholesale.type_retail' | t }}</option>
                  <option>{{ 'b2b_wholesale.type_online' | t }}</option>
                  <option>{{ 'b2b_wholesale.type_distributor' | t }}</option>
                  <option>{{ 'b2b_wholesale.type_other' | t }}</option>
                </select>
              </label>
              <label class="b2b__field">
                <span class="b2b__label">{{ 'b2b_wholesale.volume' | t }}</span>
                <select class="b2b__select" name="contact[Monthly volume]">
                  {%- assign volumes = section.settings.volume_options | newline_to_br | split: '<br />' -%}
                  {%- for v in volumes -%}
                    {%- assign v = v | strip -%}
                    {%- if v != blank -%}<option>{{ v | escape }}</option>{%- endif -%}
                  {%- endfor -%}
                </select>
              </label>
              <label class="b2b__field b2b__field--full">
                <span class="b2b__label">{{ 'b2b_wholesale.message' | t }}</span>
                <textarea class="b2b__input b2b__textarea" name="contact[body]" rows="3"></textarea>
              </label>
            </div>
            <button type="submit" class="button b2b__cta b2b__submit">
              {{- 'b2b_wholesale.submit' | t -}}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            {%- if section.settings.form_note != blank -%}
              <p class="b2b__form-note">{{ section.settings.form_note | escape }}</p>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </b2b-wholesale>
  </div>
</section>

{% stylesheet %}
  .b2b[id] {
    scroll-margin-top: calc(var(--header-height, 72px) + 16px);
  }

  .b2b {
    --b2b-ink: var(--color-foreground);
    --b2b-line: color-mix(in srgb, var(--color-foreground) 12%, transparent);
    --b2b-soft: color-mix(in srgb, var(--color-foreground) 5%, transparent);
    --b2b-ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    padding-block: var(--b2b-pad-top) var(--b2b-pad-bottom);
  }

  .b2b__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* ---------------------------------------------------------------- pitch */
  .b2b__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--b2b-accent);
    color: #111;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .b2b__heading {
    margin: 0;
    font-size: var(--section-title-size);
    font-weight: var(--section-title-weight);
    line-height: var(--section-title-leading);
    letter-spacing: var(--section-title-tracking);
    text-wrap: balance;
  }

  .b2b__text {
    margin-top: 1rem;
    max-width: 34rem;
    opacity: 0.78;
  }

  .b2b__account {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--b2b-line);
    border-radius: 14px;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .b2b__account-dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-foreground) 30%, transparent);
  }

  .b2b__account-dot--ok {
    background: #2e9e5b;
    box-shadow: 0 0 0 4px rgb(46 158 91 / 0.15);
  }

  .b2b__account-link {
    margin-inline-start: auto;
    color: inherit;
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .b2b__benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .b2b__benefit {
    display: flex;
    gap: 0.85rem;
    padding: 1rem;
    border-radius: 16px;
    background: var(--b2b-soft);
  }

  .b2b__benefit-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
    background: var(--color-background);
    box-shadow: 0 6px 16px -10px rgb(0 0 0 / 0.35);
  }

  .b2b__benefit-icon img {
    width: 60%;
    height: 60%;
    object-fit: contain;
  }

  .b2b__benefit-copy {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .b2b__benefit-title {
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .b2b__benefit-text {
    font-size: 0.82rem;
    line-height: 1.5;
    opacity: 0.72;
  }

  .b2b__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.75rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--b2b-line);
  }

  .b2b__stat {
    display: flex;
    flex-direction: column-reverse;
    margin: 0;
  }

  .b2b__stat-value {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .b2b__stat-label {
    font-size: 0.8rem;
    opacity: 0.65;
  }

  .b2b__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.75rem;
  }

  .b2b__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .b2b__text-link {
    color: inherit;
    font-weight: 600;
    text-underline-offset: 4px;
  }

  /* ---------------------------------------------------------------- card */
  .b2b__card {
    display: block;
    min-width: 0;
    padding: clamp(1.1rem, 2.5vw, 1.75rem);
    border: 1px solid var(--b2b-line);
    border-radius: var(--b2b-radius);
    background: var(--b2b-card);
    color: #161616;
    box-shadow: 0 30px 60px -40px rgb(0 0 0 / 0.35);
    --b2b-line: rgb(0 0 0 / 0.1);
    --b2b-soft: rgb(0 0 0 / 0.04);
  }

  .b2b__tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--b2b-soft);
  }

  .b2b__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s, box-shadow 0.25s;
  }

  .b2b__tab.is-active {
    background: #161616;
    color: #fff;
    box-shadow: 0 8px 20px -12px rgb(0 0 0 / 0.6);
  }

  .b2b__panel {
    padding-top: 1.25rem;
  }

  .b2b__panel[hidden] {
    display: none;
  }

  .b2b__mode {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-size: 0.78rem;
    opacity: 0.75;
  }

  .b2b__mode-dot {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--b2b-accent);
  }

  .b2b__mode--contract .b2b__mode-dot {
    background: #2e9e5b;
  }

  .b2b__label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .b2b__products {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .b2b__product-list {
    display: flex;
    gap: 0.5rem;
    margin-inline: -2px;
    padding: 2px 2px 6px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .b2b__product {
    position: relative; /* keeps the hidden radio inside the scrolling row */
    display: grid;
    flex: 0 0 6.5rem;
    gap: 0.4rem;
    padding: 0.45rem;
    border: 1.5px solid var(--b2b-line);
    border-radius: 14px;
    background: #fff;
    cursor: pointer;
    scroll-snap-align: start;
    transition: border-color 0.2s, box-shadow 0.2s, translate 0.3s var(--b2b-ease);
  }

  .b2b__product:hover {
    translate: 0 -2px;
  }

  .b2b__product.is-active {
    border-color: #161616;
    box-shadow: 0 10px 22px -16px rgb(0 0 0 / 0.55);
  }

  .b2b__product:has(:focus-visible) {
    outline: 2px solid #161616;
    outline-offset: 2px;
  }

  .b2b__product-media {
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    background: #f4f1ea;
  }

  .b2b__product-media :is(img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .b2b__placeholder {
    fill: rgb(0 0 0 / 0.3);
  }

  .b2b__product-name {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .b2b__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem 1rem;
    margin-top: 1.1rem;
  }

  .b2b__row:has(.b2b__field--variant:not([hidden])) {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .b2b__field {
    display: block;
    min-width: 0;
  }

  .b2b__field[hidden] {
    display: none;
  }

  .b2b__select,
  .b2b__input {
    width: 100%;
    min-height: 3rem;
    padding: 0.6rem 0.9rem;
    border: 1.5px solid var(--b2b-line);
    border-radius: 12px;
    background: #fff;
    color: inherit;
    font: inherit;
    font-size: 1rem;
  }

  .b2b__select:focus-visible,
  .b2b__input:focus-visible {
    outline: none;
    border-color: #161616;
    box-shadow: 0 0 0 3px rgb(0 0 0 / 0.08);
  }

  .b2b__textarea {
    min-height: 5.5rem;
    resize: vertical;
  }

  .b2b__stepper {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 3rem;
    border: 1.5px solid var(--b2b-line);
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }

  .b2b__step {
    display: grid;
    place-items: center;
    min-height: 3rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .b2b__step:hover {
    background: var(--b2b-soft);
  }

  .b2b__qty {
    width: 100%;
    min-width: 0;
    border: 0;
    border-inline: 1px solid var(--b2b-line);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1.1rem;
    font-weight: 700;
    text-align: center;
    -moz-appearance: textfield;
  }

  .b2b__qty::-webkit-outer-spin-button,
  .b2b__qty::-webkit-inner-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  .b2b__qty:focus-visible {
    outline: 2px solid #161616;
    outline-offset: -2px;
  }

  .b2b__hint {
    margin: 0.35rem 0 0;
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .b2b__hint:empty {
    display: none;
  }

  /* Tier ladder */
  .b2b__tiers {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .b2b__tiers:empty {
    display: none;
  }

  .b2b__tier-btn {
    display: grid;
    width: 100%;
    height: 100%;
    gap: 0.1rem;
    padding: 0.7rem 0.6rem;
    border: 1.5px solid var(--b2b-line);
    border-radius: 14px;
    background: #fff;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.25s, translate 0.3s var(--b2b-ease);
  }

  .b2b__tier-btn:hover {
    translate: 0 -2px;
  }

  .b2b__tier-name {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .b2b__tier-off {
    font-family: var(--font-heading--family);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .b2b__tier-qty {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .b2b__tier.is-reached .b2b__tier-btn {
    border-color: color-mix(in srgb, var(--b2b-accent) 70%, #000 10%);
    background: color-mix(in srgb, var(--b2b-accent) 18%, #fff);
  }

  .b2b__tier.is-current .b2b__tier-btn {
    border-color: #161616;
    background: var(--b2b-accent);
    color: #111;
  }

  .b2b__tier.is-current .b2b__tier-name {
    opacity: 0.8;
  }

  .b2b__progress {
    height: 6px;
    margin-top: 0.75rem;
    border-radius: 999px;
    background: var(--b2b-soft);
    overflow: hidden;
  }

  .b2b__progress-fill {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, color-mix(in srgb, var(--b2b-accent) 70%, #fff), var(--b2b-accent));
    transition: width 0.5s var(--b2b-ease);
  }

  .b2b__nudge {
    min-height: 1.25rem;
    margin: 0.5rem 0 0;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .b2b__nudge.is-top {
    color: #2e7d4f;
  }

  /* Summary */
  .b2b__summary {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1.1rem;
    border-radius: 16px;
    background: #161616;
    color: #fff;
  }

  .b2b__summary .b2b__label {
    opacity: 0.6;
  }

  .b2b__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.7rem;
  }

  .b2b__unit {
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3.6vw, 2.4rem);
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .b2b__retail {
    opacity: 0.55;
  }

  .b2b__retail:empty {
    display: none;
  }

  .b2b__badge {
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--b2b-accent);
    color: #111;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .b2b__badge[hidden] {
    display: none;
  }

  .b2b__totals {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .b2b__totals > div {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .b2b__totals dt {
    font-size: 0.72rem;
    opacity: 0.6;
  }

  .b2b__totals dd {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .b2b__save dd {
    color: var(--b2b-accent);
  }

  .b2b__margin[hidden] {
    display: none;
  }

  .b2b__margin-note {
    margin: -0.25rem 0 0;
    font-size: 0.75rem;
    opacity: 0.65;
  }

  .b2b__margin-note:empty {
    display: none;
  }

  .b2b__ctas {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .b2b__ctas:has(> :nth-child(2)) {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  }

  .b2b__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 3.25rem;
  }

  .b2b__cta[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }

  .b2b__cta.is-success {
    --button-background-color: #2e9e5b;
    --button-border-color: #2e9e5b;
  }

  .b2b__error,
  .b2b__form-error {
    margin: 0.75rem 0 0;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    background: #fdecea;
    color: #a32019;
    font-size: 0.85rem;
  }

  .b2b__error[hidden] {
    display: none;
  }

  .b2b__empty {
    padding: 2rem 1rem;
    border-radius: 14px;
    background: var(--b2b-soft);
    text-align: center;
    opacity: 0.7;
  }

  /* Quote form */
  .b2b__quote-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0.7rem 0.9rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--b2b-accent) 22%, #fff);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .b2b__quote-summary[hidden] {
    display: none;
  }

  .b2b__form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .b2b__field--full {
    grid-column: 1 / -1;
  }

  .b2b__submit {
    margin-top: 1rem;
  }

  .b2b__form-note {
    margin: 0.6rem 0 0;
    font-size: 0.75rem;
    text-align: center;
    opacity: 0.6;
  }

  .b2b__success {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 2.5rem 1rem;
    text-align: center;
  }

  .b2b__success p {
    max-width: 22rem;
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }

  .b2b__success[hidden],
  .b2b__form-body[hidden] {
    display: none;
  }

  .b2b__success {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    outline: none;
    animation: b2b-pop 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .b2b__again {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.9rem;
    margin-top: 0.25rem;
  }

  /* Thin bar that empties while the message is on screen; it freezes while the visitor hovers / focuses */
  .b2b__success-timer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgb(0 0 0 / 0.06);
  }

  .b2b__success-timer span {
    display: block;
    width: 100%;
    height: 100%;
    background: #2e9e5b;
    transform-origin: left center;
  }

  .b2b__form-body.is-back {
    animation: b2b-pop 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes b2b-pop {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }

  .b2b__success-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: #2e9e5b;
    color: #fff;
  }

  /* ---------------------------------------------------------------- layout */
  @media screen and (min-width: 990px) {
    .b2b__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }

    .b2b__card {
      position: sticky;
      top: calc(var(--header-height, 72px) + 1.5rem);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .b2b__benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .b2b__benefits {
      grid-template-columns: minmax(0, 1fr);
    }

    .b2b__tab {
      gap: 0.35rem;
      padding: 0 0.6rem;
      font-size: 0.8125rem;
      white-space: nowrap;
    }

    .b2b__tab svg {
      display: none;
    }

    .b2b__row:has(.b2b__field--variant:not([hidden])) {
      grid-template-columns: minmax(0, 1fr);
    }

    .b2b__tiers {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .b2b__tier-btn {
      padding: 0.6rem 0.5rem;
    }

    .b2b__tier-off {
      font-size: 1rem;
    }

    .b2b__totals {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .b2b__totals > .b2b__margin {
      grid-column: 1 / -1;
    }

    .b2b__ctas:has(> :nth-child(2)) {
      grid-template-columns: minmax(0, 1fr);
    }

    .b2b__form-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .b2b__account-link {
      margin-inline-start: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .b2b__product,
    .b2b__tier-btn,
    .b2b__progress-fill {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
