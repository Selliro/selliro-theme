{%- comment -%}
  Whispo — password page (store not yet open). Logo or shop name, the password message, a newsletter sign-up
  for the launch, and the store-owner password form in a dialog ("Enter using password"), which opens by itself
  when the password was wrong. Styles: assets/template-content.css ("Password").
{%- endcomment -%}

{%- comment -%} 1. CSS {%- endcomment -%}
{{ 'template-content.css' | asset_url | stylesheet_tag }}

{%- comment -%} 2. Liquid {%- endcomment -%}
<div class="password-page color-{{ section.settings.color_scheme }}">
  <header class="password-page__header page-width">
    <span class="password-page__logo">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: 480 | image_tag: widths: '160, 240, 320, 480', sizes: '160px', alt: shop.name, class: 'password-page__logo-image' }}
      {%- else -%}
        <span class="h3">{{ shop.name | escape }}</span>
      {%- endif -%}
    </span>
    <button type="button" class="link password-page__enter" aria-controls="PasswordDialog" aria-expanded="false" data-dialog-open>
      {%- render 'icon', name: 'lock' -%}
      {{ 'password.enter_using_password' | t }}
    </button>
  </header>

  <div class="password-page__main page-width">
    <h1 class="password-page__title display">{{ section.settings.heading | default: shop.name | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="password-page__message">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'PasswordNewsletter', class: 'newsletter-form password-page__newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prospect">
      {%- if form.posted_successfully? -%}
        <p class="newsletter-form__message newsletter-form__message--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter-form__field">
          <label class="visually-hidden" for="PasswordNewsletter-email">{{ 'newsletter.label' | t }}</label>
          <input id="PasswordNewsletter-email" class="newsletter-form__input" type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required>
          <button type="submit" class="button newsletter-form__button">{{ 'password.notify_me' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="newsletter-form__message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
    {%- render 'social-icons', class: 'password-page__social' -%}
  </div>

  <footer class="password-page__footer page-width">
    <p>{{ 'password.powered_by_html' | t: shopify: powered_by_link }}</p>
  </footer>

  {%- capture password_form -%}
    {%- form 'storefront_password', class: 'password-form' -%}
      {%- if form.errors -%}
        <p class="form-message--error" role="alert" id="PasswordError">{{ 'password.wrong' | t }}</p>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="PasswordInput">{{ 'password.password' | t }}</label>
        <input
          class="field__input"
          type="password"
          name="password"
          id="PasswordInput"
          autocomplete="current-password"
          required
          autofocus
          {% if form.errors %}
            aria-invalid="true" aria-describedby="PasswordError"
          {% endif %}
        >
      </div>
      <button type="submit" class="button button--full-width">{{ 'password.enter' | t }}</button>
      <p class="password-form__admin">{{ 'password.admin_html' | t: link: '/admin' }}</p>
    {%- endform -%}
  {%- endcapture -%}

  <dialog id="PasswordDialog" class="dialog password-dialog" aria-labelledby="PasswordDialogHeading"{% if password_form contains 'PasswordError' %} data-open-on-load{% endif %}>
    <div class="dialog__panel password-dialog__panel">
      <button type="button" class="icon-button password-dialog__close" data-dialog-close>
        {%- render 'icon', name: 'close' -%}
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
      </button>
      <h2 id="PasswordDialogHeading" class="h4">{{ 'password.enter_using_password' | t }}</h2>
      {{ password_form }}
    </div>
  </dialog>
  <script type="module">
    import { openDialog } from '@whispo/dialog';
    const dialog = document.getElementById('PasswordDialog');
    if (dialog?.hasAttribute('data-open-on-load')) openDialog(dialog);
  </script>
</div>

{%- comment -%} 3. Schema {%- endcomment -%}
{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.main_password.heading", "default": "Opening soon" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.main_collection.color_scheme", "default": "scheme-3" }
  ]
}
{% endschema %}
