{% comment %}
  New Arrivals Showcase — standalone section: title, tabs, promo column + Swiper products.
  Add via theme editor; upload promo image to match your design.
{% endcomment %}

{{ 'section-new-arrivals-showcase.css' | asset_url | stylesheet_tag }}
{{ 'new-arrivals-quick-view.css' | asset_url | stylesheet_tag }}

{% style %}
  #new-arrivals-{{ section.id }} {
    padding-top: {{ section.settings.pad_top }}px;
    padding-bottom: {{ section.settings.pad_bottom }}px;
    --new-arrivals-tab-active-bg: {{ section.settings.tab_on_bg }};
    --new-arrivals-tab-active-fg: {{ section.settings.tab_on_text }};
    --new-arrivals-tab-idle-bg: {{ section.settings.tab_off_bg }};
    --new-arrivals-tab-idle-fg: {{ section.settings.tab_off_text }};
    --new-arrivals-cta: {{ section.settings.cta_yellow }};
    --new-arrivals-promo-width: {{ section.settings.promo_width_pct }}%;
  }
{% endstyle %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} new-arrivals-showcase color-{{ section.settings.color_scheme }}"
  id="new-arrivals-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div
    class="new-arrivals-showcase__inner{% if section.settings.product_layout == 'grid' %} new-arrivals-showcase__inner--layout-grid{% endif %}"
    data-new-arrivals-root
    data-new-arrivals-qv-id="new-arrivals-qv-drawer-{{ section.id }}"
    data-new-arrivals-layout="{{ section.settings.product_layout | default: 'slider' }}"
    data-new-arrivals-spv-mobile="{{ section.settings.spv_mobile }}"
    data-new-arrivals-spv-desktop="{{ section.settings.spv_desktop }}"
    data-new-arrivals-gap-mobile="{{ section.settings.gap_mobile }}"
    data-new-arrivals-gap-desktop="{{ section.settings.gap_desktop }}"
  >
    {%- liquid
      assign nac_tab_count = 0
      for b in section.blocks
        if b.type == 'collection_tab' or b.type == 'layout_placeholder'
          assign nac_tab_count = nac_tab_count | plus: 1
        endif
      endfor
      assign nac_scribble = section.settings.heading_scribble | default: 'none'
      if nac_scribble != 'squiggle' and nac_scribble != 'wave' and nac_scribble != 'brush' and nac_scribble != 'double'
        assign nac_scribble = 'none'
      endif
    -%}
    <div class="new-arrivals-showcase__intro-row">
      <div class="new-arrivals-showcase__intro">
        {%- if section.settings.heading != blank -%}
          {%- if nac_scribble != 'none' -%}
            <h2
              class="new-arrivals-showcase__heading new-arrivals-showcase__heading--scribble"
              style="--new-arrivals-scribble-color: {{ section.settings.heading_scribble_color }};"
            >
              <span class="new-arrivals-showcase__heading-inner">
                <span class="new-arrivals-showcase__heading-text">{{ section.settings.heading | escape }}</span>
                <span class="new-arrivals-showcase__heading-decoration">
                  {%- render 'new-arrivals-heading-scribble', style: nac_scribble -%}
                </span>
              </span>
            </h2>
          {%- else -%}
            <h2 class="new-arrivals-showcase__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="new-arrivals-showcase__lede">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if nac_tab_count > 0 -%}
        <div class="new-arrivals-showcase__tablist" role="tablist" aria-label="{{ section.settings.tabs_a11y | escape }}">
          {%- assign nac_tab_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection_tab' or block.type == 'layout_placeholder' -%}
              <button
                type="button"
                class="new-arrivals-showcase__tab{% if nac_tab_i == 0 %} is-active{% endif %}"
                id="new-arrivals-tab-{{ section.id }}-{{ block.id }}"
                role="tab"
                aria-selected="{% if nac_tab_i == 0 %}true{% else %}false{% endif %}"
                aria-controls="new-arrivals-panel-{{ section.id }}-{{ block.id }}"
                {% if nac_tab_i != 0 %}tabindex="-1"{% endif %}
                data-new-arrivals-tab
              >
                {{ block.settings.label | default: 'Tab' | escape }}
              </button>
              {%- assign nac_tab_i = nac_tab_i | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if nac_tab_count == 0 -%}
      <p class="new-arrivals-showcase__empty">{{ 'sections.new_arrivals_showcase.no_tabs' | t }}</p>
    {%- else -%}
      {%- assign nac_tab_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection_tab' or block.type == 'layout_placeholder' -%}
          {%- render 'new-arrivals-tab-panel', block: block, section: section, tab_index: nac_tab_i -%}
          {%- assign nac_tab_i = nac_tab_i | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% render 'new-arrivals-quick-view-drawer', section: section %}

<script src="{{ 'image-loader.js' | asset_url }}" defer></script>
<script src="{{ 'new-arrivals-components.js' | asset_url }}" defer></script>
<script src="{{ 'new-arrivals-showcase.js' | asset_url }}" defer></script>
<script src="{{ 'new-arrivals-quick-view.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.new_arrivals_showcase",
  "tag": "section",
  "class": "section-new-arrivals-showcase",
  "settings": [
    {
      "type": "header",
      "content": "t:settings.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:settings.page_width" },
        { "value": "full-width", "label": "t:settings.full_width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "product_layout",
      "label": "t:sections.new-arrivals-showcase.settings.product_layout",
      "options": [
        {
          "value": "slider",
          "label": "t:sections.new-arrivals-showcase.options.layout.slider"
        },
        {
          "value": "grid",
          "label": "t:sections.new-arrivals-showcase.options.layout.grid"
        }
      ],
      "default": "slider"
    },
    {
      "type": "header",
      "content": "t:settings.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.title",
      "default": "New Arrivals"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:settings.subtitle",
      "default": "All our new arrivals in a exclusive brand selection"
    },
    {
      "type": "select",
      "id": "heading_scribble",
      "label": "t:sections.new-arrivals-showcase.settings.heading_scribble",
      "options": [
        { "value": "none", "label": "t:sections.new-arrivals-showcase.options.scribble.none" },
        { "value": "squiggle", "label": "t:sections.new-arrivals-showcase.options.scribble.squiggle" },
        { "value": "wave", "label": "t:sections.new-arrivals-showcase.options.scribble.wave" },
        { "value": "brush", "label": "t:sections.new-arrivals-showcase.options.scribble.brush" },
        { "value": "double", "label": "t:sections.new-arrivals-showcase.options.scribble.double" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "heading_scribble_color",
      "label": "t:sections.new-arrivals-showcase.settings.scribble_color",
      "default": "#0a0a0a"
    },
    {
      "type": "text",
      "id": "tabs_a11y",
      "label": "t:sections.new-arrivals-showcase.settings.tabs_a11y",
      "default": "Collection tabs"
    },
    {
      "type": "color",
      "id": "tab_on_bg",
      "label": "t:sections.new-arrivals-showcase.settings.active_tab_background",
      "default": "#2563eb"
    },
    {
      "type": "color",
      "id": "tab_on_text",
      "label": "t:sections.new-arrivals-showcase.settings.active_tab_text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tab_off_bg",
      "label": "t:sections.new-arrivals-showcase.settings.inactive_tab_background",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "tab_off_text",
      "label": "t:sections.new-arrivals-showcase.settings.inactive_tab_text",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "t:sections.new-arrivals-showcase.settings.promotion_header"
    },
    {
      "type": "checkbox",
      "id": "show_promotion",
      "label": "t:sections.new-arrivals-showcase.settings.show_promotion_column",
      "default": true
    },
    {
      "type": "range",
      "id": "promo_width_pct",
      "min": 18,
      "max": 34,
      "step": 1,
      "unit": "%",
      "label": "t:sections.new-arrivals-showcase.settings.promo_column_width",
      "default": 26
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "t:sections.new-arrivals-showcase.settings.promo_image"
    },
    {
      "type": "text",
      "id": "promo_badge",
      "label": "t:sections.new-arrivals-showcase.settings.promo_badge",
      "default": "PROMOTION"
    },
    {
      "type": "text",
      "id": "promo_btn_text",
      "label": "t:sections.new-arrivals-showcase.settings.promo_button",
      "default": "Shop sale"
    },
    {
      "type": "url",
      "id": "promo_url",
      "label": "t:sections.new-arrivals-showcase.settings.promo_link"
    },
    {
      "type": "header",
      "content": "t:settings.products"
    },
    {
      "type": "range",
      "id": "product_count",
      "min": 4,
      "max": 24,
      "step": 1,
      "label": "t:sections.new-arrivals-showcase.settings.products_per_tab",
      "default": 12
    },
    {
      "type": "range",
      "id": "new_window_days",
      "min": 7,
      "max": 107,
      "step": 1,
      "label": "t:sections.new-arrivals-showcase.settings.new_badge_days",
      "default": 45
    },
    {
      "type": "text",
      "id": "new_label",
      "label": "t:sections.new-arrivals-showcase.settings.new_badge_text",
      "default": "New"
    },
    {
      "type": "text",
      "id": "image_hover_cta",
      "label": "t:sections.new-arrivals-showcase.settings.hover_image_button",
      "default": "ADD TO CART"
    },
    {
      "type": "range",
      "id": "fallback_stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "t:sections.new-arrivals-showcase.settings.fallback_star_count",
      "default": 5
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "t:sections.new-arrivals-showcase.settings.star_color",
      "default": "#e6b800"
    },
    {
      "type": "color",
      "id": "cta_yellow",
      "label": "t:sections.new-arrivals-showcase.settings.yellow_cta",
      "default": "#f5c518"
    },
    {
      "type": "text",
      "id": "demo_type",
      "label": "t:sections.new-arrivals-showcase.settings.demo_category",
      "default": "FACE SERUMS"
    },
    {
      "type": "text",
      "id": "demo_title",
      "label": "t:sections.new-arrivals-showcase.settings.demo_product_title",
      "default": "Mens daily serum"
    },
    {
      "type": "header",
      "content": "t:sections.new-arrivals-showcase.settings.carousel_header"
    },
    {
      "type": "range",
      "id": "spv_mobile",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "label": "t:sections.new-arrivals-showcase.settings.slides_visible_mobile",
      "default": 1.1
    },
    {
      "type": "range",
      "id": "spv_desktop",
      "min": 2,
      "max": 5,
      "step": 0.1,
      "label": "t:sections.new-arrivals-showcase.settings.slides_visible_desktop",
      "default": 3.2
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 4,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "t:sections.new-arrivals-showcase.settings.gap_mobile",
      "default": 8
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 6,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "t:sections.new-arrivals-showcase.settings.gap_desktop",
      "default": 10
    },
    {
      "type": "header",
      "content": "t:names.spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "layout_placeholder",
      "name": "t:sections.new-arrivals-showcase.blocks.layout_placeholder.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.new-arrivals-showcase.blocks.layout_placeholder.settings.tab_label",
          "default": "Sample layout"
        },
        {
          "type": "paragraph",
          "content": "t:sections.new-arrivals-showcase.blocks.layout_placeholder.paragraph"
        }
      ]
    },
    {
      "type": "collection_tab",
      "name": "t:sections.new-arrivals-showcase.blocks.collection_tab.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.new-arrivals-showcase.blocks.collection_tab.settings.tab_label",
          "default": "Collection"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "t:names.new_arrivals_showcase",
      "settings": {
        "heading": "New Arrivals",
        "subheading": "All our new arrivals in a exclusive brand selection"
      },
      "blocks": {
        "nac_layout_preview": {
          "type": "layout_placeholder",
          "settings": {
            "label": "Sample layout"
          }
        },
        "nac_tab_new_arrivals": {
          "type": "collection_tab",
          "settings": {
            "label": "New Arrivals"
          }
        },
        "nac_tab_best_sellers": {
          "type": "collection_tab",
          "settings": {
            "label": "Best Sellers"
          }
        }
      },
      "block_order": [
        "nac_layout_preview",
        "nac_tab_new_arrivals",
        "nac_tab_best_sellers"
      ]
    }
  ]
}
{% endschema %}
