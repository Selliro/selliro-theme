{{ 'search-plus.css' | asset_url | stylesheet_tag }}
{{ 'search-page-plus.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'search-plus.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign safe_terms = search.terms | escape
  assign encoded_terms = search.terms | url_encode
  assign base_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last'

  assign active_type = 'all'
  if search.types.size == 1
    assign active_type = search.types.first
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="search-hero search-page-plus color-{{ section.settings.color_scheme }}{% if search.performed %} search-hero--performed{% endif %}">
  <div class="page-width">
    <div
      class="spacing-style search-page__header search-hero__inner"
      style="
        --horizontal-alignment: {{ section.settings.alignment }};
        {% render 'spacing-style', settings: section.settings %}
      "
    >
      <p class="search-hero__eyebrow">{{ 'content.search' | t }}</p>

      {% capture heading_text %}
        {%- if search.performed -%}
          <h1 class="search-hero__title">{{ 'search_plus.heading_results_html' | t: terms: safe_terms }}</h1>
        {%- else -%}
          <h1 class="search-hero__title">{{ 'search_plus.heading_empty' | t }}</h1>
        {%- endif -%}
      {% endcapture %}

      {% content_for 'block', id: 'heading', type: '_heading', text: heading_text %}

      <p class="search-hero__sub">
        {%- if search.performed -%}
          {{ 'search_plus.results_count' | t: count: search.results_count }}
        {%- else -%}
          {{ 'search_plus.subheading_empty' | t }}
        {%- endif -%}
      </p>

      <div class="search-hero__input">
        {% content_for 'block', id: 'search', type: '_search-input' %}
      </div>

      {%- if section.settings.show_popular and settings.search_popular_terms != blank -%}
        <div class="search-hero__chips">
          <span class="search-hero__chips-label">{{ 'search_plus.popular' | t }}</span>
          {% render 'search-plus-chips', page: true %}
        </div>
      {%- endif -%}
    </div>

    {%- if search.performed and section.settings.show_tabs and search.results_count > 0 or search.performed and section.settings.show_tabs and search.types.size == 1 -%}
      <nav
        class="search-tabs"
        aria-label="{{ 'content.search_results_label' | t }}"
      >
        {%- liquid
          assign tabs = 'all,product,article,page' | split: ','
        -%}
        {%- for tab in tabs -%}
          {%- liquid
            case tab
              when 'all'
                assign label = 'search_plus.tab_all' | t
                assign url = base_url
              when 'product'
                assign label = 'search_plus.tab_products' | t
                assign url = base_url | append: '&type=product'
              when 'article'
                assign label = 'search_plus.tab_articles' | t
                assign url = base_url | append: '&type=article'
              when 'page'
                assign label = 'search_plus.tab_pages' | t
                assign url = base_url | append: '&type=page'
            endcase
          -%}
          <a
            class="search-tabs__tab{% if tab == active_type %} is-active{% endif %}"
            href="{{ url }}"
            {% if tab == active_type %}
              aria-current="page"
            {% endif %}
          >
            {{- label -}}
            {%- if tab == active_type -%}
              <span class="search-tabs__count">{{ search.results_count }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:names.search",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "checkbox",
      "id": "show_popular",
      "label": "Show popular searches",
      "info": "Set the searches in Theme settings › Search.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show result type tabs",
      "info": "All, Products, Blog posts and Pages.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
