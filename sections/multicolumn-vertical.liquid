{%- comment -%}
  Multicolumn Vertical Section
  
  Displays a grid of cards with icons/images, text content, and optional buttons.
  Supports 2, 3, or 4 columns with responsive behavior.
  Mobile: Swiper carousel with progress bar and peek effect.
{%- endcomment -%}

{%- liquid
  assign section_heading = section.settings.heading
  assign section_caption = section.settings.caption
  assign section_description = section.settings.description
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign layout_type = section.settings.layout_type | default: 'grid'
  assign grid_cols_class = 'md:tw-grid-cols-4'
  assign use_carousel = false
  if columns_desktop == 2
    assign grid_cols_class = 'md:tw-grid-cols-2'
  elsif columns_desktop == 3
    assign grid_cols_class = 'md:tw-grid-cols-3'
  endif
  
  if layout_type == 'carousel'
    assign use_carousel = true
  endif
-%}

<style>
  #{{ section.id }} {
    padding-top: {{ section.settings.add_top_padding_mobile }}px;
    padding-bottom: {{ section.settings.add_bottom_padding_mobile }}px;
  }
  @media(min-width: 1024px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.add_top_padding_desktop }}px;
      padding-bottom: {{ section.settings.add_bottom_padding_desktop }}px;
    }
  }
</style>
<div id="{{ section.id }}" class="multicolumn-vertical tw-w-full">
  <div class="multicolumn-vertical__container swiper-wide">
    
    {%- comment -%} Title Container (using reusable banner components) {%- endcomment -%}
    {%- if section_caption != blank or section_heading != blank or section_description != blank -%}
      <div class="multicolumn-vertical__header section-container tw-flex tw-flex-col tw-gap-5 tw-mb-12 md:tw-mb-20 tw-max-w-[550px]">
        {%- if section_caption != blank -%}
          {%- render 'caption',
            text: section_caption,
            variant: 'banner',
            color: '#323e46',
            block_shopify_attributes: ''
          -%}
        {%- endif -%}
        
        {%- if section_heading != blank -%}
          {%- render 'heading',
            text: section_heading,
            variant: 'h2',
            color: '#000000',
            block_shopify_attributes: ''
          -%}
        {%- endif -%}
        
        {%- if section_description != blank -%}
          <div class="banner-subheading tw-text-base tw-font-medium tw-leading-5 tw-tracking-[-0.16px]" style="color: #323e46;">
            {{ section_description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    {%- comment -%} Cards Grid / Carousel {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      
      {%- comment -%} Carousel (Mobile always, Desktop if carousel selected) {%- endcomment -%}
      <div class="multicolumn-vertical__carousel {% unless use_carousel %}md:tw-hidden{% endunless %}">
        {%- assign slider_items = '' -%}
        {%- for block in section.blocks -%}
          {%- capture slider_item -%}
            {%- if block.type == '@app' -%}
              {%- render block -%}
            {%- else -%}
              {%- render block, section: section -%}
            {%- endif -%}
          {%- endcapture -%}
          {%- assign slider_items = slider_items | append: slider_item | append: '::slider-limiter' -%}
        {%- endfor -%}
        
        {%- render 'carousel-wrapper',
          section_id: section.id,
          desktop_slides_per_view: columns_desktop,
          mobile_slides_per_view: "1.5",
          mobile_space_between: 20,
          desktop_space_between: 20,
          show_progress: true,
          progress_color: 'tw-bg-slate-400',
          carousel_class: 'carousel--multicolumn',
          slider_items: slider_items
        -%}
      </div>
      
      {%- comment -%} Desktop Grid (Only if grid selected) {%- endcomment -%}
      {%- unless use_carousel -%}
        <div class="multicolumn-vertical__grid section-container tw-hidden md:tw-grid {{ grid_cols_class }} tw-gap-5">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {%- render block %}
          {%- else -%}
            {%- render block, section: section %}
          {%- endif -%}
        {%- endfor -%}
        </div>
      {%- endunless -%}
    {%- endif -%}
    
  </div>
</div>

{% schema %}
{
  "name": "Multicolumn Vertical",
  "tag": "section",
  "class": "section multicolumn-vertical",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Caption"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed dictum augue a felis accumsan fermentum. Vivamus sit amet lorem eu lectus bibendum bibendum."
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Desktop layout",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "info": "Mobile always uses carousel"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Number of columns",
      "info": "controls both column and slides per view"
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "text",
      "id": "add_top_padding_mobile",
      "label": "Add top padding mobile",
      "default": "44"
    },
    {
      "type": "text",
      "id": "add_bottom_padding_mobile",
      "label": "Add bottom padding mobile",
      "default": "44"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "text",
      "id": "add_top_padding_desktop",
      "label": "Add top padding Desktop",
      "default": "96"
    },
    {
      "type": "text",
      "id": "add_bottom_padding_desktop",
      "label": "Add bottom padding Desktop",
      "default": "96"
    }
  ],
  "blocks": [
    { "type": "column-card"},
    { "type": "parent-multicolumn-vertical-v2"},
    { "type": "parent-multicolumn-vertical-v3"},
  ],
  "presets": [
    {
      "name": "Multicolumn Vertical",
      "blocks": [
      
      ]
    }
  ]
}
{% endschema %}
