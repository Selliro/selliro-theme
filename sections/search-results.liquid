<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
{{ 'search-plus.css' | asset_url | stylesheet_tag }}
{{ 'search-page-plus.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign use_na_cards = false
  if section.settings.product_card_style == 'new_arrivals'
    assign use_na_cards = true
  endif
  assign safe_terms = search.terms | escape
-%}

{%- if use_na_cards -%}
  {{ 'section-new-arrivals-showcase.css' | asset_url | stylesheet_tag }}
  {{ 'new-arrivals-quick-view.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'image-loader.js' | asset_url }}" defer></script>
  <script src="{{ 'new-arrivals-components.js' | asset_url }}" defer></script>
  <script src="{{ 'new-arrivals-showcase.js' | asset_url }}" defer></script>
  <script src="{{ 'new-arrivals-quick-view.js' | asset_url }}" defer></script>
{%- endif -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<results-list
  class="section product-grid-container spacing-style search-page-plus color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
  {%- if use_na_cards %}
    data-new-arrivals-root
    data-new-arrivals-qv-id="new-arrivals-qv-drawer-{{ section.id }}"
  {%- endif %}
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style"
  >
    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate search.results by products_per_page %}
      {%- liquid
        assign title = blank
        assign others = blank
        if search.results_count > 0
          assign products = search.results | where: 'object_type', 'product'
          assign articles = search.results | where: 'object_type', 'article'
          assign pages = search.results | where: 'object_type', 'page'
          assign others = articles | concat: pages
        else
          assign collection = settings.empty_state_collection | default: collections.all
          if search.performed
            assign title = 'search_plus.you_might_like' | t
          else
            assign title = 'search_plus.trending' | t
          endif
          assign products = collection.products
        endif
      -%}

      {%- if search.performed and search.results_count == 0 -%}
        <div class="search-none">
          <span
            class="search-none__icon"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 48 48"
              width="44"
              height="44"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            >
              <circle cx="21" cy="21" r="12"/><path d="m30 30 9 9M16.5 21h9"/>
            </svg>
          </span>
          <h2 class="search-none__title">{{ 'search_plus.no_results_page_title_html' | t: terms: safe_terms }}</h2>
          <p class="search-none__text">{{ 'search_plus.no_results_page_text' | t }}</p>
          {% render 'search-plus-chips', page: true, class: 'search-none__chips' %}
        </div>
      {%- endif -%}

      {%- if search.results_count > 0 and products.size > 0 -%}
        {% content_for 'block', type: 'filters', id: 'filters', results: search, results_size: search.results_count %}
      {%- endif -%}

      {% capture children %}
        {% for product in products %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            {%- if use_na_cards -%}
              {%- render 'new-arrivals-card',
                product: product,
                accent: section.settings.na_card_cta_color,
                star_color: section.settings.na_card_star_color,
                new_days: section.settings.na_card_new_days,
                new_label: section.settings.na_card_new_label,
                add_label: section.settings.na_card_add_label,
                fallback_stars: section.settings.na_card_fallback_stars,
                image_sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw'
              -%}
            {%- else -%}
              {% # theme-check-disable %}
              {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
              {% # theme-check-enable %}
            {%- endif -%}
          </li>
        {% endfor %}
      {% endcapture %}

      {%- if products.size > 0 -%}
        {% render 'product-grid',
          section: section,
          children: children,
          products: products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll,
          title: title
        %}
      {%- endif -%}

      {%- if others.size > 0 -%}
        <div class="search-more">
          <h2 class="search-more__title">{{ 'search_plus.articles_pages' | t }}</h2>
          <ul
            class="search-more__grid list-unstyled"
            role="list"
          >
            {%- for item in others -%}
              {%- liquid
                assign is_article = false
                if item.object_type == 'article'
                  assign is_article = true
                endif
              -%}
              <li
                class="search-more__item"
                style="--i: {{ forloop.index0 }};"
              >
                <a
                  class="search-more__card"
                  href="{{ item.url }}"
                >
                  <span class="search-more__media{% if is_article == false or item.image == blank %} search-more__media--icon{% endif %}">
                    {%- if is_article and item.image -%}
                      {{ item.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw', alt: item.title | escape }}
                    {%- else -%}
                      <svg
                        viewBox="0 0 24 24"
                        width="30"
                        height="30"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M6 3h8.5L19 7.5V21H6z"/><path d="M14 3v5h5M9 12h7M9 15.5h7"/>
                      </svg>
                    {%- endif -%}
                    <span class="search-more__badge">
                      {%- if is_article -%}
                        {{ 'search_plus.article' | t }}
                      {%- else -%}
                        {{ 'search_plus.page' | t }}
                      {%- endif -%}
                    </span>
                  </span>
                  <span class="search-more__body">
                    {%- if is_article -%}
                      <span class="search-more__meta">
                        {%- if item.blog.title != blank -%}{{ item.blog.title | escape }} · {% endif -%}
                        {{- item.published_at | date: format: 'abbreviated_date' -}}
                      </span>
                    {%- endif -%}
                    <span
                      class="search-more__name"
                      data-search-highlight
                    >
                      {{- item.title | escape -}}
                    </span>
                    {%- assign excerpt = item.excerpt_or_content | default: item.content | strip_html | truncatewords: 22 -%}
                    {%- if excerpt != blank -%}
                      <span class="search-more__excerpt">{{ excerpt }}</span>
                    {%- endif -%}
                    <span class="search-more__cta">
                      {{- 'search_plus.read_more' | t -}}
                      <span aria-hidden="true">→</span>
                    </span>
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
          {%- if products.size == 0 and paginate.pages > 1 -%}
            {% render 'pagination-controls', paginate: paginate %}
          {%- endif -%}
        </div>
      {%- endif -%}
    {% endpaginate %}
  </div>
</results-list>

{%- if use_na_cards -%}
  {% render 'new-arrivals-quick-view-drawer', section: section %}
{%- endif -%}

{% schema %}
{
  "name": "t:names.search_results",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.edit_empty_state_collection_in_theme_settings"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "product_card_style",
      "label": "Card style",
      "options": [
        {
          "value": "new_arrivals",
          "label": "New Arrivals style"
        },
        {
          "value": "theme",
          "label": "Theme default (product card block)"
        }
      ],
      "default": "new_arrivals",
      "info": "New Arrivals style matches the collection page and homepage cards: quick view, quick add and star rating."
    },
    {
      "type": "text",
      "id": "na_card_add_label",
      "label": "Quick add button label",
      "default": "ADD TO CART",
      "visible_if": "{{ section.settings.product_card_style == 'new_arrivals' }}"
    },
    {
      "type": "color",
      "id": "na_card_cta_color",
      "label": "Quick add button color",
      "default": "#f5c518",
      "visible_if": "{{ section.settings.product_card_style == 'new_arrivals' }}"
    },
    {
      "type": "text",
      "id": "na_card_new_label",
      "label": "New badge text",
      "default": "New",
      "visible_if": "{{ section.settings.product_card_style == 'new_arrivals' }}"
    },
    {
      "type": "range",
      "id": "na_card_new_days",
      "label": "Show New badge for products added in the last",
      "min": 7,
      "max": 107,
      "step": 1,
      "unit": "d",
      "default": 45,
      "visible_if": "{{ section.settings.product_card_style == 'new_arrivals' }}"
    },
    {
      "type": "color",
      "id": "na_card_star_color",
      "label": "Star color",
      "default": "#e6b800",
      "visible_if": "{{ section.settings.product_card_style == 'new_arrivals' }}"
    },
    {
      "type": "range",
      "id": "na_card_fallback_stars",
      "label": "Stars when product has no reviews",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.product_card_style == 'new_arrivals' }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
