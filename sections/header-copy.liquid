{%- comment -%}
  Header Section with Megamenu support

  - Allows setting:
    - Logo image
    - Desktop navigation (linklist)
    - Mobile navigation (linklist)
  - Desktop / mobile menus are rendered via separate snippets:
    - `header-desktop-menu`
    - `header-mobile-drawer`
  - Megamenu integration:
    - If a menu item's URL contains `#megamenu-{{id}}`, that item is considered
      a megamenu trigger (JS will be added later to handle hover/click).
    - Non-megamenu items with child links render a nested menu UI directly.

  NOTE: This file only defines the shell/layout and delegates menu UI to snippets.
{%- endcomment -%}

{%- liquid
  assign desktop_menu = section.settings.desktop_menu
  assign mobile_menu = section.settings.mobile_menu
  assign logo_image = section.settings.logo_image
  assign header_background = section.settings.header_background | default: '#ffffff'
  assign show_bill_pay = section.settings.show_bill_pay | default: true
  assign bill_pay_label = section.settings.bill_pay_label | default: 'Bill Pay'
  assign bill_pay_link = section.settings.bill_pay_link
-%}

<header
  id="{{ section.id }}"
  class="site-header tw-w-full tw-border-b tw-border-[#e3e8ee]"
  style="background-color: {{ header_background }};"
>
  <div class="section-container tw-flex tw-items-center tw-justify-between tw-gap-4 tw-py-3  md:tw-py-4" data-header>
    {%- comment -%} Left: Mobile hamburger + Logo (matches mobile header layout) {%- endcomment -%}
    <div class="tw-flex tw-items-center tw-gap-3 lg:tw-gap-6">
      <div class="lg:tw-hidden">
        {%- render 'header-mobile-drawer', mobile_menu: mobile_menu, section: section -%}
      </div>

      <div class="site-header__logo tw-flex tw-items-center">
        {%- if logo_image != blank -%}
          <a href="{{ routes.root_url }}" class="tw-w-[145px]">
            {%- render 'shopify-responsive-image',
              image: logo_image,
              image_id: section.id | append: '-logo-desktop',
              image_aspect_ratio: 6.04,
              wrapper_class: 'tw-w-full tw-h-full tw-w-[145px]',
              image_class: 'tw-w-full tw-h-full tw-object-contain',
              contain: true
            -%}
          </a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="tw-text-lg tw-font-semibold tw-text-[#071b2f]">
            {{ shop.name }}
          </a>
        {%- endif -%}
      </div>
      <div>{%- render 'header-desktop-menu', desktop_menu: desktop_menu, blocks: section.blocks -%}</div>
    </div>

    {%- comment -%} Right: Desktop nav (hidden on mobile) + Bill Pay button {%- endcomment -%}
    <div class="tw-flex tw-items-center tw-gap-4">
      {%- comment -%} Search Popup {%- endcomment -%}
      <div class="tw-relative tw-hidden lg:tw-block">
        <button
          type="button"
          data-popover-toggle="header-search-popup"
          class="tw-justify-center tw-h-[100%] tw-rounded-full  tw-bg-white tw-text-[#092846] hover:tw-border-[#092846] tw-transition-colors tw-w-full tw-flex tw-gap-2 tw-items-center"
          aria-label="Open search"
        >
          <span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path d="M14.1057 14.2L17 17M16.0667 9.53333C16.0667 13.1416 13.1416 16.0667 9.53333 16.0667C5.92507 16.0667 3 13.1416 3 9.53333C3 5.92507 5.92507 3 9.53333 3C13.1416 3 16.0667 5.92507 16.0667 9.53333Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>

          <span class="tw-text-base tw-text-[#092846] hover:tw-opacity-80 tw-transition-opacity"> Search </span>
        </button>

        {%- comment -%} Search Popover Content {%- endcomment -%}
        <div
          id="header-search-popup"
          data-search-parent
          data-popover
          class="tw-hidden tw-absolute -tw-right-[180px] tw-top-[52px] tw-bg-white tw-shadow-lg tw-border tw-border-[#e3e8ee] tw-p-8 tw-z-[1060] lg:tw-w-[345px] tw-rounded-br-lg tw-rounded-bl-lg">
          <div class="tw-flex tw-items-center tw-gap-3" role="search">
            <label class="tw-flex-1 tw-relative">
              <span class="tw-sr-only">Search</span>
              <input
                data-search-input
                type="search"
                name="q"
                placeholder="Search"
                class="tw-w-full tw-h-[42px] tw-rounded-[12px] tw-border tw-border-[#62748e] tw-bg-white tw-px-3 tw-text-[16px] tw-leading-5 tw-tracking-[-0.16px] tw-text-[#092846] tw-placeholder-[#62748e] tw-outline-none focus:tw-border-[#092846]"
                autofocus
              >
            </label>
            <button
              class="tw-inline-flex tw-items-center tw-justify-center tw-h-[42px] tw-w-[60px] tw-rounded-full tw-border tw-border-[#092846] tw-bg-[#092846]  hover:tw-text-white tw-transition-colors"
              aria-label="Submit search"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
                style="color: #fff;"
              >
                <path d="M14.1057 14.2L17 17M16.0667 9.53333C16.0667 13.1416 13.1416 16.0667 9.53333 16.0667C5.92507 16.0667 3 13.1416 3 9.53333C3 5.92507 5.92507 3 9.53333 3C13.1416 3 16.0667 5.92507 16.0667 9.53333Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          {%- if section.blocks != blank -%}
            <div class="header-search__trending-searches" data-trending-searches>
              <h3 class="tw-text-sm tw-font-semibold tw-text-[#323e46] tw-py-4 tw-leading-none">Top searches</h3>
              <ul class="tw-flex tw-flex-col tw-gap-2">
                {%- for block in section.blocks -%}
                    <li class="tw-leading-none">
                      <a data-trending-search-item="{{ block.settings.title }}" href="#" class="tw-text-sm tw-text-[#323e46] hover:tw-text-[#00a3a3] tw-transition-colors tw-leading-none tw-font-medium">{{ block.settings.title }}</a>
                    </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          <div class="header-search__placeholder tw-flex-col tw-gap-2 tw-hidden tw-mt-6" data-search-placeholder>
            <div class="tw-animate-pulse tw-w-full tw-h-4 tw-bg-gray-200 tw-rounded-xl"></div>
            <div class="tw-animate-pulse tw-w-full tw-h-4 tw-bg-gray-200 tw-rounded-xl"></div>
            <div class="tw-animate-pulse tw-w-full tw-h-4 tw-bg-gray-200 tw-rounded-xl"></div>
          </div>
        
          <div class="header-search__results" data-search-results></div>
        </div>
      </div>

      {%- comment -%} Vertical Divider {%- endcomment -%}
      <div
      class="tw-hidden lg:tw-block tw-h-4 tw-w-[2px] tw-bg-[#E6E8E9] tw-shrink-0 tw-rounded-full"
      aria-hidden="true">
    </div>
    

      {%- comment -%} Login Popover {%- endcomment -%}
      <div class="tw-relative tw-hidden lg:tw-block">
        <button
          type="button"
          data-popover-toggle="header-login-popup"
          class="tw-text-base tw-text-[#092846] hover:tw-opacity-80 tw-transition-opacity"
          aria-label="Open login"
        >
          Login
        </button>

        {%- comment -%} Login Popover Content {%- endcomment -%}
        <div
          id="header-login-popup"
          data-popover
          class="tw-hidden tw-absolute -tw-right-[120px] tw-top-[52px] tw-bg-white tw-shadow-lg tw-border tw-border-[#e3e8ee] tw-p-8 tw-z-[1060] lg:tw-min-w-[345px] tw-rounded-br-lg tw-rounded-bl-lg"
        >
          <div class="tw-flex tw-flex-col tw-gap-4">
            {%- render 'button',
              label: 'Log in',
              link: routes.account_login_url,
              variant: 'primary',
              full_width: true,
              block_shopify_attributes: ''
            -%}
            <div class="tw-text-center tw-text-[14px] tw-leading-[18px] tw-text-[#092846]">
              <a
                href="{{ routes.account_register_url }}"
                class="tw-text-[#092846] hover:tw-text-[#00a3a3] tw-transition-colors"
                >Don't have an account?</a
              >
            </div>
            {%- render 'button',
              label: 'Create account',
              link: routes.account_register_url,
              variant: 'secondary',
              secondary_color: 'blue',
              full_width: true,
              block_shopify_attributes: ''
            -%}
          </div>
        </div>
      </div>

      {%- if show_bill_pay and bill_pay_link != blank -%}
        <div class="site-header__bill-pay-button"
          aria-label="Open bill pay"
        >
          {%- render 'button',
            label: bill_pay_label,
            link: bill_pay_link,
            variant: 'primary',
            block_shopify_attributes: ''
          -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section site-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "checkbox",
      "id": "show_bill_pay",
      "label": "Show Bill Pay button",
      "default": true
    },
    {
      "type": "text",
      "id": "bill_pay_label",
      "label": "Bill Pay label",
      "default": "Bill Pay"
    },
    {
      "type": "url",
      "id": "bill_pay_link",
      "label": "Bill Pay link"
    },
    {
      "type": "link_list",
      "id": "desktop_menu",
      "label": "Desktop navigation",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Mobile navigation",
      "default": "main-menu"
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Header background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "trending_searches",
      "name": "Trending searches",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Trending searches"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
