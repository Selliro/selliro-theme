{% schema %}
{
  "name": "Featured collection grid",
  "tag": "section",
  "class": "section-featured-collection-grid",
  "settings": [
    {
      "type": "select",
      "id": "data_source",
      "label": "Content source",
      "options": [
        { "value": "collection", "label": "Collection (dynamic)" },
        { "value": "manual", "label": "Manual blocks" }
      ],
      "default": "manual"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured Collections"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle / Tagline",
      "default": "Only the best seller products added recently in our catalog"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title font size",
      "min": 16,
      "max": 64,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "label": "Subtitle font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "tall_card_side",
      "label": "Tall card side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "card_gradient",
      "label": "Card gradient",
      "options": [
        { "value": "soft", "label": "Soft" },
        { "value": "none", "label": "None" }
      ],
      "default": "soft"
    },
    {
      "type": "color",
      "id": "card_gradient_color",
      "label": "Card gradient color (small cards)",
      "default": "#f5f0ea"
    },
    {
      "type": "color",
      "id": "card_gradient_color_tall",
      "label": "Card gradient color (tall card)",
      "default": "#f0ece4"
    },
    {
      "type": "select",
      "id": "card_body_alignment",
      "label": "Card content alignment",
      "options": [
        { "value": "bottom", "label": "Bottom" },
        { "value": "top", "label": "Top" }
      ],
      "default": "bottom"
