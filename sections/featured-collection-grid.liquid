{% comment %}
  Featured collection grid — asymmetric product layout (four small cards + one tall card).
{% endcomment %}

<style>
  .featured-collection-grid__title {
    font-size: {{ section.settings.title_font_size }}px;
  }
  .featured-collection-grid__subtitle {
    font-size: {{ section.settings.subtitle_font_size }}px;
  }
  .featured-collection-grid__header {
    text-align: {{ section.settings.header_alignment }};
  }

  #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__grid {
    grid-template-columns: {% if section.settings.tall_card_side == 'left' %}2fr 3fr{% else %}3fr 2fr{% endif %};
  }
  {% if section.settings.tall_card_side == 'left' %}
  #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__cluster {
    grid-column: 2;
  }
  #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__col--right {
    grid-column: 1;
    grid-row: 1;
  }
  {% endif %}

  #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__card::after {
    {% if section.settings.card_gradient == 'none' %}
    background: transparent;
    {% else %}
    background: linear-gradient(
      to top,
      {{ section.settings.card_gradient_color | color_modify: 'alpha', 0.97 }} 0%,
      {{ section.settings.card_gradient_color | color_modify: 'alpha', 0.80 }} 20%,
      {{ section.settings.card_gradient_color | color_modify: 'alpha', 0.30 }} 45%,
      transparent 65%
    );
    {% endif %}
  }

  #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__card--tall::after {
    {% if section.settings.card_gradient == 'none' %}
    background: transparent;
    {% else %}
    background: linear-gradient(
      to top,
      {{ section.settings.card_gradient_color_tall | color_modify: 'alpha', 0.95 }} 0%,
      {{ section.settings.card_gradient_color_tall | color_modify: 'alpha', 0.70 }} 18%,
      {{ section.settings.card_gradient_color_tall | color_modify: 'alpha', 0.20 }} 38%,
      transparent 55%
    );
    {% endif %}
  }

  #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__card-body {
    {% if section.settings.card_body_alignment == 'top' %}
    margin-top: 0;
    margin-bottom: auto;
    {% else %}
    margin-top: auto;
    margin-bottom: 0;
    {% endif %}
  }

  #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__card-tag,
  #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__card-title,
  #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__card-title a,
  #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__card-desc {
    color: var(--featured-collection-grid-card-text, inherit);
  }

  @media screen and (max-width: 1024px) {
    #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__grid {
      grid-template-columns: 1fr 1fr;
    }
    #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__cluster,
    #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__col--right {
      grid-column: auto;
    }
  }

  @media screen and (max-width: 640px) {
    #FeaturedCollectionGrid-{{ section.id }} .featured-collection-grid__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{{ 'section-featured-collection-grid.css' | asset_url | stylesheet_tag }}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="featured-collection-grid {{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  id="FeaturedCollectionGrid-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {%- liquid
    assign max_products = 5
    assign products = section.settings.collection.products | limit: max_products
    assign use_manual = false
    if section.settings.data_source == 'manual'
      assign use_manual = true
    endif
  -%}

  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="featured-collection-grid__header">
      {%- if section.settings.title != blank -%}
        <h3 class="featured-collection-grid__title">{{ section.settings.title }}</h3>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="featured-collection-grid__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="featured-collection-grid__grid">
    <div class="featured-collection-grid__cluster">
      {%- comment -%} ── LEFT COLUMN (2 stacked half cards) ── {%- endcomment -%}
      <div class="featured-collection-grid__col featured-collection-grid__col--left">
        {%- if use_manual -%}
          {%- for i in (1..2) -%}
            {%- assign pos = forloop.index | append: '' -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.column == 'left' and block.settings.position == pos -%}
                {%- assign block_product = block.settings.product -%}
                <div class="featured-collection-grid__card featured-collection-grid__card--half color-{{ block.settings.color_scheme }}" style="{% if block.settings.card_bg_color != blank %}background-color: {{ block.settings.card_bg_color }};{% endif %}{% if block.settings.card_text_color != blank %}--featured-collection-grid-card-text: {{ block.settings.card_text_color }};{% endif %}" {{ block.shopify_attributes }}>
                  {%- if block_product != blank -%}
                    <a class="featured-collection-grid__card-link" href="{{ block_product.url }}" aria-label="{{ block_product.title }}"></a>
                  {%- elsif block.settings.link != blank -%}
                    <a class="featured-collection-grid__card-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | default: 'View item' }}"></a>
                  {%- endif -%}
                  <div class="featured-collection-grid__card-image-wrap">
                    {%- if block_product != blank and block_product.featured_image != blank -%}
                      {{ block_product.featured_image | image_url: width: 800 | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800',
                        class: 'featured-collection-grid__card-image'
                      }}
                    {%- elsif block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 800 | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800',
                        class: 'featured-collection-grid__card-image'
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'featured-collection-grid__card-placeholder' }}
                    {%- endif -%}
                  </div>
                  <div class="featured-collection-grid__card-body">
                    {%- if block.settings.tag != blank -%}
                      <p class="featured-collection-grid__card-tag">{{ block.settings.tag }}</p>
                    {%- elsif block_product != blank and block_product.type != blank -%}
                      <p class="featured-collection-grid__card-tag">{{ block_product.type }}</p>
                    {%- endif -%}
                    <h3 class="featured-collection-grid__card-title">
                      {%- if block_product != blank -%}
                        <a href="{{ block_product.url }}">{{ block_product.title }}</a>
                      {%- elsif block.settings.title != blank -%}
                        {%- if block.settings.link != blank -%}
                          <a href="{{ block.settings.link }}">{{ block.settings.title }}</a>
                        {%- else -%}
                          {{ block.settings.title }}
                        {%- endif -%}
                      {%- endif -%}
                    </h3>
                    {%- if block_product != blank -%}
                      <p class="featured-collection-grid__card-desc">{{ block_product.description | strip_html | truncate: section.settings.description_length }}</p>
                    {%- elsif block.settings.description != blank -%}
                      <p class="featured-collection-grid__card-desc">{{ block.settings.description }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (0..1) -%}
            {%- assign product = products[i] -%}
            <div class="featured-collection-grid__card featured-collection-grid__card--half">
              {%- if product != blank -%}
                <a class="featured-collection-grid__card-link" href="{{ product.url }}" aria-label="{{ product.title }}"></a>
              {%- endif -%}
              <div class="featured-collection-grid__card-image-wrap">
                {%- if product != blank and product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    class: 'featured-collection-grid__card-image'
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'featured-collection-grid__card-placeholder' }}
                {%- endif -%}
              </div>
              <div class="featured-collection-grid__card-body">
                {%- if section.settings.show_tag and product != blank -%}
                  {%- assign tag_text = '' -%}
                  {%- case section.settings.tag_source -%}
                    {%- when 'product_type' -%}
                      {%- assign tag_text = product.type -%}
                    {%- when 'vendor' -%}
                      {%- assign tag_text = product.vendor -%}
                    {%- when 'collection_title' -%}
                      {%- assign tag_text = section.settings.collection.title -%}
                  {%- endcase -%}
                  {%- if tag_text != blank -%}
                    <p class="featured-collection-grid__card-tag">{{ tag_text }}</p>
                  {%- endif -%}
                {%- endif -%}
                <h3 class="featured-collection-grid__card-title">
                  {%- if product != blank -%}
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  {%- else -%}
                    Product Name
                  {%- endif -%}
                </h3>
                {%- if section.settings.show_description -%}
                  <p class="featured-collection-grid__card-desc">
                    {%- if product != blank -%}
                      {{ product.description | strip_html | truncate: section.settings.description_length }}
                    {%- else -%}
                      Faucibus a pellentesque sit amet porttitor eget dolor morbi non.
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- comment -%} ── MIDDLE COLUMN (2 stacked half cards) ── {%- endcomment -%}
      <div class="featured-collection-grid__col featured-collection-grid__col--middle">
        {%- if use_manual -%}
          {%- for i in (1..2) -%}
            {%- assign pos = forloop.index | append: '' -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.column == 'middle' and block.settings.position == pos -%}
                {%- assign block_product = block.settings.product -%}
                <div class="featured-collection-grid__card featured-collection-grid__card--half color-{{ block.settings.color_scheme }}" style="{% if block.settings.card_bg_color != blank %}background-color: {{ block.settings.card_bg_color }};{% endif %}{% if block.settings.card_text_color != blank %}--featured-collection-grid-card-text: {{ block.settings.card_text_color }};{% endif %}" {{ block.shopify_attributes }}>
                  {%- if block_product != blank -%}
                    <a class="featured-collection-grid__card-link" href="{{ block_product.url }}" aria-label="{{ block_product.title }}"></a>
                  {%- elsif block.settings.link != blank -%}
                    <a class="featured-collection-grid__card-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | default: 'View item' }}"></a>
                  {%- endif -%}
                  <div class="featured-collection-grid__card-image-wrap">
                    {%- if block_product != blank and block_product.featured_image != blank -%}
                      {{ block_product.featured_image | image_url: width: 800 | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800',
                        class: 'featured-collection-grid__card-image'
                      }}
                    {%- elsif block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 800 | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800',
                        class: 'featured-collection-grid__card-image'
                      }}
                    {%- else -%}
                      {{ 'product-2' | placeholder_svg_tag: 'featured-collection-grid__card-placeholder' }}
                    {%- endif -%}
                  </div>
                  <div class="featured-collection-grid__card-body">
                    {%- if block.settings.tag != blank -%}
                      <p class="featured-collection-grid__card-tag">{{ block.settings.tag }}</p>
                    {%- elsif block_product != blank and block_product.type != blank -%}
                      <p class="featured-collection-grid__card-tag">{{ block_product.type }}</p>
                    {%- endif -%}
                    <h3 class="featured-collection-grid__card-title">
                      {%- if block_product != blank -%}
                        <a href="{{ block_product.url }}">{{ block_product.title }}</a>
                      {%- elsif block.settings.title != blank -%}
                        {%- if block.settings.link != blank -%}
                          <a href="{{ block.settings.link }}">{{ block.settings.title }}</a>
                        {%- else -%}
                          {{ block.settings.title }}
                        {%- endif -%}
                      {%- endif -%}
                    </h3>
                    {%- if block_product != blank -%}
                      <p class="featured-collection-grid__card-desc">{{ block_product.description | strip_html | truncate: section.settings.description_length }}</p>
                    {%- elsif block.settings.description != blank -%}
                      <p class="featured-collection-grid__card-desc">{{ block.settings.description }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (2..3) -%}
            {%- assign product = products[i] -%}
            <div class="featured-collection-grid__card featured-collection-grid__card--half">
              {%- if product != blank -%}
                <a class="featured-collection-grid__card-link" href="{{ product.url }}" aria-label="{{ product.title }}"></a>
              {%- endif -%}
              <div class="featured-collection-grid__card-image-wrap">
                {%- if product != blank and product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    class: 'featured-collection-grid__card-image'
                  }}
                {%- else -%}
                  {{ 'product-2' | placeholder_svg_tag: 'featured-collection-grid__card-placeholder' }}
                {%- endif -%}
              </div>
              <div class="featured-collection-grid__card-body">
                {%- if section.settings.show_tag and product != blank -%}
                  {%- assign tag_text = '' -%}
                  {%- case section.settings.tag_source -%}
                    {%- when 'product_type' -%}
                      {%- assign tag_text = product.type -%}
                    {%- when 'vendor' -%}
                      {%- assign tag_text = product.vendor -%}
                    {%- when 'collection_title' -%}
                      {%- assign tag_text = section.settings.collection.title -%}
                  {%- endcase -%}
                  {%- if tag_text != blank -%}
                    <p class="featured-collection-grid__card-tag">{{ tag_text }}</p>
                  {%- endif -%}
                {%- endif -%}
                <h3 class="featured-collection-grid__card-title">
                  {%- if product != blank -%}
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  {%- else -%}
                    Product Name
                  {%- endif -%}
                </h3>
                {%- if section.settings.show_description -%}
                  <p class="featured-collection-grid__card-desc">
                    {%- if product != blank -%}
                      {{ product.description | strip_html | truncate: section.settings.description_length }}
                    {%- else -%}
                      Urna porttitor rhoncus dolor purus non enim praesent elementum.
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ── RIGHT COLUMN (1 tall full-height card) ── {%- endcomment -%}
    <div class="featured-collection-grid__col featured-collection-grid__col--right">
      {%- if use_manual -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'right' -%}
            {%- assign block_product = block.settings.product -%}
            <div class="featured-collection-grid__card featured-collection-grid__card--tall color-{{ block.settings.color_scheme }}" style="{% if block.settings.card_bg_color != blank %}background-color: {{ block.settings.card_bg_color }};{% endif %}{% if block.settings.card_text_color != blank %}--featured-collection-grid-card-text: {{ block.settings.card_text_color }};{% endif %}" {{ block.shopify_attributes }}>
              {%- if block_product != blank -%}
                <a class="featured-collection-grid__card-link" href="{{ block_product.url }}" aria-label="{{ block_product.title }}"></a>
              {%- elsif block.settings.link != blank -%}
                <a class="featured-collection-grid__card-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | default: 'View item' }}"></a>
              {%- endif -%}
              <div class="featured-collection-grid__card-image-wrap">
                {%- if block_product != blank and block_product.featured_image != blank -%}
                  {{ block_product.featured_image | image_url: width: 1400 | image_tag:
                    loading: 'lazy',
                    widths: '700, 1000, 1400',
                    class: 'featured-collection-grid__card-image'
                  }}
                {%- elsif block.settings.image != blank -%}
