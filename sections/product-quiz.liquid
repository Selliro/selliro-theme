{%- comment -%}
  Product Finder Quiz
  A guided, multi-step quiz that recommends products based on the shopper's answers.

  Merchant view:
  - Each "Question" block holds up to 6 answers (label, optional description, icon or image,
    and the products that answer recommends).
  - Products recommended by more of the chosen answers rank higher.
  - Results use the New Arrivals product card (quick view + quick add) and can be added to the cart in one click.
  - The "Fallback collection" tops up the results when answers recommend too few products.

  Files: assets/section-product-quiz.css, assets/product-quiz.js, snippets/itc-feature-icon.liquid (icons)
{%- endcomment -%}

{{ 'section-product-quiz.css' | asset_url | stylesheet_tag }}
{{ 'section-new-arrivals-showcase.css' | asset_url | stylesheet_tag }}
{{ 'new-arrivals-quick-view.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign question_count = 0
  for block in section.blocks
    if block.type == 'question'
      assign question_count = question_count | plus: 1
    endif
  endfor

  assign intro_layout = section.settings.intro_layout | default: 'split'
  assign media_position = section.settings.media_position | default: 'left'
  if section.settings.intro_image == blank or intro_layout == 'hero'
    assign media_position = 'none'
  endif

  assign hero_font_source = section.settings.hero_font_source | default: 'custom'
  case hero_font_source
    when 'heading'
      assign hero_family = 'var(--font-heading--family)'
      assign hero_weight = 'var(--font-heading--weight)'
    when 'accent'
      assign hero_family = 'var(--font-accent--family)'
      assign hero_weight = 'var(--font-accent--weight)'
    when 'body'
      assign hero_family = 'var(--font-body--family)'
      assign hero_weight = 'var(--font-body--weight)'
    else
      assign hero_family = section.settings.hero_font.family | append: ', ' | append: section.settings.hero_font.fallback_families
      assign hero_weight = section.settings.hero_font.weight
  endcase
  assign has_floats = false
  if intro_layout == 'hero'
    if section.settings.float_left_image != blank or section.settings.float_right_image != blank
      assign has_floats = true
    endif
  endif

  assign max_results = section.settings.max_results | default: 4
  assign accent = section.settings.accent_color | default: '#f8d12f'
  assign accent_text = section.settings.accent_text_color | default: '#000000'
  assign card_sizes = '(min-width: 990px) 25vw, 50vw'
  assign container_style = section.settings.container_style | default: 'card'

  case section.settings.heading_size
    when 'large'
      assign heading_class = 'h1'
    when 'small'
      assign heading_class = 'h3'
    else
      assign heading_class = 'h2'
  endcase

  assign questions_text = section.settings.questions_label | default: '[count] quick questions' | replace: '[count]', question_count
  assign answer_keys = 'A,B,C,D,E,F' | split: ','
-%}

{% style %}
  {%- if intro_layout == 'hero' and hero_font_source == 'custom' -%}
    {{ section.settings.hero_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  #ProductQuiz-{{ section.id }},
  #PqFloats-{{ section.id }} {
    --pq-hero-family: {{ hero_family }};
    --pq-hero-weight: {{ hero_weight }};
    --pq-hero-size: {{ section.settings.hero_heading_size }}px;
    --pq-hero-max: {{ section.settings.hero_heading_max_width }}ch;
    --pq-hero-min-height: {{ section.settings.hero_min_height }}vh;
    --pq-float-radius: {{ section.settings.float_radius }}px;
  }
  #ProductQuiz-{{ section.id }} {
    --pq-accent: {{ accent }};
    --pq-accent-text: {{ accent_text }};
    --pq-radius: {{ section.settings.card_radius }}px;
    --pq-columns: {{ section.settings.results_columns }};
    {%- if section.settings.surface_color != blank %}
      --pq-surface: {{ section.settings.surface_color }};
    {%- endif %}
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #ProductQuiz-{{ section.id }} {
      padding-block: {{ section.settings.padding_top | times: 0.6 | round }}px {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
  }
{% endstyle %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

{%- if has_floats -%}
  <div
    id="PqFloats-{{ section.id }}"
    class="pq-floats{% if section.settings.floats_mobile == 'hide' %} pq-floats--hide-mobile{% endif %}{% if section.settings.floats_keep_during_quiz %} pq-floats--keep{% endif %}"
    data-pq-floats
    data-strength="{{ section.settings.parallax_strength }}"
    data-motion="{{ section.settings.float_motion | default: 'sequence' }}"
    data-first="{{ section.settings.float_first | default: 'left' }}"
    data-rotate="{{ section.settings.scroll_rotate }}"
    aria-hidden="true"
  >
    {%- for side in (1..2) -%}
      {%- liquid
        if side == 1
          assign f_side = 'left'
        else
          assign f_side = 'right'
        endif
        assign k = 'float_' | append: f_side | append: '_image'
        assign f_image = section.settings[k]
        if f_image == blank
          continue
        endif
        assign k = 'float_' | append: f_side | append: '_width'
        assign f_width = section.settings[k]
        assign k = 'float_' | append: f_side | append: '_top'
        assign f_top = section.settings[k]
        assign k = 'float_' | append: f_side | append: '_offset'
        assign f_offset = section.settings[k]
        assign k = 'float_' | append: f_side | append: '_rotation'
        assign f_rotation = section.settings[k]
        assign k = 'float_' | append: f_side | append: '_ratio'
        assign f_ratio = section.settings[k] | default: '4 / 5'
        assign f_dir = 1
        if side == 1
          assign f_dir = -1
        endif
      -%}
      <div
        class="pq-float pq-float--{{ f_side }}"
        style="--w: {{ f_width }}%; --top: {{ f_top }}%; --offset: {{ f_offset }}%; --rot: {{ f_rotation }}deg; --ratio: {{ f_ratio }}; --dir: {{ f_dir }};"
      >
        <div class="pq-float__inner" data-pq-float>
          {{
            f_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 30vw, 45vw',
              alt: '',
              class: 'pq-float__img'
          }}
        </div>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

<product-quiz
  id="ProductQuiz-{{ section.id }}"
  class="pq pq--{{ container_style }} pq--intro-{{ intro_layout }} pq--btn-{{ section.settings.hero_button_style }}{% if section.settings.hero_button_uppercase %} pq--btn-upper{% endif %} pq--media-{{ media_position }} {{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-state="intro"
  data-auto-advance="{{ section.settings.auto_advance }}"
  data-remember="{{ section.settings.remember_result }}"
  data-analyzing="{{ section.settings.show_analyzing }}"
  data-max-results="{{ max_results }}"
  data-new-arrivals-root
  data-new-arrivals-qv-id="new-arrivals-qv-drawer-{{ section.id }}"
  data-step-template="{{ section.settings.step_label | escape }}"
>
  <div class="pq__shell">
    {%- if media_position != 'none' -%}
      <div class="pq__media" aria-hidden="true">
        <div class="pq__media-frame">
          <div class="pq__media-item is-active" data-pq-media="intro">
            {{
              section.settings.intro_image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1200, 1600',
                sizes: '(min-width: 990px) 42vw, 100vw',
                alt: '',
                class: 'pq__media-img'
            }}
          </div>
          {%- for block in section.blocks -%}
            {%- if block.type == 'question' and block.settings.image != blank -%}
              <div class="pq__media-item" data-pq-media="{{ block.id }}">
                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '600, 900, 1200, 1600',
                    sizes: '(min-width: 990px) 42vw, 100vw',
                    alt: '',
                    class: 'pq__media-img'
                }}
              </div>
            {%- endif -%}
          {%- endfor -%}
          <span class="pq__media-shade"></span>
          {%- if section.settings.media_badge != blank -%}
            <span class="pq__media-badge">
              {% render 'itc-feature-icon', icon: 'sparkle' %}
              {{ section.settings.media_badge | escape }}
            </span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="pq__panel">
      {%- comment -%} Toolbar: back + step label + segmented progress (hidden on intro) {%- endcomment -%}
      <div class="pq__toolbar" data-pq-toolbar>
        <div class="pq__toolbar-row">
          <button type="button" class="pq__back button-unstyled" data-pq-back>
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true" focusable="false"><path d="M12.5 4.5 7 10l5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>{{ section.settings.back_label | escape }}</span>
          </button>
          <span class="pq__step-label" data-pq-step-label></span>
        </div>
        <ol class="pq__progress list-unstyled" aria-hidden="true">
          {%- for i in (1..question_count) -%}
            <li class="pq__progress-seg" data-pq-seg="{{ i }}"><span></span></li>
          {%- endfor -%}
        </ol>
      </div>

      <p class="visually-hidden" aria-live="polite" data-pq-live></p>

      <div class="pq__steps">
        {%- comment -%} Intro {%- endcomment -%}
        <div class="pq__step pq__step--intro is-active" data-pq-step="intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="pq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="pq__heading{% if intro_layout == 'hero' %} pq__hero-heading{% else %} {{ heading_class }}{% endif %}" tabindex="-1">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="pq__text rte">{{ section.settings.text }}</div>
          {%- endif -%}

          {%- if section.settings.show_meta and question_count > 0 -%}
            <ul class="pq__meta list-unstyled">
              <li>{% render 'itc-feature-icon', icon: 'check' %}<span>{{ questions_text }}</span></li>
              {%- if section.settings.intro_note != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/></svg>
                  <span>{{ section.settings.intro_note | escape }}</span>
                </li>
              {%- endif -%}
              {%- if section.settings.meta_third != blank -%}
                <li>{% render 'itc-feature-icon', icon: 'heart' %}<span>{{ section.settings.meta_third | escape }}</span></li>
              {%- endif -%}
            </ul>
          {%- endif -%}

          <div class="pq__actions">
            <button type="button" class="pq__button pq__button--primary" data-pq-start {% if question_count == 0 %}disabled{% endif %}>
              <span>{{ section.settings.start_label | escape }}</span>
              <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true" focusable="false"><path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            {%- if section.settings.remember_result -%}
              <button type="button" class="pq__link button-unstyled" data-pq-last hidden>
                {{ section.settings.last_result_label | escape }}
              </button>
            {%- endif -%}
          </div>

          {%- if question_count == 0 and request.design_mode -%}
            <p class="pq__editor-hint">Add a “Question” block to start building your quiz.</p>
          {%- endif -%}

          {%- if intro_layout == 'hero' and section.settings.show_scroll_hint -%}
            <button type="button" class="pq__scroll-hint button-unstyled" data-pq-scroll-hint aria-label="{{ section.settings.start_label | escape }}">
              <svg viewBox="0 0 40 20" width="40" height="20" fill="none" aria-hidden="true" focusable="false"><path d="M3 4l17 13L37 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          {%- endif -%}
        </div>

        {%- comment -%} Questions {%- endcomment -%}
        {%- assign q_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' -%}
            {%- liquid
              assign q_index = q_index | plus: 1
              assign multiple = block.settings.allow_multiple
              assign input_type = 'radio'
              if multiple
                assign input_type = 'checkbox'
              endif
              assign answer_style = block.settings.answer_style | default: 'cards'
              assign a_index = 0
            -%}
            <fieldset
              class="pq__step pq__step--question"
              data-pq-step="question"
              data-pq-block-id="{{ block.id }}"
              data-pq-multiple="{{ multiple }}"
              {{ block.shopify_attributes }}
            >
              <legend class="pq__question">
                <span class="pq__question-text {{ heading_class }}" tabindex="-1">{{ block.settings.question | escape }}</span>
              </legend>
              <p class="pq__helper">
                {%- if block.settings.helper != blank -%}
                  {{ block.settings.helper | escape }}
                {%- elsif multiple -%}
                  {{ section.settings.multiple_hint | escape }}
                {%- endif -%}
              </p>

              <div class="pq__answers pq__answers--{{ answer_style }}">
                {%- for n in (1..6) -%}
                  {%- liquid
                    assign key = 'answer_' | append: n | append: '_label'
                    assign answer_label = block.settings[key]
                    if answer_label == blank
                      continue
                    endif
                    assign key = 'answer_' | append: n | append: '_description'
                    assign answer_description = block.settings[key]
                    assign key = 'answer_' | append: n | append: '_image'
                    assign answer_image = block.settings[key]
                    assign key = 'answer_' | append: n | append: '_icon'
                    assign answer_icon = block.settings[key] | default: 'none'
                    assign key = 'answer_' | append: n | append: '_products'
                    assign answer_ids = block.settings[key] | map: 'id' | join: ','
                    assign answer_key = answer_keys[a_index]
                    assign a_index = a_index | plus: 1
                  -%}
                  <label class="pq__answer{% if answer_style == 'cards' and answer_image != blank %} pq__answer--has-image{% endif %}">
                    <input
                      class="pq__answer-input"
                      type="{{ input_type }}"
                      name="pq-{{ section.id }}-{{ block.id }}"
                      value="{{ n }}"
                      data-products="{{ answer_ids }}"
                      data-label="{{ answer_label | escape }}"
                    >
                    {%- case answer_style -%}
                      {%- when 'cards' -%}
                        {%- if answer_image != blank -%}
                          <span class="pq__answer-media">
                            {{
                              answer_image
                              | image_url: width: 480
                              | image_tag: loading: 'lazy', widths: '240, 360, 480', sizes: '(min-width: 990px) 200px, 45vw', alt: ''
                            }}
                          </span>
                        {%- else -%}
                          <span class="pq__answer-icon" aria-hidden="true">
                            {%- if answer_icon != 'none' -%}
                              {% render 'itc-feature-icon', icon: answer_icon %}
                            {%- else -%}
                              <span class="pq__answer-key">{{ answer_key }}</span>
                            {%- endif -%}
                          </span>
                        {%- endif -%}
                      {%- when 'list' -%}
                        <span class="pq__answer-key" aria-hidden="true">{{ answer_key }}</span>
                      {%- when 'pills' -%}
                        {%- if answer_icon != 'none' -%}
                          <span class="pq__answer-pill-icon" aria-hidden="true">{% render 'itc-feature-icon', icon: answer_icon %}</span>
                        {%- endif -%}
                    {%- endcase -%}
                    <span class="pq__answer-body">
                      <span class="pq__answer-label">{{ answer_label | escape }}</span>
                      {%- if answer_description != blank and answer_style != 'pills' -%}
                        <span class="pq__answer-desc">{{ answer_description | escape }}</span>
                      {%- endif -%}
                    </span>
                    <span class="pq__answer-check" aria-hidden="true">
                      <svg viewBox="0 0 16 16" width="12" height="12" fill="none" focusable="false"><path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </label>
                {%- endfor -%}
              </div>

              <div class="pq__actions pq__actions--question">
                <button type="button" class="pq__button pq__button--primary" data-pq-next disabled>
                  <span>
                    {%- if q_index == question_count -%}
                      {{ section.settings.finish_label | escape }}
                    {%- else -%}
                      {{ section.settings.next_label | escape }}
                    {%- endif -%}
                  </span>
                  <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true" focusable="false"><path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                {%- if block.settings.allow_skip -%}
                  <button type="button" class="pq__link button-unstyled" data-pq-skip>{{ section.settings.skip_label | escape }}</button>
                {%- endif -%}
                <span class="pq__kbd-hint" aria-hidden="true">{{ section.settings.keyboard_hint | escape }}</span>
              </div>
            </fieldset>
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} Matching animation {%- endcomment -%}
        <div class="pq__step pq__step--analyzing" data-pq-step="analyzing">
          <div class="pq__analyzing">
            <span class="pq__spinner" aria-hidden="true">
              <svg viewBox="0 0 48 48" width="56" height="56"><circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="3" opacity=".15"/><circle class="pq__spinner-arc" cx="24" cy="24" r="20" fill="none" stroke="var(--pq-accent)" stroke-width="3" stroke-linecap="round" stroke-dasharray="40 200"/></svg>
              <span class="pq__spinner-icon">{% render 'itc-feature-icon', icon: 'sparkle' %}</span>
            </span>
            <p class="pq__analyzing-text h4">{{ section.settings.analyzing_text | escape }}</p>
          </div>
        </div>

        {%- comment -%} Results {%- endcomment -%}
        <div class="pq__step pq__step--results" data-pq-step="results">
          <div class="pq__results-head">
            <div class="pq__results-intro">
              {%- if section.settings.results_eyebrow != blank -%}
                <p class="pq__eyebrow">{{ section.settings.results_eyebrow | escape }}</p>
              {%- endif -%}
              <h2 class="pq__heading {{ heading_class }}" tabindex="-1">{{ section.settings.results_heading | escape }}</h2>
              {%- if section.settings.results_text != blank -%}
                <div class="pq__text rte">{{ section.settings.results_text }}</div>
              {%- endif -%}
            </div>
            {%- if section.settings.show_summary -%}
              <div class="pq__summary" data-pq-summary-wrap hidden>
                <p class="pq__summary-title">{{ section.settings.summary_label | escape }}</p>
                <ul class="pq__summary-list list-unstyled" data-pq-summary></ul>
              </div>
            {%- endif -%}
          </div>

          <ul class="pq__results list-unstyled" data-pq-results role="list"></ul>
          <p class="pq__empty" data-pq-empty hidden>{{ section.settings.empty_text | escape }}</p>

          <div class="pq__actions pq__actions--results">
            {%- if section.settings.show_add_all -%}
              <button type="button" class="pq__button pq__button--primary" data-pq-add-all hidden>
                <span class="pq__button-label">{{ section.settings.add_all_label | escape }}</span>
                <span class="pq__button-spinner" aria-hidden="true"></span>
              </button>
            {%- endif -%}
            <button type="button" class="pq__button pq__button--secondary" data-pq-restart>
              <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true" focusable="false"><path d="M4 10a6 6 0 1 0 1.76-4.24M4 4v3.5h3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{{ section.settings.restart_label | escape }}</span>
            </button>
            {%- if section.settings.results_link != blank and section.settings.results_link_label != blank -%}
              <a class="pq__link" href="{{ section.settings.results_link }}">{{ section.settings.results_link_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%}
    Product pool: every product any answer recommends (plus the fallback collection), rendered once.
    JavaScript moves the best matches into the results list.
  {%- endcomment -%}
  <div class="pq__pool" data-pq-pool hidden>
    {%- assign seen = ',' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'question' -%}
        {%- for n in (1..6) -%}
          {%- liquid
            assign key = 'answer_' | append: n | append: '_label'
            if block.settings[key] == blank
              continue
            endif
            assign key = 'answer_' | append: n | append: '_products'
          -%}
          {%- for product in block.settings[key] -%}
            {%- assign needle = ',' | append: product.id | append: ',' -%}
            {%- unless seen contains needle -%}
              {%- assign seen = seen | append: product.id | append: ',' -%}
              <li class="pq__result" data-product-id="{{ product.id }}" data-available="{{ product.available }}" data-best-label="{{ section.settings.best_match_label | escape }}">
                {%- render 'new-arrivals-card',
                  product: product,
                  accent: accent,
                  add_label: section.settings.add_label,
                  image_sizes: card_sizes
                -%}
              </li>
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if section.settings.fallback_collection != blank -%}
      {%- for product in section.settings.fallback_collection.products limit: 12 -%}
        {%- assign needle = ',' | append: product.id | append: ',' -%}
        {%- if seen contains needle -%}
          <li class="pq__result" data-product-id="{{ product.id }}" data-fallback="{{ forloop.index }}" data-duplicate></li>
        {%- else -%}
          {%- assign seen = seen | append: product.id | append: ',' -%}
          <li class="pq__result" data-product-id="{{ product.id }}" data-fallback="{{ forloop.index }}" data-available="{{ product.available }}" data-best-label="{{ section.settings.best_match_label | escape }}">
            {%- render 'new-arrivals-card',
              product: product,
              accent: accent,
              add_label: section.settings.add_label,
              image_sizes: card_sizes
            -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</product-quiz>

{% render 'new-arrivals-quick-view-drawer', section: section %}

<script src="{{ 'image-loader.js' | asset_url }}" defer></script>
<script src="{{ 'new-arrivals-components.js' | asset_url }}" defer></script>
<script src="{{ 'new-arrivals-showcase.js' | asset_url }}" defer></script>
<script src="{{ 'new-arrivals-quick-view.js' | asset_url }}" defer></script>
<script src="{{ 'product-quiz.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product finder quiz",
  "tag": "section",
  "class": "section-product-quiz",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "intro_layout",
      "label": "Intro layout",
      "options": [
        {
          "value": "hero",
