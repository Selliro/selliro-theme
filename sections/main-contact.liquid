{%- comment -%}
  Whispo — contact form (page.contact template). Heading, intro text, optional contact details, and the
  contact form (name, email, phone, message) with success and error messages that are announced and focused.
  Styles: assets/template-content.css ("Contact").
{%- endcomment -%}

{%- comment -%} 1. CSS {%- endcomment -%}
{{ 'template-content.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{%- comment -%} 2. Liquid {%- endcomment -%}
{%- assign form_id = 'ContactForm-' | append: section.id -%}
<div class="contact-page color-{{ section.settings.color_scheme }}">
  <div class="page-width contact-page__inner">
    <div class="contact-page__intro">
      {%- if section.settings.heading != blank -%}
        <h1 class="contact-page__title h1">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte contact-page__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.details != blank -%}
        <div class="rte contact-page__details">{{ section.settings.details }}</div>
      {%- endif -%}
    </div>

    {%- form 'contact', id: form_id, class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="contact-form__message form-message--success" role="status" tabindex="-1" autofocus>
          {%- render 'icon', name: 'check' -%}
          {{ 'contact.success' | t }}
        </p>
      {%- elsif form.errors -%}
        <div class="contact-form__message form-message--error" role="alert" tabindex="-1" autofocus>
          <p>{{ 'contact.error_heading' | t }}</p>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#{{ form_id }}-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="contact-form__row">
        <div class="field">
          <label class="field__label" for="{{ form_id }}-name">{{ 'contact.name' | t }}</label>
          <input class="field__input" id="{{ form_id }}-name" type="text" name="contact[{{ 'contact.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name">
        </div>
        <div class="field">
          <label class="field__label" for="{{ form_id }}-email">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
          <input
            class="field__input"
            id="{{ form_id }}-email"
            type="email"
            name="contact[email]"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
            {% endif %}
          >
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="{{ form_id }}-phone">{{ 'contact.phone' | t }}</label>
        <input class="field__input" id="{{ form_id }}-phone" type="tel" name="contact[{{ 'contact.phone' | t }}]" value="{{ form.phone }}" autocomplete="tel" pattern="[0-9\-\s\+\(\)]*">
      </div>
      <div class="field">
        <label class="field__label" for="{{ form_id }}-body">{{ 'contact.message' | t }} <span aria-hidden="true">*</span></label>
        <textarea id="{{ form_id }}-body" name="contact[body]" rows="6" required aria-required="true">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="button contact-form__submit">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{%- comment -%} 3. Schema {%- endcomment -%}
{% schema %}
{
  "name": "t:sections.main_contact.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.main_contact.heading", "default": "Contact us" },
    { "type": "richtext", "id": "text", "label": "t:sections.main_contact.text", "default": "<p>Questions about an order or a product? Send us a message and we will reply within two business days.</p>" },
    { "type": "richtext", "id": "details", "label": "t:sections.main_contact.details", "info": "t:sections.main_contact.details_info" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.main_collection.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:sections.main_collection.padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.main_collection.padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "presets": [
    { "name": "t:sections.main_contact.name" }
  ]
}
{% endschema %}
