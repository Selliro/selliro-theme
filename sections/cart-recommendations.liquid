{%- comment -%}
  Cart drawer "You may also like" products. Not added to templates: cart-drawer-plus.js renders it with the
  Section Rendering API, either through Shopify's product recommendations
  (/recommendations/products?product_id=…&section_id=cart-recommendations) for the first product in the cart, or
  on its own (?section_id=cart-recommendations) for an empty cart. Products already in the cart are skipped, and
  the fallback collection from Theme settings › Cart fills any gaps.
{%- endcomment -%}
{%- liquid
  assign limit = settings.cart_recommendations_limit | default: 6
  assign fallback = settings.cart_recommendations_collection
  if fallback == blank
    assign fallback = collections.all
  endif

  assign in_cart = ''
  for item in cart.items
    assign in_cart = in_cart | append: ',' | append: item.product_id | append: ','
  endfor

  assign pool = fallback.products
  if recommendations.performed? and recommendations.products_count > 0
    assign pool = recommendations.products | concat: fallback.products
  endif

  assign heading = settings.cart_recommendations_heading
  if cart.empty?
    assign heading = 'cart_drawer_plus.popular' | t
  endif
-%}

<div
  class="cart-recs"
  data-cart-recs-content
>
  {%- capture cards -%}
    {%- assign shown = ',' -%}
    {%- assign count = 0 -%}
    {%- for product in pool -%}
      {%- liquid
        if count >= limit
          break
        endif
        assign key = ',' | append: product.id | append: ','
        if in_cart contains key or shown contains key or product.available == false
          continue
        endif
        if product.requires_selling_plan or product.gift_card?
          continue
        endif
        assign shown = shown | append: product.id | append: ','
        assign count = count | plus: 1
        assign variant = product.selected_or_first_available_variant
      -%}
      <li
        class="cart-recs__card"
        data-product-id="{{ product.id }}"
        style="--i: {{ forloop.index0 }};"
      >
        <a
          class="cart-recs__media"
          href="{{ product.url }}"
          tabindex="-1"
          aria-hidden="true"
        >
          {%- if product.featured_image -%}
            {{
              product.featured_image
              | image_url: width: 360
              | image_tag: loading: 'lazy', widths: '180, 270, 360', sizes: '140px', alt: product.featured_image.alt
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'cart-recs__placeholder' }}
          {%- endif -%}
        </a>
        <div class="cart-recs__info">
          <a
            class="cart-recs__title"
            href="{{ product.url }}"
          >
            {{- product.title | escape -}}
          </a>
          <span class="cart-recs__price">
            {{- variant.price | money -}}
            {%- if variant.compare_at_price > variant.price -%}
              <s>{{ variant.compare_at_price | money }}</s>
            {%- endif -%}
          </span>
        </div>
        <form
          class="cart-recs__form"
          action="{{ routes.cart_add_url }}"
          method="post"
          data-cart-recs-form
        >
          {%- if product.has_only_default_variant -%}
            <input
              type="hidden"
              name="id"
              value="{{ variant.id }}"
            >
          {%- else -%}
            <label
              class="visually-hidden"
              for="CartRecs-{{ product.id }}"
            >
              {{- 'cart_drawer_plus.choose_option' | t -}}
            </label>
            <select
              class="cart-recs__select"
              name="id"
              id="CartRecs-{{ product.id }}"
            >
              {%- for v in product.variants -%}
                {%- if v.available -%}
                  <option
                    value="{{ v.id }}"
                    {% if v.id == variant.id %}
                      selected
                    {% endif %}
                  >
                    {{- v.title | escape -}}
                  </option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          {%- endif -%}
          <button
            type="submit"
            class="cart-recs__add"
            aria-label="{{ 'cart_drawer_plus.add_product' | t: product: product.title | escape }}"
          >
            <span
              class="cart-recs__add-icon"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 20 20"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              >
                <path d="M10 4v12M4 10h12"/>
              </svg>
            </span>
            <span
              class="cart-recs__add-done"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 20 20"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m4.5 10.5 3.5 3.5 7.5-8"/>
              </svg>
            </span>
            <span class="cart-recs__add-label">{{ 'cart_drawer_plus.add' | t }}</span>
          </button>
        </form>
      </li>
    {%- endfor -%}
  {%- endcapture -%}

  {%- if count > 0 -%}
    <div class="cart-recs__head">
      <h3 class="cart-recs__heading">{{ heading | escape }}</h3>
      {%- if count > 2 -%}
        <div class="cart-recs__nav">
          <button
            type="button"
            class="cart-recs__arrow"
            data-cart-recs-prev
            aria-label="{{ 'cart_drawer_plus.previous' | t }}"
            disabled
          >
            <svg
              viewBox="0 0 20 20"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m12 4-6 6 6 6"/>
            </svg>
          </button>
          <button
            type="button"
            class="cart-recs__arrow"
            data-cart-recs-next
            aria-label="{{ 'cart_drawer_plus.next' | t }}"
          >
            <svg
              viewBox="0 0 20 20"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m8 4 6 6-6 6"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </div>
    <ul
      class="cart-recs__track list-unstyled"
      data-cart-recs-track
      role="list"
    >
      {{ cards }}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart recommendations",
  "tag": "div",
  "class": "cart-recommendations-section",
  "settings": []
}
{% endschema %}
