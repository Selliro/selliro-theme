{%- comment -%}
  Product story — scroll-driven storytelling. A large image stays pinned while the steps scroll past;
  each step wipes in its own image, fills the progress rail and can feature a product with one-tap
  Add to cart. Reusable for routines, product launches, "how it works", brand stories …
  Files: assets/product-story.js (+ shared assets/section-reveal.*, assets/pdp-extras.js for quick add)
{%- endcomment -%}
{{ 'section-product-story.css' | asset_url | stylesheet_tag }}
{{ 'section-reveal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-reveal.js' | asset_url }}" defer></script>
<script src="{{ 'product-story.js' | asset_url }}" defer></script>
<script src="{{ 'pdp-extras.js' | asset_url }}" defer></script>

{%- liquid
  assign step_count = section.blocks.size
  assign transition = section.settings.transition | default: 'wipe'
  assign media_side = section.settings.media_position | default: 'left'
  assign layout = section.settings.layout | default: 'split'
  assign panel_tone = section.settings.panel_tone | default: 'light'

-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="pstory {{ section.settings.section_width }} color-{{ section.settings.color_scheme }} pstory--media-{{ media_side }} pstory--{{ transition }} pstory--layout-{{ layout }} pstory--panel-{{ panel_tone }}"
  data-reveal
  style="--pstory-pad-top: {{ section.settings.padding_top }}px; --pstory-pad-bottom: {{ section.settings.padding_bottom }}px; --pstory-radius: {{ section.settings.radius }}px; --pstory-accent: {{ section.settings.accent_color | default: '#f8d12f' }}; --pstory-ratio: {{ section.settings.media_ratio | default: '4 / 5' }}; --pstory-card: {{ section.settings.card_color | default: '#f4f1ea' }}; --sr-radius: {{ section.settings.radius }}px;"
>
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
    <header class="pstory__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pstory__eyebrow" data-reveal-fade="first">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pstory__heading" data-reveal-title>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="pstory__intro rte" data-reveal-fade>{{ section.settings.text }}</div>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- if step_count == 0 -%}
    <p class="pstory__empty">Add steps to tell your story.</p>
  {%- else -%}
    <product-story class="pstory__layout" data-layout="{{ layout }}" style="--pstory-steps: {{ step_count }};">
      {%- comment -%} Pinned media (desktop) {%- endcomment -%}
      <div class="pstory__media-col">
        <div class="pstory__media" data-reveal-card>
          {%- for block in section.blocks -%}
            <div class="pstory__slide{% if forloop.first %} is-active is-past{% endif %}" data-pstory-slide="{{ forloop.index0 }}">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 45vw, 100vw', alt: block.settings.image.alt, class: 'pstory__img' }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'pstory__img' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
          <div class="pstory__hud" aria-hidden="true">
            <span class="pstory__counter"><span data-pstory-current>01</span> / {{ step_count | prepend: '0' | slice: -2, 2 }}</span>
            <span class="pstory__hud-label" data-pstory-label>{{ section.blocks.first.settings.label | escape }}</span>
          </div>
        </div>
      </div>

      {%- comment -%} Progress rail {%- endcomment -%}
      {%- if section.settings.show_rail -%}
        <div class="pstory__rail" aria-hidden="true">
          <span class="pstory__rail-track"><span class="pstory__rail-fill" data-pstory-fill></span></span>
          {%- for block in section.blocks -%}
            <span class="pstory__rail-dot{% if forloop.first %} is-active{% endif %}" data-pstory-dot="{{ forloop.index0 }}">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Steps {%- endcomment -%}
      <ol class="pstory__steps list-unstyled">
        {%- for block in section.blocks -%}
          {%- assign item = block.settings.product -%}
          <li class="pstory__step{% if forloop.first %} is-active{% endif %}" data-pstory-step="{{ forloop.index0 }}" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            <div class="pstory__step-media" data-reveal-card>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '100vw', alt: '' }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="pstory__step-body">
              <p class="pstory__step-label">
                <span class="pstory__step-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                {%- if block.settings.label != blank -%}<span>{{ block.settings.label | escape }}</span>{%- endif -%}
              </p>
              {%- if block.settings.heading != blank -%}
                <h3 class="pstory__step-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="pstory__step-text rte">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if item != blank -%}
                {%- assign variant = item.selected_or_first_available_variant -%}
                <div class="pstory__product">
                  <a class="pstory__product-media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                    {%- if item.featured_image -%}
                      {{ item.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', width: 72, height: 72, alt: '' }}
                    {%- endif -%}
                  </a>
                  <div class="pstory__product-info">
                    <a class="pstory__product-title" href="{{ item.url }}">{{ item.title | escape }}</a>
                    <span class="pstory__product-price">
                      {{ variant.price | money }}
                      {%- if variant.compare_at_price > variant.price -%}<s>{{ variant.compare_at_price | money }}</s>{%- endif -%}
                    </span>
                  </div>
                  <button
                    type="button"
                    class="pstory__add"
                    data-pdp-add
                    data-variant-id="{{ variant.id }}"
                    data-product-id="{{ item.id }}"
                    {% unless variant.available %}disabled{% endunless %}
                    aria-label="{{ section.settings.add_label | escape }}: {{ item.title | escape }}"
                  >
                    <span class="pstory__add-label">
                      {%- if variant.available -%}{{ section.settings.add_label | escape }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                    </span>
                    <span class="pstory__add-done" aria-hidden="true">{%- render 'pdp-icon', icon: 'check' -%}</span>
                  </button>
                </div>
              {%- endif -%}

              {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                <a class="pstory__link" href="{{ block.settings.button_link }}">
                  {{- block.settings.button_label | escape -}}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </product-story>
  {%- endif -%}
</section>


{% schema %}
{
  "name": "Product story",
  "class": "pstory-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The routine"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your glow ritual, step by step"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Layout and motion"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "split",
          "label": "Split — pinned image"
        },
        {
          "value": "stacked",
          "label": "Stacked cards"
        },
        {
          "value": "immersive",
          "label": "Immersive — full-screen image"
        }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image / panel side",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "info": "Split and Stacked: side of the image. Immersive: side of the text panels."
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "3 / 4",
          "label": "Tall (3:4)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        }
      ],
      "default": "4 / 5",
      "visible_if": "{{ section.settings.layout == 'split' }}"
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Image transition",
      "options": [
        {
          "value": "wipe",
          "label": "Wipe up"
        },
        {
          "value": "fade",
          "label": "Fade and zoom"
        }
      ],
      "default": "wipe",
      "visible_if": "{{ section.settings.layout != 'stacked' }}"
    },
    {
      "type": "checkbox",
      "id": "show_rail",
      "label": "Show numbered progress rail",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'split' }}"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#f4f1ea",
      "visible_if": "{{ section.settings.layout == 'stacked' }}"
    },
    {
      "type": "select",
      "id": "panel_tone",
      "label": "Text panel style",
      "options": [
        {
          "value": "light",
          "label": "Light glass"
        },
        {
          "value": "dark",
          "label": "Dark glass"
        }
      ],
      "default": "light",
      "visible_if": "{{ section.settings.layout == 'immersive' }}"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#f8d12f"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets a link jump here, e.g. journey → link to #journey"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Cleanse"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Start with a clean canvas"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this step of the story.</p>"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured product",
          "info": "Shows the product with price and an Add to cart button."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Product story",
      "category": "Product",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "label": "Cleanse",
            "heading": "Start with a clean canvas",
            "text": "<p>Wash away the day so actives can do their best work.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Treat",
            "heading": "Target what matters",
            "text": "<p>A concentrated serum for your top skin concern.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Moisturise",
            "heading": "Lock it all in",
            "text": "<p>Seal in hydration for soft, bouncy skin.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
