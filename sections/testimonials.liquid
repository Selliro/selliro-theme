{%- comment -%}
  Testimonials Section
  Mobile-first testimonials section with rating display and carousel
  
  Layout:
  - Mobile: Stacked layout, 1 testimonial per view
  - Desktop: 1.5 testimonials per view with navigation
{%- endcomment -%}

{%- liquid
  assign section_caption = section.settings.caption | default: ''
  assign section_heading = section.settings.heading | default: 'What our customers are saying'
  assign heading_color = section.settings.heading_color | default: '#092846'
  assign rating_value = section.settings.rating_value | default: '4.8'
  assign rating_description = section.settings.rating_description | default: 'Rated by patients across the country'
  assign background_color = section.settings.background_color
-%}
<style>
  #{{ section.id }} {
    padding-top: {{ section.settings.add_top_padding_mobile }}px;
    padding-bottom: {{ section.settings.add_bottom_padding_mobile }}px;
  }
  @media(min-width: 1024px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.add_top_padding_desktop }}px;
      padding-bottom: {{ section.settings.add_bottom_padding_desktop }}px;
    }
  }
</style>
<style>
  @media(min-width: 768px) {
    #{{ section.id }} .testimonials__header {
      padding-right:0;
      {% if section.settings.left_content_max_width != blank %}
      max-width: {{ section.settings.left_content_max_width }};
      {% endif %}
    }

    #{{section.id}} .carousel__swiper {
      padding-left:0;
    }
  }

</style>

<div id="{{ section.id }}" class="testimonials tw-w-full"{% if background_color != blank %} style="background-color: {{ background_color }};"{% endif %}>
  <div class="testimonials__container" data-swiper-parent>
    {%- comment -%} Grid Layout: Header Content + Carousel {%- endcomment -%}
    <div class="testimonials__wrapper tw-grid tw-grid-cols-1 
        md-small:tw-grid-cols-3 tw-gap-8 md-small:tw-gap-12 
        tw-items-start md-small:tw-items-stretch section-container section-wide--right">
      
      {%- comment -%} Left: Header Content (Caption, Heading, Rating) {%- endcomment -%}
      <div class="testimonials__header tw-flex tw-flex-col tw-gap-4 md-small:tw-gap-5 tw-items-start">
        {%- comment -%} Caption {%- endcomment -%}
        {%- if section_caption != blank -%}
          {%- render 'caption',
            text: section_caption,
            color: '#323E46',
            parent_class: 'testimonials'
          -%}
        {%- endif -%}
        
        {%- comment -%} Heading {%- endcomment -%}
        {%- if section_heading != blank -%}
          <div class="testimonials__heading-wrapper">
            {%- render 'heading',
              text: section_heading,
              variant: 'h3',
              color: heading_color,
              parent_class: 'testimonials'
            -%}
          </div>
        {%- endif -%}
        
        {%- comment -%} Rating Section {%- endcomment -%}
        {%- if rating_value != blank -%}
          <div class="testimonials__rating tw-flex tw-flex-col tw-gap-1 tw-items-start tw-rounded-xl md:tw-py-4">
            {%- comment -%} Rating Value and Stars {%- endcomment -%}
            <div class="testimonials__rating-display tw-flex tw-gap-4 tw-items-center tw-w-full">
              <div class="testimonials__rating-value tw-text-2xl tw-font-medium tw-leading-[1.1] tw-tracking-[-0.96px] tw-text-heading-text">
                {{ rating_value }}
              </div>
              
              {%- render 'star-rating',
                rating: rating_value | plus: 0,
                star_color: section.settings.star_color | default: '#52c3c2',
                parent_class: 'testimonials'
              -%}
            </div>
            
            {%- comment -%} Rating Description {%- endcomment -%}
            {%- if rating_description != blank -%}
              <div class="testimonials__rating-description">
                <div class="tw-hidden md:tw-block">
                {%- render 'body',
                  text: rating_description,
                  variant: 'lg',
                  color: '#323e46',
                  parent_class: 'testimonials'
                -%}
                </div>
                <div class="tw-block md:tw-hidden">
                  {%- render 'body',
                    text: rating_description,
                    variant: 'base-medium',
                    color: '#323e46',
                    parent_class: 'testimonials'
                  -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      
      {%- comment -%} Right: Testimonials Carousel {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <div class="testimonials__carousel tw-col-span-2">
          <carousel-swiper class="carousel carousel--testimonials">
            <script type="application/json">
              {
                "slidesPerView": "1",
                "spaceBetween": 20,
                "navigation": true,
                "grabCursor": true,
                "breakpoints": {
                  "768": {
                    "slidesPerView": "1.46",
                    "spaceBetween": 24
                  }
                }
              }
            </script>
            
            <div class="swiper carousel__swiper">
              <div class="swiper-wrapper carousel__wrapper">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'testimonial' and block.settings.quote != blank -%}
                    <div class="swiper-slide carousel__slide tw-h-auto tw-flex">
                      {%- render 'testimonial-card',
                        quote: block.settings.quote,
                        quote_color: block.settings.quote_color,
                        author: block.settings.author,
                        author_color: block.settings.author_color,
                        block_shopify_attributes: block.shopify_attributes
                      -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </carousel-swiper>
        </div>
      {%- endif -%}
    </div>
    {%  render 'swiper-navigation' %}
    </div> 
 
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section testimonials section-container-wide",
  "settings": [
    {
      "type": "header",
