{%- comment -%}
  Whispo — logo marquee ("As seen in"). Partner or press logos run in a continuous line with softened edges;
  hover or focus pauses it, reduced motion shows the logos still. Optional heading. Each logo can link.
  Styles: assets/section-logo-marquee.css.
{%- endcomment -%}

{%- comment -%} 1. CSS {%- endcomment -%}
{{ 'section-logo-marquee.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --marquee-duration: {{ section.settings.speed }}s;
    --logo-height: {{ section.settings.logo_height }}px;
  }
{% endstyle %}

{%- comment -%} 2. Liquid {%- endcomment -%}
{%- capture logos -%}
  {%- for block in section.blocks -%}
    <li class="logo-marquee__item" {{ block.shopify_attributes }}>
      {%- capture logo -%}
        {%- if block.settings.image != blank -%}
          {%- assign image_alt = block.settings.image.alt | default: block.settings.name -%}
          {{ block.settings.image | image_url: width: 480 | image_tag: widths: '160, 240, 320, 480', sizes: '200px', loading: 'lazy', class: 'logo-marquee__image', alt: image_alt }}
        {%- else -%}
          <span class="logo-marquee__name">{{ block.settings.name | escape }}</span>
        {%- endif -%}
      {%- endcapture -%}
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" class="logo-marquee__link">{{ logo }}</a>
      {%- else -%}
        {{ logo }}
      {%- endif -%}
    </li>
  {%- endfor -%}
{%- endcapture -%}

<div class="logo-marquee color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="logo-marquee__heading page-width">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="logo-marquee__viewport{% if section.settings.page_width %} page-width{% endif %}">
    <ul class="logo-marquee__run" role="list">{{ logos }}</ul>
    <ul class="logo-marquee__run" role="list" aria-hidden="true" inert>{{ logos }}</ul>
  </div>
</div>

{%- comment -%} 3. Schema {%- endcomment -%}
{% schema %}
{
  "name": "t:sections.logo_marquee.name",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.logo_marquee.heading" },
    { "type": "range", "id": "logo_height", "label": "t:sections.logo_marquee.logo_height", "min": 20, "max": 80, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "speed", "label": "t:sections.logo_marquee.speed", "info": "t:sections.logo_marquee.speed_info", "min": 10, "max": 80, "step": 5, "unit": "s", "default": 30 },
    { "type": "checkbox", "id": "page_width", "label": "t:sections.logo_marquee.page_width", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.main_collection.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:sections.main_collection.padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.main_collection.padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.logo_marquee.blocks.logo.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.logo_marquee.blocks.logo.image" },
        { "type": "text", "id": "name", "label": "t:sections.logo_marquee.blocks.logo.name_label", "info": "t:sections.logo_marquee.blocks.logo.name_info", "default": "Brand" },
        { "type": "url", "id": "link", "label": "t:sections.logo_marquee.blocks.logo.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.logo_marquee.name",
      "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }]
    }
  ]
}
{% endschema %}
