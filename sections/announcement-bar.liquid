{%- comment -%}
  Whispo — announcement bar (header section group).

  Style "Slideshow": one announcement at a time with previous / next buttons. Autoplay moves on every few
  seconds and pauses on hover, on keyboard focus, with the pause button and for visitors who prefer reduced
  motion (WCAG 2.2.2). Style "Scrolling": all announcements run in a continuous line; hover or focus pauses
  it; reduced motion shows them static.
  Each announcement can have a link and a small icon.

  Files: assets/section-announcement-bar.css, assets/announcement-bar.js.
{%- endcomment -%}

{%- comment -%} 1. CSS {%- endcomment -%}
{{ 'section-announcement-bar.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} {
    --announcement-padding-block: {{ section.settings.padding_block }}px;
    --announcement-duration: {{ section.blocks.size | times: section.settings.marquee_speed | at_least: 12 }}s;
  }
{% endstyle %}

{%- comment -%} 2. Liquid {%- endcomment -%}
{%- liquid
  assign blocks = section.blocks
  assign count = blocks.size
  assign style = section.settings.style
  if count < 2
    assign style = 'static'
  endif
-%}

{%- if count > 0 -%}
  {%- if style != 'static' -%}
    <script src="{{ 'announcement-bar.js' | asset_url }}" type="module"></script>
  {%- endif -%}

  {%- capture items -%}
    {%- for block in blocks -%}
      {%- capture content -%}
        {%- if block.settings.icon != blank -%}
          {{
            block.settings.icon
            | image_url: width: 48
            | image_tag: width: 18, height: 18, alt: '', loading: 'lazy', class: 'announcement-bar__icon'
          }}
        {%- endif -%}
        <span class="announcement-bar__text">{{ block.settings.text }}</span>
        {%- if block.settings.link != blank -%}
          {%- render 'icon', name: 'arrow-right', class: 'announcement-bar__arrow' -%}
        {%- endif -%}
      {%- endcapture -%}
      <div
        class="announcement-bar__item"
        data-ref="slide[]"
        {% if style == 'slideshow' %}
          role="group" aria-roledescription="{{ 'accessibility.slide' | t }}" aria-label="{{ 'accessibility.slide_of' | t: index: forloop.index, count: count }}"
          {% if forloop.first %}data-active{% endif %}
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="announcement-bar__content announcement-bar__content--link">{{ content }}</a>
        {%- else -%}
          <p class="announcement-bar__content">{{ content }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  {%- endcapture -%}

  <announcement-bar
    class="announcement-bar announcement-bar--{{ style }} color-{{ section.settings.color_scheme }}"
    data-style="{{ style }}"
    data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
    {% if section.settings.autoplay %}
      data-autoplay
    {% endif %}
    role="region"
    aria-label="{{ 'accessibility.announcements' | t }}"
    {% if style == 'slideshow' %}
      aria-roledescription="{{ 'accessibility.carousel' | t }}"
    {% endif %}
  >
    <div class="announcement-bar__inner{% if section.settings.full_width == false %} page-width{% endif %}">
      {%- case style -%}
        {%- when 'slideshow' -%}
          <button type="button" class="announcement-bar__button" data-ref="previous">
            {%- render 'icon', name: 'chevron-left' -%}
            <span class="visually-hidden">{{ 'accessibility.previous_announcement' | t }}</span>
          </button>
          <div class="announcement-bar__slides" data-ref="track" aria-live="off" aria-atomic="false">
            {{ items }}
          </div>
          <button type="button" class="announcement-bar__button" data-ref="next">
            {%- render 'icon', name: 'chevron-right' -%}
            <span class="visually-hidden">{{ 'accessibility.next_announcement' | t }}</span>
          </button>
          {%- if section.settings.autoplay -%}
            <button
              type="button"
              class="announcement-bar__button announcement-bar__pause"
              data-ref="pause"
              aria-pressed="false"
              data-label-pause="{{ 'accessibility.pause_slideshow' | t }}"
              data-label-play="{{ 'accessibility.play_slideshow' | t }}"
            >
              {%- render 'icon', name: 'pause', class: 'announcement-bar__pause-icon' -%}
              {%- render 'icon', name: 'play', class: 'announcement-bar__play-icon' -%}
              <span class="visually-hidden" data-ref="pauseLabel">{{ 'accessibility.pause_slideshow' | t }}</span>
            </button>
          {%- endif -%}

        {%- when 'marquee' -%}
          <div class="announcement-bar__marquee" data-ref="track">
            <div class="announcement-bar__run">{{ items }}</div>
            <div class="announcement-bar__run" aria-hidden="true" inert>{{ items }}</div>
          </div>
          <button
            type="button"
            class="announcement-bar__button announcement-bar__pause"
            data-ref="pause"
            aria-pressed="false"
            data-label-pause="{{ 'accessibility.pause_scrolling' | t }}"
            data-label-play="{{ 'accessibility.play_scrolling' | t }}"
          >
            {%- render 'icon', name: 'pause', class: 'announcement-bar__pause-icon' -%}
            {%- render 'icon', name: 'play', class: 'announcement-bar__play-icon' -%}
            <span class="visually-hidden" data-ref="pauseLabel">{{ 'accessibility.pause_scrolling' | t }}</span>
          </button>

        {%- else -%}
          <div class="announcement-bar__static">{{ items }}</div>
      {%- endcase -%}
    </div>
  </announcement-bar>
{%- endif -%}

{%- comment -%} 3. Schema {%- endcomment -%}
{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.announcement_bar.style",
      "info": "t:sections.announcement_bar.style_info",
      "options": [
        { "value": "slideshow", "label": "t:sections.announcement_bar.style_slideshow" },
        { "value": "marquee", "label": "t:sections.announcement_bar.style_marquee" }
      ],
      "default": "slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.announcement_bar.autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:sections.announcement_bar.autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "t:sections.announcement_bar.marquee_speed",
      "info": "t:sections.announcement_bar.marquee_speed_info",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "s",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.announcement_bar.full_width",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "t:sections.announcement_bar.padding_block",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.announcement_bar.color_scheme",
      "default": "scheme-4"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement_bar.blocks.announcement.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.announcement_bar.blocks.announcement.text",
          "default": "Welcome to our store"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement_bar.blocks.announcement.link"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:sections.announcement_bar.blocks.announcement.icon",
          "info": "t:sections.announcement_bar.blocks.announcement.icon_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name",
      "blocks": [
        {
          "type": "announcement",
          "settings": { "text": "Welcome to our store" }
        }
      ]
    }
  ]
}
{% endschema %}
