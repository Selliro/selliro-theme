{%- comment -%}
  Theme features — a showcase / directory of what the theme can do.
  · Hero: eyebrow, heading (one word can be highlighted), text, headline numbers, two buttons.
  · Finder: category chips (with counts) and a live search; the result count updates as you filter.
  · Feature cards: screenshot, category, badge (New / Unique / Popular / Built-in), title, text, up to three
    highlights and a "See it live" link. Cards can be wide (two columns) to spotlight signature features.
  · Closing call to action.
  Blocks: stat, feature.   Files: assets/theme-features.js (+ shared assets/section-reveal.*)
{%- endcomment -%}
{{ 'section-theme-features.css' | asset_url | stylesheet_tag }}
{{ 'section-reveal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-reveal.js' | asset_url }}" defer></script>
<script src="{{ 'theme-features.js' | asset_url }}" defer></script>

{%- liquid
  assign stats = section.blocks | where: 'type', 'stat'
  assign features = section.blocks | where: 'type', 'feature'
  assign category_values = 'homepage,merchandising,product,storytelling,interactive,b2b,global' | split: ','
  assign category_labels = section.settings.category_labels | newline_to_br | split: '<br />'

  assign heading = section.settings.heading | escape
  assign highlight = section.settings.highlight_word | strip | escape
  if highlight != blank and heading contains highlight
    assign highlight_html = '<span class="tf__hl">' | append: highlight | append: '</span>'
    assign heading = heading | replace_first: highlight, highlight_html
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="tf {{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  data-reveal
  style="--tf-pad-top: {{ section.settings.padding_top }}px; --tf-pad-bottom: {{ section.settings.padding_bottom }}px; --tf-accent: {{ section.settings.accent_color | default: '#f8d12f' }}; --tf-card: {{ section.settings.card_color | default: '#ffffff' }}; --tf-radius: {{ section.settings.radius }}px;"
>
  {%- comment -%} ======================================================== hero {%- endcomment -%}
  {%- liquid
    assign has_hero = false
    if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank or section.settings.button_label_1 != blank or section.settings.button_label_2 != blank or stats.size > 0
      assign has_hero = true
    endif
  -%}
  {%- liquid
    assign hero_style = section.settings.hero_style | default: 'centered'
    assign hero_image = section.settings.hero_image
    if hero_style != 'centered' and hero_image == blank and hero_style == 'background'
      assign hero_style = 'banner'
    endif
    assign banner_dark = true
    if section.settings.banner_color != blank
      assign banner_brightness = section.settings.banner_color | color_brightness
      if banner_brightness > 150
        assign banner_dark = false
      endif
    endif
  -%}
  {%- capture hero_copy -%}
    {%- if section.settings.eyebrow != blank -%}
      <p class="tf__eyebrow" data-reveal-fade="first">
        <span class="tf__eyebrow-dot" aria-hidden="true"></span>
        {{- section.settings.eyebrow | escape -}}
      </p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="tf__heading" data-reveal-title>{{ heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="tf__intro rte" data-reveal-fade>{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
      <div class="tf__buttons" data-reveal-fade>
        {%- if section.settings.button_label_1 != blank -%}
          <a class="button tf__btn tf__btn--primary" href="{{ section.settings.button_link_1 | default: '#tf-finder' }}">
            {{- section.settings.button_label_1 | escape -}}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="button-secondary tf__btn tf__btn--ghost" href="{{ section.settings.button_link_2 | default: routes.root_url }}">{{ section.settings.button_label_2 | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endcapture -%}

  {%- if has_hero or hero_image != blank -%}
  <header class="tf__hero tf__hero--{{ hero_style }}">
    {%- if hero_style == 'centered' -%}
      {{ hero_copy }}
      {%- if hero_image != blank -%}
        <div class="tf__hero-media" data-reveal-rise>
          {%- assign image_alt = hero_image.alt | default: section.settings.heading -%}
          {{ hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600, 2000, 2400', sizes: '(min-width: 1200px) 1100px, 100vw', class: 'tf__hero-img', alt: image_alt }}
        </div>
      {%- endif -%}
    {%- else -%}
      <div
        class="tf__banner tf__banner--media-{{ section.settings.banner_media_position }}{% if banner_dark %} tf__banner--dark{% else %} tf__banner--light{% endif %}"
        style="{% if section.settings.banner_color != blank %}--tf-banner: {{ section.settings.banner_color }};{% endif %} --tf-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
        data-reveal-rise
      >
        {%- if hero_style == 'background' -%}
          <div class="tf__banner-bg" aria-hidden="true">
            {{ hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', alt: '' }}
          </div>
        {%- else -%}
          <span class="tf__banner-glow" aria-hidden="true"></span>
        {%- endif -%}
        <div class="tf__banner-copy">{{ hero_copy }}</div>
        {%- if hero_style == 'banner' and hero_image != blank -%}
          <div class="tf__banner-media">
            {%- assign image_alt = hero_image.alt | default: section.settings.heading -%}
            {{ hero_image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 990px) 55vw, 100vw', class: 'tf__banner-img', alt: image_alt }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if stats.size > 0 -%}
      <dl class="tf__stats" data-reveal-fade style="--tf-stats: {{ stats.size }};">
        {%- for block in stats -%}
          <div class="tf__stat" {{ block.shopify_attributes }}>
            <dt class="tf__stat-label">{{ block.settings.label | escape }}</dt>
            <dd class="tf__stat-value">{{ block.settings.value | escape }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </header>
  {%- endif -%}

  {%- comment -%} ======================================================== finder {%- endcomment -%}
  {%- if features.size > 0 or request.design_mode -%}
  <theme-features class="tf__finder" id="tf-finder" data-empty-text="{{ section.settings.empty_text | escape }}" data-count-text="{{ section.settings.count_text | escape }}">
    <div class="tf__toolbar">
      <div class="tf__chips" role="toolbar" aria-label="{{ section.settings.filter_label | escape }}">
        <button type="button" class="tf__chip is-active" data-tf-filter="all" aria-pressed="true">
          {{- section.settings.all_label | escape -}}
          <span class="tf__chip-count">{{ features.size }}</span>
        </button>
        {%- for value in category_values -%}
          {%- assign in_cat = 0 -%}
          {%- for f in features -%}
            {%- if f.settings.category == value -%}{%- assign in_cat = in_cat | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          {%- if in_cat > 0 -%}
            {%- assign label = category_labels[forloop.index0] | strip | default: value -%}
            <button type="button" class="tf__chip" data-tf-filter="{{ value }}" aria-pressed="false">
              {{- label | escape -}}
              <span class="tf__chip-count">{{ in_cat }}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <label class="tf__search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <span class="visually-hidden">{{ section.settings.search_placeholder | escape }}</span>
        <input type="search" class="tf__search-input" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off" data-tf-search>
      </label>
    </div>
    <p class="tf__count" data-tf-count aria-live="polite"></p>

    {%- if features.size == 0 -%}
      <p class="tf__empty">Add feature blocks to build the showcase.</p>
    {%- endif -%}

    <ul class="tf__grid" role="list" data-tf-grid>
      {%- for block in features -%}
        {%- liquid
          assign cat_index = 0
          for value in category_values
            if value == block.settings.category
              assign cat_index = forloop.index0
            endif
          endfor
          assign cat_label = category_labels[cat_index] | strip | default: block.settings.category
          assign lines = block.settings.highlights | newline_to_br | split: '<br />'
          assign search_text = block.settings.title | append: ' ' | append: block.settings.text | append: ' ' | append: block.settings.highlights | append: ' ' | append: cat_label | downcase | strip_newlines | escape
        -%}
        <li
          class="tf__card{% if block.settings.size == 'wide' %} tf__card--wide{% endif %}"
          data-tf-card
          data-category="{{ block.settings.category }}"
          data-search="{{ search_text }}"
          data-reveal-card
          {{ block.shopify_attributes }}
        >
          <a class="tf__card-link" href="{{ block.settings.link | default: '#' }}"{% if block.settings.link == blank %} tabindex="-1" aria-hidden="true"{% endif %}>
            <span class="visually-hidden">{{ block.settings.title | escape }}</span>
          </a>
          <div class="tf__media">
            {%- if block.settings.image != blank -%}
              {%- if block.settings.size == 'wide' -%}
                {%- assign image_alt = block.settings.image.alt | default: block.settings.title -%}
                {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 66vw, 100vw', class: 'tf__img', alt: image_alt }}
              {%- else -%}
                {%- assign image_alt = block.settings.image.alt | default: block.settings.title -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', class: 'tf__img', alt: image_alt }}
              {%- endif -%}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'tf__placeholder' }}
            {%- endif -%}
            <span class="tf__tag">{{ cat_label | escape }}</span>
            {%- if block.settings.badge != 'none' -%}
              <span class="tf__badge tf__badge--{{ block.settings.badge }}">
                {%- case block.settings.badge -%}
                  {%- when 'new' -%}{{ section.settings.badge_new | escape }}
                  {%- when 'unique' -%}{{ section.settings.badge_unique | escape }}
                  {%- when 'popular' -%}{{ section.settings.badge_popular | escape }}
                  {%- when 'builtin' -%}{{ section.settings.badge_builtin | escape }}
                {%- endcase -%}
              </span>
            {%- endif -%}
          </div>
          <div class="tf__body">
            {%- if block.settings.title != blank -%}
              <h2 class="tf__title">{{ block.settings.title | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="tf__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.highlights != blank -%}
              <ul class="tf__points" role="list">
                {%- for line in lines limit: 3 -%}
                  {%- assign line = line | strip -%}
                  {%- if line != blank -%}
                    <li>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {{ line | escape }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if block.settings.link != blank and section.settings.link_label != blank -%}
              <span class="tf__more" aria-hidden="true">
                {{- section.settings.link_label | escape -}}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    <p class="tf__empty" data-tf-empty hidden></p>
  </theme-features>
  {%- endif -%}

  {%- comment -%} ======================================================== closing CTA {%- endcomment -%}
  {%- if section.settings.cta_heading != blank -%}
    <div class="tf__cta" data-reveal-rise>
      <div class="tf__cta-copy">
        <h2 class="tf__cta-heading">{{ section.settings.cta_heading | escape }}</h2>
        {%- if section.settings.cta_text != blank -%}
          <p class="tf__cta-text">{{ section.settings.cta_text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.cta_label != blank -%}
        <a class="tf__cta-btn" href="{{ section.settings.cta_link | default: routes.root_url }}">
          {{- section.settings.cta_label | escape -}}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>


{% schema %}
{
  "name": "Theme features",
  "tag": "div",
  "class": "tf-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "select",
      "id": "hero_style",
      "label": "Hero style",
      "options": [
        {
          "value": "centered",
          "label": "Centered"
        },
        {
          "value": "banner",
          "label": "Banner with image"
        },
        {
          "value": "background",
          "label": "Background image"
        }
      ],
      "default": "centered",
      "info": "Banner with image: text beside the image on a colored banner. Background image: the image fills the banner."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "A transparent PNG (e.g. device mockups) works best for \"Banner with image\"."
    },
    {
      "type": "select",
      "id": "banner_media_position",
      "label": "Image position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right",
      "visible_if": "{{ section.settings.hero_style == 'banner' }}"
    },
    {
      "type": "color",
      "id": "banner_color",
      "label": "Banner color",
      "default": "#161616",
      "info": "Text turns white on dark colors.",
      "visible_if": "{{ section.settings.hero_style == 'banner' }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55,
      "visible_if": "{{ section.settings.hero_style == 'background' }}"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Theme features"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything your store needs to sell more"
    },
    {
      "type": "text",
      "id": "highlight_word",
      "label": "Highlighted words",
      "default": "sell more",
      "info": "Part of the heading to underline with the accent color."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Explore every section, block and tool built into the theme.</p>"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "First button",
      "default": "Explore features"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link",
      "info": "Leave empty to jump to the feature finder."
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button",
      "default": "View the live store"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Feature finder"
    },
    {
      "type": "textarea",
      "id": "category_labels",
      "label": "Category names",
      "default": "Homepage & hero\nMerchandising\nProduct page\nStorytelling\nInteractive & quizzes\nWholesale & B2B\nStore-wide",
      "info": "One per line, in this order: home page, merchandising, product page, storytelling, interactive, wholesale, store-wide."
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "\"All\" filter",
      "default": "All features"
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter label (screen readers)",
      "default": "Filter features by category"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search features"
    },
    {
      "type": "text",
      "id": "count_text",
      "label": "Result count",
      "default": "Showing [count] of [total] features",
      "info": "[count] and [total] are replaced with numbers."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "No results message",
      "default": "No features match your search. Try another word or category."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Card link label",
      "default": "See it live"
    },
    {
      "type": "text",
      "id": "badge_new",
      "label": "\"New\" badge",
      "default": "New"
    },
    {
      "type": "text",
      "id": "badge_unique",
      "label": "\"Unique\" badge",
      "default": "Unique"
    },
    {
      "type": "text",
      "id": "badge_popular",
      "label": "\"Popular\" badge",
      "default": "Popular"
    },
    {
      "type": "text",
      "id": "badge_builtin",
      "label": "\"Built-in\" badge",
      "default": "Built-in"
    },
    {
      "type": "header",
      "content": "Closing call to action"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Heading",
      "default": "Ready to build your store?"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Text",
      "default": "Every feature is editable in the theme editor: no code, no apps."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Start shopping"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#f8d12f"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Headline number",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Number",
          "default": "40+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "sections & blocks"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Screenshot"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Feature name"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "What it does and why it helps you sell."
        },
        {
          "type": "textarea",
          "id": "highlights",
          "label": "Highlights",
          "info": "One per line. The first three are shown."
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            { "value": "homepage", "label": "Home page and hero" },
            { "value": "merchandising", "label": "Merchandising" },
            { "value": "product", "label": "Product page" },
            { "value": "storytelling", "label": "Storytelling" },
            { "value": "interactive", "label": "Interactive and quizzes" },
            { "value": "b2b", "label": "Wholesale and B2B" },
            { "value": "global", "label": "Store-wide" }
          ],
          "default": "homepage"
        },
        {
          "type": "select",
          "id": "badge",
          "label": "Badge",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "new", "label": "New" },
            { "value": "unique", "label": "Unique" },
            { "value": "popular", "label": "Popular" },
            { "value": "builtin", "label": "Built-in" }
          ],
          "default": "none"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Card size",
          "options": [
            { "value": "normal", "label": "Normal" },
            { "value": "wide", "label": "Wide (spotlight)" }
          ],
          "default": "normal"
        },
        {
          "type": "url",
          "id": "link",
          "label": "\"See it live\" link"
        }
      ]
    }
  ],
  "presets": [
