      {
        "type": "header",
        "content": "Content Settings"
      },
      {
        "type": "checkbox",
        "id": "split_content",
        "label": "Split content",
        "default": true
      },
      {
        "type": "range",
        "id": "left_column_width",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 40,
        "label": "Left column width",
        "unit": "%",
        "visible_if": "{{ section.settings.split_content }}"
      },
      {
        "type": "select",
        "id": "left_column_content_alignment",
        "label": "Left column content alignment",
        "default": "start",
        "options": [
          { "value": "start", "label": "Top" },
          { "value": "center", "label": "Center" },
          { "value": "end", "label": "Bottom" }
