      },
      {
        "type": "text",
        "id": "background_color",
        "label": "Background Color",
        "default": "#092846"
      },
      {
        "type": "checkbox",
        "id": "show_overlay",
        "label": "Show solid overlay",
        "default": false,
        "info": "Dark overlay for better text readability"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 10,
        "label": "Overlay opacity",
        "unit": "%"
      },
      {
        "type": "text",
        "id": "max_height",
        "label": "Banner height",
        "info": "Max height of the banner in pixels",
        "default": "600",
        "visible_if": "{{ section.settings.background_type == 'color' }}"
      },
      {
        "type": "text",
        "id": "max_height_mobile",
        "label": "Banner height mobile",
        "info": "Height of the banner in pixels for mobile",
        "default": "600",
        "visible_if": "{{ section.settings.background_type == 'color' }}"
      },
      {
        "type": "text",
        "id": "image_aspect_ratio_desktop",
        "label": "Image aspect ratio (desktop)",
        "info": "Enter a decimal, e.g., 1.8",
        "default": "1.8",
        "visible_if": "{{ section.settings.background_type == 'image' }}"
      },
      {
        "type": "text",
        "id": "image_aspect_ratio_mobile",
        "label": "Image aspect ratio (mobile)",
        "info": "Enter a decimal, e.g., 0.48",
        "default": "0.48",
        "visible_if": "{{ section.settings.background_type == 'image' }}"
      },
      {
        "type": "checkbox",
        "id": "show_gradient_overlay",
        "label": "Show gradient overlay",
        "default": false,
        "info": "Gradient from bottom to top"
