{%- comment -%}
  Image Banner Section
  
  Flexible banner with:
  - Background: Image, Color, or 50/50 Split
  - Block-based content (breadcrumb, caption, heading, subheading, image, buttons)
  - Left/Right positioning
  - Responsive mobile/desktop images
{%- endcomment -%}

{%- liquid
    assign background_type = section.settings.background_type | default: 'image'
    assign background_color = section.settings.background_color | default: '#092846'
    assign image_desktop = section.settings.image_desktop
    assign image_mobile = section.settings.image_mobile
    assign max_height = section.settings.max_height
    assign max_height_mobile = section.settings.max_height_mobile
  -%}
  {% comment %} <style>
    #{{section.id}}.content-card {
      max-width: 1440px;
      margin: auto;
    }

  </style> {% endcomment %}

<style>
  #{{ section.id }} .content-card__content-wrapper {
    padding-top: {{ section.settings.add_top_padding_mobile }}px;
    padding-bottom: {{ section.settings.add_bottom_padding_mobile }}px;
  }
  {% if section.settings.background_type == 'color' %}
    #{{ section.id }} {
      height: {{ max_height_mobile }}px;
    }
  {% endif %}
  @media(min-width: 1024px) {
    #{{ section.id }} .content-card__content-wrapper {
      padding-top: {{ section.settings.add_top_padding_desktop }}px;
      padding-bottom: {{ section.settings.add_bottom_padding_desktop }}px;
    }
    {% if section.settings.split_content %}
      #{{ section.id }} .content-card__content > div:first-child {
          width: {{ section.settings.left_column_width }}%;
      }
      #{{ section.id }} .content-card__content > div:last-child {
          width: {{ 100 |  minus: section.settings.left_column_width }}%;
      }
    {% endif %}
    {% if section.settings.background_type == 'color' %}
      #{{ section.id }} {
        height: {{ max_height }}px;
      }
    {% endif %}
  }
</style>

{% capture section_content %}
  {%- comment -%} Left Content Column {%- endcomment -%}
  <div class="content-card__content-wrapper tw-absolute tw-inset-0 tw-h-full tw-flex
    {% if section.settings.split_content %}tw-items-start md:tw-items-center{% else %}tw-items-{{section.settings.content_alignment}}{% endif %}
  ">
    <div class="section-container section-container--wide content-card__container tw-w-full{% if section.settings.split_content %} tw-h-full{% endif %}">
      <div class="content-card__content tw-flex tw-justify-between tw-flex-col {% if section.settings.split_content %} tw-h-full 
        md:tw-flex-row md:tw-items-{% if section.blocks.first.id contains 'parent_rich_text_' %}{{section.settings.right_column_content_alignment}}{% else %}{{section.settings.left_column_content_alignment}}{% endif %}{% endif %} tw-gap-8
      ">
        {% for block in section.blocks %}
          <div class="content-card__block tw-items-{% if forloop.first %}{{section.settings.left_column_content_alignment}}{% else %}{{section.settings.right_column_content_alignment}}{% endif %}{% if block.id contains 'parent_rich_text_' %} md:tw-flex md:tw-h-full tw-overflow-hidden {% endif %}">
            {% render block %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endcapture %}

  <div id="{{section.id}}" class=" tw-relative tw-w-full tw-overflow-hidden"{% if max_height != blank and background_type == 'color' %} style="height: {{ max_height }}px; max-height: {{ max_height }}px;"{% endif %}>   

  {%- comment -%} Background Layer {%- endcomment -%}
    {%- case background_type -%}
      
      {%- when 'color' -%}
        <div class="banner-layout-color__background tw-absolute tw-inset-0" style="background-color: {{ background_color }};"></div>
      
      {%- else -%}
        {%- comment -%} Image Background {%- endcomment -%}
        {%- render 'content-card-background-image', 
          image_desktop: image_desktop,
          image_mobile: image_mobile,
          show_overlay: section.settings.show_overlay,
          overlay_opacity: section.settings.overlay_opacity,
          show_gradient_overlay: section.settings.show_gradient_overlay,
          image_aspect_ratio: section.settings.image_aspect_ratio_desktop | plus:0,
          image_aspect_ratio_mobile: section.settings.image_aspect_ratio_mobile | plus:0,
        -%}
    {%- endcase -%}

    <div class="content-card__blocks">
      {{ section_content }}
    </div>

  </div>

{%  schema  %} 
