        "visible_if": "{{ section.settings.split_content }}"
      },
      {
        "type": "select",
        "id": "right_column_content_alignment",
        "label": "Right column content alignment",
        "default": "end",
        "options": [
          { "value": "start", "label": "Top" },
          { "value": "center", "label": "Center" },
          { "value": "end", "label": "Bottom" }
        ],
        "visible_if": "{{ section.settings.split_content }}"
      },
      {
        "type": "select",
        "id": "content_alignment",
        "label": "Content alignment",
        "default": "start",
        "options": [
          { "value": "start", "label": "Top" },
          { "value": "center", "label": "Center" },
          { "value": "end", "label": "Bottom" }
        ],
        "visible_if": "{{ section.settings.split_content == false }}"
      },
