{%- comment -%}
  Store locator — find a store or stockist: search, store-type filters, "Use my location", a list of store cards
  and a map of the selected store.
  · Left panel: search (name, address, city, postcode, services), type pills, live result count, store cards.
    The selected card opens to show opening hours (today highlighted), services and Directions / Call / Email.
  · Right: Google Maps embed of the selected store (no API key needed) with a floating card, or hidden
    when "Show map" is off.
  · "Use my location" (needs latitude/longitude on the stores): sorts by distance, shows "2.4 km away" and
    selects the nearest. Open / closed status is read from each store's opening hours (visitor's clock).
  Blocks: store.
  Files:  assets/section-store-locator.css (styles), assets/section-store-locator.js (<store-locator>),
          shared assets/section-reveal.css + .js (scroll-in animation).
  Order:  1. CSS   2. Liquid (data + markup)   3. Schema
{%- endcomment -%}

{%- comment -%} ============================================================== 1. CSS {%- endcomment -%}
{{ 'section-store-locator.css' | asset_url | stylesheet_tag }}
{{ 'section-reveal.css' | asset_url | stylesheet_tag }}

{%- comment -%} Values that come from this section's settings (the rest is in section-store-locator.css) {%- endcomment -%}
{% style %}
  #shopify-section-{{ section.id }} .sl {
    --sl-pad-top: {{ section.settings.padding_top }}px;
    --sl-pad-bottom: {{ section.settings.padding_bottom }}px;
    --sl-accent: {{ section.settings.accent_color | default: '#f8d12f' }};
    --sl-radius: {{ section.settings.radius }}px;
    --sl-map-height: {{ section.settings.map_height }}px;
  }
{% endstyle %}

{%- comment -%} =========================================================== 2. Liquid {%- endcomment -%}
<script src="{{ 'section-reveal.js' | asset_url }}" defer></script>
<script src="{{ 'section-store-locator.js' | asset_url }}" defer></script>

{%- liquid
  assign stores = section.blocks | where: 'type', 'store'
  assign store_count = stores.size

  # Store types for the filter pills, in the order they first appear ("@@Flagship store@@Stockist@@")
  assign types = '@@'
  for block in stores
    assign t = block.settings.store_type | strip
    if t != blank
      assign key = '@@' | append: t | append: '@@'
      unless types contains key
        assign types = types | append: t | append: '@@'
      endunless
    endif
  endfor
  assign type_list = types | remove_first: '@@' | split: '@@'

  assign zoom = section.settings.map_zoom | default: 14
  assign show_map = section.settings.show_map
  if store_count == 0
    assign show_map = false
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<store-locator
  class="sl color-{{ section.settings.color_scheme }}{% unless show_map %} sl--no-map{% endunless %}"
  data-unit="{{ section.settings.distance_unit }}"
  data-total="{{ store_count }}"
  data-showing="{{ 'store_locator.showing_js' | t }}"
  data-showing-one="{{ 'store_locator.showing_one_js' | t }}"
  data-distance="{% if section.settings.distance_unit == 'mi' %}{{ 'store_locator.distance_mi' | t }}{% else %}{{ 'store_locator.distance_km' | t }}{% endif %}"
  data-open-now="{{ 'store_locator.open_now' | t }}"
  data-closes-at="{{ 'store_locator.closes_at' | t }}"
  data-opens-at="{{ 'store_locator.opens_at' | t }}"
  data-closed-now="{{ 'store_locator.closed_now' | t }}"
  data-locating="{{ 'store_locator.locating' | t }}"
  data-locate-error="{{ 'store_locator.location_error' | t }}"
  data-locate-unsupported="{{ 'store_locator.location_unsupported' | t }}"
  data-sorted="{{ 'store_locator.sorted_nearest' | t }}"
  data-map-title="{{ 'store_locator.map_title_js' | t }}"
  data-reveal
>
  <div class="sl__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <header class="sl__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sl__eyebrow" data-reveal-fade>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sl__title" data-reveal-title>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="sl__text rte" data-reveal-fade>{{ section.settings.text }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="sl__shell" data-reveal-card>
      {%- comment -%} -------------------------------------------------------------- panel {%- endcomment -%}
      <div class="sl__panel">
        {%- if section.settings.show_search or section.settings.show_locate -%}
          <div class="sl__tools">
            {%- if section.settings.show_search -%}
              <label class="sl__search">
                <span class="visually-hidden">{{ 'store_locator.search_label' | t }}</span>
                <svg class="sl__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                <input
                  class="sl__search-input"
                  type="search"
                  autocomplete="off"
                  placeholder="{{ 'store_locator.search_placeholder' | t }}"
                  data-sl-search
                >
              </label>
            {%- endif -%}
            {%- if section.settings.show_locate -%}
              <button type="button" class="sl__locate" data-sl-locate>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1.8"/></svg>
                <span>{{ 'store_locator.use_location' | t }}</span>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_filters and type_list.size > 1 -%}
          <div class="sl__filters" role="group" aria-label="{{ 'store_locator.filter_label' | t }}">
            <button type="button" class="sl__filter" data-sl-filter="" aria-pressed="true">
              {{- 'store_locator.all' | t -}}
            </button>
            {%- for t in type_list -%}
              {%- assign type_name = t -%}
              <button type="button" class="sl__filter" data-sl-filter="{{ type_name | handleize }}" aria-pressed="false">
                {{- type_name | escape -}}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <p class="sl__status" data-sl-status aria-live="polite">
          {{- 'store_locator.stores_count' | t: count: store_count -}}
        </p>

        <ul class="sl__list list-unstyled" role="list" data-sl-list>
          {%- for block in stores -%}
            {%- liquid
              assign s = block.settings
              assign lat = s.latitude | strip
              assign lng = s.longitude | strip
              assign address_one_line = s.address | strip | newline_to_br | replace: '<br />', ', ' | strip_newlines | replace: ',,', ','
              if s.map_query != blank
                assign map_q = s.map_query
              elsif lat != blank and lng != blank
                assign map_q = lat | append: ',' | append: lng
              else
                assign map_q = s.name | append: ', ' | append: address_one_line
              endif
              assign phone_link = s.phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '.', ''
              assign search_text = s.name | append: ' ' | append: address_one_line | append: ' ' | append: s.store_type | append: ' ' | append: s.services | downcase
              assign hours_lines = s.hours | newline_to_br | split: '<br />'
            -%}
            <li
              class="sl__item"
              data-sl-item
              data-index="{{ forloop.index0 }}"
              data-type="{{ s.store_type | strip | handleize }}"
              data-search="{{ search_text | escape }}"
              data-lat="{{ lat | escape }}"
              data-lng="{{ lng | escape }}"
              data-map="https://maps.google.com/maps?q={{ map_q | url_encode }}&z={{ zoom }}&output=embed"
              data-directions="https://www.google.com/maps/dir/?api=1&destination={{ map_q | url_encode }}"
              data-name="{{ s.name | escape }}"
              data-address="{{ address_one_line | escape }}"
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="sl-card"
                data-sl-select
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="StoreDetails-{{ block.id }}"
              >
                <span class="sl-card__media" aria-hidden="true">
                  {%- if s.image != blank -%}
                    {{
                      s.image
                      | image_url: width: 240
                      | image_tag: widths: '120, 180, 240', sizes: '80px', loading: 'lazy', alt: '', class: 'sl-card__image'
                    }}
                  {%- else -%}
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M4 9.5 5.6 4h12.8L20 9.5M4 9.5h16M4 9.5v.5a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0v-.5M5.5 12.5V20h13v-7.5M10 20v-4.5h4V20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- endif -%}
                </span>
                <span class="sl-card__body">
                  <span class="sl-card__top">
                    {%- if s.store_type != blank -%}
                      <span class="sl-card__type">{{ s.store_type | escape }}</span>
                    {%- endif -%}
                    {%- if s.badge != blank -%}
                      <span class="sl-card__badge">{{ s.badge | escape }}</span>
                    {%- endif -%}
                  </span>
                  <span class="sl-card__name">{{ s.name | escape }}</span>
                  <span class="sl-card__address">{{ s.address | escape | newline_to_br }}</span>
                  <span class="sl-card__meta">
                    <span class="sl-card__open" data-sl-open hidden></span>
                    <span class="sl-card__distance" data-sl-distance hidden></span>
                  </span>
                </span>
                <span class="sl-card__chevron" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </button>

              <div class="sl-details" id="StoreDetails-{{ block.id }}" data-sl-details>
                <div class="sl-details__inner">
                  {%- if s.hours != blank -%}
                    <div class="sl-details__block">
                      <p class="sl-details__label">{{ 'store_locator.hours' | t }}</p>
                      <ul class="sl-hours list-unstyled" role="list" data-sl-hours>
                        {%- for line in hours_lines -%}
                          {%- assign line = line | strip -%}
                          {%- if line == blank -%}{%- continue -%}{%- endif -%}
                          {%- assign parts = line | split: ': ' -%}
                          {%- if parts.size > 1 -%}
                            {%- assign days = parts | first -%}
                            {%- assign times = line | remove_first: days | remove_first: ': ' -%}
                          {%- else -%}
                            {%- assign days = line -%}
                            {%- assign times = '' -%}
                          {%- endif -%}
                          <li class="sl-hours__row" data-days="{{ days | escape }}" data-times="{{ times | escape }}">
                            <span class="sl-hours__days">{{ days | escape }}</span>
                            <span class="sl-hours__times">{{ times | escape }}</span>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}

                  {%- assign services = s.services | split: ',' -%}
                  {%- if s.services != blank -%}
                    <div class="sl-details__block">
                      <p class="sl-details__label">{{ 'store_locator.services' | t }}</p>
                      <ul class="sl-services list-unstyled" role="list">
                        {%- for service in services -%}
                          {%- assign service = service | strip -%}
                          {%- if service != blank -%}
                            <li class="sl-services__item">{{ service | escape }}</li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}

                  <div class="sl-details__actions">
                    <a
                      class="sl-details__action sl-details__action--primary"
                      href="https://www.google.com/maps/dir/?api=1&destination={{ map_q | url_encode }}"
                      target="_blank"
                      rel="noopener"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.3" stroke="currentColor" stroke-width="1.8"/></svg>
                      {{- 'store_locator.directions' | t -}}
                      <span class="visually-hidden">{{ 'store_locator.opens_new_tab' | t }}</span>
                    </a>
                    {%- if s.phone != blank -%}
                      <a class="sl-details__action" href="tel:{{ phone_link }}">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.6 3.5h2.6l1.4 4-2 1.3a11 11 0 0 0 6.6 6.6l1.3-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                        {{ s.phone | escape }}
                      </a>
                    {%- endif -%}
                    {%- if s.email != blank -%}
                      <a class="sl-details__action" href="mailto:{{ s.email | escape }}">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                        {{- 'store_locator.email' | t -}}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <div class="sl__empty" data-sl-empty hidden>
          <p class="sl__empty-title">{{ 'store_locator.no_results' | t }}</p>
          <p class="sl__empty-text">{{ 'store_locator.no_results_text' | t }}</p>
          <button type="button" class="sl__empty-clear" data-sl-clear>{{ 'store_locator.clear' | t }}</button>
        </div>

        {%- if store_count == 0 -%}
          <div class="sl__empty">
            <p class="sl__empty-title">{{ 'store_locator.empty_title' | t }}</p>
            <p class="sl__empty-text">{{ 'store_locator.empty_text' | t }}</p>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------------------------------------------------------------- map {%- endcomment -%}
      {%- if show_map -%}
        {%- liquid
          assign first = stores.first.settings
          assign first_lat = first.latitude | strip
          assign first_lng = first.longitude | strip
          if first.map_query != blank
            assign first_q = first.map_query
          elsif first_lat != blank and first_lng != blank
            assign first_q = first_lat | append: ',' | append: first_lng
          else
            assign first_q = first.name | append: ', ' | append: first.address | strip_newlines
          endif
          assign first_address = first.address | strip | newline_to_br | replace: '<br />', ', ' | strip_newlines | replace: ',,', ','
        -%}
        <div class="sl__map" data-sl-map-wrap>
          <iframe
            class="sl__map-frame"
            data-sl-map
            src="https://maps.google.com/maps?q={{ first_q | url_encode }}&z={{ zoom }}&output=embed"
            title="{{ 'store_locator.map_title' | t: store: first.name | escape }}"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <div class="sl__map-card" data-sl-map-card>
            <span class="sl__map-card-pin" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" fill="currentColor"/><circle cx="12" cy="10" r="2.4" fill="#fff"/></svg>
            </span>
            <span class="sl__map-card-text">
              <span class="sl__map-card-name" data-sl-map-name>{{ first.name | escape }}</span>
              <span class="sl__map-card-address" data-sl-map-address>{{ first_address | escape }}</span>
            </span>
            <a
              class="sl__map-card-link"
              data-sl-map-directions
              href="https://www.google.com/maps/dir/?api=1&destination={{ first_q | url_encode }}"
              target="_blank"
              rel="noopener"
            >
              {{- 'store_locator.directions' | t -}}
              <span class="visually-hidden">{{ 'store_locator.opens_new_tab' | t }}</span>
            </a>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</store-locator>

{%- comment -%} =========================================================== 3. Schema {%- endcomment -%}
{% schema %}
{
  "name": "Store locator",
  "tag": "section",
  "class": "store-locator-section",
  "max_blocks": 40,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Visit us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find a Whispo store near you"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Try our bestsellers in person, book a free skin consultation and pick up online orders at our stores and partner spas.</p>"
    },
    {
      "type": "header",
      "content": "Search and filters"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_locate",
      "label": "Show \"Use my location\"",
      "info": "Sorts stores by distance. Needs a latitude and longitude on each store.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show store type filters",
      "info": "Shown when stores have two or more different store types.",
      "default": true
    },
    {
      "type": "select",
      "id": "distance_unit",
      "label": "Distance unit",
      "options": [
        { "value": "km", "label": "Kilometers" },
        { "value": "mi", "label": "Miles" }
      ],
      "default": "km"
    },
    {
      "type": "header",
      "content": "Map"
    },
    {
      "type": "checkbox",
      "id": "show_map",
      "label": "Show map",
      "info": "Google Maps. It shows the store that is selected in the list.",
      "default": true
    },
    {
      "type": "range",
      "id": "map_zoom",
      "label": "Map zoom",
      "min": 8,
      "max": 19,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "map_height",
      "label": "Height on desktop",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Selected store, badges and the \"open now\" dot.",
      "default": "#f8d12f"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Store name",
          "default": "Whispo store"
        },
        {
          "type": "text",
          "id": "store_type",
          "label": "Store type",
          "info": "For example Flagship store, Stockist or Partner spa. Stores with the same type are grouped in the filters.",
          "default": "Whispo store"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Optional, for example New or Click and collect."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "12 Market Street\nLondon W1F 7AB"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "textarea",
          "id": "hours",
          "label": "Opening hours",
          "info": "One line per day or range, for example \"Mon–Fri: 09:00–19:00\" or \"Sun: Closed\". Used for the open / closed status.",
          "default": "Mon–Fri: 09:00–19:00\nSat: 10:00–18:00\nSun: Closed"
        },
        {
          "type": "text",
          "id": "services",
          "label": "Services",
          "info": "Separate with commas, for example Skin consultation, Gift wrapping."
        },
        {
          "type": "header",
          "content": "Location"
        },
        {
          "type": "text",
          "id": "latitude",
          "label": "Latitude",
          "info": "For distance sorting and an exact map pin, for example 51.5136. In Google Maps, right-click the store and copy the numbers."
        },
        {
          "type": "text",
          "id": "longitude",
          "label": "Longitude",
          "info": "For example -0.1386."
        },
        {
          "type": "text",
          "id": "map_query",
          "label": "Map search",
          "info": "Optional. What the map looks up instead of the address, for example the store's Google Maps name."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store locator",
      "blocks": [
        {
          "type": "store",
          "settings": {
            "name": "Whispo Flagship Soho",
            "store_type": "Flagship store",
            "badge": "Skin lab",
            "address": "21 Greek Street\nLondon W1D 4DZ",
            "phone": "+44 20 7946 0123",
            "hours": "Mon–Sat: 10:00–20:00\nSun: 12:00–18:00",
            "services": "Free skin consultation, Facials, Click & collect",
            "latitude": "51.5139",
            "longitude": "-0.1316"
          }
        },
        {
          "type": "store",
