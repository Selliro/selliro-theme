{%- comment -%}
  Routine steps — a carousel of how-to steps (Cleanse → Tone → Serum → Moisturise).
  The centred card grows and shows its text; swipe, arrows or the dots move between steps.
{%- endcomment -%}
{{ 'section-reveal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-reveal.js' | asset_url }}" defer></script>
<script src="{{ 'pdp.js' | asset_url }}" defer></script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="pdp-routine color-{{ section.settings.color_scheme }} pdp-routine--{{ section.settings.layout | default: 'carousel' }}"
  data-reveal
  style="--pdp-rt-pad-top: {{ section.settings.padding_top }}px; --pdp-rt-pad-bottom: {{ section.settings.padding_bottom }}px; --pdp-rt-radius: {{ section.settings.card_radius }}px; --pdp-rt-accent: {{ section.settings.accent_color | default: '#f8d12f' }};"
>
  {%- assign rt_layout = section.settings.layout | default: 'stepper' -%}
  {%- unless rt_layout == 'stepper' -%}
  <header class="pdp-routine__header page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pdp-routine__eyebrow" data-reveal-fade="first">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="pdp-routine__heading" data-reveal-title>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </header>
  {%- endunless -%}

  {%- if rt_layout == 'stepper' -%}
    {%- render 'pdp-routine-stepper', section: section, product: product -%}
  {%- elsif rt_layout == 'grid' -%}
    <ol class="pdp-routine__grid page-width list-unstyled" style="--pdp-rt-count: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        <li class="pdp-routine__gcard" data-reveal-card {{ block.shopify_attributes }}>
          <div class="pdp-routine__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 540, 800', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.image.alt }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag }}
            {%- endif -%}
            <span class="pdp-routine__step">{{ section.settings.step_label | escape }} {{ forloop.index }}</span>
          </div>
          <div class="pdp-routine__gcopy">
            <span class="pdp-routine__gnum" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="pdp-routine__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="pdp-routine__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  {%- else -%}
  <pdp-routine class="pdp-routine__carousel" data-start="{{ section.settings.start_step | minus: 1 }}" data-reveal-rise>
    <ol class="pdp-routine__track list-unstyled" data-pdp-routine-track>
      {%- for block in section.blocks -%}
        <li class="pdp-routine__card" data-pdp-routine-card {{ block.shopify_attributes }}>
          <div class="pdp-routine__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 26vw, 72vw', alt: block.settings.image.alt }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag }}
            {%- endif -%}
            <span class="pdp-routine__step">{{ section.settings.step_label | escape }} {{ forloop.index }}</span>
          </div>
          <div class="pdp-routine__copy">
            <h3 class="pdp-routine__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="pdp-routine__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.blocks.size > 1 -%}
      <div class="pdp-routine__nav page-width">
        <button type="button" class="pdp-routine__arrow" data-pdp-routine-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="pdp-routine__dots">
          {%- for block in section.blocks -%}
            <button type="button" class="pdp-routine__dot" data-pdp-routine-dot aria-label="{{ section.settings.step_label | escape }} {{ forloop.index }}: {{ block.settings.title | escape }}"></button>
          {%- endfor -%}
        </div>
        <button type="button" class="pdp-routine__arrow" data-pdp-routine-next aria-label="{{ 'accessibility.slideshow_next' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    {%- endif -%}
  </pdp-routine>
  {%- endif -%}
</section>

{% stylesheet %}
  .pdp-routine {
    position: relative;
    padding-block: var(--pdp-rt-pad-top) var(--pdp-rt-pad-bottom);
    overflow: hidden;
  }

  .pdp-routine__header {
    margin-block-end: clamp(1.75rem, 4vw, 3rem);
    text-align: center;
  }

  .pdp-routine__eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .pdp-routine__heading {
    margin: 0;
    font-size: var(--section-title-size);
    font-weight: var(--section-title-weight);
    line-height: var(--section-title-leading);
    letter-spacing: var(--section-title-tracking);
  }

  .pdp-routine__carousel {
    display: block;
  }

  .pdp-routine__track {
    --pdp-rt-card: clamp(14rem, 62vw, 19rem);

    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.5rem);
    margin: 0;
    padding-block: 1rem;
    padding-inline: calc(50% - var(--pdp-rt-card) / 2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .pdp-routine__track::-webkit-scrollbar {
    display: none;
  }

  .pdp-routine__card {
    flex: 0 0 var(--pdp-rt-card);
    scroll-snap-align: center;
    cursor: pointer;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s ease;
    transform: scale(0.86);
    opacity: 0.55;
  }

  .pdp-routine__card.is-active {
    transform: scale(1);
    opacity: 1;
    cursor: default;
  }

  .pdp-routine__media {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: var(--pdp-rt-radius);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-foreground) 6%, transparent);
    box-shadow: 0 24px 40px -28px rgb(0 0 0 / 0.5);
  }

  .pdp-routine__media :is(img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp-routine__step {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #111;
    background: var(--pdp-rt-accent);
  }

  .pdp-routine__copy {
    padding: 1rem 0.5rem 0;
    text-align: center;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s ease 0.1s, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.1s;
  }

  .pdp-routine__card.is-active .pdp-routine__copy {
    opacity: 1;
    transform: none;
  }

  .pdp-routine__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .pdp-routine__text {
    margin: 0.35rem auto 0;
    max-width: 18rem;
    font-size: 0.875rem;
    line-height: 1.5;
    opacity: 0.75;
  }

  .pdp-routine__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-block-start: 1.25rem;
  }

  .pdp-routine__arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    color: var(--color-foreground);
    background: color-mix(in srgb, var(--color-foreground) 7%, transparent);
    cursor: pointer;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .pdp-routine__arrow:hover:not(:disabled) {
    background: color-mix(in srgb, var(--color-foreground) 14%, transparent);
  }

  .pdp-routine__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .pdp-routine__dots {
    display: flex;
    gap: 0.4rem;
  }

  .pdp-routine__dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-foreground) 22%, transparent);
    cursor: pointer;
    transition: width 0.4s ease, background-color 0.3s ease;
  }

  .pdp-routine__dot[aria-current='true'] {
    width: 1.5rem;
    background: var(--color-foreground);
  }

  /* ---- Layout: grid — every step visible, joined by a dotted line */
  .pdp-routine__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin: 0 auto;
  }

  @media screen and (min-width: 990px) {
    .pdp-routine__grid {
      grid-template-columns: repeat(min(var(--pdp-rt-count, 4), 4), minmax(0, 1fr));
      gap: 1.75rem;
    }

    /* dotted connector from each step number to the next */
    .pdp-routine__gcard:not(:last-child) .pdp-routine__gcopy::after {
      content: '';
      position: absolute;
      top: calc(1rem + 1.25rem);
      left: calc(50% + 1.25rem + 0.5rem);
      width: calc(100% + 1.75rem - 2.5rem - 1rem);
      border-top: 2px dotted color-mix(in srgb, var(--color-foreground) 25%, transparent);
    }
  }

  .pdp-routine__gcard {
    position: relative;
  }

  .pdp-routine__gcopy {
    position: relative;
    padding: 1rem 0.25rem 0;
    text-align: center;
  }

  .pdp-routine__gnum {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-block-end: 0.6rem;
    border-radius: 50%;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #111;
    background: var(--pdp-rt-accent);
    box-shadow: 0 0 0 6px var(--color-background);
  }

  .pdp-routine__gcard .pdp-routine__text {
    max-width: 16rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .pdp-routine__card,
    .pdp-routine__copy {
      transition: none;
    }
  }

  /* ================================================== Step by step guide (layout: stepper) */
  .pdp-rs {
    --rs-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --rs-line: rgb(var(--color-foreground-rgb) / 0.14);
    --rs-muted: rgb(var(--color-foreground-rgb) / 0.62);
    --rs-card: color-mix(in srgb, var(--color-background) 45%, #fff);

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'head' 'stage' 'steps';
    gap: 24px;
  }

  @media screen and (min-width: 990px) {
    .pdp-rs {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: 'stage head' 'stage steps';
      column-gap: clamp(28px, 3.2vw, 56px);
      row-gap: 24px;
      align-items: start;
    }
  }

  .pdp-rs__header {
    grid-area: head;
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    .pdp-rs__header {
      align-self: start;
      text-align: left;
      padding-top: 12px;
    }
  }

  .pdp-rs__intro {
    margin: 12px 0 0;
    max-width: 44ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--rs-muted);
  }

  @media screen and (max-width: 989px) {
    .pdp-rs__intro {
      margin-inline: auto;
    }
  }

  /* ------------------------------------------------------------------ photo stage */
  .pdp-rs__stage {
    grid-area: stage;
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 82vh;
    overflow: hidden;
    border-radius: var(--pdp-rt-radius, 24px);
    background: rgb(var(--color-foreground-rgb) / 0.06);
    box-shadow: 0 40px 80px -48px rgb(0 0 0 / 0.55);
    touch-action: pan-y;
    user-select: none;
  }

  @media screen and (min-width: 990px) {
    .pdp-rs__stage {
      /* Not sticky: the photo stays put while steps open and close */
      aspect-ratio: auto;
      width: 100%;
      height: clamp(520px, 80vh, 780px);
      max-height: none;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .pdp-rs__stage {
      aspect-ratio: 3 / 2;
    }

    .pdp-rs__header,
    .pdp-rs__steps {
      max-width: 680px;
      width: 100%;
      justify-self: center;
    }
  }

  @media screen and (max-width: 749px) {
    .pdp-rs__stage {
      aspect-ratio: 1 / 1;
      max-height: none;
    }
  }

  .pdp-rs__frames,
  .pdp-rs__frame {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .pdp-rs__frame {
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 0.8s ease, transform 1.2s var(--rs-ease);
  }

  .pdp-rs__frame.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .pdp-rs__frame :is(img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
  }

  .pdp-rs__frame.is-active img {
    animation: pdp-rs-drift calc(var(--pdp-rs-speed, 6s) * 2) ease-out both;
  }

  @keyframes pdp-rs-drift {
    from {
      transform: scale(1.04);
    }
    to {
      transform: scale(1);
    }
  }

  .pdp-rs__stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.28), transparent 22%, transparent 75%, rgb(0 0 0 / 0.22));
  }

  .pdp-rs__bars {
    position: absolute;
    z-index: 2;
    top: 16px;
    left: 16px;
    right: 16px;
    display: flex;
    gap: 6px;
  }

  .pdp-rs__bar {
    flex: 1 1 0;
    height: 3px;
    overflow: hidden;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.38);
  }

  .pdp-rs__bar i {
    display: block;
    width: 100%;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  .pdp-rs__bar.is-done i,
  .pdp-rs__bar.is-active i {
    transform: scaleX(1);
  }

  .pdp-rs.is-playing .pdp-rs__bar.is-active i {
    animation: pdp-rs-fill var(--pdp-rs-speed, 6s) linear both;
  }

  .pdp-rs.is-playing.is-paused .pdp-rs__bar.is-active i {
    animation-play-state: paused;
  }

  @keyframes pdp-rs-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .pdp-rs__chip {
    position: absolute;
    z-index: 2;
    top: 32px;
    left: 16px;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #141414;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 0 8px 20px -12px rgb(0 0 0 / 0.5);
  }

  .pdp-rs__chip-num {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 99px;
    background: var(--pdp-rt-accent, #f8d12f);
    font-size: 0.8125rem;
    letter-spacing: 0;
  }

  .pdp-rs__chip-total {
    opacity: 0.55;
    letter-spacing: 0;
  }

  .pdp-rs__arrows {
    position: absolute;
    z-index: 2;
    right: 16px;
    bottom: 16px;
    display: flex;
    gap: 8px;
  }

  .pdp-rs__arrow {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #141414;
    cursor: pointer;
    box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.6);
    transition: transform 0.3s var(--rs-ease), background 0.2s ease, opacity 0.2s ease;
  }

  .pdp-rs__arrow:hover:not(:disabled) {
    transform: scale(1.08);
    background: #fff;
  }

  .pdp-rs__arrow:disabled {
    opacity: 0.45;
    cursor: default;
  }

  /* ---------------------------------------------------------------- steps list */
  .pdp-rs__steps {
    grid-area: steps;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .pdp-rs__step {
    position: relative;
    border-radius: 20px;
    transition: background 0.35s ease, box-shadow 0.35s ease;
  }

  /* The line joining the step numbers; it fills in up to the open step */
  .pdp-rs__step:not(:last-child)::before,
  .pdp-rs__step:not(:last-child)::after {
    content: '';
    position: absolute;
    z-index: 0;
    left: 37px;
    top: 58px;
    bottom: -24px;
    width: 2px;
    border-radius: 2px;
    background: var(--rs-line);
  }

  .pdp-rs__step:not(:last-child)::after {
    background: rgb(var(--color-foreground-rgb));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.6s var(--rs-ease);
  }

  .pdp-rs__step.is-done:not(:last-child)::after {
    transform: scaleY(1);
  }

  .pdp-rs__step:hover:not(.is-active) {
    background: rgb(var(--color-foreground-rgb) / 0.035);
  }

  .pdp-rs__step.is-active {
    background: var(--rs-card);
    box-shadow: 0 24px 48px -32px rgb(0 0 0 / 0.35), 0 0 0 1px rgb(var(--color-foreground-rgb) / 0.05);
  }

  .pdp-rs__step.is-active::before,
  .pdp-rs__step.is-active::after {
    opacity: 0;
  }

  .pdp-rs__trigger {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto 20px;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 18px;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pdp-rs__trigger:focus-visible {
    outline: 2px solid rgb(var(--color-foreground-rgb));
    outline-offset: -2px;
    border-radius: 20px;
  }

  .pdp-rs__num {
    position: relative;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--rs-line);
    border-radius: 50%;
    background: var(--color-background);
    font-size: 0.9375rem;
    font-weight: 600;
    transition: background 0.35s ease, border-color 0.35s ease, color 0.35s ease, transform 0.5s var(--rs-ease);
  }

  .pdp-rs__num > * {
    grid-area: 1 / 1;
    transition: opacity 0.25s ease, transform 0.35s var(--rs-ease);
  }

  .pdp-rs__num-check {
    opacity: 0;
    transform: scale(0.4);
  }

  .pdp-rs__step.is-done .pdp-rs__num {
    border-color: rgb(var(--color-foreground-rgb));
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }

  .pdp-rs__step.is-done .pdp-rs__num-text {
    opacity: 0;
    transform: scale(0.4);
  }

  .pdp-rs__step.is-done .pdp-rs__num-check {
    opacity: 1;
    transform: none;
  }

  .pdp-rs__step.is-active .pdp-rs__num {
    border-color: transparent;
    background: var(--pdp-rt-accent, #f8d12f);
    color: #141414;
    transform: scale(1.08);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--pdp-rt-accent, #f8d12f) 28%, transparent);
  }

  .pdp-rs__head {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .pdp-rs__meta {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rs-muted);
  }

  .pdp-rs__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.2;
  }

  .pdp-rs__this {
    padding: 5px 10px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--pdp-rt-accent, #f8d12f) 35%, transparent);
    font-size: 0.6875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .pdp-rs__chev {
    display: grid;
    place-items: center;
    opacity: 0.5;
    transition: transform 0.4s var(--rs-ease), opacity 0.2s ease;
  }

  .pdp-rs__step.is-active .pdp-rs__chev {
    transform: rotate(180deg);
    opacity: 0.8;
  }

  .pdp-rs__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--rs-ease);
  }

  .pdp-rs__step.is-active .pdp-rs__panel {
    grid-template-rows: 1fr;
  }

  .pdp-rs__panel-inner {
    min-height: 0;
    overflow: hidden;
    padding-inline: 72px 22px;
  }

  .pdp-rs__step.is-active .pdp-rs__panel-inner {
    padding-bottom: 20px;
  }

  .pdp-rs__panel-inner > * {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.4s var(--rs-ease);
  }

  .pdp-rs__step.is-active .pdp-rs__panel-inner > * {
    opacity: 1;
    transform: none;
    transition-delay: 0.12s;
  }

  .pdp-rs__text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .pdp-rs__tip {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 12px 0 0;
    padding: 10px 12px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--pdp-rt-accent, #f8d12f) 16%, transparent);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .pdp-rs__tip svg {
    flex: 0 0 auto;
    margin-top: 1px;
  }

  .pdp-rs__product {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    padding: 8px 8px 8px 8px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    border-radius: 16px;
    background: var(--color-background);
  }

  .pdp-rs__product-media {
    flex: 0 0 auto;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: 12px;
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .pdp-rs__product-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp-rs__product-info {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
    color: inherit;
    text-decoration: none;
  }

  .pdp-rs__product-label {
    white-space: nowrap;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rs-muted);
  }

  .pdp-rs__product-title {
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pdp-rs__product-info:hover .pdp-rs__product-title {
    text-decoration: underline;
  }

  .pdp-rs__product-price {
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .pdp-rs__product-price s {
    margin-left: 4px;
    font-weight: 400;
    opacity: 0.5;
  }

  .pdp-rs__add {
    position: relative;
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    min-height: 38px;
    padding: 0 16px;
    border: 0;
    border-radius: 99px;
    background: var(--color-primary-button-background, #141414);
    color: var(--color-primary-button-text, #fff);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.3s var(--rs-ease), background 0.25s ease;
  }

  .pdp-rs__add:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .pdp-rs__add:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .pdp-rs__add > * {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: opacity 0.2s ease, transform 0.3s var(--rs-ease);
  }

  .pdp-rs__add-done {
    opacity: 0;
    transform: scale(0.5);
  }

  .pdp-rs__add.is-added {
    background: #2f9e5b;
  }

  .pdp-rs__add.is-added .pdp-rs__add-label {
    opacity: 0;
  }

  .pdp-rs__add.is-added .pdp-rs__add-done {
    opacity: 1;
    transform: none;
  }

  @media screen and (max-width: 749px) {
    .pdp-rs__trigger {
      grid-template-columns: 36px minmax(0, 1fr) auto 18px;
      gap: 12px;
      padding: 14px;
    }

    .pdp-rs__num {
      width: 36px;
      height: 36px;
    }

    .pdp-rs__step:not(:last-child)::before,
    .pdp-rs__step:not(:last-child)::after {
      left: 31px;
      top: 52px;
    }

    .pdp-rs__panel-inner {
      padding-inline: 62px 16px;
    }

    .pdp-rs__this {
      display: none;
    }

    .pdp-rs__product {
      flex-wrap: wrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pdp-rs__frame,
    .pdp-rs__panel,
    .pdp-rs__panel-inner > *,
    .pdp-rs__frame.is-active img,
    .pdp-rs.is-playing .pdp-rs__bar.is-active i {
      transition: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Routine steps",
  "class": "pdp-routine-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How to use"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your daily routine"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro text",
      "default": "Four simple steps, morning and night. Tap a step to see how.",
      "visible_if": "{{ section.settings.layout == 'stepper' }}"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "stepper",
          "label": "Step by step guide"
        },
        {
          "value": "carousel",
          "label": "Carousel — centered step"
        },
        {
          "value": "grid",
          "label": "Grid — all steps"
        }
      ],
      "default": "stepper"
    },
    {
      "type": "text",
      "id": "step_label",
      "label": "Step label",
      "default": "Step"
    },
    {
      "type": "range",
      "id": "start_step",
      "label": "Start on step",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1,
      "visible_if": "{{ section.settings.layout != 'grid' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Move through the steps automatically",
      "info": "Pauses when shoppers hover, tap or scroll away, and stops once they choose a step.",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'stepper' }}"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Time per step",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6,
      "visible_if": "{{ section.settings.layout == 'stepper' and section.settings.autoplay }}"
    },
    {
      "type": "text",
      "id": "highlight_label",
      "label": "Highlighted step badge",
      "info": "Shown on steps marked \"This product's step\".",
      "default": "This product",
      "visible_if": "{{ section.settings.layout == 'stepper' }}"
    },
    {
      "type": "text",
      "id": "product_label",
      "label": "Step product label",
      "default": "Use with",
      "visible_if": "{{ section.settings.layout == 'stepper' }}"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Step badge color",
      "default": "#f8d12f"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Cleanse"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Wash your face with a gentle cleanser to remove dirt and oil."
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Time",
          "info": "For example 60 sec. Step by step layout only."
        },
        {
          "type": "text",
          "id": "tip",
          "label": "Tip",
          "info": "Step by step layout only."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product for this step",
          "info": "Shown with a quick add button. Step by step layout only."
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "This product's step",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Routine steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
