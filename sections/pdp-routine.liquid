          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Serum",
            "text": "Press in 3–4 drops of serum while skin is still damp."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Moisturise",
            "text": "Seal it all in with a light moisturiser."
          }
        }
      ]
    }
  ]
}
