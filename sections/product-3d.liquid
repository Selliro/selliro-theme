{%- comment -%}
  3D product showcase — an interactive 3D model of a product on a styled stage.
  · Model: the chosen product's first 3D model, or a link to any .glb file (e.g. uploaded to Content › Files).
  · Stage: glow / orbit rings / floor grid / plain backdrop, optional outline word behind the model,
    "360°" chip, live angle readout, drag hint, camera view buttons (front / side / back / top / reset), AR button.
  · Feature blocks: callouts beside the model (Showcase) or a list beside it (Split). Selecting one turns the model
    to that feature's angle; a feature can also pin a numbered hotspot onto the model.
  · No model yet: the poster / product image floats on the stage with a pointer tilt, so the section never looks empty.
  Uses Shopify's own model-viewer (Shopify.loadFeatures), loaded only when the section comes near the viewport.
  Files: assets/product-3d.js (+ shared assets/section-reveal.*)
{%- endcomment -%}
{{ 'section-reveal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-reveal.js' | asset_url }}" defer></script>
<script src="{{ 'product-3d.js' | asset_url }}" defer></script>

{%- liquid
  assign p3d_product = section.settings.product
  assign layout = section.settings.layout | default: 'showcase'
  assign backdrop = section.settings.backdrop | default: 'glow'
  assign count = section.blocks.size
  assign rows = count | plus: 1 | divided_by: 2
  if rows < 1
    assign rows = 1
  endif

  # 1. The selected product's own 3D model (Products › media). 2. Otherwise the pasted .glb link.
  # 3. Otherwise no model: the product photo is shown on the stage with a tilt / float effect.
  assign model_src = ''
  assign ios_src = ''
  assign poster = section.settings.poster
  assign model_alt = p3d_product.title | default: section.settings.heading | default: 'Product 3D model'

  if p3d_product != blank
    assign model_media = p3d_product.media | where: 'media_type', 'model' | first
    if model_media
      assign glb = model_media.sources | where: 'format', 'glb' | first
      assign usdz = model_media.sources | where: 'format', 'usdz' | first
      assign model_src = glb.url
      if usdz
        assign ios_src = usdz.url
      endif
      if model_media.alt != blank
        assign model_alt = model_media.alt
      endif
      if poster == blank
        assign poster = model_media.preview_image
      endif
    endif
  endif

  if model_src == blank and section.settings.model_url != blank
    assign model_src = section.settings.model_url
    if section.settings.model_usdz_url != blank
      assign ios_src = section.settings.model_usdz_url
    endif
  endif

  if poster == blank and p3d_product != blank
    assign poster = p3d_product.featured_image
  endif

  assign start_phi = 90 | minus: section.settings.start_height
  assign radius_pct = 10000 | divided_by: section.settings.model_size
  assign shadow = section.settings.shadow_intensity | divided_by: 10.0
  assign exposure = section.settings.exposure | divided_by: 10.0

  assign stage_dark = false
  if section.settings.stage_color != blank
    assign stage_brightness = section.settings.stage_color | color_brightness
    if stage_brightness < 110
      assign stage_dark = true
    endif
  endif

  assign classes = 'p3d p3d--' | append: layout | append: ' p3d--bg-' | append: backdrop
  if layout == 'split'
    assign classes = classes | append: ' p3d--media-' | append: section.settings.media_position
  endif
  if stage_dark
    assign classes = classes | append: ' p3d--stage-dark'
  endif
  if count == 0
    assign classes = classes | append: ' p3d--no-features'
  endif

  assign button_link = section.settings.button_link | default: p3d_product.url
  assign show_buy = false
  if section.settings.show_product_info and p3d_product != blank
    assign show_buy = true
  elsif section.settings.button_label != blank and button_link != blank
    assign show_buy = true
  endif
-%}

{%- capture header_markup -%}
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
    <header class="p3d__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="p3d__eyebrow" data-reveal-fade="first">
          <span class="p3d__eyebrow-dot" aria-hidden="true"></span>
          {{- section.settings.eyebrow | escape -}}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="p3d__heading" data-reveal-title>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="p3d__intro rte" data-reveal-fade>{{ section.settings.text }}</div>
      {%- endif -%}
    </header>
  {%- endif -%}
{%- endcapture -%}

{%- capture features_markup -%}
  {%- if count > 0 -%}
    <ol class="p3d__features" role="list" data-reveal-fade>
      {%- for block in section.blocks -%}
        {%- liquid
          assign f_phi = 90 | minus: block.settings.view_height
          assign hotspot = block.settings.hotspot | strip
        -%}
        <li
          class="p3d__feature{% if hotspot != blank %} p3d__feature--pinned{% endif %}"
          data-p3d-feature="{{ forloop.index0 }}"
          {% if block.settings.turn_model %}
            data-angle="{{ block.settings.view_angle }}"
            data-phi="{{ f_phi }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <button type="button" class="p3d__feature-button" aria-pressed="false">
            <span class="p3d__feature-num" aria-hidden="true">
              {%- if block.settings.icon != blank -%}
                {{ block.settings.icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', class: 'p3d__feature-icon' }}
              {%- else -%}
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              {%- endif -%}
            </span>
            <span class="p3d__feature-copy">
              {%- if block.settings.title != blank -%}
                <span class="p3d__feature-title">{{ block.settings.title | escape }}</span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <span class="p3d__feature-text">{{ block.settings.text | escape }}</span>
              {%- endif -%}
            </span>
          </button>
        </li>
      {%- endfor -%}
    </ol>
  {%- endif -%}
{%- endcapture -%}

{%- capture buy_markup -%}
  {%- if show_buy -%}
    <div class="p3d__buy" data-reveal-fade>
      {%- if section.settings.show_product_info and p3d_product != blank -%}
        <div class="p3d__buy-info">
          <a class="p3d__buy-title" href="{{ p3d_product.url }}">{{ p3d_product.title | escape }}</a>
          {%- if section.settings.show_price -%}
            <div class="p3d__buy-price">{% render 'price', product_resource: p3d_product %}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and button_link != blank -%}
        <a class="button p3d__button" href="{{ button_link }}">
          {{- section.settings.button_label | escape -}}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture stage_markup -%}
  <product-3d
    class="p3d__stage{% if model_src == blank %} p3d__stage--fallback{% endif %}"
    data-load="{{ section.settings.load_mode }}"
    data-start-angle="{{ section.settings.start_angle }}"
    data-start-phi="{{ start_phi }}"
    data-radius="{{ radius_pct }}%"
    data-reveal-rise
  >
    <div class="p3d__backdrop" aria-hidden="true">
      {%- case backdrop -%}
        {%- when 'rings' -%}
          <span class="p3d__rings">
            <span class="p3d__ring p3d__ring--1"><span class="p3d__ring-dot"></span></span>
            <span class="p3d__ring p3d__ring--2"><span class="p3d__ring-dot"></span></span>
            <span class="p3d__ring p3d__ring--3"></span>
          </span>
        {%- when 'grid' -%}
          <span class="p3d__grid"></span>
      {%- endcase -%}
      <span class="p3d__glow"></span>
      {%- if section.settings.background_text != blank -%}
        <span class="p3d__word">{{ section.settings.background_text | escape }}</span>
      {%- endif -%}
    </div>

    <div class="p3d__poster" data-p3d-poster>
      {%- if poster != blank -%}
        {{ poster | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '500, 800, 1100, 1400', alt: model_alt, class: 'p3d__poster-img' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'p3d__placeholder' }}
      {%- endif -%}
    </div>

    {%- if model_src != blank -%}
      <div class="p3d__viewer" data-p3d-slot></div>
      <template data-p3d-template>
        <model-viewer
          class="p3d__model"
          src="{{ model_src | escape }}"
          {% if ios_src != blank %}ios-src="{{ ios_src | escape }}"{% endif %}
          alt="{{ model_alt | escape }}"
          loading="eager"
          reveal="auto"
          {% if section.settings.allow_drag %}camera-controls{% endif %}
          {% unless section.settings.allow_zoom %}disable-zoom{% endunless %}
          {% if section.settings.auto_rotate %}auto-rotate{% endif %}
          auto-rotate-delay="2500"
          rotation-per-second="{{ section.settings.rotate_speed }}deg"
          interaction-prompt="none"
          camera-orbit="{{ section.settings.start_angle }}deg {{ start_phi }}deg {{ radius_pct }}%"
          min-camera-orbit="auto 12deg auto"
          max-camera-orbit="auto 108deg 250%"
          interpolation-decay="110"
          shadow-intensity="{{ shadow }}"
          shadow-softness="1"
          exposure="{{ exposure }}"
          environment-image="neutral"
          touch-action="pan-y"
          {% if section.settings.enable_ar %}ar ar-modes="webxr scene-viewer quick-look"{% endif %}
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign hotspot = block.settings.hotspot | strip
              if hotspot == blank
                continue
              endif
              assign hs_parts = hotspot | split: '/'
              assign hs_position = hs_parts.first | strip
              assign hs_normal = '0m 0m 1m'
              if hs_parts.size > 1
                assign hs_normal = hs_parts.last | strip
              endif
            -%}
            <button
              type="button"
              class="p3d__hotspot"
              slot="hotspot-{{ forloop.index }}"
              data-position="{{ hs_position | escape }}"
              data-normal="{{ hs_normal | escape }}"
              data-visibility-attribute="visible"
              data-p3d-hotspot="{{ forloop.index0 }}"
              aria-label="{{ block.settings.title | default: forloop.index | escape }}"
            >
              <span class="p3d__hotspot-num">{{ forloop.index }}</span>
              {%- if block.settings.title != blank -%}
                <span class="p3d__hotspot-label">{{ block.settings.title | escape }}</span>
              {%- endif -%}
            </button>
          {%- endfor -%}
          {%- if section.settings.enable_ar -%}
            <button type="button" slot="ar-button" class="p3d__ar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.8 20 7.4v9.2L12 21.2 4 16.6V7.4L12 2.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 7.4 12 12l8-4.6M12 12v9.2" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              {{ 'actions.view_in_your_space' | t }}
            </button>
          {%- endif -%}
        </model-viewer>
      </template>

      <div class="p3d__loader" role="status">
        <span class="p3d__loader-ring" aria-hidden="true"></span>
        <span class="p3d__loader-text">{{ 'product_3d.loading' | t }}</span>
      </div>

      {%- if section.settings.load_mode == 'click' -%}
        <button type="button" class="p3d__start" data-p3d-start>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.8 20 7.4v9.2L12 21.2 4 16.6V7.4L12 2.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 7.4 12 12l8-4.6M12 12v9.2" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          {{ 'product_3d.view_3d' | t }}
        </button>
      {%- endif -%}

      <div class="p3d__hud" aria-hidden="true">
        <span class="p3d__chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M21 12a9 9 0 1 1-3-6.7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M21 4v5h-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          360°
        </span>
        {%- if section.settings.show_readout -%}
          <span class="p3d__readout"><span class="p3d__readout-label">AZ&nbsp;</span><span data-p3d-readout>{{ section.settings.start_angle | modulo: 360 | plus: 360 | modulo: 360 | prepend: '00' | slice: -3, 3 }}</span>°</span>
        {%- endif -%}
      </div>

      {%- if section.settings.show_hint and section.settings.allow_drag -%}
        <span class="p3d__hint" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12m0-1.5v-2a1.5 1.5 0 0 1 3 0V12m0-1a1.5 1.5 0 0 1 3 0v1m0 0a1.5 1.5 0 0 1 3 0v3a6 6 0 0 1-6 6h-1.6a6 6 0 0 1-4.6-2.2L4 15.4a1.5 1.5 0 0 1 2.3-1.9L8 15.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ 'product_3d.drag_hint' | t }}
        </span>
      {%- endif -%}

      {%- if section.settings.show_controls -%}
        <div class="p3d__controls" role="group" aria-label="{{ 'product_3d.views' | t }}">
          <button type="button" class="p3d__control" data-p3d-view="front">{{ 'product_3d.front' | t }}</button>
          <button type="button" class="p3d__control" data-p3d-view="side">{{ 'product_3d.side' | t }}</button>
          <button type="button" class="p3d__control" data-p3d-view="back">{{ 'product_3d.back' | t }}</button>
          <button type="button" class="p3d__control" data-p3d-view="top">{{ 'product_3d.top' | t }}</button>
          <button type="button" class="p3d__control p3d__control--reset" data-p3d-view="reset" aria-label="{{ 'product_3d.reset' | t }}" title="{{ 'product_3d.reset' | t }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M3 4v5h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endif -%}

      <p class="p3d__toast" data-p3d-toast role="status" hidden></p>
    {%- elsif request.design_mode -%}
      <p class="p3d__notice">{{ 'product_3d.editor_hint' | t }}</p>
    {%- endif -%}
  </product-3d>
{%- endcapture -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="{{ classes }} {{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  data-reveal
  style="--p3d-pad-top: {{ section.settings.padding_top }}px; --p3d-pad-bottom: {{ section.settings.padding_bottom }}px; --p3d-h: {{ section.settings.stage_height }}px; --p3d-h-mobile: {{ section.settings.stage_height_mobile }}px; --p3d-radius: {{ section.settings.radius }}px; --p3d-accent: {{ section.settings.accent_color | default: '#f8d12f' }};{% if section.settings.stage_color != blank %} --p3d-stage: {{ section.settings.stage_color }};{% endif %} --p3d-rows: {{ rows }};"
>
  {%- if layout == 'split' -%}
    <div class="p3d__layout">
      <div class="p3d__content">
        {{ header_markup }}
        {{ features_markup }}
        {{ buy_markup }}
      </div>
      {{ stage_markup }}
    </div>
  {%- else -%}
    {{ header_markup }}
    <div class="p3d__layout">
      {{ stage_markup }}
      {{ features_markup }}
    </div>
    {{ buy_markup }}
  {%- endif -%}
</section>

{% stylesheet %}
  .p3d[id] {
    scroll-margin-top: calc(var(--header-height, 72px) + 16px);
  }

  .p3d {
    --p3d-stage: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
    --p3d-ink: var(--color-foreground);
    --p3d-ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    padding-block: var(--p3d-pad-top) var(--p3d-pad-bottom);
  }

  /* ---------------------------------------------------------------- header */
  .p3d__header {
    max-width: 44rem;
    margin: 0 auto clamp(1.75rem, 4vw, 3.25rem);
    text-align: center;
  }

  .p3d__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.75rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 14%, transparent);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .p3d__eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--p3d-accent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--p3d-accent) 70%, transparent);
    animation: p3d-pulse 2.4s ease-out infinite;
  }

  .p3d__heading {
    margin: 0;
    font-size: var(--section-title-size);
    font-weight: var(--section-title-weight);
    line-height: var(--section-title-leading);
    letter-spacing: var(--section-title-tracking);
  }

  .p3d__intro {
    margin-block-start: 0.75rem;
    opacity: 0.75;
  }

  /* ---------------------------------------------------------------- stage */
  .p3d__stage {
    position: relative;
    display: block;
    height: var(--p3d-h-mobile);
    border-radius: var(--p3d-radius);
    overflow: hidden;
    isolation: isolate;
    background: var(--p3d-stage);
    color: var(--p3d-ink);
    touch-action: pan-y;
  }

  .p3d--stage-dark .p3d__stage {
    --p3d-ink: #fff;
  }

  .p3d__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .p3d__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(42% 46% at 50% 52%, color-mix(in srgb, var(--p3d-accent) 55%, transparent), transparent 70%),
      radial-gradient(70% 40% at 50% 100%, color-mix(in srgb, var(--p3d-ink) 7%, transparent), transparent 70%);
    opacity: 0.9;
  }

  .p3d--bg-plain .p3d__glow {
    background: radial-gradient(70% 40% at 50% 100%, color-mix(in srgb, var(--p3d-ink) 6%, transparent), transparent 70%);
  }

  .p3d--bg-rings .p3d__glow,
  .p3d--bg-grid .p3d__glow {
    opacity: 0.55;
  }

  /* Outline word behind the model */
  .p3d__word {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: clamp(5rem, 24cqi, 18rem);
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--p3d-ink) 16%, transparent);
    user-select: none;
  }

  .p3d__stage {
    container-type: size;
  }

  /* Orbit rings */
  .p3d__rings {
    position: absolute;
    inset: 0;
    perspective: 900px;
  }

  .p3d__ring {
    position: absolute;
    top: 58%;
    left: 50%;
    width: var(--s);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--p3d-ink) 22%, transparent);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotateX(74deg) rotateZ(0deg);
    animation: p3d-orbit var(--t) linear infinite;
  }

  .p3d__ring--1 {
    --s: min(46cqi, 70cqb);
    --t: 18s;
  }

  .p3d__ring--2 {
    --s: min(70cqi, 104cqb);
    --t: 32s;
    border-style: dashed;
    animation-direction: reverse;
  }

  .p3d__ring--3 {
    --s: min(96cqi, 140cqb);
    --t: 60s;
    opacity: 0.6;
  }

  .p3d__ring-dot {
    position: absolute;
    top: -5px;
    left: calc(50% - 5px);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--p3d-accent);
    box-shadow: 0 0 14px 2px color-mix(in srgb, var(--p3d-accent) 80%, transparent);
  }

  /* Perspective floor grid */
  .p3d__grid {
    position: absolute;
    left: -50%;
    right: -50%;
    bottom: -10%;
    height: 70%;
    background-image:
      linear-gradient(color-mix(in srgb, var(--p3d-ink) 16%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--p3d-ink) 16%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
    transform: perspective(520px) rotateX(62deg);
    transform-origin: 50% 0;
    mask-image: radial-gradient(60% 80% at 50% 0%, #000 30%, transparent 75%);
    animation: p3d-grid 6s linear infinite;
  }

  /* Poster / fallback image */
  .p3d__poster {
    position: absolute;
    inset: 8% 10%;
    z-index: 1;
    display: grid;
    place-items: center;
    transition: opacity 0.7s var(--p3d-ease), scale 0.7s var(--p3d-ease);
  }

  .p3d__poster-img,
  .p3d__placeholder {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .p3d__placeholder {
    width: min(100%, 420px);
    height: 100%;
    fill: color-mix(in srgb, var(--p3d-ink) 40%, transparent);
  }

  .p3d__stage.is-ready .p3d__poster {
    opacity: 0;
    scale: 0.96;
    pointer-events: none;
  }

  /* No model: float + pointer tilt so the stage still feels 3D */
  .p3d__stage--fallback {
    perspective: 1000px;
  }

  .p3d__stage--fallback .p3d__poster {
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform 0.6s var(--p3d-ease);
  }

  .p3d__stage--fallback .p3d__poster-img {
    max-height: 100%;
  }

  /* Product photos usually sit on a light backdrop: multiply melts it into the stage so the product reads as a cut-out */
  .p3d:not(.p3d--stage-dark) .p3d__stage--fallback .p3d__poster {
    mix-blend-mode: multiply;
  }

  .p3d:not(.p3d--stage-dark) .p3d__stage--fallback .p3d__poster > * {
    filter: none;
  }

  .p3d__stage--fallback {
    cursor: grab;
    user-select: none;
  }

  .p3d__stage--fallback img {
    -webkit-user-drag: none;
  }

  .p3d__stage--fallback.is-dragging {
    cursor: grabbing;
  }

  .p3d__stage--fallback.is-dragging .p3d__poster {
    transition: none;
  }

  /* Soft contact shadow under the floating photo */
  .p3d__stage--fallback .p3d__poster::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2%;
    width: 42%;
    height: 7%;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, #000 22%, transparent), transparent);
    translate: -50% 0;
    animation: p3d-shadow 6s ease-in-out infinite;
    z-index: -1;
  }

  .p3d__stage--fallback .p3d__poster > * {
    animation: p3d-float 6s ease-in-out infinite;
    filter: drop-shadow(0 30px 30px color-mix(in srgb, #000 18%, transparent));
  }

  /* Viewer */
  .p3d__viewer {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.8s var(--p3d-ease);
  }

  .p3d__stage.is-ready .p3d__viewer {
    opacity: 1;
  }

  .p3d__model {
    width: 100%;
    height: 100%;
    background: transparent;
    --poster-color: transparent;
    --progress-bar-color: transparent;
    --progress-bar-height: 0;
    outline: none;
  }

  .p3d__model:focus-visible {
    outline: 2px solid var(--p3d-accent);
    outline-offset: -4px;
  }

  /* Loader ring */
  .p3d__loader {
    position: absolute;
    left: 50%;
    bottom: 5.25rem;
    z-index: 3;
    display: none;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.85rem 0.45rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-background) 80%, transparent);
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
    color: var(--color-foreground);
    translate: -50% 0;
  }

  .p3d__stage.is-loading .p3d__loader {
    display: inline-flex;
  }

  .p3d__loader-ring {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: conic-gradient(var(--p3d-accent) calc(var(--p3d-progress, 0.05) * 360deg), color-mix(in srgb, var(--color-foreground) 12%, transparent) 0);
    mask: radial-gradient(circle, transparent 6px, #000 6.5px);
  }

  /* Click-to-load */
  .p3d__start {
    position: absolute;
    left: 50%;
    bottom: 5.25rem;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.35rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-background);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    translate: -50% 0;
    box-shadow: 0 10px 30px color-mix(in srgb, #000 22%, transparent);
    transition: scale 0.3s var(--p3d-ease);
  }

  .p3d__start:hover {
    scale: 1.04;
  }

  .p3d__stage.is-loading .p3d__start,
  .p3d__stage.is-ready .p3d__start {
    display: none;
  }

  /* HUD */
  .p3d__hud {
    position: absolute;
    inset: 1rem 1rem auto;
    z-index: 4;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }

  .p3d__chip,
  .p3d__readout {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--p3d-ink) 14%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--p3d-stage) 70%, transparent);
    backdrop-filter: blur(8px);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .p3d__chip svg {
    animation: p3d-spin 4s linear infinite;
  }

  .p3d__readout {
    gap: 0;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .p3d__readout [data-p3d-readout] {
    display: inline-block;
    min-width: 3ch;
    text-align: end;
  }

  .p3d__readout-label {
    opacity: 0.55;
  }

  /* Drag hint */
  .p3d__hint {
    position: absolute;
    left: 50%;
    bottom: 5.25rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--p3d-ink) 86%, transparent);
    color: var(--p3d-stage);
    font-size: 0.75rem;
    font-weight: 600;
    translate: -50% 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s var(--p3d-ease), translate 0.5s var(--p3d-ease);
  }

  .p3d__stage.is-ready:not(.has-interacted) .p3d__hint {
    opacity: 1;
  }

  .p3d__stage.is-ready:not(.has-interacted) .p3d__hint svg {
    animation: p3d-swipe 2.4s ease-in-out infinite;
  }

  .p3d__stage.has-interacted .p3d__hint {
    translate: -50% 8px;
  }

  /* Camera views */
  .p3d__controls {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 2px;
    max-width: calc(100% - 2rem);
    padding: 4px;
    border: 1px solid color-mix(in srgb, var(--p3d-ink) 12%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--p3d-stage) 75%, transparent);
    backdrop-filter: blur(10px);
    translate: -50% 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .p3d__control {
    flex: none;
    display: inline-grid;
    place-items: center;
    min-height: 36px;
    padding: 0 0.9rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s;
  }

  .p3d__control:hover {
    background: color-mix(in srgb, var(--p3d-ink) 8%, transparent);
  }

  .p3d__control.is-active {
    background: var(--p3d-ink);
    color: var(--p3d-stage);
  }

  .p3d__control--reset {
    width: 36px;
    padding: 0;
  }

  .p3d__stage:not(.is-ready) .p3d__controls {
    opacity: 0.45;
    pointer-events: none;
  }

  /* AR (model-viewer only shows it where AR is supported) */
  .p3d__ar {
    position: absolute;
    right: 1rem;
    bottom: 4.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: var(--p3d-ink);
    color: var(--p3d-stage);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }

  /* Hotspots */
  .p3d__hotspot {
    --size: 30px;
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-foreground);
    font: inherit;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .p3d__hotspot[data-visible] {
    opacity: 1;
  }

  .p3d__hotspot-num {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: var(--color-background);
    box-shadow: 0 4px 14px color-mix(in srgb, #000 22%, transparent);
    font-size: 0.75rem;
    font-weight: 700;
    transition: background-color 0.25s, color 0.25s, scale 0.3s var(--p3d-ease);
  }

  .p3d__hotspot-num::after {
    content: '';
    position: absolute;
    inset: -5px;
    border: 1.5px solid var(--p3d-accent);
    border-radius: 50%;
    animation: p3d-ping 2.2s ease-out infinite;
  }

  .p3d__hotspot-label {
    position: absolute;
    left: calc(var(--size) + 8px);
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: var(--color-background);
    box-shadow: 0 4px 14px color-mix(in srgb, #000 14%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    translate: -6px 0;
    transition: opacity 0.25s, translate 0.25s var(--p3d-ease);
    pointer-events: none;
  }

  .p3d__hotspot:is(:hover, :focus-visible, .is-active) .p3d__hotspot-label {
    opacity: 1;
    translate: 0 0;
  }

  .p3d__hotspot.is-active .p3d__hotspot-num {
    background: var(--p3d-accent);
    color: #111;
    scale: 1.12;
  }

  /* Editor notice + toast */
  .p3d__notice,
  .p3d__toast {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    z-index: 5;
    width: max-content;
    max-width: calc(100% - 2rem);
    margin: 0;
    padding: 0.6rem 0.95rem;
    border-radius: 12px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.78rem;
    line-height: 1.4;
    text-align: center;
    translate: -50% 0;
  }

  .p3d__toast {
    top: 3.75rem;
    bottom: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .p3d__toast[hidden] {
    display: none;
  }

  /* ---------------------------------------------------------------- features */
  .p3d__features {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .p3d__feature-button {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    width: 100%;
    height: 100%;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: calc(var(--p3d-radius) * 0.6);
    background: color-mix(in srgb, var(--color-foreground) 3%, var(--color-background));
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: border-color 0.3s, background-color 0.3s, translate 0.4s var(--p3d-ease), box-shadow 0.4s var(--p3d-ease);
  }

  .p3d__feature-button:hover {
    border-color: color-mix(in srgb, var(--color-foreground) 22%, transparent);
  }

  .p3d__feature.is-active .p3d__feature-button {
    border-color: var(--color-foreground);
    background: var(--color-background);
    box-shadow: 0 14px 34px color-mix(in srgb, #000 10%, transparent);
  }

  .p3d__feature-num {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-foreground) 7%, transparent);
    font-size: 0.8rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    overflow: hidden;
    transition: background-color 0.3s, color 0.3s;
  }

  .p3d__feature-icon {
    width: 60%;
    height: 60%;
    object-fit: contain;
  }

  .p3d__feature.is-active .p3d__feature-num {
    background: var(--p3d-accent);
    color: #111;
  }

  .p3d__feature-copy {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .p3d__feature-title {
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .p3d__feature-text {
    font-size: 0.875rem;
    line-height: 1.5;
    opacity: 0.72;
  }

  /* ---------------------------------------------------------------- buy row */
  .p3d__buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin-block-start: clamp(1.5rem, 3vw, 2.25rem);
  }

  .p3d__buy-info {
    display: grid;
    gap: 0.2rem;
  }

  .p3d--showcase .p3d__buy-info {
    text-align: center;
  }

  .p3d__buy-title {
    color: inherit;
    font-family: var(--font-heading--family);
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
  }

  .p3d__buy-price {
    opacity: 0.8;
  }

  .p3d__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .p3d__button svg {
    transition: translate 0.3s var(--p3d-ease);
  }

  .p3d__button:hover svg {
    translate: 3px 0;
  }

  /* ---------------------------------------------------------------- phones & tablets: features in a swipe row
     (Showcase keeps this up to 1199px — flanking callouts only have room on wide screens) */
  @media screen and (max-width: 1199px) {
    .p3d__layout > .p3d__features {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 80%;
      gap: 0.75rem;
      margin-block-start: 1rem;
      margin-inline: calc(var(--page-margin, 16px) * -1);
      padding-inline: var(--page-margin, 16px);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-margin, 16px);
      scrollbar-width: none;
    }

    .p3d__layout > .p3d__features::-webkit-scrollbar {
      display: none;
    }

    .p3d__layout > .p3d__features .p3d__feature {
      scroll-snap-align: start;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .p3d__layout > .p3d__features {
      grid-auto-columns: minmax(15rem, 32%);
      margin-block-start: 1.25rem;
    }
  }

  @media screen and (max-width: 989px) {
    .p3d--split .p3d__content {
      order: 2;
      margin-block-start: 1.5rem;
    }

    .p3d--split .p3d__layout {
      display: flex;
      flex-direction: column;
    }

    .p3d--split .p3d__features {
      display: grid;
      gap: 0.6rem;
    }

    .p3d--split .p3d__header {
      text-align: start;
      margin-inline: 0;
      margin-block-end: 1.25rem;
    }
  }

  /* ---------------------------------------------------------------- desktop */
  @media screen and (min-width: 990px) {
    .p3d__stage {
      height: var(--p3d-h);
    }

  }

  @media screen and (min-width: 1200px) {
    /* Showcase: callouts flank the stage, odd on the left, even on the right */
    .p3d--showcase .p3d__layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr) minmax(0, 1fr);
      grid-auto-rows: 1fr;
      column-gap: clamp(1.25rem, 2.5vw, 2.5rem);
      row-gap: 1rem;
      align-items: center;
    }

    .p3d--showcase.p3d--no-features .p3d__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .p3d--showcase .p3d__stage {
      grid-column: 2;
      grid-row: 1 / span var(--p3d-rows);
    }

    .p3d--showcase.p3d--no-features .p3d__stage {
      grid-column: 1;
    }

    .p3d--showcase .p3d__features {
      display: contents;
    }

    .p3d--showcase .p3d__feature {
      position: relative;
      grid-column: 1;
      align-self: center;
    }

    .p3d--showcase .p3d__feature:nth-child(even) {
      grid-column: 3;
    }

    .p3d--showcase .p3d__feature:nth-child(odd) .p3d__feature-button {
      flex-direction: row-reverse;
      text-align: end;
    }

    /* Connector line toward the stage */
    .p3d--showcase .p3d__feature::after {
      content: '';
      position: absolute;
      top: 50%;
      width: clamp(1.25rem, 2.5vw, 2.5rem);
      height: 1px;
      background: color-mix(in srgb, var(--color-foreground) 18%, transparent);
      transition: background-color 0.3s;
    }

    .p3d--showcase .p3d__feature:nth-child(odd)::after {
      left: 100%;
    }

    .p3d--showcase .p3d__feature:nth-child(even)::after {
      right: 100%;
    }

    .p3d--showcase .p3d__feature.is-active::after {
      background: var(--color-foreground);
    }

    .p3d--showcase .p3d__feature:nth-child(odd).is-active .p3d__feature-button {
      translate: 6px 0;
    }

    .p3d--showcase .p3d__feature:nth-child(even).is-active .p3d__feature-button {
      translate: -6px 0;
    }

  }

  @media screen and (min-width: 990px) {
    /* Split: content column + stage */
    .p3d--split .p3d__layout {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
    }

    .p3d--split.p3d--media-left .p3d__stage {
      order: -1;
    }

    .p3d--split .p3d__header {
      margin-inline: 0;
      margin-block-end: 1.75rem;
      text-align: start;
    }

    .p3d--split .p3d__features {
      display: grid;
      gap: 0.6rem;
    }

    .p3d--split .p3d__feature.is-active .p3d__feature-button {
      translate: 6px 0;
    }

    .p3d--split .p3d__buy {
      justify-content: flex-start;
    }
  }

  /* ---------------------------------------------------------------- motion */
  @keyframes p3d-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--p3d-accent) 70%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 8px transparent;
    }
  }

  @keyframes p3d-orbit {
    to {
      transform: translate(-50%, -50%) rotateX(74deg) rotateZ(360deg);
    }
  }

  @keyframes p3d-grid {
    to {
      background-position: center 56px;
    }
  }

  @keyframes p3d-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -14px;
    }
  }

  @keyframes p3d-shadow {
    0%,
    100% {
      scale: 1;
      opacity: 1;
    }
    50% {
      scale: 0.82;
      opacity: 0.65;
    }
  }

  @keyframes p3d-spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes p3d-swipe {
    0%,
    100% {
      translate: -5px 0;
    }
    50% {
      translate: 5px 0;
    }
  }

  @keyframes p3d-ping {
    0% {
      opacity: 0.9;
      scale: 0.85;
    }
    80%,
    100% {
      opacity: 0;
      scale: 1.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p3d__ring,
    .p3d__grid,
    .p3d__chip svg,
    .p3d__eyebrow-dot,
    .p3d__hotspot-num::after,
    .p3d__stage--fallback .p3d__poster > *,
    .p3d__stage--fallback .p3d__poster::after,
    .p3d__hint svg {
      animation: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "3D product",
  "tag": "div",
  "class": "section-wrapper",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "360° view"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See it from every angle"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Turn it, tilt it, peek inside. Get to know it before it reaches your shelf.</p>"
    },
    {
      "type": "header",
      "content": "3D model"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Shows the product's own 3D model (add a .glb in the product's media). Without one, its main image is shown on the stage. Also used for the name, price and button."
    },
    {
      "type": "url",
      "id": "model_url",
      "label": "Backup 3D model link (.glb)",
      "info": "Only used when the product has no 3D model of its own. Upload a .glb file in Content › Files, copy its link and paste it here."
    },
    {
      "type": "url",
      "id": "model_usdz_url",
      "label": "iPhone AR link (.usdz)",
      "info": "Optional. Lets iPhones open the linked model above in AR. Shopify creates a .usdz next to each uploaded .glb."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image",
      "info": "Shown while the model loads, or on its own when there is no model. Defaults to the product image."
    },
    {
      "type": "select",
      "id": "load_mode",
      "label": "Load the model",
      "options": [
        {
          "value": "scroll",
          "label": "When scrolled into view"
        },
        {
          "value": "click",
          "label": "When the visitor taps “View in 3D”"
        }
      ],
      "default": "scroll",
      "info": "Tap to load saves data on mobile for large models."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "showcase",
          "label": "Showcase — features around the model"
        },
        {
          "value": "split",
