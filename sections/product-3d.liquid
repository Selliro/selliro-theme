{%- comment -%}
  3D product — split: an interactive 3D model of a product on a styled stage.
  · Layout: Split (text and features beside the model, model on the left or right) or Showcase (features arranged
    around the model).
  · Model: the chosen product's first 3D model, or a link to any .glb file (e.g. uploaded to Content › Files).
  · Stage: glow / orbit rings / floor grid / plain backdrop, optional outline word behind the model,
    "360°" chip, live angle readout, drag hint, camera view buttons (front / side / back / top / reset), AR button.
  · Feature blocks: callouts beside the model (Showcase) or a list beside it (Split). Selecting one turns the model
    to that feature's angle; a feature can also pin a numbered hotspot onto the model.
  · No model yet: the poster / product image floats on the stage with a pointer tilt, so the section never looks empty.
  Uses Shopify's own model-viewer (Shopify.loadFeatures), loaded only when the section comes near the viewport.
  Files: assets/product-3d.js (+ shared assets/section-reveal.*)
{%- endcomment -%}
{{ 'section-product-3d.css' | asset_url | stylesheet_tag }}
{{ 'section-reveal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-reveal.js' | asset_url }}" defer></script>
<script src="{{ 'product-3d.js' | asset_url }}" defer></script>

{%- liquid
  assign p3d_product = section.settings.product
  assign layout = section.settings.layout | default: 'split'
  assign backdrop = section.settings.backdrop | default: 'glow'
  assign count = section.blocks.size
  assign rows = count | plus: 1 | divided_by: 2
  if rows < 1
    assign rows = 1
  endif

  # 1. The selected product's own 3D model (Products › media). 2. Otherwise the pasted .glb link.
  # 3. Otherwise no model: the product photo is shown on the stage with a tilt / float effect.
  assign model_src = ''
  assign ios_src = ''
  assign poster = section.settings.poster
  assign model_alt = p3d_product.title | default: section.settings.heading | default: 'Product 3D model'

  if p3d_product != blank
    assign model_media = p3d_product.media | where: 'media_type', 'model' | first
    if model_media
      assign glb = model_media.sources | where: 'format', 'glb' | first
      assign usdz = model_media.sources | where: 'format', 'usdz' | first
      assign model_src = glb.url
      if usdz
        assign ios_src = usdz.url
      endif
      if model_media.alt != blank
        assign model_alt = model_media.alt
      endif
      if poster == blank
        assign poster = model_media.preview_image
      endif
    endif
  endif

  if model_src == blank and section.settings.model_url != blank
    assign model_src = section.settings.model_url
    if section.settings.model_usdz_url != blank
      assign ios_src = section.settings.model_usdz_url
    endif
  endif

  if poster == blank and p3d_product != blank
    assign poster = p3d_product.featured_image
  endif

  assign start_phi = 90 | minus: section.settings.start_height
  assign radius_pct = 10000 | divided_by: section.settings.model_size
  assign shadow = section.settings.shadow_intensity | divided_by: 10.0
  assign exposure = section.settings.exposure | divided_by: 10.0

  assign stage_dark = false
  if section.settings.stage_color != blank
    assign stage_brightness = section.settings.stage_color | color_brightness
    if stage_brightness < 110
      assign stage_dark = true
    endif
  endif

  assign classes = 'p3d p3d--' | append: layout | append: ' p3d--bg-' | append: backdrop
  if layout == 'split'
    assign classes = classes | append: ' p3d--media-' | append: section.settings.media_position
  endif
  if stage_dark
    assign classes = classes | append: ' p3d--stage-dark'
  endif
  if count == 0
    assign classes = classes | append: ' p3d--no-features'
  endif

  assign button_link = section.settings.button_link | default: p3d_product.url
  assign show_buy = false
  if section.settings.show_product_info and p3d_product != blank
    assign show_buy = true
  elsif section.settings.button_label != blank and button_link != blank
    assign show_buy = true
  endif
-%}

{%- capture header_markup -%}
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
    <header class="p3d__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="p3d__eyebrow" data-reveal-fade="first">
          <span class="p3d__eyebrow-dot" aria-hidden="true"></span>
          {{- section.settings.eyebrow | escape -}}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="p3d__heading" data-reveal-title>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="p3d__intro rte" data-reveal-fade>{{ section.settings.text }}</div>
      {%- endif -%}
    </header>
  {%- endif -%}
{%- endcapture -%}

{%- capture features_markup -%}
  {%- if count > 0 -%}
    <ol class="p3d__features" role="list" data-reveal-fade>
      {%- for block in section.blocks -%}
        {%- liquid
          assign f_phi = 90 | minus: block.settings.view_height
          assign hotspot = block.settings.hotspot | strip
        -%}
        <li
          class="p3d__feature{% if hotspot != blank %} p3d__feature--pinned{% endif %}"
          data-p3d-feature="{{ forloop.index0 }}"
          {% if block.settings.turn_model %}
            data-angle="{{ block.settings.view_angle }}"
            data-phi="{{ f_phi }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <button type="button" class="p3d__feature-button" aria-pressed="false">
            <span class="p3d__feature-num" aria-hidden="true">
              {%- if block.settings.icon != blank -%}
                {{ block.settings.icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', class: 'p3d__feature-icon' }}
              {%- else -%}
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              {%- endif -%}
            </span>
            <span class="p3d__feature-copy">
              {%- if block.settings.title != blank -%}
                <span class="p3d__feature-title">{{ block.settings.title | escape }}</span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <span class="p3d__feature-text">{{ block.settings.text | escape }}</span>
              {%- endif -%}
            </span>
          </button>
        </li>
      {%- endfor -%}
    </ol>
  {%- endif -%}
{%- endcapture -%}

{%- capture buy_markup -%}
  {%- if show_buy -%}
    <div class="p3d__buy" data-reveal-fade>
      {%- if section.settings.show_product_info and p3d_product != blank -%}
        <div class="p3d__buy-info">
          <a class="p3d__buy-title" href="{{ p3d_product.url }}">{{ p3d_product.title | escape }}</a>
          {%- if section.settings.show_price -%}
            <div class="p3d__buy-price">{% render 'price', product: p3d_product %}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and button_link != blank -%}
        <a class="button p3d__button" href="{{ button_link }}">
          {{- section.settings.button_label | escape -}}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture stage_markup -%}
  <product-3d
    class="p3d__stage{% if model_src == blank %} p3d__stage--fallback{% endif %}"
    data-load="{{ section.settings.load_mode }}"
    data-start-angle="{{ section.settings.start_angle }}"
    data-start-phi="{{ start_phi }}"
    data-radius="{{ radius_pct }}%"
    data-reveal-rise
  >
    <div class="p3d__backdrop" aria-hidden="true">
      {%- case backdrop -%}
        {%- when 'rings' -%}
          <span class="p3d__rings">
            <span class="p3d__ring p3d__ring--1"><span class="p3d__ring-dot"></span></span>
            <span class="p3d__ring p3d__ring--2"><span class="p3d__ring-dot"></span></span>
            <span class="p3d__ring p3d__ring--3"></span>
          </span>
        {%- when 'grid' -%}
          <span class="p3d__grid"></span>
      {%- endcase -%}
      <span class="p3d__glow"></span>
      {%- if section.settings.background_text != blank -%}
        <span class="p3d__word">{{ section.settings.background_text | escape }}</span>
      {%- endif -%}
    </div>

    <div class="p3d__poster" data-p3d-poster>
      {%- if poster != blank -%}
        {{ poster | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '500, 800, 1100, 1400', alt: model_alt, class: 'p3d__poster-img' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'p3d__placeholder' }}
      {%- endif -%}
    </div>

    {%- if model_src != blank -%}
      <div class="p3d__viewer" data-p3d-slot></div>
      <template data-p3d-template>
        <model-viewer
          class="p3d__model"
          src="{{ model_src | escape }}"
          {% if ios_src != blank %}ios-src="{{ ios_src | escape }}"{% endif %}
          alt="{{ model_alt | escape }}"
          loading="eager"
          reveal="auto"
          {% if section.settings.allow_drag %}camera-controls{% endif %}
          {% unless section.settings.allow_zoom %}disable-zoom{% endunless %}
          {% if section.settings.auto_rotate %}auto-rotate{% endif %}
          auto-rotate-delay="2500"
          rotation-per-second="{{ section.settings.rotate_speed }}deg"
          interaction-prompt="none"
          camera-orbit="{{ section.settings.start_angle }}deg {{ start_phi }}deg {{ radius_pct }}%"
          min-camera-orbit="auto 12deg auto"
          max-camera-orbit="auto 108deg 250%"
          interpolation-decay="110"
          shadow-intensity="{{ shadow }}"
          shadow-softness="1"
          exposure="{{ exposure }}"
          environment-image="neutral"
          touch-action="pan-y"
          {% if section.settings.enable_ar %}ar ar-modes="webxr scene-viewer quick-look"{% endif %}
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign hotspot = block.settings.hotspot | strip
              if hotspot == blank
                continue
              endif
              assign hs_parts = hotspot | split: '/'
              assign hs_position = hs_parts.first | strip
              assign hs_normal = '0m 0m 1m'
              if hs_parts.size > 1
                assign hs_normal = hs_parts.last | strip
              endif
            -%}
            <button
              type="button"
              class="p3d__hotspot"
              slot="hotspot-{{ forloop.index }}"
              data-position="{{ hs_position | escape }}"
              data-normal="{{ hs_normal | escape }}"
              data-visibility-attribute="visible"
              data-p3d-hotspot="{{ forloop.index0 }}"
              aria-label="{{ block.settings.title | default: forloop.index | escape }}"
            >
              <span class="p3d__hotspot-num">{{ forloop.index }}</span>
              {%- if block.settings.title != blank -%}
                <span class="p3d__hotspot-label">{{ block.settings.title | escape }}</span>
              {%- endif -%}
            </button>
          {%- endfor -%}
          {%- if section.settings.enable_ar -%}
            <button type="button" slot="ar-button" class="p3d__ar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.8 20 7.4v9.2L12 21.2 4 16.6V7.4L12 2.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 7.4 12 12l8-4.6M12 12v9.2" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              {{ 'actions.view_in_your_space' | t }}
            </button>
          {%- endif -%}
        </model-viewer>
      </template>

      <div class="p3d__loader" role="status">
        <span class="p3d__loader-ring" aria-hidden="true"></span>
        <span class="p3d__loader-text">{{ 'product_3d.loading' | t }}</span>
      </div>

      {%- if section.settings.load_mode == 'click' -%}
        <button type="button" class="p3d__start" data-p3d-start>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.8 20 7.4v9.2L12 21.2 4 16.6V7.4L12 2.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 7.4 12 12l8-4.6M12 12v9.2" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          {{ 'product_3d.view_3d' | t }}
        </button>
      {%- endif -%}

      <div class="p3d__hud" aria-hidden="true">
        <span class="p3d__chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M21 12a9 9 0 1 1-3-6.7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M21 4v5h-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          360°
        </span>
        {%- if section.settings.show_readout -%}
          <span class="p3d__readout"><span class="p3d__readout-label">AZ&nbsp;</span><span data-p3d-readout>{{ section.settings.start_angle | modulo: 360 | plus: 360 | modulo: 360 | prepend: '00' | slice: -3, 3 }}</span>°</span>
        {%- endif -%}
      </div>

      {%- if section.settings.show_hint and section.settings.allow_drag -%}
        <span class="p3d__hint" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12m0-1.5v-2a1.5 1.5 0 0 1 3 0V12m0-1a1.5 1.5 0 0 1 3 0v1m0 0a1.5 1.5 0 0 1 3 0v3a6 6 0 0 1-6 6h-1.6a6 6 0 0 1-4.6-2.2L4 15.4a1.5 1.5 0 0 1 2.3-1.9L8 15.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ 'product_3d.drag_hint' | t }}
        </span>
      {%- endif -%}

      {%- if section.settings.show_controls -%}
        <div class="p3d__controls" role="group" aria-label="{{ 'product_3d.views' | t }}">
          <button type="button" class="p3d__control" data-p3d-view="front">{{ 'product_3d.front' | t }}</button>
          <button type="button" class="p3d__control" data-p3d-view="side">{{ 'product_3d.side' | t }}</button>
          <button type="button" class="p3d__control" data-p3d-view="back">{{ 'product_3d.back' | t }}</button>
          <button type="button" class="p3d__control" data-p3d-view="top">{{ 'product_3d.top' | t }}</button>
          <button type="button" class="p3d__control p3d__control--reset" data-p3d-view="reset" aria-label="{{ 'product_3d.reset' | t }}" title="{{ 'product_3d.reset' | t }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M3 4v5h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endif -%}

      <p class="p3d__toast" data-p3d-toast role="status" hidden></p>
    {%- elsif request.design_mode -%}
      <p class="p3d__notice">{{ 'product_3d.editor_hint' | t }}</p>
    {%- endif -%}
  </product-3d>
{%- endcapture -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
  class="{{ classes }} {{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  data-reveal
  style="--p3d-pad-top: {{ section.settings.padding_top }}px; --p3d-pad-bottom: {{ section.settings.padding_bottom }}px; --p3d-h: {{ section.settings.stage_height }}px; --p3d-h-mobile: {{ section.settings.stage_height_mobile }}px; --p3d-radius: {{ section.settings.radius }}px; --p3d-accent: {{ section.settings.accent_color | default: '#f8d12f' }};{% if section.settings.stage_color != blank %} --p3d-stage: {{ section.settings.stage_color }};{% endif %} --p3d-rows: {{ rows }};"
>
  {%- if layout == 'split' -%}
    <div class="p3d__layout">
      <div class="p3d__content">
        {{ header_markup }}
        {{ features_markup }}
        {{ buy_markup }}
      </div>
      {{ stage_markup }}
    </div>
  {%- else -%}
    {{ header_markup }}
    <div class="p3d__layout">
      {{ stage_markup }}
      {{ features_markup }}
    </div>
    {{ buy_markup }}
  {%- endif -%}
</section>


{% schema %}
{
  "name": "3D product — split",
  "tag": "div",
  "class": "section-wrapper",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "360° view"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See it from every angle"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Turn it, tilt it, peek inside. Get to know it before it reaches your shelf.</p>"
    },
    {
      "type": "header",
      "content": "3D model"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Shows the product's own 3D model (add a .glb in the product's media). Without one, its main image is shown on the stage. Also used for the name, price and button."
    },
    {
      "type": "url",
      "id": "model_url",
      "label": "Backup 3D model link (.glb)",
      "info": "Only used when the product has no 3D model of its own. Upload a .glb file in Content › Files, copy its link and paste it here."
    },
    {
      "type": "url",
      "id": "model_usdz_url",
      "label": "iPhone AR link (.usdz)",
      "info": "Optional. Lets iPhones open the linked model above in AR. Shopify creates a .usdz next to each uploaded .glb."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image",
      "info": "Shown while the model loads, or on its own when there is no model. Defaults to the product image."
    },
    {
      "type": "select",
      "id": "load_mode",
      "label": "Load the model",
      "options": [
        {
          "value": "scroll",
          "label": "When scrolled into view"
        },
        {
          "value": "click",
          "label": "When the visitor taps “View in 3D”"
        }
      ],
      "default": "scroll",
      "info": "Tap to load saves data on mobile for large models."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "split",
          "label": "Split — text beside the model"
        },
        {
          "value": "showcase",
          "label": "Showcase — features around the model"
        }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Model position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right",
      "visible_if": "{{ section.settings.layout == 'split' }}"
    },
    {
      "type": "range",
      "id": "stage_height",
      "label": "Stage height",
      "min": 360,
      "max": 820,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "stage_height_mobile",
      "label": "Stage height on mobile",
      "min": 280,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Stage style"
    },
    {
      "type": "select",
      "id": "backdrop",
      "label": "Backdrop",
      "options": [
        {
          "value": "glow",
          "label": "Glow"
        },
        {
          "value": "rings",
          "label": "Orbit rings"
        },
        {
          "value": "grid",
          "label": "Floor grid"
        },
        {
          "value": "plain",
          "label": "Plain"
        }
      ],
      "default": "glow"
    },
    {
      "type": "color",
      "id": "stage_color",
      "label": "Stage background",
      "default": "#f3efe7",
      "info": "Text and controls on the stage switch to white on dark colors."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#f8d12f"
    },
    {
      "type": "text",
      "id": "background_text",
      "label": "Outline word behind the model",
      "default": "360°",
      "info": "Short words work best. Leave empty to hide."
    },
    {
      "type": "range",
      "id": "shadow_intensity",
      "label": "Floor shadow",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "exposure",
      "label": "Brightness",
      "min": 5,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "header",
      "content": "Viewer"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Rotate automatically",
      "default": true
    },
    {
      "type": "range",
      "id": "rotate_speed",
      "label": "Rotation speed",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "°/s",
      "default": 20,
      "visible_if": "{{ section.settings.auto_rotate }}"
    },
    {
      "type": "range",
      "id": "model_size",
      "label": "Model size",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "range",
      "id": "start_angle",
      "label": "Starting angle",
      "min": -180,
      "max": 180,
      "step": 15,
      "unit": "°",
      "default": 30
    },
    {
      "type": "range",
      "id": "start_height",
      "label": "Starting camera height",
      "min": 0,
      "max": 75,
      "step": 5,
      "unit": "°",
      "default": 15,
      "info": "0° looks straight at the product, 75° looks down from above."
    },
    {
      "type": "checkbox",
      "id": "allow_drag",
      "label": "Let visitors drag to rotate",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "allow_zoom",
      "label": "Let visitors zoom",
      "default": false,
      "info": "Off keeps the mouse wheel scrolling the page."
    },
    {
      "type": "checkbox",
      "id": "enable_ar",
      "label": "Show “View in your space” (AR) on supported phones",
      "default": true
    },
    {
      "type": "checkbox",
