{% comment %}
  Beauty Bundle Feature Section
  File: sections/beauty-bundle-feature.liquid
{% endcomment %}

{{ 'section-beauty-bundle-feature.css' | asset_url | stylesheet_tag }}

<shop-the-look
  class="shop-the-look section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  id="shop-the-look-{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="shop-the-look__grid shop-the-look__grid--{{ section.settings.image_position }}">
    <div class="shop-the-look__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag:
          loading: 'lazy',
          widths: '600, 900, 1200, 1600',
          class: 'shop-the-look__image'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'shop-the-look__image shop-the-look__image--placeholder' }}
      {%- endif -%}

      <div class="shop-the-look__hotspots" aria-hidden="true">
        {%- for block in section.blocks -%}
          <button
            class="shop-the-look__hotspot"
            type="button"
            style="left: {{ block.settings.hotspot_x }}%; top: {{ block.settings.hotspot_y }}%;"
            data-hotspot-id="{{ section.id }}-{{ block.id }}"
          >
            <span class="shop-the-look__hotspot-dot"></span>
          </button>
        {%- endfor -%}
      </div>
    </div>

    <div class="shop-the-look__content">
      {%- assign has_linked_products = false -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank -%}
          {%- assign has_linked_products = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="shop-the-look__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <div class="shop-the-look__heading-row">
        {%- if section.settings.heading != blank -%}
          <h2 class="shop-the-look__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if has_linked_products -%}
          <button
            type="button"
            class="shop-the-look__bundle-btn"
            aria-label="Add all bundle items to cart"
          >
            <span class="shop-the-look__bundle-btn-idle">Add Bundle to Cart</span>
            <span class="shop-the-look__bundle-btn-loading" hidden>Adding…</span>
            <span class="shop-the-look__bundle-btn-done" hidden>&#10003; Added to Cart</span>
            <span class="shop-the-look__bundle-btn-error" hidden>&#10007; Try Again</span>
          </button>
        {%- endif -%}
      </div>

      {%- if section.settings.subheading != blank -%}
        <p class="shop-the-look__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div
        class="shop-the-look__list shop-the-look__list--{{ section.settings.divider_style }}{% if section.blocks.size > section.settings.max_items %} is-scroll{% endif %}"
        style="--stl-item-max: {{ section.settings.max_items | default: 3 }};"
      >
        {%- for block in section.blocks -%}
          {%- assign block_product = block.settings.product -%}
          <div class="shop-the-look__item" data-item-id="{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="shop-the-look__item-card" style="background-color: {{ section.settings.card_background }}; border-radius: {{ section.settings.card_radius }}px;">
              <div class="shop-the-look__item-media">
                {%- if block_product != blank and block_product.featured_image != blank -%}
                  {{ block_product.featured_image | image_url: width: 240 | image_tag:
                    loading: 'lazy',
                    widths: '120, 180, 240',
                    class: 'shop-the-look__item-image'
                  }}
                {%- elsif block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 240 | image_tag:
                    loading: 'lazy',
                    widths: '120, 180, 240',
                    class: 'shop-the-look__item-image'
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'shop-the-look__item-image shop-the-look__item-image--placeholder' }}
                {%- endif -%}
              </div>
              <div class="shop-the-look__item-body">
                <div class="shop-the-look__item-header">
                  {%- if block_product != blank -%}
                    <h3 class="shop-the-look__item-title">{{ block_product.title }}</h3>
                  {%- elsif block.settings.title != blank -%}
                    <h3 class="shop-the-look__item-title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                </div>
                {%- if block_product != blank and block_product.description != blank -%}
                  <p class="shop-the-look__item-desc">{{ block_product.description | strip_html | truncate: 120 }}</p>
                {%- elsif block.settings.description != blank -%}
                  <p class="shop-the-look__item-desc">{{ block.settings.description }}</p>
                {%- endif -%}
                {%- if block_product != blank -%}
                  <span class="shop-the-look__item-price">{{ block_product.price | money }}</span>
                {%- elsif block.settings.price != blank -%}
                  <span class="shop-the-look__item-price">{{ block.settings.price }}</span>
                {%- endif -%}
                {%- if section.settings.show_rating and block.settings.rating > 0 -%}
                  <div class="shop-the-look__rating" aria-label="Rating: {{ block.settings.rating }} out of 5">
                    {%- for i in (1..5) -%}
                      <span class="shop-the-look__star{% if i <= block.settings.rating %} is-filled{% endif %}">★</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
              {%- if block_product != blank -%}
                <a class="shop-the-look__item-link" href="{{ block_product.url }}" aria-label="{{ block_product.title }}"></a>
              {%- elsif block.settings.link != blank -%}
                <a class="shop-the-look__item-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | default: 'View item' }}"></a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}

      </div>

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="shop-the-look__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</shop-the-look>

<script>
  class ShopTheLook extends HTMLElement {
    connectedCallback() {
      this.hotspots = Array.from(this.querySelectorAll('.shop-the-look__hotspot'));
      this.items = Array.from(this.querySelectorAll('.shop-the-look__item'));

      this.onHotspotEnter = this.onHotspotEnter.bind(this);
      this.onHotspotLeave = this.onHotspotLeave.bind(this);
      this.onItemEnter = this.onItemEnter.bind(this);
      this.onItemLeave = this.onItemLeave.bind(this);
      this.onBundleClick = this.onBundleClick.bind(this);

      if (this.hotspots.length && this.items.length) {
        this.hotspots.forEach((hotspot) => {
          hotspot.addEventListener('mouseenter', this.onHotspotEnter);
          hotspot.addEventListener('focus', this.onHotspotEnter);
          hotspot.addEventListener('mouseleave', this.onHotspotLeave);
          hotspot.addEventListener('blur', this.onHotspotLeave);
        });

        this.items.forEach((item) => {
          item.addEventListener('mouseenter', this.onItemEnter);
          item.addEventListener('focusin', this.onItemEnter);
          item.addEventListener('mouseleave', this.onItemLeave);
          item.addEventListener('focusout', this.onItemLeave);
        });
      }

      this.bundleBtn = this.querySelector('.shop-the-look__bundle-btn');
      if (this.bundleBtn) {
        this.bundleBtn.addEventListener('click', this.onBundleClick);
      }
    }

    disconnectedCallback() {
      if (this.hotspots && this.items) {
        this.hotspots.forEach((hotspot) => {
          hotspot.removeEventListener('mouseenter', this.onHotspotEnter);
          hotspot.removeEventListener('focus', this.onHotspotEnter);
          hotspot.removeEventListener('mouseleave', this.onHotspotLeave);
          hotspot.removeEventListener('blur', this.onHotspotLeave);
        });
        this.items.forEach((item) => {
          item.removeEventListener('mouseenter', this.onItemEnter);
          item.removeEventListener('focusin', this.onItemEnter);
          item.removeEventListener('mouseleave', this.onItemLeave);
          item.removeEventListener('focusout', this.onItemLeave);
        });
      }
      if (this.bundleBtn) {
        this.bundleBtn.removeEventListener('click', this.onBundleClick);
      }
    }

    clearActive() {
      this.hotspots.forEach((el) => el.classList.remove('is-active'));
      this.items.forEach((el) => el.classList.remove('is-active'));
      this.classList.remove('has-active');
    }

    activateById(id) {
      this.clearActive();
      const hotspot = this.querySelector('.shop-the-look__hotspot[data-hotspot-id=\"' + id + '\"]');
      const item = this.querySelector('.shop-the-look__item[data-item-id=\"' + id + '\"]');
      if (hotspot) hotspot.classList.add('is-active');
      if (item) item.classList.add('is-active');
      this.classList.add('has-active');

      if (item) {
        const list = this.querySelector('.shop-the-look__list.is-scroll');
        if (list) {
          const itemTop = item.offsetTop;
          const itemBottom = itemTop + item.offsetHeight;
          const listTop = list.scrollTop;
          const listBottom = listTop + list.clientHeight;
          if (itemTop < listTop || itemBottom > listBottom) {
            list.scrollTo({ top: Math.max(itemTop - 8, 0), behavior: 'smooth' });
          }
        }
      }
    }

    onHotspotEnter(event) {
      this.activateById(event.currentTarget.getAttribute('data-hotspot-id'));
    }

    onHotspotLeave() {
      this.clearActive();
    }

    onItemEnter(event) {
      this.activateById(event.currentTarget.getAttribute('data-item-id'));
    }

    onItemLeave() {
      this.clearActive();
    }

    onBundleClick() {
      var btn = this.bundleBtn;
      var ids = (btn.dataset.variantIds || '')
        .split(',')
        .map(function(s) { return s.trim(); })
        .filter(function(s) { return s && Number(s) > 0; });
      if (!ids.length) return;

      var idle    = btn.querySelector('.shop-the-look__bundle-btn-idle');
      var loading = btn.querySelector('.shop-the-look__bundle-btn-loading');
      var done    = btn.querySelector('.shop-the-look__bundle-btn-done');
      var error   = btn.querySelector('.shop-the-look__bundle-btn-error');

      function resetBtn() {
        if (loading) loading.hidden = true;
        if (idle) idle.hidden = false;
        btn.disabled = false;
      }

      btn.disabled = true;
      if (idle) idle.hidden = true;
      if (loading) loading.hidden = false;

      var items = ids.map(function(id) { return { id: Number(id), quantity: 1 }; });

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(function(r) {
        if (!r.ok) {
          return r.json().then(function(err) {
            throw new Error(err.description || err.message || 'Cart error ' + r.status);
          });
        }
        return r.json();
      })
      .then(function() {
        return fetch('/cart.js', { headers: { 'Accept': 'application/json' } });
      })
      .then(function(r) { return r.json(); })
      .then(function(cartData) {
        if (loading) loading.hidden = true;
        if (done) done.hidden = false;
        btn.classList.add('is-success');

        var evt = new Event('cart:update', { bubbles: true });
        evt.detail = {
          resource: cartData,
          data: { itemCount: cartData.item_count, source: 'bundle' }
        };
        document.dispatchEvent(evt);

        setTimeout(function() {
          if (done) done.hidden = true;
          if (idle) idle.hidden = false;
          btn.disabled = false;
          btn.classList.remove('is-success');
        }, 2500);
      })
      .catch(function(err) {
        console.error('[Bundle] Add to cart failed:', err.message);
        if (loading) loading.hidden = true;
        if (error) {
          error.hidden = false;
          btn.classList.add('is-error');
          setTimeout(function() {
            error.hidden = true;
            btn.classList.remove('is-error');
            resetBtn();
          }, 3000);
        } else {
          resetBtn();
        }
      });
    }
  }

  if (!customElements.get('shop-the-look')) {
    customElements.define('shop-the-look', ShopTheLook);
  }
</script>

{% schema %} 
{
  "name": "Beauty Bundle Feature",
  "tag": "section",
  "class": "section-beauty-bundle-feature",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Be yourself"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beauty Cream Bundles"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Item divider style",
      "options": [
        { "value": "lines", "label": "Lines" },
        { "value": "none", "label": "None" }
      ],
      "default": "lines"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Max items to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Item card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Item card radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Link a product to enable 'Add Bundle to Cart'"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot X position",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 35,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot Y position",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 55,
          "unit": "%"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Face Cream"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A lightweight, deeply nourishing cream that hydrates and soothes."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$100"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beauty Bundle Feature",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item",
          "settings": {
            "title": "Body Lotion",
            "price": "$58",
            "rating": 5
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Body Serum",
            "price": "$72",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
