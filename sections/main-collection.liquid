{%- comment -%}
  Whispo — collection page (main section).

  Banner (title, description, optional image) · toolbar (filters, count, sort) · active filter chips · product
  grid (snippets/product-card.liquid) · pagination. Filters sit in a sidebar on desktop or in a drawer
  (setting), always in a drawer on mobile; changes update in place (assets/facets.js). Empty collections and
  filter combinations without products get their own messages.

  Files: assets/component-facets.css, assets/component-product-card.css, assets/facets.js,
  assets/quick-view.js, snippets/facets.liquid, snippets/pagination.liquid.
{%- endcomment -%}

{%- comment -%} 1. CSS {%- endcomment -%}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{%- comment -%} 2. Liquid {%- endcomment -%}
<script src="{{ 'facets.js' | asset_url }}" type="module"></script>
<script src="{{ 'quick-view.js' | asset_url }}" type="module"></script>

{%- liquid
  assign layout = section.settings.filter_layout
  assign filtering = section.settings.enable_filtering
  if collection.filters.size == 0
    assign filtering = false
  endif
-%}

<div class="main-collection color-{{ section.settings.color_scheme }}">
  {%- if section.settings.show_banner -%}
    <header class="collection-banner page-width{% if section.settings.show_image and collection.image %} collection-banner--image{% endif %}">
      <div class="collection-banner__text">
        <h1 class="collection-banner__title h1">{{ collection.title | escape }}</h1>
        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="collection-banner__description rte">{{ collection.description }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.show_image and collection.image -%}
        <div class="collection-banner__media media">
          {%- assign image_alt = collection.image.alt | default: collection.title -%}
          {{ collection.image | image_url: width: 1600 | image_tag: widths: '600, 800, 1000, 1200, 1600', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: image_alt }}
        </div>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- paginate collection.products by section.settings.products_per_page -%}
    <facet-filters
      class="collection-results page-width collection-results--{{ layout }}{% if filtering %} has-filters{% endif %}"
      data-section-id="{{ section.id }}"
      data-form-id="FacetsForm-{{ section.id }}"
    >
      {%- render 'facets', part: 'form', results: collection, id: section.id, action: collection.url -%}

      {%- if filtering -%}
        {%- render 'facets', part: 'filters', results: collection, id: section.id, action: collection.url, layout: layout -%}
      {%- endif -%}

      <div class="collection-results__main">
        {%- liquid
          if filtering
            render 'facets', part: 'toolbar', results: collection, id: section.id, action: collection.url, enable_sorting: section.settings.enable_sorting
          elsif section.settings.enable_sorting
            render 'facets', part: 'toolbar', results: collection, id: section.id, action: collection.url, enable_sorting: true
          endif
        -%}
        {%- render 'facets', part: 'active', results: collection, id: section.id, action: collection.url -%}

        <div class="collection-results__grid" data-facets-update="results">
          {%- if collection.products.size > 0 -%}
            <ul
              class="product-grid"
              role="list"
              style="--columns: {{ section.settings.columns }}; --columns-mobile: {{ section.settings.columns_mobile }};"
            >
              {%- for product in collection.products -%}
                <li>
                  {%- liquid
                    assign loading = 'lazy'
                    if forloop.index <= section.settings.columns
                      assign loading = 'eager'
                    endif
                    render 'product-card', product: product, ratio: section.settings.image_ratio, show_vendor: section.settings.show_vendor, show_rating: section.settings.show_rating, show_quick_add: section.settings.show_quick_add, id_prefix: section.id, loading: loading, heading_level: 'h2'
                  -%}
                </li>
              {%- endfor -%}
            </ul>
            {%- render 'pagination', paginate: paginate -%}
          {%- elsif collection.all_products_count == 0 -%}
            <div class="collection-empty">
              <p class="h4">{{ 'collections.empty' | t }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue_shopping' | t }}</a>
            </div>
          {%- else -%}
            <div class="collection-empty">
              <p class="h4">{{ 'facets.no_results' | t }}</p>
              <a href="{{ collection.url }}" class="button button--secondary" data-facet-link>{{ 'facets.clear_all' | t }}</a>
            </div>
          {%- endif -%}
        </div>
      </div>
    </facet-filters>
  {%- endpaginate -%}
</div>

{%- comment -%} 3. Schema {%- endcomment -%}
{% schema %}
{
  "name": "t:sections.main_collection.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main_collection.banner"
    },
    { "type": "checkbox", "id": "show_banner", "label": "t:sections.main_collection.show_banner", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "t:sections.main_collection.show_description", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "t:sections.main_collection.show_image", "default": false },
    {
      "type": "header",
      "content": "t:sections.main_collection.grid"
    },
    { "type": "range", "id": "products_per_page", "label": "t:sections.main_collection.products_per_page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "t:sections.main_collection.columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.main_collection.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.main_collection.image_ratio",
      "options": [
        { "value": "1", "label": "t:sections.main_collection.ratio_square" },
        { "value": "0.8", "label": "t:sections.main_collection.ratio_portrait" },
        { "value": "0.75", "label": "t:sections.main_collection.ratio_tall" }
      ],
      "default": "0.8"
    },
    { "type": "checkbox", "id": "show_vendor", "label": "t:sections.main_collection.show_vendor", "default": false },
    { "type": "checkbox", "id": "show_rating", "label": "t:sections.main_collection.show_rating", "info": "t:sections.main_collection.show_rating_info", "default": true },
    { "type": "checkbox", "id": "show_quick_add", "label": "t:sections.main_collection.show_quick_add", "default": true },
    {
      "type": "header",
      "content": "t:sections.main_collection.filtering"
    },
    { "type": "checkbox", "id": "enable_filtering", "label": "t:sections.main_collection.enable_filtering", "info": "t:sections.main_collection.enable_filtering_info", "default": true },
    {
      "type": "select",
      "id": "filter_layout",
      "label": "t:sections.main_collection.filter_layout",
      "options": [
        { "value": "sidebar", "label": "t:sections.main_collection.layout_sidebar" },
        { "value": "drawer", "label": "t:sections.main_collection.layout_drawer" }
      ],
      "default": "sidebar"
    },
    { "type": "checkbox", "id": "enable_sorting", "label": "t:sections.main_collection.enable_sorting", "default": true },
    {
      "type": "header",
      "content": "t:sections.main_collection.section"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.main_collection.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:sections.main_collection.padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.main_collection.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
