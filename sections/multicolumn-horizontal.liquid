{%- comment -%}
  Multicolumn Horizontal Section
  
  Layout: Left side (title/content) + Right side (grid of cards)
  Desktop: 2-column layout (title left, cards right)
  Mobile: Stacked layout
{%- endcomment -%}

{%- liquid
  assign section_caption = section.settings.caption
  assign section_heading = section.settings.heading
  assign section_description = section.settings.description
  assign show_button = section.settings.show_button
  assign show_button_3 = section.settings.show_button_3
  assign button_label = section.settings.button_label
  assign button_label_3 = section.settings.button_label_3
  assign button_link = section.settings.button_link
  assign button_link_3 = section.settings.button_link_3
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign add_top_padding = section.settings.add_top_padding | default: false
  assign add_bottom_padding = section.settings.add_bottom_padding | default: false
  assign enable_grid_layout = section.settings.enable_grid_layout 
-%} 


<style>
  #{{ section.id }} {
    padding-top: {{ section.settings.add_top_padding_mobile }}px;
    padding-bottom: {{ section.settings.add_bottom_padding_mobile }}px;
  }
  @media(min-width: 1024px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.add_top_padding_desktop }}px;
      padding-bottom: {{ section.settings.add_bottom_padding_desktop }}px;
    }
  }
</style>

<div id="{{ section.id }}" class="multicolumn-horizontal {{ section.settings.parent_class }} tw-w-full {% if add_top_padding %}section-padding-top{% endif %} {% if add_bottom_padding %}section-padding-bottom{% endif %}">
  <div class="section-container multicolumn-horizontal__container">
        {% liquid 
        assign has_title_content = false
        if section_caption != blank or section_heading != blank or section_description != blank or show_button
          assign has_title_content = true
        endif
      %}
    {%- comment -%} Main Layout: Left Title/Content + Right Cards Grid (Grid at top level) {%- endcomment -%}
    {%- comment -%} Mobile (< 638px): Stacked | Tablet (638px-1280px): Stacked | Desktop (> 1280px): Side-by-side {%- endcomment -%}
    <div class="multicolumn-horizontal__wrapper{% if enable_grid_layout %} tw-grid tw-grid-cols-1 lg:tw-grid-cols-[310px_1fr] !tw-gap-8 {% endif %}">
      {%- comment -%} Left: Title Content Wrapper {%- endcomment -%}
      {%- comment -%} Mobile: Button below (flex-col) | Tablet: Button on right (flex-row) | Desktop: Button below (flex-col) {%- endcomment -%}
      <div class="multicolumn-horizontal__title-wrapper tw-flex tw-flex-col md:tw-flex-row md:tw-items-start md:tw-justify-between lg:tw-flex-col lg:tw-items-start lg:tw-justify-start tw-gap-4 lg:tw-gap-10">
        {%  if has_title_content %}
        {%- comment -%} Content Block (Caption, Heading, Description) {%- endcomment -%}
            <div class="tw-flex tw-flex-col tw-gap-4 md:tw-gap-5 tw-max-w-[565px]">
              {%- comment -%} Caption {%- endcomment -%}
              {%- if section_caption != blank -%}
                {%- render 'caption',
                  text: section_caption,
                  color: '#323e46',
                  block_shopify_attributes: ''
                -%}
              {%- endif -%}
              
              {%- comment -%} Heading {%- endcomment -%}
              {%- if section_heading != blank -%}
                {%- render 'heading',
                  text: section_heading,
                  variant: 'h3',
                  color: section.settings.heading_color,
                  block_shopify_attributes: ''
                -%}
              {%- endif -%}
              
              {%- comment -%} Description {%- endcomment -%}
              {%- if section_description != blank -%}
                {% render 'body', text: section_description, variant: 'base' , parent_class: "multicolumn-horizontal__description", color: '#323e46' %}
              {%- endif -%}
            </div>
          {% endif %}
          {%- comment -%} Secondary Button (Below on mobile/desktop, Right on tablet) {%- endcomment -%}
          {%- if show_button or show_button_3 -%}
            <div class="multicolumn-horizontal__button md:tw-pt-0 md:tw-justify-end md:tw-shrink-0">
              {%- render 'button-group',
                show_button_1: false,
                button_1_label: '',
                button_1_link: '',
                show_button_2: show_button,
                button_2_label: button_label,
                button_2_link: button_link,
                button_2_color: 'blue',
                show_button_3: show_button_3,
                button_3_label: button_label_3,
                button_3_link: button_link_3,
                block_shopify_attributes: ''
              -%}
            </div>
          {%- endif -%}
          
        </div>
      {% comment %} {%- endif -%}
       {% endcomment %}
      {%- comment -%} Right: Cards Grid {%- endcomment -%}
      {%- comment -%} Dynamic grid columns based on section settings {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <div class="multicolumn-horizontal__cards tw-flex-1 tw-min-w-0">
          {%- liquid
              assign grid_classes = 'tw-grid tw-grid-cols-1 tw-gap-5 md-small:tw-grid-cols-1 md:tw-grid-cols-3'
              
              case columns_desktop
                when 1
                  assign grid_classes = grid_classes | append: ' lg:tw-grid-cols-1'
                when 2
                  assign grid_classes = grid_classes | append: ' lg:tw-grid-cols-2'
                when 3
                  assign grid_classes = grid_classes | append: ' lg:tw-grid-cols-3'
                when 4
                  assign grid_classes = grid_classes | append: ' lg:tw-grid-cols-4'
              endcase

          -%}
          <div class="{% if enable_grid_layout %} {{ grid_classes }} {% endif %}">
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                {%- render block %}
              {%- else -%}
                {%- render block, section: section %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Multicolumn Horizontal",
  "tag": "section",
  "class": "section multicolumn-horizontal",
  "settings": [
    {
      "type": "text",
      "id": "parent_class",
      "label": "Parent class",
      "info": "Optional parent class for the section"
    },
    {
      "type": "header",
      "content": "Title Content"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Caption"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#00a3a3"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed dictum augue a felis accumsan fermentum. Vivamus sit amet lorem eu lectus bibendum bibendum.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all Services"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Button Tertiary"
    },
    {
      "type": "checkbox",
      "id": "show_button_3",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label_3",
      "label": "Button label",
      "default": "View all Services"
    },
    {
      "type": "url",
      "id": "button_link_3",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_grid_layout",
      "label": "Enable grid layout",
      "default": true,
      "info": "Enable the grid layout for title and cards (side-by-side on desktop)"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "Number of columns on desktop screens (1440px and above)"
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "text",
      "id": "add_top_padding_mobile",
      "label": "Add top padding mobile",
      "default": "44"
    },
    {
      "type": "text",
      "id": "add_bottom_padding_mobile",
      "label": "Add bottom padding mobile",
      "default": "44"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "text",
      "id": "add_top_padding_desktop",
      "label": "Add top padding Desktop",
      "default": "96"
    },
    {
      "type": "text",
      "id": "add_bottom_padding_desktop",
      "label": "Add bottom padding Desktop",
      "default": "96"
    }
  ],
  "blocks": [
    { "type": "column-card"},
    { "type": "parent-multicolumn-horizontal-v3" },
    { "type": "parent-multicolumn-horizontal-v4" },
  ],
  "presets": [
    {
      "name": "Multicolumn Horizontal",
      "blocks": [
        
      ]
    }
  ]
}
{% endschema %}

