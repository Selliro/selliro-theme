{%- comment -%}
  Comparison table — "Why we're different": your product (highlighted column) against two others,
  one row per feature. Rows are blocks with a yes / no (or short text) per column.
{%- endcomment -%}
{{ 'section-reveal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-reveal.js' | asset_url }}" defer></script>

{%- liquid
  assign ours = section.settings.product
  if ours == blank
    assign ours = product
  endif
  assign ours_image = section.settings.our_image | default: ours.featured_image
  assign ours_title = section.settings.our_title | default: ours.title
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="cmp page-width color-{{ section.settings.color_scheme }} cmp--intro-{{ section.settings.intro_position | default: 'side' }}"
  data-reveal
  style="--cmp-pad-top: {{ section.settings.padding_top }}px; --cmp-pad-bottom: {{ section.settings.padding_bottom }}px; --cmp-accent: {{ section.settings.accent_color | default: '#1f3b1a' }}; --cmp-accent-text: {{ section.settings.accent_text | default: '#ffffff' }};"
>
  <div class="cmp__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="cmp__heading" data-reveal-title>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="cmp__text" data-reveal-fade>{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>

  <div class="cmp__scroller" data-reveal-rise>
    <table class="cmp__table">
      <caption class="visually-hidden">{{ section.settings.heading | escape }}</caption>
      <thead>
        <tr>
          <td class="cmp__corner"></td>
          <th scope="col" class="cmp__col cmp__col--ours">
            <span class="cmp__badge" aria-hidden="true">{%- render 'pdp-icon', icon: 'sparkle' -%}</span>
            <span class="cmp__product">
              {%- if ours_image != blank -%}
                {{ ours_image | image_url: width: 320 | image_tag: loading: 'lazy', width: 120, height: 120, alt: '' }}
              {%- endif -%}
              <span class="cmp__name">{{ ours_title | escape }}</span>
              {%- if ours != blank -%}
                <span class="cmp__price">{{ ours.price | money }}</span>
              {%- endif -%}
            </span>
          </th>
          {%- for i in (1..2) -%}
            {%- assign k_t = 'other_' | append: i | append: '_title' -%}
            {%- assign k_i = 'other_' | append: i | append: '_image' -%}
            <th scope="col" class="cmp__col">
              <span class="cmp__product">
                {%- if section.settings[k_i] != blank -%}
                  {{ section.settings[k_i] | image_url: width: 320 | image_tag: loading: 'lazy', width: 120, height: 120, alt: '' }}
                {%- endif -%}
                <span class="cmp__name">{{ section.settings[k_t] | escape }}</span>
              </span>
            </th>
          {%- endfor -%}
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <th scope="row" class="cmp__feature">{{ block.settings.feature | escape }}</th>
            {%- assign cells = 'ours,other_1,other_2' | split: ',' -%}
            {%- for cell in cells -%}
              {%- assign value = block.settings[cell] | default: 'no' -%}
              <td class="cmp__cell{% if forloop.first %} cmp__cell--ours{% endif %}">
                {%- case value -%}
                  {%- when 'yes' -%}
                    <span class="cmp__mark cmp__mark--yes">{%- render 'pdp-icon', icon: 'check' -%}<span class="visually-hidden">{{ section.settings.yes_label | escape }}</span></span>
                  {%- when 'no' -%}
                    <span class="cmp__mark cmp__mark--no">{%- render 'pdp-icon', icon: 'cross' -%}<span class="visually-hidden">{{ section.settings.no_label | escape }}</span></span>
                  {%- else -%}
                    <span class="cmp__mark cmp__mark--some">{{ section.settings.some_label | escape }}</span>
                {%- endcase -%}
              </td>
            {%- endfor -%}
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</section>

{% stylesheet %}
  .cmp {
    position: relative;
    display: grid;
    gap: 2rem;
    padding-block: var(--cmp-pad-top) var(--cmp-pad-bottom);
  }

  .cmp__heading {
    margin: 0;
    font-size: var(--section-title-size);
    font-weight: var(--section-title-weight);
    line-height: var(--section-title-leading);
    letter-spacing: var(--section-title-tracking);
  }

  .cmp__text {
    margin: 0.75rem 0 0;
    max-width: 24rem;
    opacity: 0.75;
  }

  .cmp__scroller {
    overflow-x: auto;
    padding-block-start: 1.25rem;
  }

  .cmp__table {
    width: 100%;
    min-width: 34rem;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }

  .cmp__corner,
  .cmp__feature {
    width: 34%;
  }

  .cmp__col {
    position: relative;
    padding: 1.5rem 0.75rem 1rem;
    vertical-align: bottom;
    font-weight: 400;
    border-radius: 18px 18px 0 0;
  }

  .cmp__col--ours {
    color: var(--cmp-accent-text);
    background: var(--cmp-accent);
  }

  .cmp__badge {
    position: absolute;
    top: -1rem;
    left: 50%;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--cmp-accent-text);
    background: var(--cmp-accent);
    box-shadow: 0 0 0 4px var(--color-background);
  }

  .cmp__badge svg {
    width: 1rem;
    height: 1rem;
  }

  .cmp__product {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .cmp__product img {
    width: clamp(4rem, 9vw, 6.5rem);
    height: clamp(4rem, 9vw, 6.5rem);
    object-fit: cover;
    border-radius: 12px;
    background: #fff;
  }

  .cmp__name {
    font-family: var(--font-heading--family);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .cmp__price {
    font-size: 0.8125rem;
    opacity: 0.85;
  }

  .cmp__feature {
    padding: 1rem 1rem 1rem 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-align: start;
    text-transform: uppercase;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .cmp__cell {
    padding: 1rem 0.5rem;
    text-align: center;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .cmp__cell--ours {
    color: var(--cmp-accent-text);
    background: var(--cmp-accent);
    border-bottom-color: color-mix(in srgb, var(--cmp-accent-text) 18%, transparent);
  }

  tbody tr:last-child .cmp__cell--ours {
    border-radius: 0 0 18px 18px;
    border-bottom-color: transparent;
  }

  .cmp__mark {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
  }

  .cmp__mark svg {
    width: 1rem;
    height: 1rem;
  }

  .cmp__mark--yes {
    background: color-mix(in srgb, currentColor 14%, transparent);
  }

  .cmp__mark--no {
    opacity: 0.4;
  }

  .cmp__mark--some {
    width: auto;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  /* Phones: shrink everything so the three columns fit without sideways scrolling */
  @media screen and (max-width: 749px) {
    .cmp__table {
      min-width: 0;
    }

    .cmp__corner,
    .cmp__feature {
      width: 31%;
    }

    .cmp__col {
      padding: 1.25rem 0.25rem 0.75rem;
      border-radius: 14px 14px 0 0;
    }

    .cmp__product img {
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 8px;
    }

    .cmp__name {
      font-size: 0.75rem;
    }

    .cmp__price {
      font-size: 0.6875rem;
    }

    .cmp__feature {
      padding-inline-end: 0.5rem;
      font-size: 0.625rem;
      letter-spacing: 0.04em;
    }

    .cmp__cell {
      padding: 0.75rem 0.25rem;
    }

    .cmp__mark {
      width: 1.5rem;
      height: 1.5rem;
    }

    .cmp__mark--some {
      font-size: 0.625rem;
    }

    tbody tr:last-child .cmp__cell--ours {
      border-radius: 0 0 14px 14px;
    }
  }

  /* Layout: centred intro above a full-width table */
  .cmp--intro-top .cmp__intro {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .cmp--intro-top .cmp__text {
    margin-inline: auto;
  }

  .cmp--intro-top .cmp__table {
    max-width: 62rem;
    margin-inline: auto;
  }

  @media screen and (min-width: 990px) {
    .cmp.cmp--intro-side {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 2fr);
      align-items: center;
      gap: 3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Comparison table",
  "class": "comparison-table-section",
  "settings": [
    {
      "type": "select",
      "id": "intro_position",
      "label": "Layout",
      "options": [
        {
          "value": "side",
          "label": "Intro beside the table"
        },
        {
          "value": "top",
          "label": "Intro above the table"
        }
      ],
      "default": "side"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why it's different"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Clean, clinically proven and kind to sensitive skin."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Your product",
      "info": "Defaults to the product on the page."
    },
    {
      "type": "text",
      "id": "our_title",
      "label": "Your product name (optional)"
    },
    {
      "type": "image_picker",
      "id": "our_image",
      "label": "Your product image (optional)"
    },
    {
      "type": "text",
      "id": "other_1_title",
      "label": "Comparison 1 name",
      "default": "Drugstore serum"
    },
    {
      "type": "image_picker",
      "id": "other_1_image",
      "label": "Comparison 1 image"
    },
    {
      "type": "text",
      "id": "other_2_title",
      "label": "Comparison 2 name",
      "default": "Luxury serum"
    },
    {
      "type": "image_picker",
      "id": "other_2_image",
      "label": "Comparison 2 image"
    },
    {
      "type": "text",
      "id": "yes_label",
      "label": "Yes label (screen readers)",
      "default": "Yes"
    },
    {
      "type": "text",
      "id": "no_label",
      "label": "No label (screen readers)",
      "default": "No"
    },
    {
      "type": "text",
      "id": "some_label",
      "label": "Partly label",
      "default": "Some"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Highlight column",
      "default": "#1f3b1a"
    },
    {
      "type": "color",
      "id": "accent_text",
      "label": "Highlight text",
      "default": "#ffffff"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature",
          "default": "Clean ingredients"
        },
        {
          "type": "select",
          "id": "ours",
          "label": "Your product",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            },
            {
              "value": "some",
              "label": "Partly"
            }
          ],
          "default": "yes"
        },
        {
          "type": "select",
          "id": "other_1",
          "label": "Comparison 1",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            },
            {
              "value": "some",
              "label": "Partly"
            }
          ],
          "default": "no"
        },
        {
          "type": "select",
          "id": "other_2",
          "label": "Comparison 2",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            },
            {
              "value": "some",
              "label": "Partly"
            }
          ],
          "default": "some"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "feature": "Clean ingredients",
            "ours": "yes",
            "other_1": "no",
            "other_2": "some"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Vegan & cruelty free",
            "ours": "yes",
            "other_1": "no",
            "other_2": "no"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Fragrance free",
            "ours": "yes",
            "other_1": "no",
            "other_2": "yes"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Under $50",
            "ours": "yes",
            "other_1": "yes",
            "other_2": "no"
          }
        }
      ]
    }
  ]
}
{% endschema %}
