

{% liquid
  assign animation_style = section.settings.animation_style | default: 'slideshow'
  assign is_marquee = false
  if animation_style == 'marquee'
    assign is_marquee = true
  endif
%}

{% comment %}
  Shopify allows only one {% content_for 'blocks' %} per section — capture once and reuse.
{% endcomment %}
{% capture announcement_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if is_marquee %}
  <script
    src="{{ 'marquee.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% elsif section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<aside
  class="announcement-bar spacing-style {{ section.settings.section_width }} color-{{ section.settings.color_scheme }}{% if is_marquee %} announcement-bar--marquee{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;"
>
  {% if is_marquee %}
    <marquee-component
      class="announcement-bar__marquee"
      style="{% render 'spacing-style', settings: section.settings %} --marquee-direction: {{ section.settings.marquee_direction | default: 'normal' }}; --marquee-gap: 48px;"
      data-speed-factor="{{ section.settings.speed | times: 2.5 | round }}"
      data-movement-direction="{{ section.settings.marquee_direction | default: 'normal' }}"
    >
      <div class="marquee__wrapper announcement-bar__marquee-wrapper" ref="wrapper">
        <div class="marquee__content" ref="content">
          <div class="marquee__repeated-items announcement-bar__marquee-items" ref="marqueeItems[]">
            {{ announcement_blocks }}
          </div>
        </div>
      </div>
    </marquee-component>
  {% else %}
    {% liquid
      assign autoplay = false
      if section.blocks.size > 1
        assign autoplay = true
      endif
    %}

    <announcement-bar-component
      class="announcement-bar__slider"
      {% if autoplay == true %}
        autoplay="{{ section.settings.speed }}" aria-live="polite"
      {% endif %}
    >

      <div class="announcement-bar__slides">
        {{ announcement_blocks }}
      </div>
    </announcement-bar-component>
  {% endif %}
</aside>

{% stylesheet %}

  .announcement-bar {
    background-color: var(--color-background) !important;
    color: var(--color-foreground);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  announcement-bar-component.announcement-bar__slider {
    --button-size: 13px;
    --icon-size-xs: 14px;

  }
  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
    position: relative;
    min-height: var(--minimum-touch-target);
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  /* Absolutely overlay arrows so they align with slides and stay clickable (parent is positioning context) */
  .announcement-bar__slides slideshow-arrows {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    box-sizing: border-box;
  }

  .announcement-bar__slides .announcement-bar__slide {
    z-index: 0;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    min-width: 0;
    min-height: 0;
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;
    flex-shrink: 0;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  .announcement-bar--marquee marquee-component {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .announcement-bar--marquee .marquee__wrapper {
    display: flex;
    width: fit-content;
    white-space: nowrap;
  }

  .announcement-bar--marquee .marquee__content {
    min-width: max-content;
    display: flex;
    align-items: center;
  }

  .announcement-bar--marquee .marquee__repeated-items {
    min-width: max-content;
    display: flex;
    align-items: center;
    gap: var(--marquee-gap, 2rem);
  }

  .announcement-bar--marquee .marquee__repeated-items > * {
    flex-shrink: 0;
    max-width: none;
  }

  .announcement-bar--marquee .announcement-bar__marquee-item {
    white-space: nowrap;
  }

  .announcement-bar--marquee .announcement-bar__marquee-item .announcement-bar__text {
    margin: 0;
  }

  .announcement-bar__slide .announcement-bar__inner {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .announcement-bar--marquee marquee-component:not([data-disabled]) .marquee__wrapper {
      animation: announcement-marquee-motion var(--marquee-speed, 30s) linear infinite var(--marquee-direction, normal);
    }
  }

  @keyframes announcement-marquee-motion {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap, 2rem) / 2)), 0, 0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    },
    {
      "type": "social-links"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "animation_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "slideshow",
          "label": "slideshow"
        },
        {
          "value": "marquee",
          "label": "marquee"
        }
      ],
      "default": "slideshow"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "marquee direction",
      "options": [
        {
          "value": "normal",
          "label": "t:options.left"
        },
        {
          "value": "reverse",
          "label": "t:options.right"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.animation_style == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-4",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
