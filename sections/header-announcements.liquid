{%- comment -%}
  Announcement bar (header group).
  · Slideshow: one announcement at a time. Transition: slide (from the side), slide up, or fade. Arrows, swipe on
    touch screens, autoplay that pauses on hover.
  · Marquee: a continuously scrolling line of announcements. Speed, direction, spacing and an optional separator.
  · Both: solid colour scheme or a two-colour gradient background.
  Blocks: _announcement (text, link, icon, typography), social-links.
  Files:  assets/section-header-announcements.css (styles), assets/announcement-bar.js (slideshow),
          assets/marquee.js (marquee).
  Order:  1. CSS   2. Liquid (data + markup)   3. Schema
{%- endcomment -%}

{%- liquid
  assign animation_style = section.settings.animation_style | default: 'slideshow'
  assign is_marquee = false
  if animation_style == 'marquee'
    assign is_marquee = true
  endif

  assign transition = section.settings.slide_transition | default: 'slide' | replace: '_', '-'
  assign separator = section.settings.separator | default: 'none'
  assign marquee_speed = section.settings.marquee_speed | default: 5
  comment
    marquee.js turns the speed factor into the loop duration (bigger factor = slower), so invert the 1-10 setting
  endcomment
  assign marquee_factor = 12 | minus: marquee_speed | times: 2.5
-%}

{%- comment -%} ============================================================== 1. CSS {%- endcomment -%}
{{ 'section-header-announcements.css' | asset_url | stylesheet_tag }}

{%- comment -%} Values that come from this section's settings (the rest is in section-header-announcements.css) {%- endcomment -%}
{% style %}
  #shopify-section-{{ section.id }} .announcement-bar {
    {% render 'spacing-padding', settings: section.settings %}
    --border-bottom-width: {{ section.settings.divider_width }}px;
    --ab-gap: {{ section.settings.marquee_gap | default: 48 }}px;
    {%- if section.settings.background_style == 'gradient' %}
    --ab-gradient-start: {{ section.settings.gradient_start }};
    --ab-gradient-end: {{ section.settings.gradient_end }};
    {%- endif %}
  }
{% endstyle %}

{%- comment -%} =========================================================== 2. Liquid {%- endcomment -%}
{% if is_marquee %}
  <script
    src="{{ 'marquee.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% elsif section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% comment %}
  Shopify allows only one {% content_for 'blocks' %} per section — capture once and reuse.
{% endcomment %}
{% capture announcement_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<aside
  class="
    announcement-bar spacing-style {{ section.settings.section_width }} color-{{ section.settings.color_scheme }}
    {% if is_marquee %}announcement-bar--marquee{% if separator != 'none' %} announcement-bar--sep-{{ separator }}{% endif %}{% else %}announcement-bar--slideshow announcement-bar--{{ transition }}{% endif %}
    {% if section.settings.pause_on_hover %}announcement-bar--pause-hover{% endif %}
    {% if section.settings.background_style == 'gradient' %}announcement-bar--gradient{% endif %}
  "
>
  {% if is_marquee %}
    <marquee-component
      class="announcement-bar__marquee"
      style="--marquee-direction: {{ section.settings.marquee_direction | default: 'normal' }}; --marquee-gap: var(--ab-gap, 48px);"
      data-speed-factor="{{ marquee_factor | round }}"
      data-movement-direction="{{ section.settings.marquee_direction | default: 'normal' }}"
    >
      <div
        class="marquee__wrapper announcement-bar__marquee-wrapper"
        ref="wrapper"
      >
        <div
          class="marquee__content"
          ref="content"
        >
          <div
            class="marquee__repeated-items announcement-bar__marquee-items"
            ref="marqueeItems[]"
          >
            {{ announcement_blocks }}
          </div>
        </div>
      </div>
    </marquee-component>
  {% else %}
    <announcement-bar-component
      class="announcement-bar__slider"
      data-direction="next"
      {% if section.blocks.size > 1 %}
        autoplay="{{ section.settings.speed }}"
        aria-live="polite"
        {% if section.settings.pause_on_hover %}
          pause-on-hover
        {% endif %}
      {% endif %}
    >
      <div class="announcement-bar__slides">
        {{ announcement_blocks }}
      </div>
    </announcement-bar-component>
  {% endif %}
</aside>

{%- comment -%} =========================================================== 3. Schema {%- endcomment -%}
{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    },
    {
      "type": "social-links"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "animation_style",
      "label": "Style",
      "options": [
        {
          "value": "slideshow",
          "label": "Slideshow (one at a time)"
        },
        {
          "value": "marquee",
          "label": "Marquee (scrolling)"
        }
      ],
      "default": "slideshow"
    },
    {
      "type": "header",
      "content": "Slideshow",
      "visible_if": "{{ section.settings.animation_style != 'marquee' }}"
    },
    {
      "type": "select",
      "id": "slide_transition",
      "label": "Transition",
      "options": [
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "slide_up",
          "label": "Slide up"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ],
      "default": "slide",
      "visible_if": "{{ section.settings.animation_style != 'marquee' }}"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Time per announcement",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s",
      "visible_if": "{{ section.settings.animation_style != 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true,
      "visible_if": "{{ section.settings.animation_style != 'marquee' }}"
    },
    {
      "type": "header",
      "content": "Marquee",
      "visible_if": "{{ section.settings.animation_style == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Scroll speed",
      "info": "Higher is faster.",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.animation_style == 'marquee' }}"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Direction",
      "options": [
        {
          "value": "normal",
          "label": "t:options.left"
        },
        {
          "value": "reverse",
          "label": "t:options.right"
        }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.animation_style == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "marquee_gap",
      "label": "Space between announcements",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.animation_style == 'marquee' }}"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Separator",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "dot",
          "label": "Dot"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "line",
          "label": "Line"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.animation_style == 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-4",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background",
      "options": [
        {
          "value": "scheme",
          "label": "Color scheme"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "scheme"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient start",
      "default": "#fad02c",
      "visible_if": "{{ section.settings.background_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient end",
      "default": "#f6e7a6",
      "visible_if": "{{ section.settings.background_style == 'gradient' }}"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
