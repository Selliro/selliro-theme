

{% if section.blocks.size > 1 %}
  {% capture controls %}
    {%- liquid
      assign controls_style = section.settings.slideshow_controls_style
      if controls_style == 'bars'
        assign controls_style = 'dots'
      endif
    -%}
    {%- render 'slideshow-controls',
      style: controls_style,
      autoplay: section.settings.autoplay,
      item_count: section.blocks.size,
      show_arrows: false,
      arrows_on_media: true,
      controls_on_media: true,
      pagination_position: 'center',
      icon_style: section.settings.icons_style
    -%}
  {% endcapture %}
{% endif %}

{% capture slides %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  assign slideshow_class = 'slideshow--single-media'
  if section.blocks.size > 1
    assign slideshow_class = ''
  endif

  assign show_arrows = true
  if section.settings.icons_style == 'none' or section.blocks.size <= 1
    assign show_arrows = false
  endif
%}

{%- liquid
  assign content_style = section.settings.content_style | default: 'glass'
  assign arrow_position = section.settings.arrow_position | default: 'center'
  assign pagination = section.settings.slideshow_controls_style | default: 'dots'
-%}
{% style %}
  #shopify-section-{{ section.id }} {
    --ss-heading-size: {{ section.settings.heading_size | default: 64 }}px;
    --ss-heading-case: {% if section.settings.heading_case == 'uppercase' %}uppercase{% else %}none{% endif %};
    --ss-radius: {{ section.settings.corner_radius | default: 24 }}px;
    --ss-inset: {{ section.settings.card_spacing | default: 24 }}px;
    --ss-autoplay: {{ section.settings.autoplay_speed | default: 5 }}s;
    {%- if section.settings.button_shape == 'square' %}
      --style-border-radius-buttons-primary: 4px;
      --style-border-radius-buttons-secondary: 4px;
    {%- else %}
      --style-border-radius-buttons-primary: 999px;
      --style-border-radius-buttons-secondary: 999px;
    {%- endif %}
  }

  {%- if section.settings.button_background != blank %}
    #shopify-section-{{ section.id }} .ss-copy__btn:not(.ss-copy__btn--secondary),
    #shopify-section-{{ section.id }} .ss-copy__btn:not(.ss-copy__btn--secondary):hover {
      --button-background-color: {{ section.settings.button_background }};
      --button-border-color: {{ section.settings.button_background }};
      --button-color: {{ section.settings.button_text | default: '#111111' }};
    }
  {%- endif %}

  {%- if content_style == 'glass' -%}
    /* Glass panel behind the slide text */
    #shopify-section-{{ section.id }} .ss-copy__panel {
      padding: clamp(1.5rem, 3vw, 2.75rem);
      border: 1px solid rgb(255 255 255 / 0.22);
      border-radius: 24px;
      background: rgb(0 0 0 / 0.28);
      backdrop-filter: blur(16px) saturate(1.2);
      -webkit-backdrop-filter: blur(16px) saturate(1.2);
      box-shadow: 0 24px 60px -30px rgb(0 0 0 / 0.5);
    }

    #shopify-section-{{ section.id }} .ss-copy--dark .ss-copy__panel {
      border-color: rgb(255 255 255 / 0.6);
      background: rgb(255 255 255 / 0.5);
    }
  {%- else -%}
    /* No panel: text sits on the media with a soft shadow for legibility */
    #shopify-section-{{ section.id }} .ss-copy--light :is(.ss-copy__heading, .ss-copy__eyebrow, .ss-copy__text) {
      text-shadow: 0 2px 18px rgb(0 0 0 / 0.35);
    }
  {%- endif -%}

  {%- if content_style == 'glass' -%}
    /* Glass card on slide content groups (light text on a frosted dark panel) */
    #shopify-section-{{ section.id }} .group-block {
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      background-color: rgba(0, 0, 0, 0.32) !important;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 20px;
      overflow: hidden;
    }
    /* White text on the frosted panel — buttons keep their own colors so their labels stay readable */
    #shopify-section-{{ section.id }} .group-block,
    #shopify-section-{{ section.id }} .group-block :not(.button, .button *, .button-secondary, .button-secondary *, .button-unstyled, .button-unstyled *) {
      color: #ffffff !important;
    }
  {%- endif -%}

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --ss-inset: {{ section.settings.card_spacing | default: 24 | times: 0.6 | round }}px;
    }
  }

  /* Counter / dots sit on the media: white with a soft shadow so they read on light and dark slides */
  #shopify-section-{{ section.id }} slideshow-controls[controls-on-media],
  #shopify-section-{{ section.id }} slideshow-arrows {
    --color-foreground: #ffffff;
    --color-foreground-rgb: 255 255 255;
    color: #ffffff;
    /* Horizon inverts these with mix-blend-mode: difference, which turns white into dark blue on light photos */
    mix-blend-mode: normal;
    filter: drop-shadow(0 1px 3px rgb(0 0 0 / 0.55));
  }

  {%- if arrow_position == 'bottom' -%}
    /* Arrows sit at the bottom so they never overlap slide content */
    #shopify-section-{{ section.id }} slideshow-arrows {
      align-items: flex-end;
      padding-inline: clamp(20px, 3vw, 48px);
      padding-block-end: 28px;
    }
  {%- else -%}
    /* Arrows centred vertically, pushed in from the screen edge */
    #shopify-section-{{ section.id }} slideshow-arrows {
      padding-inline: clamp(16px, 2.5vw, 36px);
    }
  {%- endif -%}
{% endstyle %}

{%- liquid
  assign media_effect = section.settings.media_effect | default: 'none'
  assign content_animation = section.settings.content_animation | default: 'none'
-%}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="spacing-style {{ section.settings.section_width }} color-{{ section.settings.color_scheme }} disable-section-top-offset ss ss--effect-{{ media_effect }} ss--text-{{ content_animation }} ss--{{ content_style }} ss--pagination-{{ pagination }}{% if show_arrows %} ss--arrows{% endif %}"
  data-slideshow-media
  data-ss-header-style="{{ section.settings.header_style | default: 'solid' }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  {%- if template.name == 'index' -%}
    <script>
      /* Slideshow → Header style: when the home page opens with a slideshow, it decides whether the header
         is transparent or solid. Runs while the page is still loading, so the header never flashes. */
      window.selliroHeaderStyle =
        window.selliroHeaderStyle ||
        function () {
          var header = document.getElementById('header-component');
          var main = document.querySelector('main');
          if (!header || !main || !header.dataset.transparentMode) return;
          if (header.dataset.transparentDefault === undefined) {
            header.dataset.transparentDefault = header.getAttribute('transparent') || '';
          }
          var first = main.querySelector(':scope > .shopify-section');
          var slideshow = first && first.querySelector('[data-ss-header-style]');
          var on = slideshow
            ? slideshow.getAttribute('data-ss-header-style') === 'transparent'
            : header.dataset.transparentDefault !== '';
          var scheme = header.dataset.transparentScheme;
          if (on) {
            header.setAttribute('transparent', header.dataset.transparentDefault || header.dataset.transparentMode);
            if (scheme) header.classList.add(scheme);
          } else {
            header.removeAttribute('transparent');
            if (scheme) header.classList.remove(scheme);
          }
        };
      window.selliroHeaderStyle();
    </script>
  {%- endif -%}
  {% render 'slideshow',
    class: slideshow_class,
    controls: controls,
    show_arrows: show_arrows,
    icon_style: section.settings.icons_style,
    autoplay: section.settings.autoplay,
    autoplay_speed: section.settings.autoplay_speed,
    slides: slides,
    slide_count: section.blocks.size,
    slide_size: section.settings.slide_height
  %}
</div>

<script src="{{ 'slideshow-media.js' | asset_url }}" defer></script>

{% stylesheet %}
  /* Page width: the slideshow becomes a rounded card inside the page margins, on the section's color scheme */
  .ss.page-width slideshow-component {
    border-radius: var(--ss-radius, 24px);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---- Under a transparent header (Header → Transparent header), when the slideshow is the first section ---- */
  /* Keep slide text clear of the floating header */
  body:has(#header-component[transparent]) main > .shopify-section:first-child > .ss .ss-copy {
    padding-top: calc(var(--header-height, 0px) + clamp(1rem, 3vw, 2.5rem));
  }

  /* Optional top shade so the menu stays readable on light images (Header → Top shade) */
  body:has(#header-component[transparent]) main > .shopify-section:first-child > .ss slideshow-component::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--header-height, 64px) * 2.25);
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / var(--transparent-header-shade, 0)),
      rgb(0 0 0 / calc(var(--transparent-header-shade, 0) * 0.45)) 55%,
      transparent
    );
    z-index: 2;
    pointer-events: none;
  }

  /* Text rise animation also covers the built-in slide text */
  @media (prefers-reduced-motion: no-preference) {
    .ss--text-rise slideshow-slide[aria-hidden='false'] .ss-copy__panel > * {
      animation: ss-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .ss--text-rise slideshow-slide[aria-hidden='false'] .ss-copy__panel > :nth-child(2) { animation-delay: 0.1s; }
    .ss--text-rise slideshow-slide[aria-hidden='false'] .ss-copy__panel > :nth-child(3) { animation-delay: 0.2s; }
    .ss--text-rise slideshow-slide[aria-hidden='false'] .ss-copy__panel > :nth-child(4) { animation-delay: 0.3s; }
  }

  /* Progress bars pagination: slim bars, the active one fills over the auto-rotate time */
  .ss--pagination-bars .slideshow-controls__dots {
    gap: 0.5rem;
    padding-block: 0.75rem;
  }

  .ss--pagination-bars .slideshow-controls__dots button {
    width: clamp(2rem, 4vw, 3.25rem);
    height: 1.5rem;
    margin: 0;
    border-radius: 0;
  }

  .ss--pagination-bars .slideshow-controls__dots button::after {
    width: 100%;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(#fff, #fff) 0 0 / 0% 100% no-repeat, rgb(255 255 255 / 0.4);
  }

  .ss--pagination-bars .slideshow-controls__dots button[aria-selected='true']::after {
    background-size: 100% 100%, auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ss--pagination-bars slideshow-component[autoplay]:not([paused]) .slideshow-controls__dots button[aria-selected='true']::after {
      animation: ss-bar var(--ss-autoplay, 5s) linear both;
    }
  }

  @keyframes ss-bar {
    from {
      background-size: 0% 100%, auto;
    }
    to {
      background-size: 100% 100%, auto;
    }
  }

  /* Full screen height: the screen minus the header (and the space around the card in page width) */
  .ss slideshow-slides[size='full'],
  .ss slideshow-slides[size='full'] slideshow-slide {
    min-height: var(--ss-fill, calc(100svh - var(--header-height, 0px)));
  }

  .ss.page-width slideshow-slides[size='full'],
  .ss.page-width slideshow-slides[size='full'] slideshow-slide {
    min-height: var(--ss-fill, calc(100svh - var(--header-height, 0px) - var(--ss-inset, 24px) * 2));
  }

  /* ---- Arrows: always-visible, perfectly round frosted buttons ---- */
  .ss slideshow-arrows {
    mix-blend-mode: normal;
  }

  .ss slideshow-arrows .slideshow-control {
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    min-width: 3.25rem;
    min-height: 3.25rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 50%;
    background-color: rgb(0 0 0 / 0.28);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #fff;
    opacity: 0.92;
    transition: background-color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
  }

  .ss slideshow-arrows .slideshow-control:hover {
    background-color: rgb(0 0 0 / 0.5);
    border-color: rgb(255 255 255 / 0.65);
    opacity: 1;
  }

  .ss slideshow-arrows .slideshow-control:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .ss slideshow-arrows .slideshow-control .svg-wrapper {
    width: 1.1rem;
    height: 1.1rem;
  }

  .ss slideshow-arrows .slideshow-control svg {
    width: 100%;
    height: 100%;
  }

  /* ---- Pause/play + progress: one frosted pill at the bottom ---- */
  .ss slideshow-controls[controls-on-media] {
    left: 50%;
    right: auto;
    bottom: clamp(0.75rem, 2vw, 1.25rem);
    width: auto;
    min-height: 0;
    translate: -50% 0;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem 0.3rem 0.3rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    filter: none;
  }

  .ss slideshow-controls[controls-on-media] :is(.icon-pause, .icon-play) {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    min-width: 2rem;
    min-height: 2rem;
    padding: 0;
    border-radius: 50%;
    color: #fff;
    transition: background-color 0.2s ease;
  }

  .ss slideshow-controls[controls-on-media] :is(.icon-pause, .icon-play):hover {
    background-color: rgb(255 255 255 / 0.16);
  }

  .ss slideshow-controls[controls-on-media] :is(.icon-pause, .icon-play):focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Horizon keeps both buttons and only hides the inactive icon — hide the inactive button itself */
  .ss slideshow-component:not([paused]) slideshow-controls .icon-play,
  .ss slideshow-component[paused] slideshow-controls .icon-pause {
    display: none;
  }

  /* No panel + light text: a soft scrim on the text side keeps it readable on bright photos */
  .ss--none .ss-copy--light {
    position: relative;
    isolation: isolate;
  }

  .ss--none .ss-copy--light::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to right, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0.22) 38%, transparent 68%);
  }

  .ss--none .ss-copy--light.ss-copy--h-right::before {
    background: linear-gradient(to left, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0.22) 38%, transparent 68%);
  }

  .ss--none .ss-copy--light.ss-copy--h-center::before {
    background: radial-gradient(ellipse 60% 55% at 50% 50%, rgb(0 0 0 / 0.42), transparent 75%);
  }

  @media screen and (max-width: 749px) {
    .ss--none .ss-copy--light::before,
    .ss--none .ss-copy--light.ss-copy--h-right::before {
      background: linear-gradient(to top, rgb(0 0 0 / 0.55) 0%, rgb(0 0 0 / 0.2) 50%, transparent 80%);
    }
  }

  /* Keep slide text clear of the arrows */
  @media screen and (min-width: 750px) {
    .ss--arrows .ss-copy {
      padding-inline: max(clamp(1.25rem, 5.5vw, 6rem), calc(clamp(16px, 2.5vw, 36px) + 3.25rem + 1.75rem));
    }
  }

  .ss slideshow-controls[controls-on-media] .slideshow-controls__dots,
  .ss slideshow-controls[controls-on-media] .slideshow-controls__counter {
    padding-block: 0;
    background: none;
    backdrop-filter: none;
  }

  /* Phones: swipe and the progress bars navigate — arrows would sit on the text */
  @media screen and (max-width: 749px) {
    .ss slideshow-arrows {
      display: none;
    }
  }

  /* Slow zoom on the showing slide's images */
  @media (prefers-reduced-motion: no-preference) {
    .ss--effect-zoom slideshow-slide .slide__image {
      transform-origin: 50% 50%;
    }

    .ss--effect-zoom slideshow-slide[aria-hidden='false'] .slide__image {
      animation: ss-zoom 9s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    }

    /* Text rises in each time its slide comes into view */
    .ss--text-rise slideshow-slide[aria-hidden='false'] .slide__content .group-block-content > *,
    .ss--text-rise slideshow-slide[aria-hidden='false'] .slide__content .group-block > * {
      animation: ss-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .ss--text-rise slideshow-slide[aria-hidden='false'] .slide__content .group-block > :nth-child(2) {
      animation-delay: 0.12s;
    }

    .ss--text-rise slideshow-slide[aria-hidden='false'] .slide__content .group-block > :nth-child(3) {
      animation-delay: 0.24s;
    }

    .ss--text-rise slideshow-slide[aria-hidden='false'] .slide__content .group-block > :nth-child(n + 4) {
      animation-delay: 0.36s;
    }
  }

  @keyframes ss-zoom {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes ss-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.slideshow",
  "class": "container-background-image",
  "blocks": [
    {
      "type": "_slide"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Slide appearance"
    },
    {
      "type": "select",
      "id": "content_style",
      "label": "t:slideshow_media.content_style",
      "options": [
        { "value": "glass", "label": "t:slideshow_media.glass" },
        { "value": "none", "label": "t:slideshow_media.no_panel" }
      ],
      "default": "glass"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:slideshow_media.heading_size",
      "min": 32,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "t:settings.case",
      "options": [
        { "value": "default", "label": "t:options.default" },
        { "value": "uppercase", "label": "t:options.uppercase" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "button_shape",
      "label": "t:settings.shape",
      "options": [
        { "value": "pill", "label": "t:options.pill" },
        { "value": "square", "label": "t:options.square" }
      ],
      "default": "pill"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "t:settings.primary_button_background"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "t:settings.primary_button_text"
    },
    {
      "type": "select",
      "id": "arrow_position",
      "label": "Arrow position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.navigation",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.large_arrows"
        },
        {
          "value": "chevron_large",
          "label": "t:options.large_chevrons"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrows_large"
    },
    {
      "type": "select",
      "id": "slideshow_controls_style",
      "label": "t:settings.pagination",
      "options": [
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "counter",
          "label": "t:options.counter"
        },
        {
          "value": "bars",
          "label": "t:slideshow_media.bars"
        }
      ],
      "default": "bars"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:settings.auto_rotate_slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:settings.speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "select",
      "id": "media_effect",
      "label": "t:slideshow_media.media_effect",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "zoom",
          "label": "t:options.subtle_zoom"
        }
      ],
      "default": "zoom"
    },
    {
      "type": "select",
      "id": "content_animation",
      "label": "t:slideshow_media.content_animation",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "rise",
          "label": "t:slideshow_media.rise"
        }
      ],
      "default": "rise"
    },
    {
      "type": "checkbox",
      "id": "video_toggle",
      "label": "t:slideshow_media.video_toggle",
      "info": "t:slideshow_media.video_toggle_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.section_width == 'page-width' }}"
    },
    {
      "type": "range",
      "id": "card_spacing",
      "label": "t:slideshow_media.card_spacing",
      "info": "t:slideshow_media.card_spacing_info",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.section_width == 'page-width' }}"
    },
    {
      "type": "select",
      "id": "header_style",
      "label": "Header style",
      "info": "Used when this slideshow is the first section on the home page. Transparent: the header floats over the slides and turns solid on scroll.",
      "options": [
        { "value": "transparent", "label": "Transparent header" },
