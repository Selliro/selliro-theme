{%- comment -%}
  FAQ Test Section
  Test section for accordion-faq snippet
{%- endcomment -%}

{%- liquid
  assign background_color = section.settings.background_color | default: '#ffffff'
  assign section_caption = section.settings.caption | default: ''
  assign section_heading = section.settings.heading | default: ''
  assign section_body = section.settings.body | default: ''
-%}

<style>
  /* FAQ Section Padding - Based on multicolumn-horizontal pattern */
  #{{ section.id }} {
    padding-top: {{ section.settings.add_top_padding_mobile }}px;
    padding-bottom: {{ section.settings.add_bottom_padding_mobile }}px;
  }
  @media(min-width: 1024px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.add_top_padding_desktop }}px;
      padding-bottom: {{ section.settings.add_bottom_padding_desktop }}px;
    }
  }

  /* FAQ Accordion panel visibility */
  #{{ section.id }} .faq-section__accordion-panel[hidden] {
    display: none !important;
  }

  /* FAQ Accordion icon state */
  /* When open: teal background with white minus */
  /* When closed: white background with teal plus */
  #{{ section.id }} .faq-section__accordion-item.is-active .faq-section__accordion-icon {
    background-color: #52c3c2;
  }


  #{{ section.id }} .faq-section__accordion-item.is-active .faq-section__icon-line-vertical {
    display: none;
  }
</style>

<div id="{{ section.id }}" class="faq-section tw-w-full {%  if section.settings.section_id != blank %} tw-hidden {% endif %}" style="background-color: {{ background_color }};">
  <div class="section-container faq-section__container">
    <div class="faq-section__wrapper tw-flex tw-flex-col tw-gap-4 md:tw-gap-[60px]">

      {%- comment -%} Header Section (Caption, Heading, Body) - Based on Figma design {%- endcomment -%}
      {%- if section_caption != blank or section_heading != blank or section_body != blank -%}
        <div class="faq-section__header tw-flex tw-flex-col tw-gap-4 tw-items-start tw-w-full">
          {%- comment -%} Caption {%- endcomment -%}
          {%- if section_caption != blank -%}
            <div class="faq-section__caption tw-w-full">
              {%- render 'caption',
                text: section_caption,
                color: section.settings.caption_color | default: '#323e46',
                parent_class: 'faq-section'
              -%}
            </div>
          {%- endif -%}
          
          {%- comment -%} Heading {%- endcomment -%}
          {%- if section_heading != blank -%}
            <div class="faq-section__heading tw-w-full">
              {%- render 'heading',
                text: section_heading,
                variant: 'h3',
                color: section.settings.heading_color | default: '#092846',
                parent_class: 'faq-section'
              -%}
            </div>
          {%- endif -%}
          
          {%- comment -%} Body {%- endcomment -%}
          {%- if section_body != blank -%}
            <div class="faq-section__body tw-w-full tw-max-w-[400px]">
              {%- render 'body',
                text: section_body,
                variant: 'base',
                parent_class: 'faq-section'
              -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
          {%- comment -%} Button {%- endcomment -%}
      {%- comment -%} Accordion Container with data-accordion attribute {%- endcomment -%}
      <div class="" data-migrate-section="{{ section.settings.section_id }}">
      <div class="faq-section__accordion-container tw-w-full " data-accordion>
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq_item' -%}
            {%- render 'accordion-faq', block: block -%}
          {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section faq-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "info": "Optional caption text (uppercase, decorative style)"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Caption color",
      "default": "#323e46"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Main heading text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#092846"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "info": "Optional body text below heading (max-width 400px)"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID for migration",
      "info": "Optional: Used for section migration"
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "text",
      "id": "add_top_padding_mobile",
      "label": "Add top padding mobile",
      "default": "44"
    },
    {
      "type": "text",
      "id": "add_bottom_padding_mobile",
      "label": "Add bottom padding mobile",
      "default": "44"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "text",
      "id": "add_top_padding_desktop",
      "label": "Add top padding Desktop",
      "default": "96"
    },
    {
      "type": "text",
      "id": "add_bottom_padding_desktop",
      "label": "Add bottom padding Desktop",
      "default": "96"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "header",
          "content": "Accordion"
        },
        {
          "type": "text",
          "id": "heading_text",
          "label": "Accordion title",
          "default": "What is your question?"
        },
        {
          "type": "richtext",
          "id": "body_text",
          "label": "Body text",
          "default": "<p>This is the answer to your question.</p>"
        },
        {
          "type": "text",
          "id": "body_variant",
          "label": "Body variant",
          "default": "base",
          "info": "base, base-medium, base-bold"
        },
        {
          "type": "text",
          "id": "body_color",
          "label": "Body color",
          "info": "Hex color (e.g., #092846)"
        },
        {
          "type": "image_picker",
          "id": "content_image",
          "label": "Content image"
        },
        {
          "type": "image_picker",
          "id": "content_image_mobile",
          "label": "Content image (Mobile)"
        },
        {
          "type": "text",
          "id": "image_aspect_ratio",
          "label": "Image aspect ratio (Desktop)",
          "default": "0.79"
        },
        {
          "type": "text",
          "id": "image_aspect_ratio_mobile",
          "label": "Image aspect ratio (Mobile)",
          "default": "2.37"
        },
        {
          "type": "text",
          "id": "image_max_width",
          "label": "Image max width",
          "info": "Enter max width value (e.g., 800px, 50%, 1200px). Applies to all screen sizes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "heading_text": "Sample Question 1",
            "body_text": "<p>This is a sample answer for testing the accordion functionality.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "heading_text": "Sample Question 2",
            "body_text": "<p>This is another sample answer. You can add more content here.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

