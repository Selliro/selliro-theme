{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer-main.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_reveal -%}
<script>
(function () {
  // Reveal footer (the pattern Shopify's Concept theme uses): the footer sits pinned under the page
  // (position: sticky; bottom: 0, behind #MainContent) and the page lifts off it as you reach the end.
  // Sticky leaves the layout alone (no body padding), so nothing jumps when the mode changes.
  //   data-footer-reveal="pin"   the footer fits the screen. It's pinned at the bottom of the screen, above the
  //                              page, and plays out with the scroll (0 % = the page's last section reaches
  //                              the bottom of the screen, 100 % = end of the page):
  //                              0–30 %   footer card + copyright bar slide up over the last section, fully in
  //                                       view at 30 % (faster than the page, so the two overlap),
  //                              30–50 %  they stay there (the last section still meets them, no gap),
  //                              50–100 % they move on up to their place and uncover the big wordmark
  //                                       underneath; its letters rise as it shows (footer-wordmark.js).
  //                              Scrolling back up plays it in reverse.
  //   data-footer-reveal="rise"  taller than that (phones, short windows): pinning would put its top out
  //                              of reach, so it rises into view instead, a short slide tied to scroll
  //   (no attribute)             theme editor or reduced motion: a normal footer
  // While the footer is on screen the sticky header slides away (body[data-footer-zone]), so the footer
  // gets the whole screen and is fully visible at the end. Nothing scrolls on its own: the footer only
  // moves with the shopper's scroll (the wordmark letters follow it too, see footer-wordmark.js).
  if (document.documentElement.classList.contains('shopify-design-mode')) return;
  var footer = document.querySelector('.shopify-section-group-footer-group');
  if (!footer) return;
  var body = document.body;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  var mode = '';
  var frame = 0;
  var main = document.getElementById('MainContent');
  var card = null; // top layer: .footer-main (found once parsed: this script runs before the footer markup)
  var bar = null; // …and the copyright bar under it (.footer__content-bottom > .footer__page-width)
  var under = null; // beneath them: the wordmark ([data-footer-wordmark]; or the bottom area if there's none)
  var underShown = false;

  var inZone = false;

  // Header out of the way while the footer is showing (a little hysteresis so it doesn't flicker)
  function zone() {
    if (!main) return;
    var uncovered = window.innerHeight - main.getBoundingClientRect().bottom;
    var next = inZone ? uncovered > 8 : uncovered > 24;
    if (next !== inZone) {
      inZone = next;
      body.toggleAttribute('data-footer-zone', inZone);
    }
  }


  // Pinned: see the timeline above. offset = how far the card + copyright bar ("sheet") sit below their
  // place: H at 0 % (just below the screen), the wordmark's height at 30 % (sheet fully in view at the
  // bottom), 0 at the end. The wordmark only shows below the sheet (clip-path), so nothing of the footer
  // covers the page before the sheet gets there.
  var SHEET_IN = 0.3; // sheet fully in view
  var WORDMARK_FROM = 0.5; // sheet starts moving on, uncovering the wordmark
  function stack() {
    card = card || footer.querySelector('.footer-main');
    bar = bar || footer.querySelector('.footer__content-bottom > .footer__page-width');
    under = under || footer.querySelector('[data-footer-wordmark]');
    if (!card || !main) return;
    var vh = window.innerHeight;
    var H = footer.offsetHeight;
    var S = card.offsetHeight + (bar ? bar.offsetHeight : 0);
    var W = Math.max(0, H - S);
    var r = Math.max(0, Math.min(H, vh - main.getBoundingClientRect().bottom));
    var p = H > 0 ? r / H : 1;
    // Hold no longer than the page still reaches the sheet (r <= S), so no gap opens above it
    var from = Math.max(SHEET_IN, Math.min(WORDMARK_FROM, H > 0 ? S / H : 0));
    var offset;
    if (p <= SHEET_IN) {
      var e = p / SHEET_IN;
      offset = H - S * (1 - (1 - e) * (1 - e)); // ease-out: rises quickly, settles softly
    } else if (p <= from) {
      offset = W;
    } else {
      offset = W * (1 - (p - from) / (1 - from));
    }
    var t = offset > 0.5 ? 'translate3d(0,' + offset.toFixed(1) + 'px,0)' : '';
    card.style.transform = t;
    if (bar) bar.style.transform = t;

    var clipped = 0;
    if (under) {
      var sheetBottom = footer.getBoundingClientRect().top + S + offset;
      var u = under.getBoundingClientRect();
      clipped = Math.max(0, Math.min(u.height, sheetBottom - u.top));
      under.style.clipPath = clipped > 0.5 ? 'inset(' + clipped.toFixed(1) + 'px 0 0 0)' : '';
    }
    var shown = p >= SHEET_IN * 0.85; // the yellow copyright bar has reached the bottom of the screen
    if (shown !== underShown) {
      underShown = shown;
      footer.toggleAttribute('data-footer-bottom-shown', shown); // styles the back-to-top button
    }
  }

  function rise() {
    frame = 0;
    zone();
    if (mode === 'pin') return stack();
    if (mode !== 'rise') return;
    var rect = footer.getBoundingClientRect();
    var vh = window.innerHeight;
    if (rect.top > vh || rect.bottom < 0) return;
    var travel = Math.min(rect.height, vh);
    var shift = Math.min(vh * 0.22, rect.height * 0.3);
    var progress = Math.max(0, Math.min(1, (vh - rect.top) / travel));
    footer.style.transform = 'translate3d(0,' + (-(1 - progress) * shift).toFixed(1) + 'px,0)';
  }

  function sync() {
    // The header slides away while the footer shows, so it only has to fit the screen
    var next = reduce.matches ? '' : footer.offsetHeight <= window.innerHeight ? 'pin' : 'rise';
    if (next !== mode) {
      mode = next;
      footer.style.transform = '';
      footer.querySelectorAll('.footer-main, .footer__content-bottom > .footer__page-width').forEach(function (el) {
        el.style.transform = '';
      });
      var wm = footer.querySelector('[data-footer-wordmark]');
      if (wm) wm.style.clipPath = '';
      if (mode) body.setAttribute('data-footer-reveal', mode);
      else body.removeAttribute('data-footer-reveal');
      body.classList.toggle('footer-reveal-on', Boolean(mode));
      if (!mode && inZone) {
        inZone = false;
        body.removeAttribute('data-footer-zone');
      }
    }
    rise();
  }

  window.addEventListener('scroll', function () {
    if (mode && !frame) frame = requestAnimationFrame(rise);
  }, { passive: true });
  window.addEventListener('resize', sync, { passive: true });
  if (reduce.addEventListener) reduce.addEventListener('change', sync);
  if ('ResizeObserver' in window) new ResizeObserver(sync).observe(footer);
  sync();
})();
</script>
{%- endif -%}

{% style %}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
  .footer__content-bottom.section-{{ section.id }}-padding-bottom {
    padding-bottom: 0;
  }
{% endstyle %}

{%- liquid
  assign footer_show_copyright = false
  for block in section.blocks
    if block.type == 'logo_info' and block.settings.copyright_show
      assign footer_show_copyright = true
      break
    endif
  endfor
-%}
<div
  class="footer footer-section footer-main section-{{ section.id }}-padding-top section-{{ section.id }}-padding-bottom section-{{ section.id }}-margin"
  id="shopify-section-{{ section.id }}-footer-main"
>
  <div
    class="footer__content-top color-{{ section.settings.color_scheme }}{% if section.settings.enable_border_bottom %} section_border_bottom{% endif %}"
  >
    <div class="section section--page-width footer__page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer-main__inner">
        <div class="footer-main__grid footer-main__grid--blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'logo_info' -%}
                <div
                  class="footer-main__brand footer-main__block footer-main__block--logo"
                  {{ block.shopify_attributes }}
                >
                  <a href="{{ routes.root_url }}" class="footer-main__logo-link focus-inset" aria-label="{{ shop.name }}">
                    {%- if block.settings.logo != blank -%}
                      <div class="footer-main__logo-block" style="--footer-logo-width: {{ block.settings.logo_width }}px;">
                        {% assign image_height = block.settings.logo_width | divided_by: block.settings.logo.aspect_ratio %}
                        {% assign logo_alt = block.settings.logo.alt | default: shop.name | escape %}
                        {{
                          block.settings.logo
                          | image_url: width: 1296
                          | image_tag:
                            loading: 'lazy',
                            width: block.settings.logo_width,
                            height: image_height,
                            sizes: block.settings.logo_width,
                            widths: '50, 100, 150, 200, 250, 300, 375',
                            alt: logo_alt,
                            class: 'footer-main__logo-image footer-main__logo-image--default'
                        }}
                        {%- if block.settings.logo_2 != blank -%}
                          {% assign image_height_2 = block.settings.logo_width | divided_by: block.settings.logo_2.aspect_ratio %}
                          {{
                            block.settings.logo_2
                            | image_url: width: 1296
                            | image_tag:
                              loading: 'lazy',
                              width: block.settings.logo_width,
                              height: image_height_2,
                              sizes: block.settings.logo_width,
                              widths: '50, 100, 150, 200, 250, 300, 375',
                              alt: logo_alt,
                              class: 'footer-main__logo-image footer-main__logo-image--dark'
                          }}
                        {%- endif -%}
                      </div>
                    {%- else -%}
                      {%- liquid
                        assign logo_text_name = shop.name | default: ''
                        assign logo_text_len = logo_text_name.size
                      -%}
                      {%- if logo_text_len > 1 -%}
                        {%- assign logo_prefix_len = logo_text_len | minus: 1 -%}
                        <span class="footer-main__logo footer-main__logo--text footer-main__logo-word" aria-label="{{ shop.name }}">
                          <span class="footer-main__logo-text">{{ logo_text_name | slice: 0, logo_prefix_len }}</span>
                          <span class="footer-main__logo-o" aria-hidden="true">
                            <span class="footer-main__logo-o-inner">{{ logo_text_name | slice: logo_prefix_len, 1 }}</span>
                          </span>
                        </span>
                      {%- else -%}
                        <span class="footer-main__logo footer-main__logo--text">{{ shop.name }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  </a>

                  {%- assign footer_brand_description = block.settings.description | default: shop.description -%}
                  {%- if footer_brand_description != blank -%}
                    <p class="footer-main__tagline">{{ footer_brand_description | strip_html | truncate: 220 }}</p>
                  {%- endif -%}

                  {%- if section.settings.enable_language_selector or section.settings.enable_country_selector -%}
                    <div class="footer-main__localization">
                      {% render 'footer-localization',
                        show_country: section.settings.enable_country_selector,
                        show_language: section.settings.enable_language_selector,
                        block_id: section.id
                      %}
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'link_list' -%}
                {%- if block.settings.heading != blank and block.settings.menu != blank -%}
                  <div class="footer-main__link-list footer-main__block" {{ block.shopify_attributes }}>
                    <details class="footer-main__accordion">
                      <summary class="footer-main__accordion-summary">
                        <span class="footer-main__nav-title">{{ block.settings.heading }}</span>
                        <svg class="footer-main__accordion-icon" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                          {%- render 'icon', icon: 'caret' -%}
                        </svg>
                      </summary>
                      <ul class="footer-main__nav-list list-unstyled" role="list">
                        {%- for link in block.settings.menu.links -%}
                          <li>
                            <a href="{{ link.url }}" class="footer-main__nav-link-a{% if link.active %} is-active{% endif %}">{{ link.title | escape }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </details>
                    <nav class="footer-main__nav footer-main__nav--desktop" aria-labelledby="FooterNav-{{ block.id }}">
                      <h2 class="footer-main__nav-title" id="FooterNav-{{ block.id }}">{{ block.settings.heading }}</h2>
                      <ul class="footer-main__nav-list list-unstyled" role="list">
                        {%- for link in block.settings.menu.links -%}
                          <li>
                            <a href="{{ link.url }}" class="footer-main__nav-link-a{% if link.active %} is-active{% endif %}">{{ link.title | escape }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </nav>
                  </div>
                {%- endif -%}

              {%- when 'subscribe' -%}
                <div class="footer-main__newsletter footer-main__block footer-main__block--subscribe" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="footer-main__newsletter-title">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.newsletter_text != blank -%}
                    <div class="footer-main__newsletter-text rte">{{ block.settings.newsletter_text }}</div>
                  {%- endif -%}

                  {% form 'customer', class: 'footer-main__customer-form' %}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    <div class="footer-main__input-row">
                      <label class="visually-hidden" for="FooterNewsletter-{{ block.id }}">{{ 'blocks.email_signup.label' | t }}</label>
                      <input
                        id="FooterNewsletter-{{ block.id }}"
                        type="email"
                        name="contact[email]"
                        class="footer-main__email-input"
                        value="{{ form.email }}"
                        placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
                        autocomplete="email"
                        aria-required="true"
                        required
                        {% if form.errors %}
                          aria-invalid="true"
                        {% endif %}
                      >
                      {%- if block.settings.button_label != blank -%}
                        <button
                          type="submit"
                          class="footer-main__subscribe-btn footer-main__subscribe-btn--{{ block.settings.button_style | default: 'primary' }}"
                          name="commit"
                        >
                          {{ block.settings.button_label | escape }}
                        </button>
                      {%- endif -%}
                    </div>
                    {%- if form.errors -%}
                      <p class="footer-main__form-msg footer-main__form-msg--error" role="alert">
                        {{ form.errors.translated_fields.email | capitalize }}
                        {{ form.errors.messages.email }}
                      </p>
                    {%- endif -%}
                    {%- if form.posted_successfully? -%}
                      <p class="footer-main__form-msg footer-main__form-msg--success" role="status">
                        {{ 'blocks.email_signup.success' | t }}
                      </p>
                    {%- endif -%}
                  {% endform %}

                  <div class="footer-main__social footer-main__social--outline">
                    {%- liquid
                      assign social_platforms = 'facebook,twitter,instagram,youtube' | split: ','
                    -%}
                    {%- for platform in social_platforms -%}
                      {%- liquid
                        assign sk = 'social_' | append: platform | append: '_link'
                        assign url = settings[sk]
                      -%}
                      {%- if url != blank -%}
                        <a
                          class="footer-main__social-link"
                          href="{{ url }}"
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label="{{ platform | capitalize }}"
                        >
                          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                            {%- render 'icon', icon: platform -%}
                          </svg>
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
    </div>
  </div>
</div>

<div
  class="footer__content-bottom color-{{ section.settings.color_scheme_bottom }} background footer-section footer-section--bottom section-{{ section.id }}-padding-bottom"
  id="shopify-section-{{ section.id }}-footer-bottom"
>
  <div class="section section--page-width footer__page-width">
    <div class="footer-main__inner">
      <div class="footer-main__bottom-bar">
        {%- if footer_show_copyright -%}
          <div class="footer-main__inline-copyright footer-main__inline-copyright--bottom">
            <span class="footer-main__inline-copyright-text"
              >&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'sections.footer.all_rights_reserved' | t -}}
            </span>
            <span class="footer-main__inline-copyright-text">{{ powered_by_link }}</span>
          </div>
        {%- endif -%}
        <div class="footer-main__bottom-utilities">
          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="footer-main__follow-on-shop">
              {% # theme-check-disable %}
              {{ shop | login_button: action: 'follow' }}
              {% # theme-check-enable %}
            </div>
          {%- endif -%}

          {%- if section.settings.payment_enable -%}
            <ul
              class="footer-main__payment-list footer-main__payment"
              role="list"
              aria-label="{{ 'blocks.payment_methods' | t }}"
            >
              {%- for type in shop.enabled_payment_types -%}
                <li class="footer-main__payment-item">{{ type | payment_type_svg_tag: class: 'footer-main__payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.show_policy -%}
            <ul class="footer-main__policies list-unstyled" role="list">
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li><a href="{{ policy.url }}" class="footer-main__policy-link">{{ policy.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  {%- if section.settings.wordmark_text != blank -%}
    {%- liquid
      assign wm_source = section.settings.wordmark_font_source | default: 'heading'
      case wm_source
        when 'body'
          assign wm_family = 'var(--font-body--family)'
          assign wm_weight = 'var(--font-body--weight)'
        when 'accent'
          assign wm_family = 'var(--font-accent--family)'
          assign wm_weight = 'var(--font-accent--weight)'
        when 'custom'
          assign wm_family = section.settings.wordmark_font.family | append: ', ' | append: section.settings.wordmark_font.fallback_families
          assign wm_weight = section.settings.wordmark_font.weight
        else
          assign wm_family = 'var(--font-heading--family)'
          assign wm_weight = 'var(--font-heading--weight)'
      endcase
      assign wm_crop = section.settings.wordmark_crop | default: 30 | divided_by: 100.0
    -%}
    {%- if wm_source == 'custom' -%}
      {% style %}
        {{ section.settings.wordmark_font | font_face: font_display: 'swap' }}
      {% endstyle %}
    {%- endif -%}
    <div
      class="footer-wordmark{% if section.settings.wordmark_animate %} footer-wordmark--animate{% endif %}"
      data-footer-wordmark
      style="--fw-family: {{ wm_family }}; --fw-weight: {{ wm_weight }}; --fw-crop: {{ wm_crop }};{% if section.settings.wordmark_color != blank %} --fw-color: {{ section.settings.wordmark_color }};{% endif %}"
      aria-hidden="true"
    >
      <span class="footer-wordmark__text" data-footer-wordmark-text>{{ section.settings.wordmark_text | escape }}</span>
    </div>
    <script src="{{ 'footer-wordmark.js' | asset_url }}" defer></script>
  {%- endif -%}
</div>

{% stylesheet %}
  /* Big wordmark across the full width of the footer bottom (sized by footer-wordmark.js) */
  .footer-wordmark {
    --fw-leading: 0.8;

    position: relative;
    overflow: hidden;
    padding-inline: var(--page-margin, 16px);
    padding-top: clamp(1rem, 3vw, 2.5rem);
    line-height: var(--fw-leading);
    color: var(--fw-color, var(--color-foreground));
    pointer-events: none;
    user-select: none;
  }

  .footer-wordmark__text {
    display: block;
    width: fit-content;
    max-width: none;
    margin-inline: auto;
    /* fallback before the script measures: roughly fills the width for ~7 letters */
    font-size: var(--fw-size, 18vw);
    font-family: var(--fw-family);
    font-weight: var(--fw-weight, 400);
    line-height: var(--fw-leading);
    letter-spacing: -0.02em;
    white-space: nowrap;
    /* cut off the lower part of the letters, like a wordmark running off the page */
    margin-bottom: calc(var(--fw-crop, 0.3) * var(--fw-leading) * -1em);
  }

  .footer-wordmark__letter {
    display: inline-block;
  }

  body .blur-div {
    transition: opacity 0.4s ease;
  }

  body.footer-wordmark-visible .blur-div {
    opacity: 0;
  }

  /* Letters rise one after another, following the scroll (footer-wordmark.js sets --fw-q: 0 = covered,
     1 = all in view). Each letter starts a little after the previous one (--fw-stagger) and they all
     finish together at the end of the page. */
  @media (prefers-reduced-motion: no-preference) {
    .footer-wordmark--animate.is-ready .footer-wordmark__letter {
      --fw-stagger: 0.12;
      --fw-lp: clamp(
        0,
        calc(var(--fw-q, 0) * (1 + (var(--fw-n, 6) - 1) * var(--fw-stagger)) - var(--fw-i, 0) * var(--fw-stagger)),
        1
      );

      opacity: var(--fw-lp);
      translate: 0 calc((1 - var(--fw-lp)) * 0.5em);
      transition: opacity 0.15s linear, translate 0.15s linear;
    }
  }

  .footer-main__nav-link-a {
    color: inherit;
    text-decoration: none;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--footer-main-muted);
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }
  .footer-main__nav-link-a:hover,
  .footer-main__nav-link-a.is-active {
    color: var(--footer-main-fg);
  }
  .footer-main__logo-link {
    text-decoration: none;
    color: inherit;
  }
  .footer-main__logo--text {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: clamp(1.85rem, 3.5vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--footer-main-fg);
  }
  .section_border_bottom {
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .footer-main__bottom-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding: 0;
    margin: 0;
    border: none;
  }
  .footer-main__bottom-utilities {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: flex-end;
    margin-inline-start: auto;
  }
  .footer-main__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
  }
  .footer-main__policy-link {
    color: inherit;
    text-decoration: underline;
  }
  .footer-main__follow-on-shop {
    display: flex;
    align-items: center;
  }
  @media screen and (max-width: 749px) {
    .footer-main__bottom-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .footer-main__bottom-utilities {
      justify-content: flex-start;
      margin-inline-start: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "max_blocks": 7,
  "tag": "footer",
  "class": "footer-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Reveal footer on scroll",
      "info": "The page slides up to uncover the footer, which stays pinned underneath. When the footer is taller than the screen it rises into view instead.",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.color_scheme.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_bottom",
      "default": "background-3",
