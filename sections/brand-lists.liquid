{%- comment -%}
  Brand Lists Section
  Displays a header (caption, heading, subheading) followed by a Swiper carousel
  Uses brand-img-carousel snippet to render carousel with carousel-item blocks
{%- endcomment -%}

{%- liquid
  assign section_caption = section.settings.caption
  assign section_heading = section.settings.heading
  assign section_subheading = section.settings.subheading
  assign section_image = section.settings.image
  assign background_color = section.settings.background_color | default: '#ffffff'
  assign section_max_width = section.settings.section_max_width | default: ''
  assign mobile_slides_per_view = section.settings.mobile_slides_per_view | default: '2.5'
  assign desktop_slides_per_view = section.settings.desktop_slides_per_view | default: '6'
  assign show_progress = section.settings.show_progress | default: false
-%}

<style>
  #{{ section.id }} {
    padding-top: {{ section.settings.add_top_padding_mobile }}px;
    padding-bottom: {{ section.settings.add_bottom_padding_mobile }}px;
  }
  @media(min-width: 1024px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.add_top_padding_desktop }}px;
      padding-bottom: {{ section.settings.add_bottom_padding_desktop }}px;
    }
  }
</style>

{%- if section_max_width != blank -%}
  <style>
   #{{ section.id }} .brand-lists-section__container {
      max-width: {{ section_max_width }};
    }
  </style>
{%- endif -%}

<div id="{{ section.id }}" class="brand-lists-section tw-w-full" style="background-color: {{ background_color }};">
  <div class="brand-lists-section__container">
    
    {%- comment -%} Top Level Grid {%- endcomment -%}
    <div class="brand-lists-section__wrapper tw-grid tw-grid-cols-1 tw-gap-8">
      
      {%- comment -%} Header Section (Caption, Heading, Subheading, Image) {%- endcomment -%}
      {%- if section_caption != blank or section_heading != blank or section_subheading != blank or section_image != blank -%}
        <div class="brand-lists-section__header section-container">
          
          {%- comment -%} Caption, Heading, Subheading (Flex Container) {%- endcomment -%}
          {%- if section_caption != blank or section_heading != blank or section_subheading != blank -%}
            <div class="brand-lists-section__header-content tw-flex tw-flex-col tw-gap-4 tw-items-start">
              {%- comment -%} Caption {%- endcomment -%}
              {%- if section_caption != blank -%}
                {%- render 'caption',
                  text: section_caption,
                  color: section.settings.caption_color | default: '#323e46',
                  parent_class: 'brand-lists'
                -%}
              {%- endif -%}
              
              {%- comment -%} Heading {%- endcomment -%}
              {%- if section_heading != blank -%}
                {%- render 'heading',
                  text: section_heading,
                  variant: section.settings.heading_variant | default: 'h2',
                  color: section.settings.heading_color | default: '#092846',
                  parent_class: 'brand-lists'
                -%}
              {%- endif -%}
              
              {%- comment -%} Subheading {%- endcomment -%}
              {%- if section_subheading != blank -%}
                {%- render 'subheading',
                  text: section_subheading,
                  variant: section.settings.subheading_variant | default: 'md',
                  color: section.settings.subheading_color | default: '#323e46',
                  max_width: section.settings.subheading_max_width,
                  parent_class: 'brand-lists'
                -%}
              {%- endif -%}
            </div>
          {%- endif -%}
          
          {%- comment -%} Image (Outside Flex Container) {%- endcomment -%}
          {%- if section_image != blank -%}
            <div class="brand-lists-section__image tw-mt-4">
              {%- render 'image',
                desktop_image: section_image,
                mobile_image: section_image,
                image_id: section.id,
                layout_type: 'icon',
                icon_max_width: section.settings.image_max_width | default: '145',
                desktop_aspect_ratio: section.settings.image_aspect_ratio | default: '1',
                parent_class: 'brand-lists'
              -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      
      {%- comment -%} Carousel {%- endcomment -%}
      {%- render 'brand-img-carousel',
        blocks: section.blocks,
        section_id: section.id,
        mobile_slides_per_view: mobile_slides_per_view,
        desktop_slides_per_view: desktop_slides_per_view,
        mobile_space_between: section.settings.mobile_space_between,
        desktop_space_between: section.settings.desktop_space_between,
        desktop_aspect_ratio: section.settings.desktop_aspect_ratio,
        mobile_aspect_ratio: section.settings.mobile_aspect_ratio,
        show_progress: show_progress,
        progress_color: 'tw-bg-slate-400',
        carousel_class: 'carousel--brands'
      -%}
      
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand Lists",
  "tag": "section",
  "class": "brand-lists-section",
  "settings": [
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "section_max_width",
      "label": "Section max width",
      "info": "Enter max width value (e.g., 1200px, 80%, 1400px). Applies to all screen sizes"
    },
    {
      "type": "header",
      "content": "Carousel Settings"
    },
    {
      "type": "text",
      "id": "mobile_slides_per_view",
      "label": "Mobile slides per view",
      "default": "2.5",
      "info": "Enter a number (e.g., 3, 4, 5, 6)"
    },
    {
      "type": "text",
      "id": "desktop_slides_per_view",
      "label": "Desktop slides per view",
      "default": "6",
      "info": "Enter a number (e.g., 3, 4, 5, 6)"
    },
    {
      "type": "text",
      "id": "mobile_space_between",
      "label": "Mobile space between slides",
      "default": "16",
      "info": "Enter a number (e.g., 16, 20, 32)"
    },
    {
      "type": "text",
      "id": "desktop_space_between",
      "label": "Desktop space between slides",
      "default": "32",
      "info": "Enter a number (e.g., 16, 20, 32)"
    },
    {
      "type": "text",
      "id": "desktop_aspect_ratio",
      "label": "Desktop aspect ratio",
      "default": "1",
      "info": "Aspect ratio for all carousel images (e.g., 1, 1.5, 2.37)"
    },
    {
      "type": "text",
      "id": "mobile_aspect_ratio",
      "label": "Mobile aspect ratio",
      "default": "1",
      "info": "Aspect ratio for all carousel images on mobile (e.g., 1, 1.5, 2.37)"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show progress bar",
      "default": false
    },
    {
      "type": "header",
      "content": "Caption"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "PARTNER BRANDS"
    },
    {
      "type": "text",
      "id": "caption_color",
      "label": "Caption color",
      "info": "Optional: hex color value (e.g., #323e46)",
      "default": "#323e46"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "heading_variant",
      "label": "Heading variant",
      "default": "h2",
      "info": "Enter variant: h1, h2, h3, h4, h5"
    },
    {
      "type": "text",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Optional: hex color value",
      "default": "#092846"
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "subheading_variant",
      "label": "Subheading variant",
      "default": "md",
      "info": "Enter variant: sm, md, lg, lg-bold"
    },
    {
      "type": "text",
      "id": "subheading_color",
      "label": "Subheading color",
      "info": "Optional: hex color value",
      "default": "#323e46"
    },
    {
      "type": "text",
      "id": "subheading_max_width",
      "label": "Subheading max width",
      "info": "Enter max width value (e.g., 800px, 50%, 1200px). Applies to all screen sizes"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_max_width",
      "label": "Image max width (px)",
      "default": "200"
    },
    {
      "type": "text",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "default": "6",
      "info": "Enter a number (e.g., 2.5, 6)"
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "text",
      "id": "add_top_padding_mobile",
      "label": "Add top padding mobile",
      "default": "44"
    },
    {
      "type": "text",
      "id": "add_bottom_padding_mobile",
      "label": "Add bottom padding mobile",
      "default": "44"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "text",
      "id": "add_top_padding_desktop",
      "label": "Add top padding Desktop",
      "default": "96"
    },
    {
      "type": "text",
      "id": "add_bottom_padding_desktop",
      "label": "Add bottom padding Desktop",
      "default": "96"
    }
  ],
  "blocks": [
    {
      "type": "brand-image",
      "name": "Brand Image",
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional: If not provided, desktop image will be used"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Lists",
      "blocks": [
        {
          "type": "brand-image"
        },
        {
          "type": "brand-image"
        },
        {
          "type": "brand-image"
        }
      ]
    }
  ]
}
{% endschema %}

