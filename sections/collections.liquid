{%- comment -%}
  Whispo — list of collections (/collections). Every collection as a card with image, title and product count,
  in the order the shop sorts them. Styles: assets/template-content.css ("Collection cards").
{%- endcomment -%}

{%- comment -%} 1. CSS {%- endcomment -%}
{{ 'template-content.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{%- comment -%} 2. Liquid {%- endcomment -%}
<div class="collections-page color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <h1 class="collections-page__title h1">{{ 'collections.title' | t }}</h1>
    {%- paginate collections by 24 -%}
      <ul class="collection-cards" role="list" style="--columns: {{ section.settings.columns }};">
        {%- for collection in collections -%}
          <li>
            {%- render 'collection-card', collection: collection, ratio: section.settings.image_ratio -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</div>

{%- comment -%} 3. Schema {%- endcomment -%}
{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "settings": [
    { "type": "range", "id": "columns", "label": "t:sections.main_collection.columns", "min": 2, "max": 5, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.main_collection.image_ratio",
      "options": [
        { "value": "1", "label": "t:sections.main_collection.ratio_square" },
        { "value": "0.8", "label": "t:sections.main_collection.ratio_portrait" },
        { "value": "1.333", "label": "t:sections.main_list_collections.ratio_landscape" }
      ],
      "default": "0.8"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.main_collection.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:sections.main_collection.padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.main_collection.padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ]
}
{% endschema %}
