{%- comment -%}
  Routine Builder
  A sentence-style product finder: shoppers complete one sentence by tapping its blank words
  ("My skin feels [dry] and I'd love to fix [dullness]…"). Recommendations update live under the
  sentence after every choice, and the background mood colors follow the answers.

  Merchant view:
  - Each "Blank" block is one gap in the sentence: words before it, words after it, and up to
    6 answers (label, mood color, optional image, recommended products).
  - Products recommended by more of the chosen answers rank higher; the fallback collection tops up.

  Files: assets/section-routine-builder.css, assets/routine-builder.js
{%- endcomment -%}

{{ 'section-routine-builder.css' | asset_url | stylesheet_tag }}
{{ 'section-new-arrivals-showcase.css' | asset_url | stylesheet_tag }}
{{ 'new-arrivals-quick-view.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign blank_count = 0
  for block in section.blocks
    if block.type == 'blank'
      assign blank_count = blank_count | plus: 1
    endif
  endfor

  assign accent = section.settings.accent_color | default: '#f8d12f'
  assign font_source = section.settings.sentence_font_source | default: 'custom'
  case font_source
    when 'heading'
      assign sentence_family = 'var(--font-heading--family)'
      assign sentence_weight = 'var(--font-heading--weight)'
    when 'accent'
      assign sentence_family = 'var(--font-accent--family)'
      assign sentence_weight = 'var(--font-accent--weight)'
    when 'body'
      assign sentence_family = 'var(--font-body--family)'
      assign sentence_weight = 'var(--font-body--weight)'
    else
      assign sentence_family = section.settings.sentence_font.family | append: ', ' | append: section.settings.sentence_font.fallback_families
      assign sentence_weight = section.settings.sentence_font.weight
  endcase
  assign card_sizes = '(min-width: 990px) 22vw, 50vw'
-%}

{% style %}
  {%- if font_source == 'custom' -%}
    {{ section.settings.sentence_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  #RoutineBuilder-{{ section.id }} {
    --rb-accent: {{ accent }};
    --rb-accent-text: {{ section.settings.accent_text_color | default: '#000000' }};
    --rb-family: {{ sentence_family }};
    --rb-weight: {{ sentence_weight }};
    --rb-size: {{ section.settings.sentence_size }}px;
    --rb-columns: {{ section.settings.results_columns }};
    --rb-radius: {{ section.settings.card_radius }}px;
    --rb-mood-strength: {{ section.settings.mood_strength | times: 0.01 }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #RoutineBuilder-{{ section.id }} {
      padding-block: {{ section.settings.padding_top | times: 0.6 | round }}px {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
  }
{% endstyle %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

{%- liquid
  assign float_count = 0
  for i in (1..2)
    assign k = 'float_image_' | append: i
    if section.settings[k] != blank
      assign float_count = float_count | plus: 1
    endif
  endfor
-%}
{%- capture floats_markup -%}
{%- if float_count > 0 -%}
  <div
    class="rb-floats rb-floats--{{ section.settings.float_shape }}{% if section.settings.floats_mobile == 'hide' %} rb-floats--hide-mobile{% endif %}"
    id="RbFloats-{{ section.id }}"
    data-rb-floats
    data-speed="{{ section.settings.float_speed }}"
    data-first="{{ section.settings.float_first | default: 'left' }}"
    style="--rb-float-size: {{ section.settings.float_size }}vw; --rb-float-tilt: {{ section.settings.float_tilt }}deg;"
    aria-hidden="true"
  >
    {%- for i in (1..2) -%}
      {%- assign k = 'float_image_' | append: i -%}
      {%- assign f_image = section.settings[k] -%}
      {%- if f_image != blank -%}
        <div class="rb-float rb-float--{{ i }}" data-rb-float data-depth="{{ forloop.index }}">
          <div class="rb-float__inner">
            {{
              f_image
              | image_url: width: 900
              | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 18vw, 30vw', alt: '', class: 'rb-float__img'
            }}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
{%- endcapture -%}

<routine-builder
  id="RoutineBuilder-{{ section.id }}"
  class="rb rb--align-{{ section.settings.alignment }} {{ section.settings.section_width }} color-{{ section.settings.color_scheme }}{% if section.settings.show_mood %} rb--mood{% endif %}"
  data-section-id="{{ section.id }}"
  data-max-results="{{ section.settings.max_results }}"
  data-remember="{{ section.settings.remember }}"
  data-scroll-results="{{ section.settings.scroll_to_results }}"
  data-accent="{{ accent }}"
  data-new-arrivals-root
  data-new-arrivals-qv-id="new-arrivals-qv-drawer-{{ section.id }}"
>
  {%- if section.settings.show_mood -%}
    <div class="rb__mood" aria-hidden="true">
      <span class="rb__blob rb__blob--1"></span>
      <span class="rb__blob rb__blob--2"></span>
      <span class="rb__blob rb__blob--3"></span>
    </div>
  {%- endif -%}

  <div class="rb__inner">
    <div class="rb__stage">
    {{ floats_markup }}
    <div class="rb__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rb__eyebrow">
          <span class="rb__eyebrow-dot" aria-hidden="true"></span>
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}

      {%- comment -%} The sentence {%- endcomment -%}
      <p class="rb__sentence">
        {%- assign b_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'blank' -%}
            {%- if block.settings.before != blank -%}
              <span class="rb__words">{{ block.settings.before | escape }} </span>
            {%- endif -%}
            <button
              type="button"
              class="rb__blank"
              data-rb-blank="{{ b_index }}"
              aria-expanded="false"
              aria-controls="RbTray-{{ section.id }}-{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              <span class="rb__blank-thumbs" data-rb-thumbs aria-hidden="true"></span>
              <span class="rb__blank-text" data-rb-blank-text data-placeholder="{{ block.settings.placeholder | default: section.settings.placeholder | escape }}">
                {{- block.settings.placeholder | default: section.settings.placeholder | escape -}}
              </span>
              <span class="rb__blank-icon" aria-hidden="true">
                <svg class="rb__blank-plus" viewBox="0 0 16 16" width="16" height="16" fill="none" focusable="false"><path d="M8 3.5v9M3.5 8h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                <svg class="rb__blank-caret" viewBox="0 0 12 12" width="12" height="12" fill="none" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </button>
            {%- liquid
              assign after_text = block.settings.after | strip
              assign first_char = after_text | slice: 0
              assign is_punct = false
              if first_char == ',' or first_char == '.' or first_char == '!' or first_char == '?' or first_char == ';' or first_char == ':'
                assign is_punct = true
              endif
            -%}
            {%- if after_text != blank -%}
              <span class="rb__words{% if is_punct %} rb__words--punct{% endif %}">{% unless is_punct %} {% endunless %}{{ after_text | escape }}</span>
            {%- endif -%}
            {{- ' ' -}}
            {%- assign b_index = b_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </p>

      <div class="rb__status">
        <div class="rb__meter" aria-hidden="true">
          {%- for i in (1..blank_count) -%}<span class="rb__meter-seg"></span>{%- endfor -%}
        </div>
        {%- if section.settings.hint != blank -%}
          <p class="rb__hint" data-rb-hint>{{ section.settings.hint | escape }}</p>
        {%- endif -%}
        <button type="button" class="rb__reset button-unstyled" data-rb-reset hidden>
          <svg viewBox="0 0 20 20" width="15" height="15" fill="none" aria-hidden="true" focusable="false"><path d="M4 10a6 6 0 1 0 1.76-4.24M4 4v3.5h3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ section.settings.reset_label | escape }}
        </button>
      </div>

      {%- if blank_count == 0 and request.design_mode -%}
        <p class="rb__editor-hint">Add a “Blank” block to start building the sentence.</p>
      {%- endif -%}
    </div>

    {%- comment -%} Answer trays — one per blank, only the active one is shown {%- endcomment -%}
    <div class="rb__trays">
      {%- for block in section.blocks -%}
        {%- if block.type == 'blank' -%}
          {%- liquid
            assign multiple = block.settings.allow_multiple
            assign input_type = 'radio'
            if multiple
              assign input_type = 'checkbox'
            endif
          -%}
          <fieldset
            class="rb__tray"
            id="RbTray-{{ section.id }}-{{ block.id }}"
            data-rb-tray
            data-rb-block-id="{{ block.id }}"
            data-multiple="{{ multiple }}"
            hidden
          >
            <legend class="rb__tray-legend">
              {{- block.settings.question | default: block.settings.before | escape -}}
              {%- if multiple -%}<span class="rb__tray-note">{{ section.settings.multiple_note | escape }}</span>{%- endif -%}
            </legend>
            <div class="rb__options">
              {%- for n in (1..6) -%}
                {%- liquid
                  assign key = 'answer_' | append: n | append: '_label'
                  assign label = block.settings[key]
                  if label == blank
                    continue
                  endif
                  assign key = 'answer_' | append: n | append: '_color'
                  assign color = block.settings[key] | default: accent
                  assign key = 'answer_' | append: n | append: '_image'
                  assign image = block.settings[key]
                  assign key = 'answer_' | append: n | append: '_products'
                  assign ids = block.settings[key] | map: 'id' | join: ','
                  assign thumb = ''
                  if image != blank
                    assign thumb = image | image_url: width: 96
                  endif
                -%}
                <label class="rb__option" style="--rb-c: {{ color }};">
                  <input
                    class="rb__option-input"
                    type="{{ input_type }}"
                    name="rb-{{ section.id }}-{{ block.id }}"
                    value="{{ n }}"
                    data-label="{{ label | escape }}"
                    data-color="{{ color }}"
                    data-products="{{ ids }}"
                    {% if thumb != blank %}data-thumb="{{ thumb }}"{% endif %}
                  >
                  {%- if image != blank -%}
                    <span class="rb__option-thumb">{{ image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48 }}</span>
                  {%- else -%}
                    <span class="rb__option-dot" aria-hidden="true"></span>
                  {%- endif -%}
                  <span class="rb__option-label">{{ label | escape }}</span>
                </label>
              {%- endfor -%}
            </div>
            {%- if multiple -%}
              <button type="button" class="rb__done" data-rb-done>{{ section.settings.done_label | escape }}</button>
            {%- endif -%}
          </fieldset>
        {%- endif -%}
      {%- endfor -%}
    </div>

    </div>

    {%- comment -%} Results — revealed once every blank is filled {%- endcomment -%}
    <div class="rb__results-wrap" data-rb-results-wrap>
      <div class="rb__results-clip">
        <div class="rb__results-inner">
          <div class="rb__results-head">
            <div>
              {%- if section.settings.results_eyebrow != blank -%}
                <p class="rb__results-eyebrow">{{ section.settings.results_eyebrow | escape }}</p>
              {%- endif -%}
              <h2 class="rb__results-title" tabindex="-1" data-rb-results-title>{{ section.settings.results_done | escape }}</h2>
            </div>
            <div class="rb__results-actions">
              {%- if section.settings.show_add_all -%}
                <button type="button" class="rb__add-all" data-rb-add-all disabled>
                  <span class="rb__add-all-label">{{ section.settings.add_all_label | escape }}</span>
                  <span class="rb__add-all-spinner" aria-hidden="true"></span>
                </button>
              {%- endif -%}
            </div>
          </div>
          <ul class="rb__results list-unstyled" data-rb-results role="list"></ul>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Product pool (rendered once; JS moves matches into the results list) {%- endcomment -%}
  <div class="rb__pool" data-rb-pool hidden>
    {%- assign seen = ',' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'blank' -%}
        {%- for n in (1..6) -%}
          {%- liquid
            assign key = 'answer_' | append: n | append: '_label'
            if block.settings[key] == blank
              continue
            endif
            assign key = 'answer_' | append: n | append: '_products'
          -%}
          {%- for product in block.settings[key] -%}
            {%- assign needle = ',' | append: product.id | append: ',' -%}
            {%- unless seen contains needle -%}
              {%- assign seen = seen | append: product.id | append: ',' -%}
              <li class="rb__result" data-product-id="{{ product.id }}" data-available="{{ product.available }}">
                <span class="rb__step" aria-hidden="true"></span>
                {%- render 'new-arrivals-card', product: product, accent: accent, add_label: section.settings.add_label, image_sizes: card_sizes -%}
              </li>
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if section.settings.fallback_collection != blank -%}
      {%- for product in section.settings.fallback_collection.products limit: 12 -%}
        {%- assign needle = ',' | append: product.id | append: ',' -%}
        {%- if seen contains needle -%}
          <li class="rb__result" data-product-id="{{ product.id }}" data-fallback="{{ forloop.index }}" data-duplicate></li>
        {%- else -%}
          {%- assign seen = seen | append: product.id | append: ',' -%}
          <li class="rb__result" data-product-id="{{ product.id }}" data-fallback="{{ forloop.index }}" data-available="{{ product.available }}">
            <span class="rb__step" aria-hidden="true"></span>
            {%- render 'new-arrivals-card', product: product, accent: accent, add_label: section.settings.add_label, image_sizes: card_sizes -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</routine-builder>

{% render 'new-arrivals-quick-view-drawer', section: section %}

<script src="{{ 'image-loader.js' | asset_url }}" defer></script>
<script src="{{ 'new-arrivals-components.js' | asset_url }}" defer></script>
<script src="{{ 'new-arrivals-showcase.js' | asset_url }}" defer></script>
<script src="{{ 'new-arrivals-quick-view.js' | asset_url }}" defer></script>
<script src="{{ 'routine-builder.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Routine builder",
  "tag": "section",
  "class": "section-routine-builder",
  "settings": [
    {
      "type": "header",
      "content": "Sentence"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Build your routine"
    },
    {
      "type": "select",
      "id": "sentence_font_source",
      "label": "Sentence font",
      "options": [
        {
          "value": "custom",
          "label": "Custom (pick below)"
        },
        {
          "value": "heading",
          "label": "Theme heading font"
        },
        {
          "value": "accent",
          "label": "Theme accent font"
        },
        {
          "value": "body",
          "label": "Theme body font"
        }
      ],
      "default": "custom"
    },
    {
      "type": "font_picker",
      "id": "sentence_font",
      "label": "Custom font",
      "default": "playfair_display_n4",
      "visible_if": "{{ section.settings.sentence_font_source == 'custom' }}"
    },
    {
      "type": "range",
      "id": "sentence_size",
      "label": "Sentence size (desktop)",
      "min": 28,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Blank placeholder",
      "info": "Shown in a blank before it's filled. Each blank can override it.",
      "default": "choose"
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Hint under the sentence",
      "default": "Tap the underlined words to build your routine"
    },
    {
      "type": "text",
      "id": "multiple_note",
      "label": "Multiple-choice note",
      "default": "Pick as many as you like"
    },
    {
      "type": "text",
      "id": "done_label",
      "label": "Done button (multiple choice)",
      "default": "Done"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#f8d12f"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Accent text color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "show_mood",
      "label": "Mood background",
      "info": "Soft color clouds that take on the colors of the chosen answers.",
      "default": true
    },
    {
      "type": "range",
      "id": "mood_strength",
      "label": "Mood intensity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55,
      "visible_if": "{{ section.settings.show_mood }}"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Floating images"
    },
    {
      "type": "paragraph",
      "content": "One image on each side. As the page scrolls down, they rise from the bottom of the screen to the top, one after the other."
    },
    {
      "type": "image_picker",
      "id": "float_image_1",
      "label": "Left image"
    },
    {
      "type": "image_picker",
      "id": "float_image_2",
      "label": "Right image"
    },
    {
      "type": "select",
      "id": "float_first",
      "label": "Image that rises first",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "float_shape",
      "label": "Shape",
      "options": [
        {
          "value": "rounded",
          "label": "Rounded rectangle"
        },
        {
          "value": "arch",
          "label": "Arch"
        },
        {
          "value": "pebble",
          "label": "Pebble"
        },
        {
          "value": "circle",
          "label": "Circle"
        }
      ],
      "default": "rounded"
    },
    {
      "type": "range",
      "id": "float_size",
      "label": "Size",
      "min": 8,
      "max": 26,
      "step": 1,
