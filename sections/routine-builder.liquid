        {
          "value": "hide",
          "label": "Hide"
        }
      ],
      "default": "show"
    },
    {
      "type": "header",
      "content": "Results"
    },
    {
      "type": "text",
      "id": "results_eyebrow",
      "label": "Results eyebrow",
      "default": "Made for you"
    },
    {
      "type": "text",
      "id": "results_done",
      "label": "Results heading",
      "default": "Your routine is ready"
    },
    {
      "type": "checkbox",
      "id": "scroll_to_results",
      "label": "Scroll to the products when the sentence is complete",
      "default": true
