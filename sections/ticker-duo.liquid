          "min": -6,
          "max": 6,
          "step": 1,
          "default": 0,
          "unit": "deg"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Color scheme",
          "default": "scheme-2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ticker Duo",
      "blocks": [
        {
          "type": "ticker_row",
          "settings": {
            "text": "40% Off On Booking",
            "speed": 24,
