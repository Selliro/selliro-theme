{% comment %}
  Ticker Duo Section
  File: sections/ticker-duo.liquid
{% endcomment %}

{{ 'section-ticker-duo.css' | asset_url | stylesheet_tag }}

<ticker-duo
  class="ticker-duo {{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  id="ticker-duo-{{ section.id }}"
  data-scroll-boost="{{ section.settings.scroll_boost }}"
  data-boost-strength="{{ section.settings.scroll_boost_strength }}"
  data-scroll-up="{{ section.settings.scroll_up_behavior }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ticker-duo__stack" style="gap: {{ section.settings.row_gap }}px;">
    {%- for block in section.blocks -%}
      <div
        class="ticker-duo__row color-{{ block.settings.color_scheme }}"
        style="padding-top: {{ block.settings.padding_top }}px; padding-bottom: {{ block.settings.padding_bottom }}px; transform: rotate({{ block.settings.rotation }}deg);"
        {{ block.shopify_attributes }}
      >
        <div class="ticker-duo__scroll">
          <div class="ticker-duo__track{% if block.settings.direction == 'reverse' %} is-reverse{% endif %}" data-speed="{{ block.settings.speed }}">
            {%- for i in (1..8) -%}
              <div class="ticker-duo__group"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
                {%- if block.settings.text != blank -%}
                  <span class="ticker-duo__text" style="{% render 'typography-style', settings: block.settings %}">{{ block.settings.text }}</span>
                {%- endif -%}
                {%- if block.settings.textarea != blank -%}
                  <span class="ticker-duo__text ticker-duo__text--long" style="{% render 'typography-style', settings: block.settings %}">{{ block.settings.textarea }}</span>
                {%- endif -%}
                {%- if block.settings.icon != blank -%}
                  <span class="ticker-duo__icon">
                    {{ block.settings.icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', widths: '48, 96', sizes: '48px' }}
                  </span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</ticker-duo>

<script src="{{ 'ticker-duo.js' | asset_url }}" defer></script>

