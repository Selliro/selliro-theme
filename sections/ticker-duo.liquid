{
  "name": "Ticker Duo",
  "tag": "section",
  "class": "section-ticker-duo",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 6,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "ticker_row",
      "name": "Ticker row",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "40% Off On Booking"
        },
        {
          "type": "textarea",
          "id": "textarea",
          "label": "Textarea"
        },
        {
          "type": "header",
          "content": "t:content.typography"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:settings.preset",
          "options": [
            { "value": "rte", "label": "t:options.default" },
            { "value": "paragraph", "label": "t:options.paragraph" },
            { "value": "h1", "label": "t:options.h1" },
            { "value": "h2", "label": "t:options.h2" },
            { "value": "h3", "label": "t:options.h3" },
