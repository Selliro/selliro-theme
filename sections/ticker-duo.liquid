{% comment %}
  Ticker Duo Section
  File: sections/ticker-duo.liquid
{% endcomment %}

{{ 'section-ticker-duo.css' | asset_url | stylesheet_tag }}

<ticker-duo
  class="ticker-duo section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  id="ticker-duo-{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ticker-duo__stack" style="gap: {{ section.settings.row_gap }}px;">
    {%- for block in section.blocks -%}
      <div
        class="ticker-duo__row color-{{ block.settings.color_scheme }}"
        style="--ticker-duration: {{ block.settings.speed }}s; padding-top: {{ block.settings.padding_top }}px; padding-bottom: {{ block.settings.padding_bottom }}px; transform: rotate({{ block.settings.rotation }}deg);"
        data-base-duration="{{ block.settings.speed }}"
        {{ block.shopify_attributes }}
      >
        <div class="ticker-duo__scroll">
          <div class="ticker-duo__track{% if block.settings.direction == 'reverse' %} is-reverse{% endif %}">
            {%- for i in (1..8) -%}
              <div class="ticker-duo__group">
                {%- if block.settings.text != blank -%}
                  <span class="ticker-duo__text" style="{% render 'typography-style', settings: block.settings %}">{{ block.settings.text }}</span>
                {%- endif -%}
                {%- if block.settings.textarea != blank -%}
                  <span class="ticker-duo__text ticker-duo__text--long" style="{% render 'typography-style', settings: block.settings %}">{{ block.settings.textarea }}</span>
                {%- endif -%}
                {%- if block.settings.icon != blank -%}
                  <span class="ticker-duo__icon">
                    {{ block.settings.icon | image_url: width: 48 | image_tag: loading: 'lazy' }}
                  </span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</ticker-duo>

<script>
  class TickerDuo extends HTMLElement {
    connectedCallback() {
      this.rows = Array.from(this.querySelectorAll('.ticker-duo__row'));
      this.scrollWrappers = Array.from(this.querySelectorAll('.ticker-duo__scroll'));
      if (!this.rows.length) return;

      this.lastY = window.scrollY;
      this.resetTimer = null;
      this.targetMultiplier = 1;
      this.currentMultiplier = 1;
      this.rafId = null;

      this.onScroll = this.onScroll.bind(this);
      this.tick = this.tick.bind(this);

      window.addEventListener('scroll', this.onScroll, { passive: true });
      this.tick();
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScroll);
      if (this.resetTimer) clearTimeout(this.resetTimer);
      if (this.rafId) cancelAnimationFrame(this.rafId);
    }

    setSpeed(multiplier) {
      this.rows.forEach((row) => {
        const base = parseFloat(row.getAttribute('data-base-duration')) || 28;
        const next = Math.max(3, base / multiplier);
        // Set directly on the track element — this updates the running animation immediately.
        // Setting only a CSS custom property (--ticker-duration) does NOT affect a running animation.
        const track = row.querySelector('.ticker-duo__track');
        if (track) track.style.animationDuration = next + 's';
      });
    }

    onScroll() {
      const delta = Math.abs(window.scrollY - this.lastY);
      this.lastY = window.scrollY;
      if (delta === 0) return;

      this.targetMultiplier = Math.min(3.2, Math.max(1, delta / 25));
      const shift = Math.min(28, delta * 0.3);
      this.scrollWrappers.forEach((wrap, index) => {
        const dir = index % 2 === 0 ? 1 : -1;
        wrap.style.setProperty('--scroll-shift', (dir * shift) + 'px');
      });

      if (this.resetTimer) clearTimeout(this.resetTimer);
      this.resetTimer = setTimeout(() => {
        this.targetMultiplier = 1;
        this.scrollWrappers.forEach((wrap) => {
          wrap.style.setProperty('--scroll-shift', '0px');
        });
      }, 180);
    }

    tick() {
      this.currentMultiplier += (this.targetMultiplier - this.currentMultiplier) * 0.09;
      this.setSpeed(this.currentMultiplier);
      this.rafId = requestAnimationFrame(this.tick);
    }
  }

  if (!customElements.get('ticker-duo')) {
    customElements.define('ticker-duo', TickerDuo);
  }
</script>

