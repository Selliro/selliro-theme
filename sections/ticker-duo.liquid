{% comment %}
  Ticker Duo Section
  File: sections/ticker-duo.liquid
{% endcomment %}

{{ 'section-ticker-duo.css' | asset_url | stylesheet_tag }}

<ticker-duo
  class="ticker-duo section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  id="ticker-duo-{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ticker-duo__stack" style="gap: {{ section.settings.row_gap }}px;">
    {%- for block in section.blocks -%}
      <div
        class="ticker-duo__row color-{{ block.settings.color_scheme }}"
        style="padding-top: {{ block.settings.padding_top }}px; padding-bottom: {{ block.settings.padding_bottom }}px; transform: rotate({{ block.settings.rotation }}deg);"
        {{ block.shopify_attributes }}
      >
        <div class="ticker-duo__scroll">
          <div class="ticker-duo__track{% if block.settings.direction == 'reverse' %} is-reverse{% endif %}">
            {%- for i in (1..8) -%}
              <div class="ticker-duo__group">
                {%- if block.settings.text != blank -%}
                  <span class="ticker-duo__text" style="{% render 'typography-style', settings: block.settings %}">{{ block.settings.text }}</span>
                {%- endif -%}
                {%- if block.settings.textarea != blank -%}
                  <span class="ticker-duo__text ticker-duo__text--long" style="{% render 'typography-style', settings: block.settings %}">{{ block.settings.textarea }}</span>
                {%- endif -%}
                {%- if block.settings.icon != blank -%}
                  <span class="ticker-duo__icon">
                    {{ block.settings.icon | image_url: width: 48 | image_tag: loading: 'lazy' }}
                  </span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</ticker-duo>

<script>
  class TickerDuo extends HTMLElement {
    connectedCallback() {
      this.tracks = Array.from(this.querySelectorAll('.ticker-duo__track'));
      if (!this.tracks.length) return;

      // Clone groups until the track is at least 2.5× the viewport wide.
      // Reason: at position p = -halfWidth the track's right edge must still
      // be beyond the viewport right edge, which requires scrollWidth ≥ 2× viewport.
      // We clone the original set at a time so the loop boundary always falls
      // on an exact group boundary (no partial-group seam).
      this.tracks.forEach(track => {
        const origGroups = Array.from(track.querySelectorAll('.ticker-duo__group'));
        if (!origGroups.length) return;
        const minWidth = window.innerWidth * 2.5;
        while (track.scrollWidth < minWidth) {
          origGroups.forEach(g => track.appendChild(g.cloneNode(true)));
        }
      });

      // Cache loop boundaries after cloning — scrollWidth won't change after this.
      this.loopWidths = this.tracks.map(t => t.scrollWidth / 2);
      this.positions  = this.tracks.map(() => 0);

      const IDLE = 0.6;
      this.idleSpeed     = IDLE;
      this.velocity      = IDLE;
      this.targetVelocity = IDLE;
      this.lastScrollY   = window.scrollY;
      this.rafId         = null;

      this.onScroll = this.onScroll.bind(this);
      this.tick     = this.tick.bind(this);

      window.addEventListener('scroll', this.onScroll, { passive: true });
      this.rafId = requestAnimationFrame(this.tick);
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScroll);
      if (this.rafId) cancelAnimationFrame(this.rafId);
    }

    onScroll() {
      const currentY = window.scrollY;
      const delta    = currentY - this.lastScrollY;
      this.lastScrollY = currentY;

      // Upward scroll is clamped tighter (−1.5) than downward (+4) so a sudden
      // scroll-up never causes a jarring fast reversal.
      this.targetVelocity = Math.max(
        this.idleSpeed - 1.5,
        Math.min(this.idleSpeed + 4, this.idleSpeed + delta * 0.15)
      );
    }

    tick() {
      // Decay target back toward idle each frame (~4 frames to settle).
      this.targetVelocity += (this.idleSpeed - this.targetVelocity) * 0.25;

      // Asymmetric lerp: ease in slowly when decelerating/reversing (scroll up)
      // so it never snaps; ease in faster when accelerating (scroll down).
      const lerp = this.targetVelocity < this.velocity ? 0.06 : 0.18;
      this.velocity += (this.targetVelocity - this.velocity) * lerp;

      this.tracks.forEach((track, i) => {
        const dir = track.classList.contains('is-reverse') ? 1 : -1;
        this.positions[i] += this.velocity * dir;

        const halfWidth = this.loopWidths[i];
        if (halfWidth > 0) {
          let p = this.positions[i] % halfWidth;
          if (p > 0) p -= halfWidth;
          this.positions[i] = p;
          track.style.transform = `translateX(${p}px)`;
        }
      });

      this.rafId = requestAnimationFrame(this.tick);
    }
  }

  if (!customElements.get('ticker-duo')) {
    customElements.define('ticker-duo', TickerDuo);
  }
</script>

