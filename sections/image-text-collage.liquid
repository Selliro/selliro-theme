{% comment %}Image Text Collage — stacked photo collage + text column{% endcomment %}

{{ 'section-image-text-collage.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign img1 = section.settings.image_1
  assign img2 = section.settings.image_2
  assign img3 = section.settings.image_3

  assign img_count = 0
  if img1 != blank
    assign img_count = img_count | plus: 1
  endif
  if img2 != blank
    assign img_count = img_count | plus: 1
  endif
  if img3 != blank
    assign img_count = img_count | plus: 1
  endif

  assign stack_mode = img_count
  if stack_mode == 0
    assign stack_mode = 3
  endif

  assign has_feature_blocks = false
  for block in section.blocks
    if block.type == 'feature'
      assign has_feature_blocks = true
    endif
  endfor
-%}

{%- capture pos_vars -%}
  {%- liquid
    assign p1t = section.settings.image_1_top    | default: 0
    assign p1r = section.settings.image_1_right  | default: 0
    assign p1b = section.settings.image_1_bottom | default: -1
    assign p1l = section.settings.image_1_left   | default: -1
    assign p1h = section.settings.image_1_height | default: -1
    assign p2t = section.settings.image_2_top    | default: 28
    assign p2r = section.settings.image_2_right  | default: -1
    assign p2b = section.settings.image_2_bottom | default: -1
    assign p2l = section.settings.image_2_left   | default: 0
    assign p2h = section.settings.image_2_height | default: -1
    assign p3t = section.settings.image_3_top    | default: -1
    assign p3r = section.settings.image_3_right  | default: 3
    assign p3b = section.settings.image_3_bottom | default: 0
    assign p3l = section.settings.image_3_left   | default: -1
    assign p3h = section.settings.image_3_height | default: -1
  -%}
  {%- if p1t < 0 -%}--itc-p1-top:auto;{%- else -%}--itc-p1-top:{{ p1t }}%;{%- endif -%}
  {%- if p1r < 0 -%}--itc-p1-right:auto;{%- else -%}--itc-p1-right:{{ p1r }}%;{%- endif -%}
  {%- if p1b < 0 -%}--itc-p1-bottom:auto;{%- else -%}--itc-p1-bottom:{{ p1b }}%;{%- endif -%}
  {%- if p1l < 0 -%}--itc-p1-left:auto;{%- else -%}--itc-p1-left:{{ p1l }}%;{%- endif -%}
  --itc-p1-w:{{ section.settings.image_1_width | default: 56 }}%;
  {%- if p1h < 0 -%}--itc-p1-h:auto;{%- else -%}--itc-p1-h:{{ p1h }}%;{%- endif -%}
  {%- if p2t < 0 -%}--itc-p2-top:auto;{%- else -%}--itc-p2-top:{{ p2t }}%;{%- endif -%}
  {%- if p2r < 0 -%}--itc-p2-right:auto;{%- else -%}--itc-p2-right:{{ p2r }}%;{%- endif -%}
  {%- if p2b < 0 -%}--itc-p2-bottom:auto;{%- else -%}--itc-p2-bottom:{{ p2b }}%;{%- endif -%}
  {%- if p2l < 0 -%}--itc-p2-left:auto;{%- else -%}--itc-p2-left:{{ p2l }}%;{%- endif -%}
  --itc-p2-w:{{ section.settings.image_2_width | default: 68 }}%;
  {%- if p2h < 0 -%}--itc-p2-h:auto;{%- else -%}--itc-p2-h:{{ p2h }}%;{%- endif -%}
  {%- if p3t < 0 -%}--itc-p3-top:auto;{%- else -%}--itc-p3-top:{{ p3t }}%;{%- endif -%}
  {%- if p3r < 0 -%}--itc-p3-right:auto;{%- else -%}--itc-p3-right:{{ p3r }}%;{%- endif -%}
  {%- if p3b < 0 -%}--itc-p3-bottom:auto;{%- else -%}--itc-p3-bottom:{{ p3b }}%;{%- endif -%}
  {%- if p3l < 0 -%}--itc-p3-left:auto;{%- else -%}--itc-p3-left:{{ p3l }}%;{%- endif -%}
  --itc-p3-w:{{ section.settings.image_3_width | default: 48 }}%;
  {%- if p3h < 0 -%}--itc-p3-h:auto;{%- else -%}--itc-p3-h:{{ p3h }}%;{%- endif -%}
{%- endcapture -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<section
  class="itc section section--{{ section.settings.section_width | default: 'page-width' }} color-{{ section.settings.color_scheme }}"
  id="ImageTextCollage-{{ section.id }}"
  {{ section.shopify_attributes }}
  style="
    {{ pos_vars | strip }}
    padding-top: {{ section.settings.padding_top | default: 72 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 72 }}px;
    --itc-pattern-opacity: {{ section.settings.pattern_opacity | default: 14 | times: 0.01 }};
    --itc-img-radius: {{ section.settings.image_radius | default: 16 }}px;
    --itc-rot1: {{ section.settings.image_1_rotation | default: -4 }}deg;
    --itc-rot2: {{ section.settings.image_2_rotation | default: 4 }}deg;
    --itc-rot3: {{ section.settings.image_3_rotation | default: -3 }}deg;
    --itc-btn-bg: {{ section.settings.btn_bg | default: '#f5c518' }};
    --itc-btn-fg: {{ section.settings.btn_fg | default: '#111111' }};
    --itc-btn-hover-bg: {{ section.settings.btn_hover_bg | default: '#ddb015' }};
    --itc-badge-bg: {{ section.settings.badge_bg | default: '#f2c419' }};
    --itc-badge-fg: {{ section.settings.badge_fg | default: '#1a1a1a' }};
    --itc-badge-size: {{ section.settings.badge_size | default: 18 }}%;
    {% case section.settings.heading_size %}
      {% when 'small'  %}--itc-heading-size: clamp(1.15rem, 2vw, 1.65rem);
      {% when 'medium' %}--itc-heading-size: clamp(1.5rem, 2.8vw, 2.35rem);
      {% when 'large'  %}--itc-heading-size: clamp(1.85rem, 3.5vw, 3rem);
      {% when 'xlarge' %}--itc-heading-size: clamp(2.25rem, 4.5vw, 3.75rem);
      {% else           %}--itc-heading-size: clamp(1.5rem, 2.8vw, 2.35rem);
    {% endcase %}
  "
>

  {%- if section.settings.pattern_image != blank -%}
    <div
      class="itc__pattern force-full-width"
      style="background-image: url('{{ section.settings.pattern_image | image_url: width: 2000 }}');"
      role="presentation"
      aria-hidden="true"
    ></div>
  {%- endif -%}

  <div class="section-container">
    <div class="itc__inner{% if section.settings.media_position == 'right' %} itc__inner--reversed{% endif %}">

      {%- comment -%}─── COLLAGE COLUMN ───{%- endcomment -%}
      <div class="itc__collage-wrap{% if stack_mode == 1 %} itc__collage-wrap--solo{% endif %}">
        <div class="itc__stack itc__stack--{{ stack_mode }}">

          {%- if img1 != blank -%}
            <div class="itc__photo itc__photo--1">
              {{ img1 | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000',
                  sizes: '(min-width: 990px) 26vw, 55vw',
                  alt: img1.alt | default: section.settings.heading | default: '',
                  class: 'itc__img'
              }}
            </div>
          {%- elsif stack_mode >= 2 -%}
            <div class="itc__photo itc__photo--1 itc__photo--placeholder" aria-hidden="true">
              {{ 'image' | placeholder_svg_tag: 'itc__img itc__img--ph' }}
            </div>
          {%- endif -%}

          {%- if img2 != blank -%}
            <div class="itc__photo itc__photo--2">
              {{ img2 | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 500, 700, 900',
                  sizes: '(min-width: 990px) 22vw, 45vw',
                  alt: img2.alt | default: section.settings.heading | default: '',
                  class: 'itc__img'
              }}
            </div>
          {%- elsif stack_mode >= 2 -%}
            <div class="itc__photo itc__photo--2 itc__photo--placeholder" aria-hidden="true">
              {{ 'image' | placeholder_svg_tag: 'itc__img itc__img--ph' }}
            </div>
          {%- endif -%}

          {%- if img3 != blank -%}
            <div class="itc__photo itc__photo--3">
              {{ img3 | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 500, 700, 900',
                  sizes: '(min-width: 990px) 20vw, 40vw',
                  alt: img3.alt | default: section.settings.heading | default: '',
                  class: 'itc__img'
              }}
            </div>
          {%- elsif stack_mode >= 2 -%}
            <div class="itc__photo itc__photo--3 itc__photo--placeholder" aria-hidden="true">
              {{ 'image' | placeholder_svg_tag: 'itc__img itc__img--ph' }}
            </div>
          {%- endif -%}

          {%- if stack_mode >= 2 and section.settings.show_badge != false -%}
            {%- assign badge_text = section.settings.badge_text | default: 'EXPLORE MORE ~ EXPLORE MORE ~ ' -%}
            {%- if section.settings.button_link != blank -%}
              <a class="itc-badge" href="{{ section.settings.button_link }}" aria-label="{{ badge_text | escape }}">
            {%- else -%}
              <div class="itc-badge" aria-hidden="true">
            {%- endif -%}
              <svg class="itc-badge__ring" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                <defs>
                  <path id="itc-ring-{{ section.id }}" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/>
                </defs>
                <circle cx="60" cy="60" r="35" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
                <text font-size="12.5" font-weight="700" letter-spacing="1">
                  <textPath href="#itc-ring-{{ section.id }}" textLength="289" lengthAdjust="spacingAndGlyphs">{{ badge_text }}</textPath>
                </text>
              </svg>
              <span class="itc-badge__center" aria-hidden="true">
                <span class="itc-badge__arrow">&#x2192;</span>
              </span>
            {%- if section.settings.button_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          {%- endif -%}

        </div>
      </div>

      {%- comment -%}─── CONTENT COLUMN ───{%- endcomment -%}
      <div class="itc__content">

        {%- if section.settings.show_subtitle and section.settings.subtitle != blank or section.settings.heading != blank -%}
          <div class="itc__heading-group">
            {%- if section.settings.show_subtitle and section.settings.subtitle != blank -%}
              <p class="itc__eyebrow">{{ section.settings.subtitle | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="itc__heading" id="ImageTextCollage-heading-{{ section.id }}">
                {{- section.settings.heading | escape -}}
              </h2>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_description and section.settings.description != blank -%}
          <div class="itc__description rte">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.settings.show_feature_grid and has_feature_blocks -%}
          <div class="itc__features" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <div class="itc__feature" role="listitem" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <div class="itc__feature-icon has-icon">
                      {{ block.settings.icon | image_url: width: 120
                        | image_tag:
                          loading: 'lazy',
                          widths: '60, 90, 120',
                          sizes: '48px',
                          alt: block.settings.title,
                          class: 'itc__feature-img'
                      }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <p class="itc__feature-label">{{ block.settings.title | escape }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_cta and section.settings.button_label != blank -%}
          {%- if section.settings.button_link != blank -%}
            <a href="{{ section.settings.button_link }}" class="itc__btn">
              {{- section.settings.button_label | escape -}}
            </a>
          {%- else -%}
            <span class="itc__btn itc__btn--static">
              {{- section.settings.button_label | escape -}}
            </span>
          {%- endif -%}
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text collage",
  "tag": "section",
  "class": "image-text-collage-section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Color" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },

    { "type": "header", "content": "Background pattern" },
    { "type": "image_picker", "id": "pattern_image", "label": "Decorative pattern", "info": "Optional full-width background texture (e.g. floral). Tile or full-cover." },
    { "type": "range", "id": "pattern_opacity", "min": 4, "max": 40, "step": 2, "unit": "%", "label": "Pattern visibility", "default": 14 },

    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "section_width", "label": "Section width",
      "options": [{ "value": "page-width", "label": "Page width" }, { "value": "full-width", "label": "Full width" }],
      "default": "page-width"
    },
    {
      "type": "select", "id": "media_position", "label": "Collage side",
      "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }],
      "default": "left"
    },

    { "type": "header", "content": "Images" },
    { "type": "paragraph", "content": "1 image → fills column. 2 images → offset overlap. 3 images → stacked collage. Position values: −1 = Auto (ignored)." },

    { "type": "image_picker", "id": "image_1", "label": "Image 1", "info": "Top-right photo." },
    { "type": "range", "id": "image_1_width", "min": 20, "max": 100, "step": 1, "unit": "%", "label": "Image 1 — width", "default": 56 },
    { "type": "range", "id": "image_1_rotation", "min": -15, "max": 15, "step": 1, "unit": "deg", "label": "Image 1 — rotation", "default": -4 },
    { "type": "header", "content": "Image 1 — position" },
    { "type": "range", "id": "image_1_top", "min": -1, "max": 80, "step": 1, "unit": "%", "label": "From top (−1 = auto)", "default": 0 },
    { "type": "range", "id": "image_1_right", "min": -1, "max": 80, "step": 1, "unit": "%", "label": "From right (−1 = auto)", "default": 0 },
    { "type": "range", "id": "image_1_bottom", "min": -1, "max": 80, "step": 1, "unit": "%", "label": "From bottom (−1 = auto)", "default": -1 },
    { "type": "range", "id": "image_1_left", "min": -1, "max": 80, "step": 1, "unit": "%", "label": "From left (−1 = auto)", "default": -1 },

    { "type": "image_picker", "id": "image_2", "label": "Image 2", "info": "Main center-left photo (largest)." },
    { "type": "range", "id": "image_2_width", "min": 20, "max": 100, "step": 1, "unit": "%", "label": "Image 2 — width", "default": 68 },
    { "type": "range", "id": "image_2_rotation", "min": -15, "max": 15, "step": 1, "unit": "deg", "label": "Image 2 — rotation", "default": 4 },
    { "type": "header", "content": "Image 2 — position" },
    { "type": "range", "id": "image_2_top", "min": -1, "max": 80, "step": 1, "unit": "%", "label": "From top (−1 = auto)", "default": 28 },
    { "type": "range", "id": "image_2_right", "min": -1, "max": 80, "step": 1, "unit": "%", "label": "From right (−1 = auto)", "default": -1 },
    { "type": "range", "id": "image_2_bottom", "min": -1, "max": 80, "step": 1, "unit": "%", "label": "From bottom (−1 = auto)", "default": -1 },
    { "type": "range", "id": "image_2_left", "min": -1, "max": 80, "step": 1, "unit": "%", "label": "From left (−1 = auto)", "default": 0 },

    { "type": "image_picker", "id": "image_3", "label": "Image 3", "info": "Bottom-right photo." },
    { "type": "range", "id": "image_3_width", "min": 20, "max": 100, "step": 1, "unit": "%", "label": "Image 3 — width", "default": 48 },
    { "type": "range", "id": "image_3_rotation", "min": -15, "max": 15, "step": 1, "unit": "deg", "label": "Image 3 — rotation", "default": -3 },
    { "type": "header", "content": "Image 3 — position" },
    { "type": "range", "id": "image_3_top", "min": -1, "max": 80, "step": 1, "unit": "%", "label": "From top (−1 = auto)", "default": -1 },
    { "type": "range", "id": "image_3_right", "min": -1, "max": 80, "step": 1, "unit": "%", "label": "From right (−1 = auto)", "default": 3 },
    { "type": "range", "id": "image_3_bottom", "min": -1, "max": 80, "step": 1, "unit": "%", "label": "From bottom (−1 = auto)", "default": 0 },
    { "type": "range", "id": "image_3_left", "min": -1, "max": 80, "step": 1, "unit": "%", "label": "From left (−1 = auto)", "default": -1 },

    { "type": "range", "id": "image_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Image corner radius", "default": 16 },

    { "type": "header", "content": "Text" },
    { "type": "checkbox", "id": "show_subtitle", "label": "Show eyebrow text", "default": true },
    { "type": "text", "id": "subtitle", "label": "Eyebrow text", "default": "Pure and simple" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Intensive Hair Serum for Radiant Shine & Lasting Strength" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size",
      "options": [
        { "value": "small",  "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large",  "label": "Large" },
        { "value": "xlarge", "label": "Extra large" }
      ],
      "default": "medium"
    },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    {
      "type": "richtext", "id": "description", "label": "Description",
      "default": "<p>Our concentrated serum helps smooth the look of damage and adds luminous shine with plant-based actives you can feel good about.</p>"
    },
    { "type": "checkbox", "id": "show_feature_grid", "label": "Show feature icons", "default": true },
    { "type": "checkbox", "id": "show_cta", "label": "Show button", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore sale" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Button style" },
    { "type": "color", "id": "btn_bg", "label": "Background", "default": "#f5c518" },
    { "type": "color", "id": "btn_fg", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "btn_hover_bg", "label": "Hover background", "default": "#ddb015" },

    { "type": "header", "content": "Explore badge" },
    { "type": "checkbox", "id": "show_badge", "label": "Show rotating badge", "default": true, "info": "Visible with 2 or 3 images." },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "EXPLORE MORE ~ EXPLORE MORE ~ ", "info": "Repeat twice with a separator to fill the ring." },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#f2c419" },
    { "type": "color", "id": "badge_fg", "label": "Badge text & icon color", "default": "#1a1a1a" },
    { "type": "range", "id": "badge_size", "label": "Badge size", "min": 12, "max": 28, "step": 1, "unit": "%", "default": 18 },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature icon",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon image" },
        { "type": "text", "id": "title", "label": "Label", "default": "Healthy & soft" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text collage",
      "settings": {
        "color_scheme": "scheme-1",
        "section_width": "page-width",
        "media_position": "left",
        "subtitle": "Pure and simple",
        "heading": "Intensive Hair Serum for Radiant Shine & Lasting Strength",
        "show_subtitle": true,
        "show_description": true,
        "show_feature_grid": true,
        "show_cta": true,
        "button_label": "Explore sale"
      },
      "blocks": [
        { "type": "feature", "settings": { "title": "Healthy & Soft" } },
        { "type": "feature", "settings": { "title": "Free from Sulfates" } },
        { "type": "feature", "settings": { "title": "No Parabens Added" } },
        { "type": "feature", "settings": { "title": "100% Plant-Powered" } }
      ]
    }
  ]
}
{% endschema %}
