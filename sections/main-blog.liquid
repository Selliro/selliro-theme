{%- comment -%}
  Blog list page (blog template) — the journal.
  · Header panel: eyebrow, blog title, description, post count and a search box (searches blog posts only).
  · Categories: "All" plus one pill per tag (Shopify filters a blog by tag: /blogs/<blog>/tagged/<tag>).
  · Toolbar: what is showing, a "Clear" link while a category is active, grid / list view switch.
  · Featured post: the newest post as a large card (first page of "All" only).
  · Posts: cards with image, category, title, excerpt, author / date / reading time; numbered pagination.
  Files:  assets/section-main-blog.css (styles), assets/section-main-blog.js (view switch),
          snippets/blog-list-card.liquid (a post card).
  Order:  1. CSS   2. Liquid (data + markup)   3. Schema
{%- endcomment -%}

{%- comment -%} ============================================================== 1. CSS {%- endcomment -%}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- comment -%} Values that come from this section's settings (the rest is in section-main-blog.css) {%- endcomment -%}
{% style %}
  #shopify-section-{{ section.id }} .blog-list {
    --blog-pad-top: {{ section.settings.padding-block-start }}px;
    --blog-pad-bottom: {{ section.settings.padding-block-end }}px;
    --blog-ratio: {{ section.settings.image_ratio | default: '16 / 10' }};
    --blog-columns: {{ section.settings.columns }};
  }
{% endstyle %}

{%- comment -%} =========================================================== 2. Liquid {%- endcomment -%}
<script
  src="{{ 'section-main-blog.js' | asset_url }}"
  defer
></script>

{%- liquid
  assign active_tag = current_tags.first
  assign is_filtered = false
  if active_tag != blank
    assign is_filtered = true
  endif
  assign per_page = section.settings.posts_per_page | default: 9
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="blog-list color-{{ section.settings.color_scheme }}">
  {%- comment -%} ------------------------------------------------------------ header {%- endcomment -%}
  <header class="blog-list__hero">
    <div class="blog-list__hero-text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="blog-list__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="blog-list__title">
        {%- if is_filtered -%}
          {{ active_tag | escape }}
        {%- else -%}
          {{ blog.title | escape }}
        {%- endif -%}
      </h1>
      {%- if section.settings.description != blank -%}
        <div class="blog-list__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
      <p class="blog-list__count">{{ 'blog_plus.posts_count' | t: count: blog.articles_count }}</p>
    </div>

    {%- if section.settings.show_search -%}
      <form
        class="blog-list__search"
        action="{{ routes.search_url }}"
        method="get"
        role="search"
      >
        <input
          type="hidden"
          name="type"
          value="article"
        >
        <input
          type="hidden"
          name="options[prefix]"
          value="last"
        >
        <label
          class="visually-hidden"
          for="BlogSearch-{{ section.id }}"
        >
          {{- 'blog_plus.search_label' | t -}}
        </label>
        <svg
          class="blog-list__search-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="m20 20-3.6-3.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <input
          id="BlogSearch-{{ section.id }}"
          class="blog-list__search-input"
          type="search"
          name="q"
          placeholder="{{ 'blog_plus.search_placeholder' | t }}"
          autocomplete="off"
        >
        <button
          type="submit"
          class="blog-list__search-btn"
          aria-label="{{ 'blog_plus.search_label' | t }}"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </form>
    {%- endif -%}
  </header>

  {%- comment -%} -------------------------------------------------------- categories {%- endcomment -%}
  {%- if section.settings.show_categories and blog.all_tags.size > 0 -%}
    <nav
      class="blog-list__cats"
      aria-label="{{ 'blog_plus.categories' | t }}"
    >
      <ul
        class="blog-list__cats-list list-unstyled"
        role="list"
      >
        <li>
          <a
            class="blog-list__cat{% unless is_filtered %} is-active{% endunless %}"
            href="{{ blog.url }}"
            {% unless is_filtered %}
              aria-current="page"
            {% endunless %}
          >
            {{- 'blog_plus.all' | t -}}
          </a>
        </li>
        {%- for tag in blog.all_tags -%}
          {%- assign is_active = false -%}
          {%- if current_tags contains tag -%}
            {%- assign is_active = true -%}
          {%- endif -%}
          <li>
            <a
              class="blog-list__cat{% if is_active %} is-active{% endif %}"
              href="{{ blog.url }}/tagged/{{ tag | handleize }}"
              {% if is_active %}
                aria-current="page"
              {% endif %}
            >
              {{- tag | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  {%- comment -%} ------------------------------------------------------------- posts {%- endcomment -%}
  <blog-list-view
    class="blog-list__body"
    data-default-view="{{ section.settings.default_view }}"
    data-view="{{ section.settings.default_view }}"
  >
    {%- paginate blog.articles by per_page -%}
      {%- liquid
        assign show_featured = false
        if section.settings.show_featured and is_filtered == false and paginate.current_page == 1 and blog.articles.size > 1
          assign show_featured = true
        endif
      -%}

      <div class="blog-list__toolbar">
        <p
          class="blog-list__status"
          role="status"
        >
          {%- if is_filtered -%}
            {{ 'blog_plus.in_category_html' | t: tag: active_tag }}
            <a
              class="blog-list__clear"
              href="{{ blog.url }}"
            >
              {{- 'blog_plus.clear' | t -}}
            </a>
          {%- else -%}
            {{ 'blog_plus.showing_html' | t: count: paginate.items }}
          {%- endif -%}
        </p>

        {%- if section.settings.show_view_toggle and blog.articles.size > 0 -%}
          <div
            class="blog-list__views"
            role="group"
          >
            <button
              type="button"
              class="blog-list__view-btn"
              data-blog-view="grid"
              aria-pressed="true"
              aria-label="{{ 'blog_plus.view_grid' | t }}"
              title="{{ 'blog_plus.view_grid' | t }}"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.6" stroke="currentColor" stroke-width="1.7"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6" stroke="currentColor" stroke-width="1.7"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6" stroke="currentColor" stroke-width="1.7"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.6" stroke="currentColor" stroke-width="1.7"/></svg>
            </button>
            <button
              type="button"
              class="blog-list__view-btn"
              data-blog-view="list"
              aria-pressed="false"
              aria-label="{{ 'blog_plus.view_list' | t }}"
              title="{{ 'blog_plus.view_list' | t }}"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5" width="6" height="5" rx="1.4" stroke="currentColor" stroke-width="1.7"/><rect x="4" y="14" width="6" height="5" rx="1.4" stroke="currentColor" stroke-width="1.7"/><path d="M13.5 6.5h6.5M13.5 9h4M13.5 15.5h6.5M13.5 18h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      {%- if blog.articles.size == 0 -%}
        <div class="blog-list__empty">
          <span
            class="blog-list__empty-icon"
            aria-hidden="true"
          >
            <svg width="40" height="40" viewBox="0 0 48 48" fill="none"><rect x="9" y="7" width="30" height="34" rx="4" stroke="currentColor" stroke-width="1.8"/><path d="M16 17h16M16 24h16M16 31h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </span>
          <h2 class="blog-list__empty-title">{{ 'blog_plus.no_posts_title' | t }}</h2>
          <p class="blog-list__empty-text">{{ 'blog_plus.no_posts_text' | t }}</p>
          <a
            class="button blog-list__empty-btn"
            href="{{ blog.url }}"
          >
            {{- 'blog_plus.see_all' | t -}}
          </a>
        </div>
      {%- else -%}
        {%- if show_featured -%}
          {% render 'blog-list-card', post: blog.articles.first, blog: blog, settings: section.settings, featured: true %}
        {%- endif -%}

        <ul
          class="blog-list__grid list-unstyled"
          role="list"
          data-blog-grid
        >
          {%- for post in blog.articles -%}
            {%- if show_featured and forloop.first -%}
              {%- continue -%}
            {%- endif -%}
            <li class="blog-list__item">
              {% render 'blog-list-card', post: post, blog: blog, settings: section.settings, index: forloop.index0 %}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav
            class="blog-list__pagination"
            aria-label="{{ 'content.pagination.nav_label' | t }}"
          >
            {%- if paginate.previous -%}
              <a
                class="blog-list__page blog-list__page--step"
                href="{{ paginate.previous.url }}"
                aria-label="{{ 'blog_plus.previous_page' | t }}"
              >
                ←
              </a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a
                  class="blog-list__page"
                  href="{{ part.url }}"
                  aria-label="{{ 'blog_plus.page' | t: page: part.title }}"
                >
                  {{- part.title -}}
                </a>
              {%- elsif part.title == paginate.current_page -%}
                <span
                  class="blog-list__page is-current"
                  aria-current="page"
                >
                  {{- part.title -}}
                </span>
              {%- else -%}
                <span class="blog-list__page blog-list__page--gap">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a
                class="blog-list__page blog-list__page--step"
                href="{{ paginate.next.url }}"
                aria-label="{{ 'blog_plus.next_page' | t }}"
              >
                →
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </blog-list-view>

  {%- comment -%} Blocks added in the theme editor (and app blocks) {%- endcomment -%}
  <div class="blog-list__blocks">
    {% content_for 'blocks' %}
  </div>
</div>

{%- comment -%} =========================================================== 3. Schema {%- endcomment -%}
{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The journal"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Skincare guides, simple routines and honest advice from the Whispo team.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "info": "Searches blog posts only.",
      "default": true
    },
    {
      "type": "header",
      "content": "Categories and view"
    },
    {
      "type": "checkbox",
      "id": "show_categories",
      "label": "Show categories",
      "info": "One category per post tag. Add tags to posts in Online Store › Blog posts.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_toggle",
      "label": "Show grid / list switch",
      "default": true
    },
    {
      "type": "select",
      "id": "default_view",
      "label": "Default view",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "list",
          "label": "List"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "Feature the newest post",
      "info": "A large card at the top of the first page of All.",
      "default": true
    },
    {
      "type": "header",
      "content": "Posts"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "Posts per page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "16 / 10",
          "label": "Landscape"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        }
      ],
      "default": "16 / 10"
    },
    {
      "type": "checkbox",
      "id": "show_card_tags",
      "label": "Show category on cards",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reading_time",
      "label": "Show reading time",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    }
  ]
}
{% endschema %}
