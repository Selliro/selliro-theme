{%- comment -%}
  Contact page — banner, quick-contact cards, contact form and map.
  · Banner: background image with overlay, eyebrow, heading, text and breadcrumb.
  · Quick-contact cards (blocks): email, phone, visit, hours… overlapping the banner's lower edge.
  · Form (Shopify contact form → emails the store): name, email, phone, topic, order number, message.
  · Map: Google Maps embed of an address (no API key), optional grayscale, with a card showing the address,
    opening hours and a "Get directions" link. Form and map can swap sides; without an address an image shows.
  Block: contact_item.   Uses the shared assets/section-reveal.*
{%- endcomment -%}
{{ 'section-reveal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-reveal.js' | asset_url }}" defer></script>

{%- liquid
  assign items = section.blocks | where: 'type', 'contact_item'
  assign address = section.settings.map_address | strip
  assign address_q = address | url_encode
  assign form_id = 'ContactPageForm-' | append: section.id
  assign map_side = section.settings.map_position | default: 'right'
  assign topics = section.settings.topics | newline_to_br | split: '<br />'
-%}

{%- capture icon_svgs -%}
  mail|<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/>
  phone|<path d="M5 3.5h3l1.6 4.2-2 1.4a12 12 0 0 0 7.3 7.3l1.4-2 4.2 1.6v3A2 2 0 0 1 18.3 21 15.5 15.5 0 0 1 3 5.7a2 2 0 0 1 2-2.2Z"/>
  pin|<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.4"/>
  clock|<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
  chat|<path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9.5h8M8 12.5h5"/>
  instagram|<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"/>
  truck|<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
  help|<circle cx="12" cy="12" r="8.5"/><path d="M9.7 9.5a2.4 2.4 0 1 1 3.4 2.2c-.7.4-1.1.9-1.1 1.7v.4M12 16.8v.2"/>
{%- endcapture -%}
{%- assign icon_lines = icon_svgs | strip | newline_to_br | split: '<br />' -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="ctc color-{{ section.settings.color_scheme }}"
  data-reveal
  style="--ctc-pad-top: {{ section.settings.padding_top }}px; --ctc-pad-bottom: {{ section.settings.padding_bottom }}px; --ctc-accent: {{ section.settings.accent_color | default: '#f8d12f' }}; --ctc-radius: {{ section.settings.radius }}px; --ctc-banner-h: {{ section.settings.banner_height }}px; --ctc-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --ctc-map-h: {{ section.settings.map_height }}px;"
>
  {%- comment -%} ======================================================== banner {%- endcomment -%}
  {%- if section.settings.show_banner -%}
    <div class="ctc__banner-wrap {{ section.settings.banner_width }}">
      <div class="ctc__banner ctc__banner--{{ section.settings.banner_align }}{% if items.size > 0 %} ctc__banner--with-cards{% endif %}" data-reveal-rise>
        <div class="ctc__banner-media" aria-hidden="true">
          {%- if section.settings.banner_image != blank -%}
            {{ section.settings.banner_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', alt: '' }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'ctc__placeholder' }}
          {%- endif -%}
        </div>
        <div class="ctc__banner-copy page-width">
          {%- if section.settings.show_breadcrumb -%}
            <nav class="ctc__crumbs" aria-label="{{ 'collection_hero.breadcrumb_label' | t }}">
              <a href="{{ routes.root_url }}">{{ 'collection_hero.home' | t }}</a>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{{ page.title | default: section.settings.heading | escape }}</span>
            </nav>
          {%- endif -%}
          {%- if section.settings.eyebrow != blank -%}
            <p class="ctc__eyebrow" data-reveal-fade="first">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h1 class="ctc__heading" data-reveal-title>{{ section.settings.heading | escape }}</h1>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="ctc__banner-text rte" data-reveal-fade>{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="page-width">
    {%- comment -%} ======================================================== quick-contact cards {%- endcomment -%}
    {%- if items.size > 0 -%}
      <ul class="ctc__cards{% if section.settings.show_banner %} ctc__cards--overlap{% endif %}" role="list" style="--ctc-cards: {{ items.size }};">
        {%- for block in items -%}
          <li class="ctc__card" data-reveal-card {{ block.shopify_attributes }}>
            <span class="ctc__card-icon" aria-hidden="true">
              {%- for line in icon_lines -%}
                {%- assign parts = line | strip | split: '|' -%}
                {%- if parts.first == block.settings.icon -%}
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{{ parts.last }}</svg>
                {%- endif -%}
              {%- endfor -%}
            </span>
            <span class="ctc__card-copy">
              {%- if block.settings.title != blank -%}<strong class="ctc__card-title">{{ block.settings.title | escape }}</strong>{%- endif -%}
              {%- if block.settings.text != blank -%}<span class="ctc__card-text">{{ block.settings.text | escape | newline_to_br }}</span>{%- endif -%}
              {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                <a class="ctc__card-link" href="{{ block.settings.link }}">
                  {{- block.settings.link_label | escape -}}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- comment -%} ======================================================== form + map {%- endcomment -%}
    <div class="ctc__split ctc__split--map-{{ map_side }}">
      <div class="ctc__form-panel" data-reveal-slide="left">
        {%- if section.settings.form_eyebrow != blank -%}
          <p class="ctc__form-eyebrow">{{ section.settings.form_eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.form_heading != blank -%}
          <h2 class="ctc__form-heading">{{ section.settings.form_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.form_text != blank -%}
          <div class="ctc__form-text rte">{{ section.settings.form_text }}</div>
        {%- endif -%}
        {%- if section.settings.show_page_content and page.content != blank -%}
          <div class="ctc__form-text rte">{{ page.content }}</div>
        {%- endif -%}

        {%- form 'contact', id: form_id, class: 'ctc__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="ctc__success" role="status" tabindex="-1" data-ctc-posted>
              <span class="ctc__success-icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <p>{{ section.settings.success_text | default: 'Thanks for reaching out! We will get back to you within one business day.' | escape }}</p>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div class="ctc__error" role="alert" data-ctc-posted>{{ form.errors | default_errors }}</div>
            {%- endif -%}
            <div class="ctc__grid">
              <label class="ctc__field">
                <span class="ctc__label">{{ section.settings.label_name | escape }}</span>
                <input class="ctc__input" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}" required>
              </label>
              <label class="ctc__field">
                <span class="ctc__label">{{ section.settings.label_email | escape }}</span>
                <input class="ctc__input" type="email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}" required{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
              </label>
              {%- if section.settings.show_phone -%}
                <label class="ctc__field">
                  <span class="ctc__label">{{ section.settings.label_phone | escape }}</span>
                  <input class="ctc__input" type="tel" name="contact[phone]" autocomplete="tel">
                </label>
              {%- endif -%}
              {%- if topics.size > 0 and section.settings.topics != blank -%}
                <label class="ctc__field">
                  <span class="ctc__label">{{ section.settings.label_topic | escape }}</span>
                  <select class="ctc__input ctc__select" name="contact[Topic]">
                    {%- for topic in topics -%}
                      {%- assign topic = topic | strip -%}
                      {%- if topic != blank -%}<option>{{ topic | escape }}</option>{%- endif -%}
                    {%- endfor -%}
                  </select>
                </label>
              {%- endif -%}
              {%- if section.settings.show_order -%}
                <label class="ctc__field ctc__field--full">
                  <span class="ctc__label">{{ section.settings.label_order | escape }} <span class="ctc__optional">{{ section.settings.label_optional | escape }}</span></span>
                  <input class="ctc__input" type="text" name="contact[Order number]" inputmode="text" placeholder="#1001">
                </label>
              {%- endif -%}
              <label class="ctc__field ctc__field--full">
                <span class="ctc__label">{{ section.settings.label_message | escape }}</span>
                <textarea class="ctc__input ctc__textarea" name="contact[body]" rows="5" required>{{ form.body }}</textarea>
              </label>
            </div>
            <button type="submit" class="button ctc__submit">
              {{- section.settings.button_label | escape -}}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            {%- if section.settings.privacy_note != blank -%}
              <p class="ctc__note">{{ section.settings.privacy_note | escape }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="ctc__map-panel" data-reveal-slide="right">
        <div class="ctc__map{% if section.settings.map_grayscale %} ctc__map--gray{% endif %}">
          {%- if address != blank -%}
            <iframe
              class="ctc__map-frame"
              src="https://maps.google.com/maps?q={{ address_q }}&z={{ section.settings.map_zoom }}&output=embed"
              title="{{ section.settings.map_title | default: address | escape }}"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          {%- elsif section.settings.map_image != blank -%}
            {{ section.settings.map_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', class: 'ctc__map-img', alt: section.settings.store_name }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'ctc__placeholder' }}
          {%- endif -%}

          {%- if section.settings.store_name != blank or section.settings.store_address != blank or section.settings.store_hours != blank -%}
            <div class="ctc__map-card">
              {%- if section.settings.store_name != blank -%}
                <p class="ctc__map-name">
                  <span class="ctc__map-dot" aria-hidden="true"></span>
                  {{- section.settings.store_name | escape -}}
                </p>
              {%- endif -%}
              {%- if section.settings.store_address != blank -%}
                <p class="ctc__map-text">{{ section.settings.store_address | escape | newline_to_br }}</p>
              {%- endif -%}
              {%- if section.settings.store_hours != blank -%}
                <p class="ctc__map-hours">{{ section.settings.store_hours | escape | newline_to_br }}</p>
              {%- endif -%}
              {%- if address != blank and section.settings.directions_label != blank -%}
                <a class="ctc__map-link" href="https://www.google.com/maps/dir/?api=1&destination={{ address_q }}" target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.7"/></svg>
                  {{- section.settings.directions_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%} After a submission, bring the form (and its message) into view {%- endcomment -%}
<script>
  (() => {
    const msg = document.querySelector('#{{ form_id }} [data-ctc-posted]');
    if (!msg) return;
    requestAnimationFrame(() => {
      msg.closest('.ctc__form-panel')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
      msg.focus?.({ preventScroll: true });
    });
  })();
</script>

{% stylesheet %}
  .ctc {
    --ctc-line: color-mix(in srgb, var(--color-foreground) 12%, transparent);
    --ctc-soft: color-mix(in srgb, var(--color-foreground) 4%, transparent);
    --ctc-ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    padding-block: var(--ctc-pad-top) var(--ctc-pad-bottom);
  }

  /* ---------------------------------------------------------------- banner */
  .ctc__banner-wrap.page-width {
    margin-inline: auto;
  }

  .ctc__banner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--ctc-banner-h);
    overflow: hidden;
    isolation: isolate;
    color: #fff;
  }

  .ctc__banner-wrap.page-width .ctc__banner {
    border-radius: calc(var(--ctc-radius) + 8px);
  }

  .ctc__banner--with-cards {
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .ctc__banner-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .ctc__banner-media img,
  .ctc__banner-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ctc__banner-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(20 16 12 / var(--ctc-overlay)) 0%, rgb(20 16 12 / calc(var(--ctc-overlay) * 0.55)) 55%, rgb(20 16 12 / calc(var(--ctc-overlay) * 0.2)) 100%);
  }

  .ctc__banner--center .ctc__banner-media::after {
    background: rgb(20 16 12 / var(--ctc-overlay));
  }

  .ctc__placeholder {
    background: #3a332c;
    fill: rgb(255 255 255 / 0.25);
  }

  .ctc__banner-copy {
    width: 100%;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .ctc__banner-wrap.page-width .ctc__banner-copy {
    padding-inline: clamp(1.5rem, 5vw, 4.5rem);
  }

  .ctc__banner--center .ctc__banner-copy {
    text-align: center;
  }

  .ctc__banner--center .ctc__banner-copy > * {
    margin-inline: auto;
  }

  .ctc__crumbs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: 0.8rem;
    opacity: 0.85;
  }

  .ctc__banner--center .ctc__crumbs {
    justify-content: center;
  }

  .ctc__crumbs a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .ctc__eyebrow {
    display: inline-flex;
    margin: 0 0 0.9rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: var(--ctc-accent);
    color: #111;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ctc__heading {
    max-width: 40rem;
    margin: 0;
    color: inherit;
    font-family: var(--font-heading--family);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: var(--section-title-weight, 600);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .ctc__banner-text {
    max-width: 34rem;
    margin-top: 1rem;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    opacity: 0.9;
  }

  /* ---------------------------------------------------------------- quick-contact cards */
  .ctc__cards {
    display: grid;
    grid-template-columns: repeat(min(var(--ctc-cards, 4), 4), minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .ctc__cards--overlap {
    position: relative;
    z-index: 2;
    margin-top: calc(clamp(3rem, 6vw, 4.5rem) * -0.75);
  }

  .ctc__card {
    display: flex;
    gap: 0.9rem;
    padding: clamp(1rem, 1.8vw, 1.35rem);
    border: 1px solid var(--ctc-line);
    border-radius: var(--ctc-radius);
    background: var(--color-background);
    box-shadow: 0 22px 44px -32px rgb(0 0 0 / 0.45);
    transition: translate 0.4s var(--ctc-ease), box-shadow 0.4s var(--ctc-ease);
  }

  @media (hover: hover) {
    .ctc__card:hover {
      translate: 0 -3px;
      box-shadow: 0 28px 50px -30px rgb(0 0 0 / 0.5);
    }
  }

  .ctc__card-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 14px;
    background: color-mix(in srgb, var(--ctc-accent) 35%, var(--color-background));
  }

  .ctc__card-copy {
    display: grid;
    align-content: start;
    gap: 0.2rem;
    min-width: 0;
  }

  .ctc__card-title {
    font-size: 0.95rem;
  }

  .ctc__card-text {
    font-size: 0.85rem;
    line-height: 1.5;
    opacity: 0.72;
    overflow-wrap: anywhere;
  }

  .ctc__card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.35rem;
    color: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .ctc__card-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------------------------------------------------------------- form + map */
  .ctc__split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: stretch;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .ctc__split--map-left .ctc__map-panel {
    order: -1;
  }

  .ctc__form-panel {
    min-width: 0;
  }

  .ctc__form-eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .ctc__form-heading {
    margin: 0;
    font-size: var(--section-title-size, clamp(1.8rem, 3.2vw, 2.6rem));
    font-weight: var(--section-title-weight);
    line-height: var(--section-title-leading, 1.1);
    letter-spacing: var(--section-title-tracking);
  }

  .ctc__form-text {
    margin-top: 0.75rem;
    max-width: 34rem;
    opacity: 0.75;
  }

  .ctc__form {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .ctc__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .ctc__field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .ctc__field--full {
    grid-column: 1 / -1;
  }

  .ctc__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .ctc__optional {
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    opacity: 0.8;
  }

  .ctc__input {
    width: 100%;
    min-height: 3.1rem;
    padding: 0.7rem 1rem;
    border: 1.5px solid var(--ctc-line);
    border-radius: 12px;
    background: var(--color-background);
    color: inherit;
    font: inherit;
    font-size: 1rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .ctc__input:focus-visible {
    outline: none;
    border-color: var(--color-foreground);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  .ctc__input[aria-invalid='true'] {
    border-color: #c0362c;
  }

  .ctc__textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .ctc__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 3.4rem;
    margin-top: 1.1rem;
  }

  .ctc__note {
    margin: 0.75rem 0 0;
    font-size: 0.78rem;
    text-align: center;
    opacity: 0.6;
  }

  .ctc__error {
    margin-bottom: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: #fdecea;
    color: #a32019;
    font-size: 0.9rem;
  }

  .ctc__success {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    padding: clamp(2rem, 5vw, 3.5rem) 1rem;
    border: 1px solid var(--ctc-line);
    border-radius: var(--ctc-radius);
    text-align: center;
    outline: none;
  }

  .ctc__success p {
    max-width: 24rem;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .ctc__success-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: #2e9e5b;
    color: #fff;
  }

  /* Map */
  .ctc__map-panel {
    min-width: 0;
  }

  .ctc__map {
    position: relative;
    height: 100%;
    min-height: var(--ctc-map-h);
    overflow: hidden;
    border: 1px solid var(--ctc-line);
    border-radius: calc(var(--ctc-radius) + 6px);
    background: #e9e5dc;
  }

  .ctc__map-frame,
  .ctc__map-img,
  .ctc__map .ctc__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .ctc__map--gray .ctc__map-frame {
    filter: grayscale(1) contrast(1.05);
  }

  .ctc__map-card {
    position: absolute;
    left: clamp(0.75rem, 2vw, 1.25rem);
    bottom: clamp(0.75rem, 2vw, 1.25rem);
    z-index: 2;
    display: grid;
    gap: 0.35rem;
    max-width: min(20rem, calc(100% - 1.5rem));
    padding: 1.1rem 1.2rem;
    border-radius: var(--ctc-radius);
    background: var(--color-background);
    box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.5);
  }

  .ctc__map-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .ctc__map-dot {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: #2e9e5b;
    box-shadow: 0 0 0 4px rgb(46 158 91 / 0.18);
  }

  .ctc__map-text,
  .ctc__map-hours {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    opacity: 0.78;
  }

  .ctc__map-hours {
    padding-top: 0.35rem;
    border-top: 1px solid var(--ctc-line);
  }

  .ctc__map-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.6rem;
    margin-top: 0.4rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .ctc__map-link:hover {
    opacity: 0.88;
  }

  /* ---------------------------------------------------------------- responsive */
  @media screen and (max-width: 989px) {
    .ctc__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ctc__split {
      grid-template-columns: minmax(0, 1fr);
    }

    .ctc__split--map-left .ctc__map-panel {
      order: 0;
    }

    .ctc__map {
      min-height: calc(var(--ctc-map-h) * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ctc__banner {
      min-height: calc(var(--ctc-banner-h) * 0.8);
    }

    .ctc__banner-media::after {
      background: rgb(20 16 12 / var(--ctc-overlay));
    }

    .ctc__cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .ctc__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Phones: the full map, with the address card underneath instead of on top */
    .ctc__map {
      display: flex;
      flex-direction: column;
      min-height: 0;
      height: auto;
    }

    .ctc__map-frame,
    .ctc__map-img,
    .ctc__map .ctc__placeholder {
      position: relative;
      inset: auto;
      height: 20rem;
      flex: none;
    }

    .ctc__map-card {
      position: static;
      max-width: none;
      border-top: 1px solid var(--ctc-line);
      border-radius: 0;
      box-shadow: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ctc__card {
      transition: none;
    }
  }
{% endstylesheet %}

