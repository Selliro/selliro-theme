{% liquid
  assign source_blog = section.settings.blog
  assign layout_mode = section.settings.layout_mode | default: 'split'
  assign show_excerpt = section.settings.show_excerpt
  assign show_tags = section.settings.show_tags
  assign show_comments = section.settings.show_comments
  assign show_view_all = section.settings.show_view_all
  assign display_limit = section.settings.post_limit | default: 3
  assign grid_columns = section.settings.grid_columns | default: 3
  assign mobile_columns = section.settings.mobile_columns | default: 1
  assign carousel_card_min = section.settings.carousel_card_min | default: 16

  if layout_mode == 'split'
    assign display_limit = 3
  endif

  assign rendered_count = 0
%}

{{ 'section-featured-blog-posts-v2.css' | asset_url | stylesheet_tag }}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} featured-blog-posts-v2 color-{{ section.settings.color_scheme }}"
  id="FeaturedBlogPosts-{{ section.id }}"
  style="
    --fbp-pad-top: {{ section.settings.padding_top }}px;
    --fbp-pad-bottom: {{ section.settings.padding_bottom }}px;
    --fbp-gap: {{ section.settings.card_gap }}px;
    --fbp-grid-columns: {{ grid_columns }};
    --fbp-mobile-columns: {{ mobile_columns }};
    --fbp-carousel-min: {{ carousel_card_min }}rem;
  "
  {{ section.shopify_attributes }}
>
  <div class="featured-blog-posts-v2__inner section-container">
    <header class="featured-blog-posts-v2__header">
      <h2 class="featured-blog-posts-v2__heading">
        {{ section.settings.heading | default: 'Latest Stories' | escape }}
      </h2>
      {% if show_view_all and source_blog != blank %}
        <a class="featured-blog-posts-v2__view-all" href="{{ source_blog.url }}">
          {{ section.settings.view_all_text | default: 'View All Posts' | escape }}
          <span aria-hidden="true">&#8250;</span>
        </a>
      {% endif %}
    </header>

    {% if layout_mode == 'carousel' %}
      <div class="featured-blog-posts-v2__carousel" role="list">
        {% if source_blog != blank and source_blog.articles_count > 0 %}
          {% for article in source_blog.articles limit: display_limit %}
            {% assign rendered_count = rendered_count | plus: 1 %}
            <article class="featured-blog-posts-v2__card featured-blog-posts-v2__card--carousel" role="listitem">
              <a class="featured-blog-posts-v2__card-link" href="{{ article.url }}">
                <div class="featured-blog-posts-v2__media-wrap">
                  <span class="featured-blog-posts-v2__date-ribbon">{{ article.published_at | date: '%b %d, %Y' | upcase }}</span>
                  {% if article.image != blank %}
                    {{
                      article.image
                      | image_url: width: 1100
                      | image_tag:
                        class: 'featured-blog-posts-v2__media',
                        loading: 'lazy',
                        widths: '420, 640, 860, 1100',
                        sizes: '(min-width: 990px) 31vw, 84vw',
                        alt: article.title
                    }}
                  {% else %}
                    {{ 'blog-apparel-1' | placeholder_svg_tag: 'featured-blog-posts-v2__media featured-blog-posts-v2__media--placeholder' }}
                  {% endif %}
                </div>
              </a>
              {% if show_tags and article.tags.size > 0 %}
                <ul class="featured-blog-posts-v2__tags" role="list">
                  {% for tag in article.tags limit: 2 %}
                    <li class="featured-blog-posts-v2__tag">#{{ tag | handleize }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </article>
          {% endfor %}
        {% endif %}

        {% assign missing = display_limit | minus: rendered_count %}
        {% if missing > 0 %}
          {% for i in (1..missing) %}
            <article class="featured-blog-posts-v2__card featured-blog-posts-v2__card--carousel" role="listitem">
              <div class="featured-blog-posts-v2__media-wrap">
                <span class="featured-blog-posts-v2__date-ribbon">{{ 'now' | date: '%b %d, %Y' | upcase }}</span>
                {{ 'blog-apparel-1' | placeholder_svg_tag: 'featured-blog-posts-v2__media featured-blog-posts-v2__media--placeholder' }}
              </div>
              <ul class="featured-blog-posts-v2__tags" role="list">
                <li class="featured-blog-posts-v2__tag">#beauty forecast</li>
                <li class="featured-blog-posts-v2__tag">#clean beauty</li>
              </ul>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    {% elsif layout_mode == 'split' %}
      <div class="featured-blog-posts-v2__split">
        <div class="featured-blog-posts-v2__split-main">
          {% assign rendered_count = 0 %}
          {% if source_blog != blank and source_blog.articles_count > 0 %}
            {% for article in source_blog.articles limit: 1 %}
              {% assign rendered_count = rendered_count | plus: 1 %}
              <article class="featured-blog-posts-v2__card featured-blog-posts-v2__card--featured">
                <a class="featured-blog-posts-v2__card-link" href="{{ article.url }}">
                  <div class="featured-blog-posts-v2__media-wrap featured-blog-posts-v2__media-wrap--featured featured-blog-posts-v2__media-wrap--featured-overlay">
                    {% if article.tags.size > 0 %}
                      <span class="featured-blog-posts-v2__badge">{{ article.tags.first }}</span>
                    {% endif %}
                    {% if article.image != blank %}
                      {{
                        article.image
                        | image_url: width: 1600
                        | image_tag:
                          class: 'featured-blog-posts-v2__media',
                          loading: 'lazy',
                          widths: '640, 920, 1280, 1600',
                          sizes: '(min-width: 990px) 65vw, 100vw',
                          alt: article.title
                      }}
                    {% else %}
                      {{ 'blog-apparel-1' | placeholder_svg_tag: 'featured-blog-posts-v2__media featured-blog-posts-v2__media--placeholder' }}
                    {% endif %}
                    <div class="featured-blog-posts-v2__content featured-blog-posts-v2__content--overlay">
                      <div class="featured-blog-posts-v2__meta">
                        <span>{{ article.published_at | date: '%b %d, %Y' }}</span>
                        {% if show_comments %}<span>{{ article.comments_count }} Comments</span>{% endif %}
                      </div>
                      <h3 class="featured-blog-posts-v2__title">{{ article.title }}</h3>
                      {% if show_excerpt %}
                        <p class="featured-blog-posts-v2__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
                      {% endif %}
                      <span class="featured-blog-posts-v2__read-more">Read more</span>
                    </div>
                  </div>
                </a>
              </article>
            {% endfor %}
          {% endif %}
          {% if rendered_count == 0 %}
            <article class="featured-blog-posts-v2__card featured-blog-posts-v2__card--featured">
              <div class="featured-blog-posts-v2__media-wrap featured-blog-posts-v2__media-wrap--featured featured-blog-posts-v2__media-wrap--featured-overlay">
                <span class="featured-blog-posts-v2__badge">Skincare</span>
                {{ 'blog-apparel-1' | placeholder_svg_tag: 'featured-blog-posts-v2__media featured-blog-posts-v2__media--placeholder' }}
                <div class="featured-blog-posts-v2__content featured-blog-posts-v2__content--overlay">
                  <div class="featured-blog-posts-v2__meta"><span>{{ 'now' | date: '%b %d, %Y' }}</span><span>0 Comments</span></div>
                  <h3 class="featured-blog-posts-v2__title">Top 5 Skincare Trends of 2025</h3>
                  <p class="featured-blog-posts-v2__excerpt">Explore the biggest beauty trends taking over this year.</p>
                  <span class="featured-blog-posts-v2__read-more">Read more</span>
                </div>
              </div>
            </article>
          {% endif %}
        </div>

        <div class="featured-blog-posts-v2__split-side">
          {% assign side_rendered = 0 %}
          {% if source_blog != blank and source_blog.articles_count > 1 %}
            {% for article in source_blog.articles offset: 1 limit: 2 %}
              {% assign side_rendered = side_rendered | plus: 1 %}
              <article class="featured-blog-posts-v2__side-item">
                <a class="featured-blog-posts-v2__side-media" href="{{ article.url }}">
                  <div class="featured-blog-posts-v2__media-wrap">
                    {% if article.tags.size > 0 %}
                      <span class="featured-blog-posts-v2__badge">{{ article.tags.first }}</span>
                    {% endif %}
                    {% if article.image != blank %}
                      {{
                        article.image
                        | image_url: width: 860
                        | image_tag:
                          class: 'featured-blog-posts-v2__media',
                          loading: 'lazy',
                          widths: '320, 520, 740, 860',
                          sizes: '(min-width: 990px) 22vw, 100vw',
                          alt: article.title
                      }}
                    {% else %}
                      {{ 'blog-apparel-1' | placeholder_svg_tag: 'featured-blog-posts-v2__media featured-blog-posts-v2__media--placeholder' }}
                    {% endif %}
                  </div>
                </a>
                <div class="featured-blog-posts-v2__side-content">
                  <div class="featured-blog-posts-v2__meta">
                    <span>{{ article.published_at | date: '%b %d, %Y' }}</span>
                    {% if show_comments %}<span>{{ article.comments_count }} Comments</span>{% endif %}
                  </div>
                  <h3 class="featured-blog-posts-v2__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
                  {% if show_excerpt %}
                    <p class="featured-blog-posts-v2__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 14 }}</p>
                  {% endif %}
                  <a class="featured-blog-posts-v2__read-more" href="{{ article.url }}">Read more</a>
                </div>
              </article>
            {% endfor %}
          {% endif %}

          {% assign side_missing = 2 | minus: side_rendered %}
          {% if side_missing > 0 %}
            {% for i in (1..side_missing) %}
              <article class="featured-blog-posts-v2__side-item">
                <div class="featured-blog-posts-v2__media-wrap">
                  <span class="featured-blog-posts-v2__badge">Skincare</span>
                  {{ 'blog-apparel-1' | placeholder_svg_tag: 'featured-blog-posts-v2__media featured-blog-posts-v2__media--placeholder' }}
                </div>
                <div class="featured-blog-posts-v2__side-content">
                  <div class="featured-blog-posts-v2__meta"><span>{{ 'now' | date: '%b %d, %Y' }}</span><span>0 Comments</span></div>
                  <h3 class="featured-blog-posts-v2__title">Build the Perfect Routine for Your Skin Type</h3>
                  <p class="featured-blog-posts-v2__excerpt">Discover how to glow with fewer products and better habits.</p>
                  <span class="featured-blog-posts-v2__read-more">Read more</span>
                </div>
              </article>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    {% else %}
      <div class="featured-blog-posts-v2__grid" role="list">
        {% assign rendered_count = 0 %}
        {% if source_blog != blank and source_blog.articles_count > 0 %}
          {% for article in source_blog.articles limit: display_limit %}
            {% assign rendered_count = rendered_count | plus: 1 %}
            <article class="featured-blog-posts-v2__card" role="listitem">
              <a class="featured-blog-posts-v2__card-link" href="{{ article.url }}">
                <div class="featured-blog-posts-v2__media-wrap">
                  {% if article.tags.size > 0 %}
                    <span class="featured-blog-posts-v2__badge">{{ article.tags.first }}</span>
                  {% endif %}
                  {% if article.image != blank %}
                    {{
                      article.image
                      | image_url: width: 1100
                      | image_tag:
                        class: 'featured-blog-posts-v2__media',
                        loading: 'lazy',
                        widths: '420, 640, 860, 1100',
                        sizes: '(min-width: 990px) 31vw, 84vw',
                        alt: article.title
                    }}
                  {% else %}
                    {{ 'blog-apparel-1' | placeholder_svg_tag: 'featured-blog-posts-v2__media featured-blog-posts-v2__media--placeholder' }}
                  {% endif %}
                </div>
              </a>
              <div class="featured-blog-posts-v2__content">
                <div class="featured-blog-posts-v2__meta">
                  <span>{{ article.published_at | date: '%b %d, %Y' }}</span>
                  {% if show_comments %}<span>{{ article.comments_count }} Comments</span>{% endif %}
                </div>
                <h3 class="featured-blog-posts-v2__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
                {% if show_excerpt %}
                  <p class="featured-blog-posts-v2__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
                {% endif %}
                <a class="featured-blog-posts-v2__read-more" href="{{ article.url }}">Read more</a>
              </div>
            </article>
          {% endfor %}
        {% endif %}

        {% assign missing = display_limit | minus: rendered_count %}
        {% if missing > 0 %}
          {% for i in (1..missing) %}
            <article class="featured-blog-posts-v2__card" role="listitem">
              <div class="featured-blog-posts-v2__media-wrap">
                <span class="featured-blog-posts-v2__badge">Skincare</span>
                {{ 'blog-apparel-1' | placeholder_svg_tag: 'featured-blog-posts-v2__media featured-blog-posts-v2__media--placeholder' }}
              </div>
              <div class="featured-blog-posts-v2__content">
                <div class="featured-blog-posts-v2__meta"><span>{{ 'now' | date: '%b %d, %Y' }}</span><span>0 Comments</span></div>
                <h3 class="featured-blog-posts-v2__title">Top 5 Skincare Trends of 2025</h3>
                <p class="featured-blog-posts-v2__excerpt">Explore the biggest beauty trends taking over this year.</p>
                <span class="featured-blog-posts-v2__read-more">Read more</span>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured blog posts",
  "tag": "section",
  "class": "featured-blog-posts-v2",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest Stories"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" },
        { "value": "split", "label": "Featured split (1 big + 2 small)" }
      ],
      "default": "split"
    },
    {
      "type": "range",
      "id": "grid_columns",
      "label": "Grid columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.layout_mode == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Grid columns (mobile/tablet)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1",
      "visible_if": "{{ section.settings.layout_mode == 'grid' }}"
    },
    {
      "type": "range",
      "id": "carousel_card_min",
      "label": "Carousel card width",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "rem",
      "default": 16,
      "visible_if": "{{ section.settings.layout_mode == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Posts to show",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.layout_mode != 'split' }}"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "Show comments count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View All Posts"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Featured blog posts",
      "settings": {
        "layout_mode": "split",
        "grid_columns": 3,
        "mobile_columns": "1",
        "carousel_card_min": 16,
        "card_gap": 24
      }
    }
  ]
}
{% endschema %}
