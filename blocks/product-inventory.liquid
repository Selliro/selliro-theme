

{%- liquid
  assign block_settings = block.settings
  assign variant = closest.product.selected_or_first_available_variant
  if variant.inventory_management == 'shopify'
    assign inventory_managed = true
  endif
  assign inventory_quantity = variant.inventory_quantity
  assign inventory_policy = variant.inventory_policy
  assign threshold = block_settings.inventory_threshold

  if inventory_managed
    if inventory_quantity > 0
      if inventory_quantity <= threshold
        assign status = 'low'
        assign show_quantity = block_settings.show_inventory_quantity
        if show_quantity == false
          assign translation_key = 'content.inventory_low_stock'
        endif
      else
        assign status = 'in_stock'
        assign translation_key = 'content.inventory_in_stock'
      endif
    else
      if inventory_policy == 'continue'
        assign status = 'in_stock'
        assign translation_key = 'content.inventory_in_stock'
      else
        assign status = 'out_of_stock'
        assign translation_key = 'content.inventory_out_of_stock'
      endif
    endif
  else
    if closest.product.selected_or_first_available_variant != null
      assign status = 'in_stock'
      assign translation_key = 'content.inventory_in_stock'
    else
      assign status = 'out_of_stock'
      assign translation_key = 'content.inventory_out_of_stock'
    endif
  endif

  # Selliro: stock progress bar + urgency messages ([count] = units left)
  assign show_bar = block_settings.show_progress_bar
  assign bar_full_at = block_settings.progress_full_at | default: 30
  case status
    when 'low'
      assign bar_pct = inventory_quantity | times: 100 | divided_by: bar_full_at | at_least: 6 | at_most: 100
      assign custom_text = block_settings.low_stock_text
    when 'in_stock'
      if inventory_managed and inventory_quantity > 0
        assign bar_pct = inventory_quantity | times: 100 | divided_by: bar_full_at | at_least: 6 | at_most: 100
      else
        assign bar_pct = 100
      endif
      assign custom_text = block_settings.in_stock_text
    else
      assign bar_pct = 0
      assign custom_text = ''
  endcase
  if custom_text contains '[count]' and inventory_managed != true
    assign custom_text = ''
  endif
  if custom_text != blank
    assign custom_text = custom_text | replace: '[count]', inventory_quantity
  endif
-%}

<product-inventory
  class="
    product-inventory spacing-style{% if show_bar %} product-inventory--bar{% endif %}
    {% if block_settings.type_preset != '' %}{{ block_settings.type_preset }}{% endif%}
  "
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
  data-product-id="{{ product.id }}"
>
  <span
    class="product-inventory__status"
  >
    <span
      class="svg-wrapper product-inventory__icon product-inventory__icon-{{ status }}"
    >
      {{ 'icon-inventory.svg' | inline_asset_content }}
    </span>
    <span
      class="product-inventory__text"
      id="Inventory-{{ section.id }}"
      role="status"
      aria-label="{{ 'accessibility.inventory_status' | t }}"
    >
      {%- if custom_text != blank -%}
        {{ custom_text }}
      {%- elsif show_quantity -%}
        {{ 'content.inventory_low_stock_show_count' | t: count: inventory_quantity }}
      {%- else -%}
        {{- translation_key | t -}}
      {%- endif -%}
    </span>
  </span>
  {%- if show_bar -%}
    <span class="product-inventory__bar product-inventory__bar--{{ status }}" aria-hidden="true">
      <span class="product-inventory__bar-fill" style="--stock-fill: {{ bar_pct }}%;"></span>
    </span>
  {%- endif -%}
</product-inventory>

{% stylesheet %}
  .product-inventory__status {
    display: flex;
    align-items: center;
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
    gap: var(--padding-xs);
  }

  .product-inventory__icon,
  .product-inventory__icon svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  .product-inventory__icon-low {
    color: var(--color-lowstock);
  }

  .product-inventory__icon-in_stock {
    color: var(--color-instock);
  }

  .product-inventory__icon-out_of_stock {
    color: var(--color-outofstock);
  }

  .product-inventory__icon circle:first-of-type {
    opacity: 0.3;
  }

  /* Stock progress bar */
  .product-inventory--bar {
    display: grid;
    gap: 0.55rem;
  }

  .product-inventory--bar .product-inventory__text {
    font-weight: 500;
  }

  .product-inventory__bar {
    position: relative;
    display: block;
    height: 6px;
    border-radius: 999px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  .product-inventory__bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--stock-fill, 0%);
    border-radius: inherit;
    background: var(--color-instock, #2f7a3d);
    transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    animation: stock-bar-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .product-inventory__bar--low .product-inventory__bar-fill {
    background: linear-gradient(90deg, var(--color-lowstock, #e8833a), color-mix(in srgb, var(--color-lowstock, #e8833a) 70%, #f8d12f));
  }

  .product-inventory__bar--low .product-inventory__bar-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.45), transparent);
    translate: -100% 0;
    animation: stock-bar-shine 2.4s ease-in-out 1.2s infinite;
  }

  @keyframes stock-bar-in {
    from {
      width: 0;
    }
  }

  @keyframes stock-bar-shine {
    to {
      translate: 100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-inventory__bar-fill,
    .product-inventory__bar-fill::after {
      animation: none;
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_inventory",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_inventory"
    },
    {
      "type": "range",
      "id": "inventory_threshold",
      "label": "t:settings.inventory_threshold",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_inventory_quantity",
      "label": "t:settings.show_inventory_quantity",
      "default": true
    },
    {
      "type": "header",
      "content": "Stock bar"
    },
    {
      "type": "checkbox",
      "id": "show_progress_bar",
      "label": "Show stock progress bar",
      "default": false
    },
    {
      "type": "range",
      "id": "progress_full_at",
      "label": "Bar is full at",
      "info": "Stock level that fills the whole bar.",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "pcs",
      "default": 30,
      "visible_if": "{{ block.settings.show_progress_bar }}"
    },
    {
      "type": "text",
      "id": "low_stock_text",
      "label": "Low stock message",
      "info": "[count] = units left. Leave empty for the default text.",
      "default": "Hurry! Only [count] left in stock"
    },
    {
      "type": "text",
      "id": "in_stock_text",
      "label": "In stock message",
      "info": "[count] = units left. Leave empty for the default text.",
      "default": "In stock, ready to ship"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_inventory",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
