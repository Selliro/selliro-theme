{%- doc -%}
  Product tags — small pills under the title (key ingredients, "Bestseller", "Limited" …).
  Uses the comma-separated list in the block, or the product's own tags.
{%- enddoc -%}
{%- liquid
  assign source = block.settings.source | default: 'manual'
  # Product tags, falling back to the list below when a product has none
  assign tag_list = block.settings.tags | split: ','
  if source == 'product' and closest.product.tags.size > 0
    assign tag_list = closest.product.tags
  endif
  assign style = block.settings.style | default: 'soft'
-%}
{%- if tag_list.size > 0 -%}
  <ul
    class="pdp-tags pdp-tags--{{ style }} list-unstyled"
    style="--pdp-tag-accent: {{ block.settings.accent_color | default: '#f8d12f' }};"
    {{ block.shopify_attributes }}
  >
    {%- for tag in tag_list limit: 8 -%}
      {%- assign label = tag | strip -%}
      {%- if label != blank -%}
        <li class="pdp-tags__tag{% if forloop.first and block.settings.highlight_first %} pdp-tags__tag--accent{% endif %}">
          {{- label | escape -}}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .pdp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }

  .pdp-tags__tag {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--color-foreground);
    background: color-mix(in srgb, var(--color-foreground) 6%, transparent);
  }

  .pdp-tags--outline .pdp-tags__tag {
    background: transparent;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-foreground) 22%, transparent);
  }

  .pdp-tags .pdp-tags__tag--accent {
    background: var(--pdp-tag-accent);
    color: #111;
    box-shadow: none;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product tags",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Tags from",
      "options": [
        { "value": "manual", "label": "List below" },
        { "value": "product", "label": "Product tags" }
      ],
      "default": "manual"
    },
    {
      "type": "text",
      "id": "tags",
      "label": "Tags",
      "info": "Separate with commas, e.g. Vitamin C, Niacinamide, Vegan. With 'Product tags', used for products that have no tags.",
      "default": "Bestseller, Vitamin C, Niacinamide, Hyaluronic acid"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "soft", "label": "Soft fill" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "soft"
    },
    {
      "type": "checkbox",
      "id": "highlight_first",
      "label": "Highlight the first tag",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Highlight color",
      "default": "#f8d12f",
      "visible_if": "{{ block.settings.highlight_first }}"
    }
  ],
  "presets": [{ "name": "Product tags" }]
}
{% endschema %}
