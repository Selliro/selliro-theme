{%- doc -%}
  Rating line — stars, score and review count from the product's reviews metafield
  (reviews.rating / reviews.rating_count, filled by review apps). Without reviews it shows nothing on the
  storefront; in the theme editor it shows the preview values so the block can be placed and styled.
{%- enddoc -%}
{%- liquid
  assign has_reviews = false
  if closest.product.metafields.reviews.rating.value != blank
    assign has_reviews = true
    assign rating = closest.product.metafields.reviews.rating.value.rating | round: 1
    assign count = closest.product.metafields.reviews.rating_count.value
  elsif request.design_mode
    assign rating = block.settings.rating | default: 4.8
    assign count = block.settings.count
  endif
  assign rating_pct = rating | times: 20
-%}
{%- if has_reviews or request.design_mode -%}
<a
  class="pdp-rating"
  href="{{ block.settings.link | default: '#reviews' }}"
  style="--pdp-star: {{ block.settings.star_color | default: '#e6b800' }}; --pdp-rating: {{ rating_pct }}%;"
  {{ block.shopify_attributes }}
>
  <span class="pdp-rating__stars" aria-hidden="true">
    <span class="pdp-rating__stars-fill">★★★★★</span>★★★★★
  </span>
  <span class="pdp-rating__score">{{ rating }}</span>
  {%- if count != blank -%}
    <span class="pdp-rating__count">({{ count }} {{ block.settings.count_label | escape }})</span>
  {%- endif -%}
  <span class="visually-hidden">{{ rating }} / 5</span>
</a>
{%- endif -%}

{% stylesheet %}
  .pdp-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    color: var(--color-foreground);
    text-decoration: none;
    width: fit-content;
  }

  .pdp-rating__stars {
    position: relative;
    display: inline-block;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    line-height: 1;
    color: color-mix(in srgb, var(--color-foreground) 18%, transparent);
  }

  .pdp-rating__stars-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--pdp-rating);
    overflow: hidden;
    white-space: nowrap;
    color: var(--pdp-star);
  }

  .pdp-rating__score {
    font-weight: 600;
  }

  .pdp-rating__count {
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--color-foreground) 30%, transparent);
  }

  .pdp-rating:hover .pdp-rating__count {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rating",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "use_metafield",
      "label": "Show review app rating",
      "info": "Ratings come from your review app (product reviews metafield). Products without reviews show no rating.",
      "default": true
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Preview rating",
      "info": "Only shown in the theme editor, while the product has no reviews.",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "type": "text",
      "id": "count",
      "label": "Preview review count",
      "info": "Only shown in the theme editor.",
      "default": "1,240"
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Count label",
      "default": "reviews"
    },
    {
      "type": "text",
      "id": "link",
      "label": "Link",
      "info": "Where the rating scrolls to, for example #reviews",
      "default": "#reviews"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#e6b800"
    }
  ],
  "presets": [{ "name": "Rating" }]
}
{% endschema %}
