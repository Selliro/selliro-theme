{%- doc -%}
  Sticky add-to-cart bar — slides up from the bottom once the main Add to cart button scrolls away.
  It mirrors the selected size and price and presses the main button, so the cart, quantity and
  variant logic stay Horizon's own.
{%- enddoc -%}
{%- assign product = closest.product -%}
<pdp-sticky-bar
  class="pdp-sticky color-{{ block.settings.color_scheme }}"
  data-hide-mobile="{{ block.settings.hide_on_mobile }}"
  aria-hidden="true"
  {{ block.shopify_attributes }}
>
  <div class="pdp-sticky__inner">
    <div class="pdp-sticky__product">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', width: 44, height: 44, alt: '', class: 'pdp-sticky__image' }}
      {%- endif -%}
      <div class="pdp-sticky__text">
        <span class="pdp-sticky__title">{{ product.title | escape }}</span>
        <span class="pdp-sticky__variant" data-pdp-sticky-variant>
          {%- unless product.has_only_default_variant -%}{{ product.selected_or_first_available_variant.title | escape }}{%- endunless -%}
        </span>
      </div>
    </div>
    <span class="pdp-sticky__price" data-pdp-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</span>
    <button type="button" class="button pdp-sticky__button" data-pdp-sticky-add tabindex="-1">
      <span data-pdp-sticky-label>{{ block.settings.button_label | escape }}</span>
    </button>
  </div>
</pdp-sticky-bar>

<script src="{{ 'pdp.js' | asset_url }}" defer></script>

{% stylesheet %}
  /* Floating bar: centred, half the screen wide on desktop, a rounded card with a soft shadow.
     Phones and tablets: nearly full width with a small margin (half would be too narrow). */
  .pdp-sticky {
    --pdp-sticky-gap: max(0.75rem, env(safe-area-inset-bottom));

    position: fixed;
    left: 50%;
    bottom: var(--pdp-sticky-gap);
    z-index: calc(var(--layer-sticky, 20) + 1);
    width: min(calc(100% - 1.5rem), 720px);
    padding: 0.55rem 0.55rem 0.55rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: 999px;
    background: var(--color-background);
    color: var(--color-foreground);
    box-shadow:
      0 18px 40px -18px rgb(0 0 0 / 0.35),
      0 2px 8px -2px rgb(0 0 0 / 0.08);
    translate: -50% calc(100% + var(--pdp-sticky-gap) + 1rem);
    opacity: 0;
    transition:
      translate 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }

  @media screen and (min-width: 990px) {
    .pdp-sticky {
      --pdp-sticky-gap: 1.25rem;

      width: clamp(560px, 50vw, 820px);
    }
  }

  .pdp-sticky.is-visible {
    translate: -50% 0;
    opacity: 1;
  }

  /* The theme's bottom blur (layout/theme.liquid .blur-div) would blur the bar: hide it while the bar shows */
  body:has(.pdp-sticky.is-visible) .blur-div {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* Lift the back-to-top button above the bar where the two would meet (below desktop) */
  #progress-wrap {
    transition: translate 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
  }

  @media screen and (max-width: 989px) {
    body:has(.pdp-sticky.is-visible) #progress-wrap {
      translate: 0 calc(-1 * (5rem + env(safe-area-inset-bottom)));
    }
  }

  .pdp-sticky[data-hide-mobile='true'] {
    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .pdp-sticky__inner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .pdp-sticky__product {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  .pdp-sticky__image {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
    flex: 0 0 auto;
  }

  .pdp-sticky__text {
    display: grid;
    min-width: 0;
  }

  .pdp-sticky__title {
    font-weight: 600;
    font-size: 0.9375rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pdp-sticky__variant {
    font-size: 0.75rem;
    opacity: 0.65;
  }

  .pdp-sticky__variant:empty {
    display: none;
  }

  .pdp-sticky__price {
    font-weight: 600;
    white-space: nowrap;
  }

  .pdp-sticky__price :is(s, .compare-at-price) {
    margin-inline-start: 0.35rem;
    font-weight: 400;
    opacity: 0.5;
  }

  .pdp-sticky__button {
    flex: 0 0 auto;
    min-height: 2.75rem;
    padding-inline: 1.6rem;
    border-radius: 999px;
  }

  @media screen and (max-width: 749px) {
    .pdp-sticky {
      padding: 0.45rem 0.45rem 0.45rem 0.6rem;
    }

    .pdp-sticky__inner {
      gap: 0.6rem;
    }

    .pdp-sticky__image {
      width: 2.25rem;
      height: 2.25rem;
    }

    .pdp-sticky__variant {
      display: none;
    }

    .pdp-sticky__title {
      font-size: 0.8125rem;
    }

    .pdp-sticky__price {
      font-size: 0.875rem;
    }

    .pdp-sticky__price :is(s, .compare-at-price) {
      display: none;
    }

    .pdp-sticky__button {
      min-height: 2.5rem;
      padding-inline: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pdp-sticky {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticky add to cart",
  "tag": null,
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Sticky add to cart" }]
}
{% endschema %}
