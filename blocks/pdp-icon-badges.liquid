{%- doc -%}
  Icon badges — a row of up to five small promises (Vegan, Cruelty free, Recyclable …).
  Each badge uses a built-in line icon or an uploaded image.
{%- enddoc -%}
<ul class="pdp-badges list-unstyled" {{ block.shopify_attributes }}>
  {%- for i in (1..5) -%}
    {%- liquid
      assign k_icon = 'icon_' | append: i
      assign k_image = 'image_' | append: i
      assign k_label = 'label_' | append: i
      assign icon = block.settings[k_icon] | default: 'none'
      assign image = block.settings[k_image]
      assign label = block.settings[k_label]
    -%}
    {%- if label != blank -%}
      <li class="pdp-badges__item">
        <span class="pdp-badges__icon" aria-hidden="true">
          {%- if image != blank -%}
            {{ image | image_url: width: 96 | image_tag: loading: 'lazy', width: 28, height: 28, alt: '' }}
          {%- else -%}
            {%- render 'pdp-icon', icon: icon -%}
          {%- endif -%}
        </span>
        <span class="pdp-badges__label">{{ label | escape }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>

{% stylesheet %}
  /* Centred row: the badges share the width evenly, and a wrapped row stays centred too */
  .pdp-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 0.5rem;
    margin: 0;
    padding: 0;
  }

  .pdp-badges__item {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 4.5rem;
    max-width: 8rem;
    text-align: center;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    line-height: 1.25;
  }

  /* Phones: keep all five on one row */
  @media screen and (max-width: 480px) {
    .pdp-badges {
      gap: 0.75rem 0.25rem;
    }

    .pdp-badges__item {
      min-width: 3.6rem;
    }
  }

  .pdp-badges__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-foreground) 22%, transparent);
  }

  .pdp-badges__icon :is(svg, img) {
    width: 1.35rem;
    height: 1.35rem;
    object-fit: contain;
  }
{% endstylesheet %}

