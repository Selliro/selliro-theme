

{% assign block_settings = block.settings %}
{%- assign block_index = section.blocks | find_index: 'id', block.id -%}
{%- assign section_index = section.index -%}

{% capture children %}
  {% liquid
    assign preview_image = block_settings.image_1
    if block_settings.media_type_1 == 'video' and block_settings.video_1 != blank
      assign preview_image = block_settings.video_1.preview_image | default: block_settings.image_1
    endif
    assign is_split = false
    if block_settings.media_layout == 'split'
      assign is_split = true
    endif
  %}
  {% if section.settings.slide_height == 'adapt_image' and block_index == 0 and preview_image != blank %}
    {%
      # Great example of why it can be helpful for a section to be able to read the settings of its direct child blocks.
      # In this case, we want the section to be able to read the image aspect ratio of the first slide and apply it to the slideshow slides and slides.
    %}
    {% style %}
      .shopify-section-{{ section.id }} slideshow-slides,
      .shopify-section-{{ section.id }} slideshow-slide {
        min-height: {{ 1 | divided_by: preview_image.aspect_ratio | times: 100 }}vw;
      }
    {% endstyle %}
  {% endif %}

  <div class="slide__image-container">
    {%- liquid
      assign media_sizes = '100vw'
      if is_split
        assign media_sizes = '(min-width: 750px) 50vw, 100vw'
      endif
      assign loading = 'lazy'
      if block_index == 0 and section_index <= 3
        assign loading = 'eager'
      endif
      assign fetchpriority = 'low'
      if block_index == 0 and section_index == 1
        assign fetchpriority = 'high'
      endif
      # Does this slide actually play a video? (empty video sources fall back to the image)
      assign slide_has_video = false
      assign slots = '1'
      if is_split
        assign slots = '1,2'
      endif
      assign slot_list = slots | split: ','
      for n in slot_list
        assign k_type = 'media_type_' | append: n
        assign k_video = 'video_' | append: n
        assign k_mp4 = 'video_url_' | append: n
        assign k_ext = 'video_external_' | append: n
        case block_settings[k_type]
          when 'video'
            if block_settings[k_video] != blank
              assign slide_has_video = true
            endif
          when 'mp4'
            if block_settings[k_mp4] != blank
              assign slide_has_video = true
            endif
          when 'external'
            if block_settings[k_ext] != blank
              assign slide_has_video = true
            endif
        endcase
      endfor
      assign show_toggle = section.settings.video_toggle
      if show_toggle == nil
        assign show_toggle = true
      endif
    -%}
    <div
      class="slide__panes{% if is_split %} slide__panes--split slide__panes--mobile-{{ block_settings.split_mobile | default: 'stack' }}{% endif %}"
      {% if is_split %}style="--slide-split: {{ block_settings.split_ratio | default: 50 }}%;"{% endif %}
    >
      {% render 'slide-media', settings: block_settings, n: 1, loading: loading, fetchpriority: fetchpriority, sizes: media_sizes %}
      {%- if is_split -%}
        {% render 'slide-media', settings: block_settings, n: 2, loading: loading, fetchpriority: 'low', sizes: media_sizes %}
      {%- endif -%}
    </div>
    {%- if block_settings.toggle_overlay -%}
      {% render 'overlay', settings: block_settings %}
    {%- endif -%}
  </div>
  <div
    class="spacing-style slide__content{% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}{% if preview_image or block_settings.toggle_overlay %} background-transparent{% endif %}"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    {%- liquid
      assign copy_align = block_settings.text_align | default: 'left'
      assign copy_position = block_settings.text_position | default: 'center'
      assign copy_tone = block_settings.text_tone | default: 'light'
      assign has_copy = false
      if block_settings.eyebrow != blank or block_settings.heading != blank or block_settings.subheading != blank or block_settings.button_label_1 != blank or block_settings.button_label_2 != blank
        assign has_copy = true
      endif
    -%}
    {%- if has_copy -%}
      <div class="ss-copy ss-copy--h-{{ copy_align }} ss-copy--v-{{ copy_position }} ss-copy--{{ copy_tone }}">
        <div class="ss-copy__panel">
          {%- if block_settings.eyebrow != blank -%}
            <p class="ss-copy__eyebrow">{{ block_settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if block_settings.heading != blank -%}
            <h2 class="ss-copy__heading">{{ block_settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if block_settings.subheading != blank -%}
            <p class="ss-copy__text">{{ block_settings.subheading | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if block_settings.button_label_1 != blank or block_settings.button_label_2 != blank -%}
            <div class="ss-copy__buttons">
              {%- if block_settings.button_label_1 != blank -%}
                <a class="button ss-copy__btn" href="{{ block_settings.button_link_1 | default: routes.all_products_collection_url }}">
                  {{- block_settings.button_label_1 | escape -}}
                </a>
              {%- endif -%}
              {%- if block_settings.button_label_2 != blank -%}
                <a class="button-secondary ss-copy__btn ss-copy__btn--secondary" href="{{ block_settings.button_link_2 | default: routes.all_products_collection_url }}">
                  {{- block_settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- comment -%} Any extra theme blocks added to the slide (text, buttons, groups…) {%- endcomment -%}
    <div
      class="group-block-content layout-panel-flex layout-panel-flex--column slide__blocks"
      style="--flex-direction: column; --horizontal-alignment: {{ copy_align | replace: 'left', 'flex-start' | replace: 'right', 'flex-end' }}; --vertical-alignment: center; --gap: 12px;"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
  {%- if slide_has_video and show_toggle -%}
    <button
      type="button"
      class="slide__video-toggle"
      data-slide-toggle
      aria-pressed="false"
      aria-label="{{ 'accessibility.pause_video' | t | escape }}"
      data-label-pause="{{ 'accessibility.pause_video' | t | escape }}"
      data-label-play="{{ 'accessibility.play_video' | t | escape }}"
    >
      <svg class="slide__video-toggle-pause" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="M6 4h3v12H6zM11 4h3v12h-3z" fill="currentColor"/></svg>
      <svg class="slide__video-toggle-play" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="M6 4.5v11l9-5.5z" fill="currentColor"/></svg>
    </button>
  {%- endif -%}
{% endcapture %}

{%- capture class -%}
  {%- if block_settings.inherit_color_scheme == false -%}
    color-{{ block_settings.color_scheme }}
  {%- endif -%}
{%- endcapture -%}

{% render 'slideshow-slide',
  index: block_index,
  class: class,
  children: children,
  attributes: block.shopify_attributes
%}

{% stylesheet %}
  .slide__content {
    height: 100%;
    position: relative;
    z-index: var(--layer-flat);
  }

  .slide__content > * {
    margin: auto;
  }

  .slide__content.background-transparent {
    background-color: transparent;
  }

  .slide__panes {
    position: absolute;
    inset: 0;
    display: flex;
  }

  .slide__media {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    container-type: size;
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .slide__panes--split > .slide__media:first-child {
    flex: 0 0 var(--slide-split, 50%);
  }

  .slide__media > picture,
  .slide__media > picture > img,
  .slide__media > .slide__image,
  .slide__media > .slide__video,
  .slide__media > .slide__video-poster,
  .slide__media > placeholder-image,
  .slide__media > svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .slide__media > .slide__video {
    z-index: 1;
  }

  /* YouTube / Vimeo: scale the 16:9 player so it always covers the pane */
  .slide__embed {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .slide__iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100cqw, 177.78cqh);
    height: max(100cqh, 56.25cqw);
    border: 0;
    translate: -50% -50%;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .slide__media.is-playing .slide__iframe {
    opacity: 1;
  }

  .slide__video-toggle {
    position: absolute;
    z-index: calc(var(--layer-flat, 1) + 2);
    right: 1rem;
    bottom: 1rem;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.38);
    backdrop-filter: blur(8px);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .slide__video-toggle:hover {
    background: rgb(0 0 0 / 0.55);
    transform: scale(1.05);
  }

  .slide__video-toggle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .slide__video-toggle-play,
  .slide__video-toggle[aria-pressed='true'] .slide__video-toggle-pause {
    display: none;
  }

  .slide__video-toggle[aria-pressed='true'] .slide__video-toggle-play {
    display: block;
  }

  .slide__image-container > .overlay {
    z-index: 1;
  }

  /* Split on phones: stack the two panes, or keep only the first */
  @media screen and (max-width: 749px) {
    .slide__panes--split.slide__panes--mobile-stack {
      flex-direction: column;
    }

    .slide__panes--split.slide__panes--mobile-stack > .slide__media:first-child {
      flex: 1 1 0;
    }

    .slide__panes--split.slide__panes--mobile-first > .slide__media:nth-child(2) {
      display: none;
    }

    .slide__video-toggle {
      right: 0.75rem;
      bottom: 0.75rem;
    }
  }

  /* ---- Built-in slide text (heading, small heading, text, buttons) ---- */
  .ss-copy {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: inherit;
    padding: clamp(1.5rem, 5vw, 5rem) clamp(1.25rem, 5.5vw, 6rem);
    box-sizing: border-box;
  }

  .ss-copy--h-left { justify-content: flex-start; text-align: start; }
  .ss-copy--h-center { justify-content: center; text-align: center; }
  .ss-copy--h-right { justify-content: flex-end; text-align: end; }
  .ss-copy--v-top { align-items: flex-start; }
  .ss-copy--v-center { align-items: center; }
  .ss-copy--v-bottom { align-items: flex-end; }

  .ss-copy__panel {
    display: grid;
    gap: clamp(0.75rem, 1.4vw, 1.1rem);
    max-width: min(46rem, 100%);
    justify-items: start;
  }

  .ss-copy--h-center .ss-copy__panel { justify-items: center; }
  .ss-copy--h-right .ss-copy__panel { justify-items: end; }

  .ss-copy--light { --ss-ink: #ffffff; --ss-ink-soft: rgb(255 255 255 / 0.88); }
  .ss-copy--dark { --ss-ink: #141414; --ss-ink-soft: rgb(20 20 20 / 0.8); }

  .ss-copy__eyebrow {
    margin: 0;
    font-size: clamp(0.8125rem, 1.1vw, 0.9375rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ss-ink);
  }

  .ss-copy__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--ss-heading-weight, 700);
    font-size: clamp(2rem, 5.2vw, var(--ss-heading-size, 64px));
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: var(--ss-heading-case, none);
    text-wrap: balance;
    color: var(--ss-ink);
  }

  .ss-copy__text {
    margin: 0;
    max-width: 38rem;
    font-size: clamp(1rem, 1.3vw, 1.1875rem);
    line-height: 1.5;
    color: var(--ss-ink-soft);
    text-wrap: pretty;
  }

  .ss-copy__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .ss-copy--h-center .ss-copy__buttons { justify-content: center; }
  .ss-copy--h-right .ss-copy__buttons { justify-content: flex-end; }

  .ss-copy__btn {
    min-height: 3.25rem;
    padding-inline: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 700;
    text-decoration: none;
  }

  /* Main button on media: white on light-text slides, near-black on dark-text slides
     (the section's custom button colors override this) */
  .ss-copy--light .ss-copy__btn:not(.ss-copy__btn--secondary) {
    --button-background-color: #ffffff;
    --button-border-color: #ffffff;
    --button-color: #111111;
  }

  .ss-copy--light .ss-copy__btn:not(.ss-copy__btn--secondary):hover {
    --button-background-color: rgb(255 255 255 / 0.86);
    --button-border-color: rgb(255 255 255 / 0.86);
    --button-color: #111111;
  }

  .ss-copy--dark .ss-copy__btn:not(.ss-copy__btn--secondary),
  .ss-copy--dark .ss-copy__btn:not(.ss-copy__btn--secondary):hover {
    --button-background-color: #141414;
    --button-border-color: #141414;
    --button-color: #ffffff;
  }

  /* Second button on media: outlined in the text color */
  .ss-copy__btn--secondary {
    --button-color: var(--ss-ink);
    --button-background-color: transparent;
    --button-border-color: var(--ss-ink);
    border: 1.5px solid var(--ss-ink);
  }

  .ss-copy__btn--secondary:hover {
    --button-color: var(--ss-ink);
    --button-background-color: color-mix(in srgb, var(--ss-ink) 14%, transparent);
  }

  /* Extra theme blocks: hidden when there are none */
  .slide__blocks:not(:has(*)) {
    display: none;
  }

  .slide__content:has(.ss-copy) {
    display: flex;
    flex-direction: column;
  }

  @media screen and (max-width: 749px) {
    .ss-copy {
      padding: 2.5rem 1.25rem 3.5rem;
    }

    .ss-copy__btn {
      min-height: 3rem;
    }
  }

  slideshow-slide > .slide__image-container {
    display: flex;
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: absolute;
  }

  .slide__image-container > placeholder-image,
  .slide__image-container > placeholder-image > img {
    width: 100%;
  }

  .slide__image-container > .slide__image,
  .slide__image-container > .slide__video,
  .slide__image-container > .slide__video-poster {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .slide__image-container > .slide__video-poster {
    position: absolute;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.slide",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "media_type_1",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:collection_grid.media_upload"
        },
        {
          "value": "mp4",
          "label": "t:collection_grid.media_mp4"
        },
        {
          "value": "external",
          "label": "t:collection_grid.media_external"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "t:settings.image",
      "info": "t:collection_grid.image_poster_info"
    },
    {
      "type": "image_picker",
      "id": "image_mobile_1",
      "label": "t:slideshow_media.mobile_image",
      "info": "t:slideshow_media.mobile_image_info",
      "visible_if": "{{ block.settings.media_type_1 == 'image' }}"
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "t:settings.video",
      "visible_if": "{{ block.settings.media_type_1 == 'video' }}"
    },
    {
      "type": "url",
      "id": "video_url_1",
      "label": "t:collection_grid.video_mp4",
      "info": "t:collection_grid.video_mp4_info",
      "visible_if": "{{ block.settings.media_type_1 == 'mp4' }}"
    },
    {
      "type": "video_url",
      "id": "video_external_1",
      "label": "t:collection_grid.video_url",
      "accept": ["youtube", "vimeo"],
      "visible_if": "{{ block.settings.media_type_1 == 'external' }}"
    },
    {
      "type": "select",
      "id": "media_layout",
      "label": "t:slideshow_media.media_layout",
      "options": [
        {
          "value": "full",
          "label": "t:options.full"
        },
        {
          "value": "split",
          "label": "t:slideshow_media.split"
        }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "t:content.media_2",
      "visible_if": "{{ block.settings.media_layout == 'split' }}"
    },
    {
      "type": "select",
      "id": "media_type_2",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:collection_grid.media_upload"
        },
        {
          "value": "mp4",
          "label": "t:collection_grid.media_mp4"
        },
        {
          "value": "external",
          "label": "t:collection_grid.media_external"
        }
      ],
      "default": "video",
      "visible_if": "{{ block.settings.media_layout == 'split' }}"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:settings.image",
      "info": "t:collection_grid.image_poster_info",
      "visible_if": "{{ block.settings.media_layout == 'split' }}"
    },
    {
      "type": "video",
      "id": "video_2",
      "label": "t:settings.video",
      "visible_if": "{{ block.settings.media_layout == 'split' and block.settings.media_type_2 == 'video' }}"
    },
    {
      "type": "url",
      "id": "video_url_2",
      "label": "t:collection_grid.video_mp4",
      "info": "t:collection_grid.video_mp4_info",
      "visible_if": "{{ block.settings.media_layout == 'split' and block.settings.media_type_2 == 'mp4' }}"
    },
    {
      "type": "video_url",
      "id": "video_external_2",
      "label": "t:collection_grid.video_url",
      "accept": ["youtube", "vimeo"],
      "visible_if": "{{ block.settings.media_layout == 'split' and block.settings.media_type_2 == 'external' }}"
    },
    {
      "type": "select",
      "id": "split_ratio",
      "label": "t:slideshow_media.split_ratio",
      "options": [
        {
          "value": "50",
          "label": "50 / 50"
        },
        {
          "value": "60",
          "label": "60 / 40"
        },
        {
          "value": "40",
          "label": "40 / 60"
        }
      ],
      "default": "50",
      "visible_if": "{{ block.settings.media_layout == 'split' }}"
    },
    {
      "type": "select",
      "id": "split_mobile",
      "label": "t:slideshow_media.split_mobile",
      "options": [
        {
          "value": "stack",
          "label": "t:slideshow_media.stack"
        },
        {
          "value": "first",
          "label": "t:slideshow_media.first_only"
        }
      ],
      "default": "stack",
      "visible_if": "{{ block.settings.media_layout == 'split' }}"
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:slideshow_media.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:settings.text"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "top",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_tone",
      "label": "t:slideshow_media.text_tone",
      "options": [
        {
          "value": "light",
          "label": "t:options.light"
        },
        {
          "value": "dark",
          "label": "t:slideshow_media.dark"
        }
      ],
      "default": "light"
    },
    {
      "type": "header",
      "content": "t:content.buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "t:settings.label"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "t:settings.link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:slideshow_media.button_2"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.media_overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
