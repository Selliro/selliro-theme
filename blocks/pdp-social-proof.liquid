{%- doc -%}
  Social proof bar — "Loved by 12,000+ happy customers" with up to three avatar photos.
{%- enddoc -%}
<div
  class="pdp-proof"
  style="--pdp-proof-bg: {{ block.settings.background | default: '#eef6e7' }}; --pdp-proof-fg: {{ block.settings.text_color | default: '#1f3b1a' }};"
  {{ block.shopify_attributes }}
>
  {%- liquid
    assign has_avatar = false
    if block.settings.avatar_1 != blank or block.settings.avatar_2 != blank or block.settings.avatar_3 != blank
      assign has_avatar = true
    endif
  -%}
  {%- if has_avatar -%}
    <span class="pdp-proof__avatars" aria-hidden="true">
      {%- for i in (1..3) -%}
        {%- assign key = 'avatar_' | append: i -%}
        {%- assign avatar = block.settings[key] -%}
        {%- if avatar != blank -%}
          {{ avatar | image_url: width: 96 | image_tag: loading: 'lazy', width: 32, height: 32, alt: '', class: 'pdp-proof__avatar' }}
        {%- endif -%}
      {%- endfor -%}
    </span>
  {%- else -%}
    <span class="pdp-proof__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.6 1.1 4.4 2.5h1.8c.8-1.4 2.3-2.5 4.4-2.5 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/></svg>
    </span>
  {%- endif -%}
  <span class="pdp-proof__text">{{ block.settings.text }}</span>
</div>

{% stylesheet %}
  .pdp-proof {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    background: var(--pdp-proof-bg);
    color: var(--pdp-proof-fg);
    font-size: 0.8125rem;
    line-height: 1.35;
    text-align: center;
  }

  .pdp-proof__text p {
    margin: 0;
  }

  .pdp-proof__avatars {
    display: inline-flex;
    flex: 0 0 auto;
  }

  .pdp-proof__avatar {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--pdp-proof-bg);
  }

  .pdp-proof__avatar + .pdp-proof__avatar {
    margin-inline-start: -0.55rem;
  }

  .pdp-proof__icon {
    display: inline-flex;
    flex: 0 0 auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social proof",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Loved by <strong>12,000+</strong> happy customers"
    },
    { "type": "image_picker", "id": "avatar_1", "label": "Avatar 1" },
    { "type": "image_picker", "id": "avatar_2", "label": "Avatar 2" },
    { "type": "image_picker", "id": "avatar_3", "label": "Avatar 3" },
    { "type": "color", "id": "background", "label": "Background", "default": "#eef6e7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1f3b1a" }
  ],
  "presets": [{ "name": "Social proof" }]
}
{% endschema %}
