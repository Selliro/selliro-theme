{%- doc -%}
  Benefits checklist — one benefit per line, shown with check marks.
{%- enddoc -%}
{%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
<ul
  class="pdp-benefits pdp-benefits--cols-{{ block.settings.columns | default: '1' }} list-unstyled"
  style="--pdp-check: {{ block.settings.icon_color | default: '#2f7a3d' }};"
  {{ block.shopify_attributes }}
>
  {%- for line in lines -%}
    {%- assign item = line | strip -%}
    {%- if item != blank -%}
      <li class="pdp-benefits__item">
        <svg class="pdp-benefits__icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
        <span>{{ item | escape }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>

{% stylesheet %}
  .pdp-benefits {
    display: grid;
    gap: 0.5rem 1.25rem;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .pdp-benefits--cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media screen and (max-width: 749px) {
    .pdp-benefits--cols-2 {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .pdp-benefits__item {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .pdp-benefits__icon {
    flex: 0 0 auto;
    margin-block-start: 0.05rem;
    padding: 2px;
    border-radius: 50%;
    color: var(--pdp-check);
    background: color-mix(in srgb, var(--pdp-check) 12%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Benefits list",
  "tag": null,
  "settings": [
    {
      "type": "textarea",
      "id": "items",
      "label": "Benefits",
      "info": "One per line",
      "default": "Visibly brighter skin in 2 weeks\nFades dark spots and uneven tone\nLightweight, absorbs in seconds\nSafe for sensitive skin"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    { "type": "color", "id": "icon_color", "label": "Check color", "default": "#2f7a3d" }
  ],
  "presets": [{ "name": "Benefits list" }]
}
{% endschema %}
