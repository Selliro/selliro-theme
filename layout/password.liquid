<!doctype html>
{%- comment -%}
  Whispo — password page layout (store closed to the public). Same head as layout/theme.liquid, without the
  header and footer groups; the password template renders the logo or shop name, the password message and
  the password form.
{%- endcomment -%}
<html
  class="no-js{% if settings.animations_reveal %} animations-reveal{% endif %}{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    <script type="importmap">
      {
        "imports": {
          "@whispo/component": "{{ 'component.js' | asset_url }}",
          "@whispo/utilities": "{{ 'utilities.js' | asset_url }}",
          "@whispo/events": "{{ 'events.js' | asset_url }}"
        }
      }
    </script>
    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>

    {{ content_for_header }}
  </head>

  <body class="color-{{ settings.color_schemes.first.id | default: 'scheme-1' }}">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
