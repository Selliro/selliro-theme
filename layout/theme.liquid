<!doctype html>
{%- comment -%}
  Whispo — main layout.
  head: meta and SEO (snippets/meta-tags), design tokens (snippets/css-variables), base styles, the JS module
        import map and theme data for scripts (window.Whispo: routes, money format, strings).
  body: skip link, header section group, <main id="MainContent">, footer section group.
  <html> classes: no-js → js (assets/theme.js), animations-reveal / animations-hover (Theme settings →
  Animations), shopify-design-mode in the theme editor.
{%- endcomment -%}
<html
  class="no-js{% if settings.animations_reveal %} animations-reveal{% endif %}{% if settings.animations_hover %} animations-hover{% endif %}{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- unless settings.type_body_font.system? -%}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless -%}
    {%- unless settings.type_heading_font.system? -%}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless -%}

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    <script type="importmap">
      {
        "imports": {
          "@whispo/component": "{{ 'component.js' | asset_url }}",
          "@whispo/utilities": "{{ 'utilities.js' | asset_url }}",
          "@whispo/events": "{{ 'events.js' | asset_url }}"
        }
      }
    </script>
    <link rel="modulepreload" href="{{ 'component.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'utilities.js' | asset_url }}">
    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>

    <script>
      window.Whispo = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          productRecommendations: {{ routes.product_recommendations_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        cartType: {{ settings.cart_type | json }},
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          quantityError: {{ 'cart.quantity_error' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="color-{{ settings.color_schemes.first.id | default: 'scheme-1' }}">
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
