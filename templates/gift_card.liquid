{% layout none %}
{%- comment -%}
  Whispo — issued gift card (the page customers open from their gift card email).
  Logo or shop name, a card with the balance (and the original value when part has been spent), the code with a
  copy button, a QR code (Shopify's qrcode.js, 120 x 120px) for use in store, Add to Apple Wallet, and print /
  shop buttons. Expired and disabled cards say so. Styles are inline: this page has no layout.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>

    {% style %}
      .gift-card {
        display: grid;
        align-content: center;
        justify-items: center;
        gap: 1.5rem;
        min-height: 100dvh;
        padding: 2.5rem var(--page-margin);
        text-align: center;
      }
      .gift-card__logo img {
        width: min(10rem, 50vw);
        height: auto;
      }
      .gift-card__card {
        display: grid;
        gap: 0.4rem;
        width: min(26rem, 100%);
        padding: 2rem 1.75rem;
        border-radius: var(--radius-card);
        background: var(--color-button);
        color: var(--color-button-text);
        box-shadow: 0 30px 60px -36px rgb(0 0 0 / 0.5);
      }
      .gift-card__label {
        font-size: var(--text-xs);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.85;
      }
      .gift-card__balance {
        margin: 0;
        color: inherit;
        font-size: var(--h1);
      }
      .gift-card__initial {
        font-size: var(--text-sm);
        opacity: 0.85;
      }
      .gift-card__status {
        padding: 0.6rem 1rem;
        border-radius: var(--radius-input);
        background: rgb(var(--color-text-rgb) / 0.07);
        font-weight: var(--font-body-weight-bold);
      }
      .gift-card__code-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
      }
      .gift-card__code {
        padding: 0.7rem 1.1rem;
        border: 1.5px dashed rgb(var(--color-text-rgb) / 0.45);
        border-radius: var(--radius-input);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: var(--text-lg);
        letter-spacing: 0.08em;
      }
      .gift-card__qr {
        display: grid;
        place-items: center;
        width: 136px;
        height: 136px;
        padding: 8px;
        border-radius: 12px;
        background: #fff;
      }
      .gift-card__qr img,
      .gift-card__qr canvas {
        width: 120px;
        height: 120px;
      }
      .gift-card__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
      }
      .gift-card__wallet img {
        width: 160px;
        height: auto;
      }
      @media print {
        .gift-card__actions,
        .gift-card__wallet,
        .gift-card__copy {
          display: none !important;
        }
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body class="color-{{ settings.color_schemes.first.id | default: 'scheme-1' }}">
    <main class="gift-card">
      <a href="{{ routes.root_url }}" class="gift-card__logo">
        {%- if settings.logo -%}
          {{ settings.logo | image_url: width: 400 | image_tag: widths: '160, 240, 320, 400', sizes: '160px', alt: shop.name }}
        {%- else -%}
          <span class="h3">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>

      <h1 class="h3">{{ 'gift_card.heading' | t: shop: shop.name }}</h1>

      <div class="gift-card__card">
        <span class="gift-card__label">{{ 'gift_card.card' | t }}</span>
        <p class="gift-card__balance">
          {%- if settings.show_currency_code -%}
            {{ gift_card.balance | money_with_currency }}
          {%- else -%}
            {{ gift_card.balance | money }}
          {%- endif -%}
        </p>
        {%- if gift_card.balance != gift_card.initial_value -%}
          {%- assign initial_value = gift_card.initial_value | money -%}
          <span class="gift-card__initial">{{ 'gift_card.initial_value' | t: value: initial_value }}</span>
        {%- endif -%}
      </div>

      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="gift-card__status" role="status">{{ 'gift_card.expired' | t }}</p>
      {%- elsif gift_card.expires_on -%}
        {%- assign expires_on = gift_card.expires_on | date: format: 'date' -%}
        <p>{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
      {%- endif -%}

      <p>{{ 'gift_card.use_at_checkout' | t }}</p>
      <div class="gift-card__code-row">
        <span class="gift-card__code" id="GiftCardCode">{{ gift_card.code | format_code }}</span>
        <button type="button" class="button button--secondary button--small gift-card__copy" data-copy="{{ gift_card.code | format_code }}" data-copied="{{ 'gift_card.copied' | t }}">
          {{- 'gift_card.copy_code' | t -}}
        </button>
      </div>
      <p class="visually-hidden" role="status" id="GiftCardCopyStatus"></p>

      <div class="gift-card__qr" id="GiftCardQr" data-identifier="{{ gift_card.qr_identifier }}" role="img" aria-label="{{ 'gift_card.qr_label' | t }}"></div>

      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
          <img
            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
            width="160"
            height="50"
          >
        </a>
      {%- endif -%}

      <div class="gift-card__actions">
        <button type="button" class="button button--secondary" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
        <a href="{{ routes.root_url }}" class="button">{{ 'gift_card.shop' | t }}</a>
      </div>
    </main>

    <script>
      window.addEventListener('load', function () {
        var qr = document.getElementById('GiftCardQr');
        if (qr && window.QRCode) {
          new window.QRCode(qr, { text: qr.dataset.identifier, width: 120, height: 120, imageAltText: qr.getAttribute('aria-label') });
        }
      });
      document.addEventListener('click', function (event) {
        var button = event.target.closest('[data-copy]');
        if (!button || !navigator.clipboard) return;
        navigator.clipboard.writeText(button.dataset.copy).then(function () {
          document.getElementById('GiftCardCopyStatus').textContent = button.dataset.copied;
          button.textContent = button.dataset.copied;
        });
      });
    </script>
  </body>
</html>
