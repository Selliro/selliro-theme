{
  "name": "Selliro",
  "version": "1.0.0",
  "description": "Shopify theme development tool.",
  "private": true,
  "main": "webpack.config.js",
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.vue"
  ],
  "scripts": {
    "build": "webpack",
    "deploy": "webpack && shopify theme push",
    "start": "NODE_ENV=development webpack --watch",
    "shopify:push": "shopify theme push",
    "shopify:pull": "shopify theme pull -o 'templates/*.json'"
  },
  "keywords": [
    "shopify",
    "theme",
    "webpack"
  ],
  "author": "@jingleBaba",
  "license": "ISC",
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@shopify/cli": "^3.87.4",
    "prop-types": "^15.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "swiper": "^10.3.1",
    "video.js": "^8.23.4"
  },
  "devDependencies": {
    "@babel/core": "^7.9.0",
    "@babel/plugin-transform-runtime": "^7.9.0",
    "@babel/preset-env": "^7.9.0",
    "@babel/preset-react": "^7.22.5",
    "@playwright/test": "^1.57.0",
    "@videojs/themes": "^1.0.1",
    "animate.css": "^4.1.1",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^8.1.0",
    "baseline-browser-mapping": "^2.9.14",
    "css-loader": "^6.7.1",
    "css-minimizer-webpack-plugin": "^6.0.0",
    "dotenv": "^16.0.0",
    "eslint": "^8.12.0",
