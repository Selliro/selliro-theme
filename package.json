{
  "name": "Selliro",
  "version": "1.0.0",
  "description": "Some dependecies required for development",
  "main": "index.js",
  "scripts": {
    "theme-pull-dev": "shopify theme pull --environment demo_store_listing_theme_pull",
    "serve-dev": "shopify theme dev --store=rani-st.myshopify.com --port=9292 --ignore=src/*.js --ignore=src/*.scss",
    "filter-files": "node files-build.js",
    "build-zip": "shopify theme package",
    "watch": "gulp build && gulp watch",
    "build": "gulp build --production",
    "start": "run-p serve-dev watch",
    "gen-zip": "run-s build filter-files build-zip"
  },
  "keywords": [
    "sass",
    "js-compiler"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "browserslist": "^4.21.4",
    "gulp": "^4.0.2",
    "gulp-concat": "^2.6.1",
    "gulp-flatten": "^0.4.0",
    "gulp-postcss": "^9.0.1",
    "gulp-sass": "^5.1.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.80.6",
    "tailwindcss": "^3.4.14",
    "yargs": "^17.7.2"
  },
  "browserslist": [
    "> 1%"
  ],
  "dependencies": {
    "@ungap/custom-elements": "^1.3.0",
    "instant.page": "5.2.0",
    "motion": "11.17.0",
    "swiper": "8.4.4"
  }
}

