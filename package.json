    "sass": "^1.63.6",
    "sass-loader": "^12.6.0",
    "skills": "^1.0.10",
    "stylelint": "^14.6.1",
    "stylelint-config-standard": "^25.0.0",
    "tailwindcss": "^3.4.17",
    "webpack": "^5.70.0",
