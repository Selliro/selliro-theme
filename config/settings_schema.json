  {
    "name": "t:settings_schema.logo.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings_schema.logo.logo"
      },
      {
        "type": "image_picker",
        "id": "logo_inverse",
        "label": "t:settings_schema.logo.logo_inverse",
        "info": "t:settings_schema.logo.logo_inverse_info"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "t:settings_schema.logo.logo_width",
        "min": 50,
        "max": 300,
        "step": 5,
        "unit": "px",
        "default": 120
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "label": "t:settings_schema.logo.logo_width_mobile",
        "min": 40,
        "max": 200,
        "step": 5,
        "unit": "px",
        "default": 96
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings_schema.logo.favicon",
        "info": "t:settings_schema.logo.favicon_info"
      }
    ]
  },
  {
    "name": "t:settings_schema.colors.name",
