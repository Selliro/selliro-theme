      {
        "type": "range",
        "id": "section_spacing_mobile",
        "label": "t:settings_schema.layout.section_spacing_mobile",
        "min": 24,
        "max": 96,
        "step": 4,
        "unit": "px",
        "default": 56
      }
    ]
  },
