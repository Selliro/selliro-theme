        "role": {
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_text",
          "secondary_button": "secondary_button",
          "on_secondary_button": "secondary_button_text",
          "links": "text",
          "icons": "text",
          "primary_button_border": "button",
          "secondary_button_border": "secondary_button_text"
        }
      }
    ]
  },
  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.typography.headings"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:settings_schema.typography.font",
        "default": "fraunces_n6"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "t:settings_schema.typography.heading_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "select",
        "id": "heading_case",
        "label": "t:settings_schema.typography.heading_case",
        "options": [
          {
            "value": "none",
            "label": "t:settings_schema.typography.case_default"
          },
          {
            "value": "uppercase",
            "label": "t:settings_schema.typography.case_uppercase"
          }
        ],
        "default": "none"
      },
      {
        "type": "header",
        "content": "t:settings_schema.typography.body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:settings_schema.typography.font",
        "default": "figtree_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "t:settings_schema.typography.body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "header",
        "content": "t:settings_schema.typography.accent"
      },
      {
        "type": "font_picker",
        "id": "type_accent_font",
        "label": "t:settings_schema.typography.font",
        "info": "t:settings_schema.typography.accent_info",
        "default": "fraunces_i4"
      }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
      {
        "type": "select",
        "id": "page_width",
        "label": "t:settings_schema.layout.page_width",
        "options": [
          {
            "value": "1200px",
            "label": "t:settings_schema.layout.width_narrow"
          },
          {
            "value": "1440px",
            "label": "t:settings_schema.layout.width_normal"
          },
          {
            "value": "1840px",
            "label": "t:settings_schema.layout.width_wide"
          }
        ],
        "default": "1440px"
      },
      {
        "type": "range",
        "id": "page_margin",
        "label": "t:settings_schema.layout.page_margin",
        "min": 12,
        "max": 64,
        "step": 2,
        "unit": "px",
        "default": 40
