          },
          {
            "type": "color",
            "id": "heading",
            "label": "t:settings_schema.colors.heading",
            "default": "#000000"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "t:settings_schema.colors.accent",
            "info": "t:settings_schema.colors.accent_info",
            "default": "#FAD02C"
          },
          {
            "type": "color",
            "id": "accent_text",
            "label": "t:settings_schema.colors.accent_text",
            "default": "#000000"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:settings_schema.colors.border",
            "default": "#E6E6E6"
          },
          {
            "type": "header",
            "content": "t:settings_schema.colors.buttons"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings_schema.colors.button",
            "default": "#000000"
          },
          {
            "type": "color",
            "id": "button_text",
            "label": "t:settings_schema.colors.button_text",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button",
            "label": "t:settings_schema.colors.secondary_button",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_text",
            "label": "t:settings_schema.colors.secondary_button_text",
            "default": "#000000"
          },
          {
            "type": "header",
            "content": "t:settings_schema.colors.inputs"
          },
          {
            "type": "color",
            "id": "input",
            "label": "t:settings_schema.colors.input",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "input_text",
            "label": "t:settings_schema.colors.input_text",
            "default": "#1A1A1A"
          }
